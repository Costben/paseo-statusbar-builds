index 000000000..4c30e73fe
--- /dev/null
+++ b/packages/server/src/server/agent/providers/dsh/provider-hooks.ts
@@ -0,0 +1,183 @@
+import type { AgentPromptInput } from "../../agent-sdk-types.js";
+import type { AgentGoal } from "../../agent-sdk-types.js";
+import type { ACPProviderHooks } from "../acp-agent.js";
+import {
+  type DshGoalWatcher,
+  dshGoalCacheCandidates,
+  readDshGoalFromCache,
+  resolveDshHome,
+  watchDshGoal,
+} from "./goal-projection.js";
+import { DshSubagentBridge } from "./native-bridge.js";
+import { DshSubagentProjector } from "./subagents.js";
+
+export interface DshProviderHooksOptions {
+  /** Overrides dsh's home directory; defaults to `DSH_HOME` or `~/.dsh`. */
+  dshHome?: string;
+  /** Overrides the goal poll cadence; the default is one second. */
+  pollIntervalMs?: number;
+}
+
+/**
+ * What Paseo sends to keep an armed goal moving. dsh activates an armed goal at
+ * the start of the next turn and injects its own round instructions there, so the
+ * text itself carries no instructions — it only has to be a prompt.
+ */
+const GOAL_CONTINUATION_PROMPT = "继续";
+
+/** `/goal` subcommands that never create a goal. */
+const GOAL_SUBCOMMANDS = new Set([
+  "pause",
+  "resume",
+  "clear",
+  "edit",
+  "status",
+  "show",
+  "done",
+  "cancel",
+]);
+
+/** The text of a prompt, whichever shape the caller handed over. */
+function promptText(prompt: AgentPromptInput): string {
+  if (typeof prompt === "string") {
+    return prompt;
+  }
+  const parts: string[] = [];
+  for (const block of prompt) {
+    if (block && typeof block === "object" && "text" in block && typeof block.text === "string") {
+      parts.push(block.text);
+    }
+  }
+  return parts.join("\n");
+}
+
+/** Whether this prompt is the `/goal <objective>` that creates a goal. */
+function startsGoal(text: string): boolean {
+  const match = /^\/goal(?:\s+([\s\S]*))?$/.exec(text.trim());
+  if (!match) {
+    return false;
+  }
+  const argument = (match[1] ?? "").trim();
+  if (argument.length === 0) {
+    return false;
+  }
+  const [head] = argument.split(/\s+/);
+  return !GOAL_SUBCOMMANDS.has(head.toLowerCase());
+}
+
+/**
+ * Provider hooks for dsh: the ACP stream carries no goal state, so each live
+ * session watches the goal row dsh persists for it and reports the changes as
+ * `goal_updated`.
+ *
+ * dsh also never advances a goal on its own under ACP: it arms the goal, ends the
+ * turn, and waits for the next prompt. Without a continuation the goal would stay
+ * active forever while Paseo shows an idle session, so the same hook asks for the
+ * next round whenever the goal is still active and the turn actually produced
+ * output.
+ *
+ * dsh says nothing about the child sessions it spawns for `subagent` and
+ * `subagent_fork` on the ACP stream — the transport has no `_meta` at all and
+ * `session/list` filters those sessions out. The transcript is the only place
+ * the edges survive, so each session also runs a {@link DshSubagentBridge} that
+ * tails it and reports the children as `provider_subagent` events, the same rail
+ * Kimi Code's subagents use. The `_meta` projector stays wired for the day dsh
+ * starts forwarding children itself.
+ */
+export function createDshProviderHooks(options: DshProviderHooksOptions = {}): ACPProviderHooks {
+  const watchers = new Map<string, DshGoalWatcher>();
+  /** Transcript readers; dsh never reports its children over ACP. */
+  const bridges = new Map<string, DshSubagentBridge>();
+  /** Last goal the watcher reported, kept for the moments the cache lags behind. */
+  const lastObserved = new Map<string, AgentGoal>();
+  /** Sessions whose newest turn created a goal the cache has not flushed yet. */
+  const pendingGoalStart = new Set<string>();
+  /** dsh forwards child sessions onto this stream; they belong on their own rail. */
+  const subagents = new DshSubagentProjector();
+
+  return {
+    onSessionReady(ctx) {
+      const watcher = watchDshGoal({
+        sessionId: ctx.acpSessionId,
+        home: resolveDshHome(options.dshHome),
+        provider: ctx.provider,
+        logger: ctx.logger,
+        emit: (event) => {
+          if (event.type === "goal_updated" && event.goal) {
+            lastObserved.set(ctx.acpSessionId, event.goal);
+            if (event.goal.status === "active") {
+              pendingGoalStart.delete(ctx.acpSessionId);
+            }
+          }
+          ctx.emit(event);
+        },
+        pollIntervalMs: options.pollIntervalMs,
+      });
+      watchers.set(ctx.acpSessionId, watcher);
+
+      // dsh spawns its children in-process and says nothing about them on the
+      // ACP stream, so the rail is read out of the session's own transcript.
+      const bridge = new DshSubagentBridge({
+        sessionId: ctx.acpSessionId,
+        home: resolveDshHome(options.dshHome),
+        provider: ctx.provider,
+        logger: ctx.logger,
+        emit: ctx.emit,
+        pollIntervalMs: options.pollIntervalMs,
+      });
+      bridges.set(ctx.acpSessionId, bridge);
+      bridge.start();
+
+      return {
+        onClose: () => {
+          watchers.delete(ctx.acpSessionId);
+          bridges.delete(ctx.acpSessionId);
+          lastObserved.delete(ctx.acpSessionId);
+          pendingGoalStart.delete(ctx.acpSessionId);
+          watcher.stop();
+          bridge.stop();
+        },
+      };
+    },
+    onSubagentUpdate(update, ctx) {
+      return subagents.handle(update, ctx);
+    },
+    onForegroundTurnStarting(ctx, prompt) {
+      // The goal row is written write-behind, so right after `/goal` there may be
+      // no cache file at all. Remember that this session just asked for a goal.
+      if (startsGoal(promptText(prompt))) {
+        pendingGoalStart.add(ctx.acpSessionId);
+      }
+    },
+    continueTurn(ctx) {
+      // A round that produced nothing is not worth another round; the caller
+      // stops the loop after a few of those as well.
+      if (!ctx.sawTimeline) {
+        return null;
+      }
+      const home = resolveDshHome(options.dshHome);
+      for (const candidate of dshGoalCacheCandidates(home, ctx.acpSessionId)) {
+        const result = readDshGoalFromCache(candidate);
+        if (result.kind === "unknown") {
+          // No cache yet, or it is mid-write: never start a round on a guess.
+          continue;
+        }
+        if (result.kind === "none" || result.goal.status !== "active") {
+          pendingGoalStart.delete(ctx.acpSessionId);
+          return null;
+        }
+        pendingGoalStart.delete(ctx.acpSessionId);
+        return GOAL_CONTINUATION_PROMPT;
+      }
+      // The cache has not caught up with the turn that just ended. Continue only
+      // when something already told us a goal exists and is running.
+      if (lastObserved.get(ctx.acpSessionId)?.status === "active") {
+        return GOAL_CONTINUATION_PROMPT;
+      }
+      if (pendingGoalStart.delete(ctx.acpSessionId)) {
+        return GOAL_CONTINUATION_PROMPT;
+      }
+      return null;
+    },
+  };
+}
