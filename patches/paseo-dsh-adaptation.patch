+import { mkdtempSync, mkdirSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, test } from "vitest";
+
+import { createTestLogger } from "../../../../test-utils/test-logger.js";
+import type { AgentStreamEvent } from "../../agent-sdk-types.js";
+import {
+  dshGoalCacheCandidates,
+  readDshGoalFromCache,
+  resolveDshHome,
+  watchDshGoal,
+} from "./goal-projection.js";
+
+const tempDirs: string[] = [];
+
+function createTempDir(): string {
+  const dir = mkdtempSync(path.join(tmpdir(), "paseo-dsh-goal-"));
+  tempDirs.push(dir);
+  return dir;
+}
+
+afterEach(() => {
+  while (tempDirs.length > 0) {
+    const dir = tempDirs.pop();
+    if (dir) {
+      rmSync(dir, { recursive: true, force: true });
+    }
+  }
+});
+
+/** Build the projection-cache document dsh writes for one session. */
+function buildCache(goal: Record<string, unknown> | null, current?: Record<string, unknown>) {
+  return {
+    version: 7,
+    record: {
+      rows: {
+        goal: {
+          ver: 3,
+          seq: 12,
+          val: {
+            current:
+              goal === null
+                ? null
+                : {
+                    goal,
+                    roundsStarted: 0,
+                    createdAt: 1_700_000_000_000,
+                    updatedAt: 1_700_000_005_000,
+                    ...current,
+                  },
+            seenGoalIds: [],
+            failure: null,
+          },
+        },
+      },
+    },
+  };
+}
+
+function writeCacheFile(home: string, sessionId: string, document: unknown): string {
+  const [file] = dshGoalCacheCandidates(home, sessionId);
+  if (!file) {
+    throw new Error("expected a cache candidate");
+  }
+  mkdirSync(path.dirname(file), { recursive: true });
+  writeFileSync(file, JSON.stringify(document));
+  return file;
+}
+
+const ACTIVE_GOAL = {
+  id: "goal-1",
+  revision: 1,
+  objective: "验证 dsh goal 适配",
+  phase: "active",
+  maxGoalRounds: 256,
+};
+
+describe("resolveDshHome", () => {
+  test("prefers an explicit override", () => {
+    expect(resolveDshHome("D:\\dsh-home")).toBe("D:\\dsh-home");
+  });
+
+  test("falls back to DSH_HOME, then the default location", () => {
+    const previous = process.env["DSH_HOME"];
+    try {
+      process.env["DSH_HOME"] = "D:\\from-env";
+      expect(resolveDshHome()).toBe("D:\\from-env");
+      process.env["DSH_HOME"] = "   ";
+      expect(resolveDshHome()).toContain(".dsh");
+    } finally {
+      if (previous === undefined) {
+        delete process.env["DSH_HOME"];
+      } else {
+        process.env["DSH_HOME"] = previous;
+      }
+    }
+  });
+});
+
+describe("dshGoalCacheCandidates", () => {
+  test("lists both the current and the legacy file name", () => {
+    expect(dshGoalCacheCandidates("C:\\dsh", "abc")).toEqual([
+      path.join("C:\\dsh", "storages", "session_projcache", "sessions", "abc.json"),
+      path.join("C:\\dsh", "storages", "session_projcache", "sessions", "session-abc.json"),
+    ]);
+  });
+});
+
+describe("readDshGoalFromCache", () => {
+  test("maps an active goal onto the Paseo payload", () => {
+    const home = createTempDir();
+    const file = writeCacheFile(home, "session-1", buildCache(ACTIVE_GOAL, { roundsStarted: 3 }));
+
+    expect(readDshGoalFromCache(file)).toEqual({
+      kind: "goal",
+      goal: {
+        goalId: "goal-1",
+        objective: "验证 dsh goal 适配",
+        status: "active",
+        turnsUsed: 3,
+        tokensUsed: 0,
+        startedAt: 1_700_000_000_000,
+        endedAt: null,
+        updatedAt: 1_700_000_005_000,
+      },
+    });
+  });
+
+  test("carries a blocked reason through as the terminal reason", () => {
+    const home = createTempDir();
+    const file = writeCacheFile(
+      home,
+      "session-1",
