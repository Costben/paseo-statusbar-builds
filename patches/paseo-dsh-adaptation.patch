+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import * as zlib from "node:zlib";
+import { afterEach, describe, expect, test } from "vitest";
+
+import {
+  collectDshSubagentFacts,
+  readDshSessionLog,
+  readDshTokenTotals,
+  resolveDshSessionLogPath,
+} from "./session-store.js";
+
+// The typings this repo builds against do not name zstd yet; the runtime has it.
+const zstdCompressSync = (zlib as unknown as { zstdCompressSync: (buffer: Buffer) => Buffer })
+  .zstdCompressSync;
+
+const tempDirs: string[] = [];
+
+function createTempDir(): string {
+  const dir = mkdtempSync(path.join(tmpdir(), "paseo-dsh-store-"));
+  tempDirs.push(dir);
+  return dir;
+}
+
+afterEach(() => {
+  while (tempDirs.length > 0) {
+    const dir = tempDirs.pop();
+    if (dir) {
+      rmSync(dir, { recursive: true, force: true });
+    }
+  }
+});
+
+/** dsh appends one zstd frame per flush, so a fixture is concatenated frames. */
+function frame(lines: Array<string | Record<string, unknown>>): Buffer {
+  const encoded = lines.map((line) => (typeof line === "string" ? line : JSON.stringify(line)));
+  return zstdCompressSync(Buffer.from(`${encoded.join("\n")}\n`, "utf8"));
+}
+
+function sessionFile(home: string, sessionId: string, workspace = "--Users-me-Projects-demo--"): string {
+  const dir = path.join(home, "sessions", workspace, sessionId);
+  mkdirSync(dir, { recursive: true });
+  const file = path.join(dir, "session.v4.jsonl.zstd");
+  writeFileSync(file, Buffer.alloc(0));
+  return file;
+}
+
+const CHILD = "d50f5a53-c77d-4bcf-b573-d419d8844e12";
+const HEADER = JSON.stringify({ type: "session", version: 4, id: "parent-1", cwd: "/tmp/demo" });
+const CATALOG = JSON.stringify({
+  type: "subagent/catalog",
+  data: { version: 0, childId: CHILD, childCreatedAt: 1_700_000_000_000, mode: "continuable", label: "Inspect the toolbar" },
+});
+
+describe("resolveDshSessionLogPath", () => {
+  test("finds the session under whichever workspace directory holds it", () => {
+    const home = createTempDir();
+    const file = sessionFile(home, "parent-1", "--Users-me-Other-project--");
+    expect(resolveDshSessionLogPath(home, "parent-1")).toBe(file);
+  });
+
+  test("returns null before dsh flushes anything", () => {
+    const home = createTempDir();
+    mkdirSync(path.join(home, "sessions"), { recursive: true });
+    expect(resolveDshSessionLogPath(home, "missing")).toBeNull();
+  });
+});
+
+describe("readDshSessionLog", () => {
+  test("returns one frame at a time and never re-reads what it consumed", () => {
+    const home = createTempDir();
+    const file = sessionFile(home, "parent-1");
+    writeFileSync(file, Buffer.concat([frame([HEADER, CATALOG])]));
+
+    const first = readDshSessionLog(file, 0);
+    expect(first.text.split("\n").filter(Boolean)).toHaveLength(2);
+    expect(first.pending).toBe(false);
+
+    const second = readDshSessionLog(file, first.offset);
+    expect(second.text).toBe("");
+    expect(second.offset).toBe(first.offset);
+  });
+
+  test("picks up a frame appended after the first read", () => {
+    const home = createTempDir();
+    const file = sessionFile(home, "parent-1");
+    const head = frame([HEADER]);
+    writeFileSync(file, head);
+    const first = readDshSessionLog(file, 0);
+
+    const settle = frame([
+      JSON.stringify({
+        type: "user/message",
+        data: {
+          source: { kind: "subagent-settled" },
+          content: [
+            {
+              type: "text",
+              text: `Background subagent ${CHILD} finished and will do no further work unless you send it more. Its closing message: done`,
+            },
+          ],
+        },
+      }),
+    ]);
+    writeFileSync(file, Buffer.concat([head, settle]));
+
+    const second = readDshSessionLog(file, first.offset);
+    expect(second.text).toContain("subagent-settled");
+    expect(second.offset).toBeGreaterThan(first.offset);
+  });
+
+  test("holds a torn frame until the rest of it lands", () => {
+    const home = createTempDir();
+    const file = sessionFile(home, "parent-1");
+    const whole = frame([HEADER, CATALOG]);
+    writeFileSync(file, whole.subarray(0, whole.length - 3));
+    const first = readDshSessionLog(file, 0);
+    expect(first.text).toBe("");
+    expect(first.pending).toBe(true);
+    expect(first.offset).toBe(0);
+
+    writeFileSync(file, whole);
+    const second = readDshSessionLog(file, first.offset);
+    expect(second.text.split("\n").filter(Boolean)).toHaveLength(2);
+  });
+});
+
+describe("readDshTokenTotals", () => {
+  test("reads the totals dsh writes for one session", () => {
+    const home = createTempDir();
+    const dir = path.join(home, "storages", "session_projcache", "sessions");
+    mkdirSync(dir, { recursive: true });
+    writeFileSync(
+      path.join(dir, "child-1.json"),
+      JSON.stringify({
+        version: 2,
+        record: {
+          rows: {
+            tokenUsage: {
+              ver: 2,
+              seq: 122,
+              val: {
+                totals: {
+                  uncachedInputTokens: 43_867,
+                  outputTokens: 14_058,
+                  cacheReadTokens: 718_592,
+                  cacheWriteTokens: 10,
+                },
+              },
+            },
+          },
+        },
+      }),
+    );
+
+    expect(readDshTokenTotals(home, "child-1")).toEqual({
+      inputTokens: 43_877,
+      cachedInputTokens: 718_592,
+      outputTokens: 14_058,
+    });
+  });
+
+  test("returns null when the cache has no usage yet", () => {
+    const home = createTempDir();
+    expect(readDshTokenTotals(home, "missing")).toBeNull();
+  });
+});
+
+describe("collectDshSubagentFacts", () => {
+  test("registers a child from the catalogue row", () => {
+    expect(collectDshSubagentFacts([CATALOG])).toEqual([
+      {
+        childId: CHILD,
+        createdAt: 1_700_000_000_000,
+        label: "Inspect the toolbar",
+        mode: "continuable",
+        settled: null,
+        closingMessage: null,
+      },
+    ]);
+  });
+
+  test("reads a finished child and its closing message", () => {
+    const settle = JSON.stringify({
+      type: "user/message",
+      data: {
+        source: { kind: "subagent-settled" },
+        content: [
+          {
+            type: "text",
+            text: `Background subagent ${CHILD} finished and will do no further work unless you send it more. Its closing message: 6 checks passed`,
+          },
+        ],
+      },
+    });
+    const [facts] = collectDshSubagentFacts([CATALOG, settle]);
+    expect(facts?.settled).toBe("completed");
+    expect(facts?.closingMessage).toBe("6 checks passed");
+  });
+
+  test("reads a stopped child as canceled", () => {
+    const settle = JSON.stringify({
+      type: "user/message",
+      data: {
+        source: { kind: "subagent-settled" },
+        content: [
+          {
+            type: "text",
+            text: `Background subagent ${CHILD} was stopped before it finished. It left no closing message.`,
+          },
+        ],
+      },
+    });
+    const [facts] = collectDshSubagentFacts([settle]);
+    expect(facts?.settled).toBe("canceled");
+    expect(facts?.closingMessage).toBeNull();
+  });
+
+  test("ignores notices that are not about a subagent", () => {
+    const other = JSON.stringify({
+      type: "user/message",
+      data: { source: { kind: "user" }, content: [{ type: "text", text: "hello" }] },
+    });
+    expect(collectDshSubagentFacts([other])).toEqual([]);
+  });
+});
