@@ -0,0 +1,246 @@
+import type { Logger } from "pino";
+
+import type { AgentProvider, AgentStreamEvent } from "../../agent-sdk-types.js";
+import type { ProviderSubagentStatus } from "../../provider-subagents/store.js";
+import {
+  collectDshSubagentFacts,
+  readDshSessionLog,
+  readDshTokenTotals,
+  resolveDshSessionLogPath,
+  type DshSubagentFacts,
+  type DshTokenTotals,
+} from "./session-store.js";
+
+/** Default cadence. A transcript poll is a `stat` until dsh flushes, so this is cheap. */
+const DEFAULT_POLL_INTERVAL_MS = 1_000;
+
+export interface DshSubagentBridgeOptions {
+  sessionId: string;
+  /** dsh home; the transcript lives under `<home>/sessions`. */
+  home: string;
+  provider: AgentProvider;
+  logger: Logger;
+  emit: (event: AgentStreamEvent) => void;
+  pollIntervalMs?: number;
+}
+
+/**
+ * Reads the subagent rail out of dsh's own transcript.
+ *
+ * dsh spawns children in-process and never mentions them on the ACP stream —
+ * `dsh-acp` has no `_meta` at all, and `session/list` filters subagent sessions
+ * out. The transcript is the only place the edges survive: `subagent/catalog`
+ * registers a child, and a `subagent-settled` notice ends it. Tailing that file
+ * is the same shape Kimi Code's bridge uses, and it lands on the same
+ * `provider_subagent` rail the ACP projector feeds.
+ */
+export class DshSubagentBridge {
+  private readonly sessionId: string;
+  private readonly home: string;
+  private readonly provider: AgentProvider;
+  private readonly logger: Logger;
+  private readonly emit: (event: AgentStreamEvent) => void;
+  private readonly pollIntervalMs: number;
+
+  private file: string | null = null;
+  private offset = 0;
+  private timer: ReturnType<typeof setTimeout> | null = null;
+  private started = false;
+  private stopped = false;
+  private polling = false;
+  /**
+   * Last row reported per child. The transcript hands the catalogue row and the
+   * settle notice to different polls, so the name has to outlive the batch that
+   * carried it.
+   */
+  private readonly reported = new Map<
+    string,
+    {
+      status: ProviderSubagentStatus;
+      subtitle: string | null;
+      label: string | null;
+      mode: string | null;
+    }
+  >();
+  /** Children whose closing message already went out; a compaction re-read must not duplicate it. */
+  private readonly closingSent = new Set<string>();
+
+  constructor(options: DshSubagentBridgeOptions) {
+    this.sessionId = options.sessionId;
+    this.home = options.home;
+    this.provider = options.provider;
+    this.logger = options.logger;
+    this.emit = options.emit;
+    this.pollIntervalMs = options.pollIntervalMs ?? DEFAULT_POLL_INTERVAL_MS;
+  }
+
+  /** Idempotent. Reads what the session already produced, then keeps up with it. */
+  start(): void {
+    if (this.started || this.stopped) {
+      return;
+    }
+    this.started = true;
+    void this.pollOnce();
+    this.schedule();
+  }
+
+  /** Idempotent. */
+  stop(): void {
+    this.stopped = true;
+    if (this.timer) {
+      clearTimeout(this.timer);
+      this.timer = null;
+    }
+  }
+
+  /** One read. Exposed for tests; the timer calls it with the same body. */
+  async pollOnce(): Promise<void> {
+    if (this.stopped || this.polling) {
+      return;
+    }
+    this.polling = true;
+    try {
+      if (this.file === null) {
+        this.file = resolveDshSessionLogPath(this.home, this.sessionId);
+        if (this.file === null) {
+          return;
+        }
+      }
+      const read = readDshSessionLog(this.file, this.offset);
+      if (read.text.length === 0) {
+        return;
+      }
+      this.offset = read.offset;
+      const facts = collectDshSubagentFacts(read.text.split("\n"));
+      for (const entry of facts) {
+        this.report(entry);
+      }
+    } catch (error) {
+      this.logger.warn({ err: error, sessionId: this.sessionId }, "dsh subagent bridge read failed");
+    } finally {
+      if (this.reported.size > 0) {
+        this.refreshSpend();
+      }
+      this.polling = false;
+    }
+  }
+
+  private report(entry: DshSubagentFacts): void {
+    const status: ProviderSubagentStatus = entry.settled ?? "running";
+    const previous = this.reported.get(entry.childId);
+    const label = entry.label ?? previous?.label ?? null;
+    const mode = entry.mode ?? previous?.mode ?? null;
+    const subtitle = this.subtitleFor(entry.childId, mode);
+    if (
+      previous?.status === status &&
+      previous.subtitle === subtitle &&
+      previous.label === label
+    ) {
+      return;
+    }
+    const next = { status, subtitle, label, mode };
+    this.reported.set(entry.childId, next);
+    this.emitRow(entry.childId, next);
+    if (entry.settled && entry.closingMessage && !this.closingSent.has(entry.childId)) {
+      this.closingSent.add(entry.childId);
+      this.emit({
+        type: "provider_subagent",
+        provider: this.provider,
+        event: {
+          type: "timeline",
+          id: entry.childId,
+          item: {
+            type: "assistant_message",
+            text: entry.closingMessage,
+            messageId: `${entry.childId}:final`,
+          },
+        },
+      });
+    }
+  }
+
+  /**
+   * The spend keeps moving while a child works, and a running child writes
+   * nothing to its parent's transcript — the cache is the only thing that
+   * changes. Re-read it every poll so the row's numbers tick along instead of
+   * waiting for the child to finish.
+   */
+  private refreshSpend(): void {
+    for (const [childId, state] of this.reported) {
+      const subtitle = this.subtitleFor(childId, state.mode);
+      if (subtitle === state.subtitle) {
+        continue;
+      }
+      state.subtitle = subtitle;
+      this.emitRow(childId, state);
+    }
+  }
+
+  private emitRow(
+    childId: string,
+    row: { status: ProviderSubagentStatus; subtitle: string | null; label: string | null },
+  ): void {
+    this.emit({
+      type: "provider_subagent",
+      provider: this.provider,
+      event: {
+        type: "upsert",
+        id: childId,
+        // dsh records the task, not a type: the label is the only name a child has.
+        title: null,
+        description: row.label,
+        status: row.status,
+        toolCallId: null,
+        subtitle: row.subtitle,
+      },
+    });
+  }
+
+  /**
+   * The rail's compact line: what the child is, and what it has spent so far.
+   * Totals come from the child's own projection cache — dsh writes one per
+   * session, so a subagent's spend is readable the same way its parent's is.
+   */
+  private subtitleFor(childId: string, mode: string | null): string | null {
+    const parts: string[] = [];
+    if (mode === "fork") {
+      parts.push("fork");
+    }
+    const totals = readDshTokenTotals(this.home, childId);
+    if (totals) {
+      parts.push(formatTokenUsage(totals));
+    }
+    return parts.length > 0 ? parts.join(" · ") : null;
+  }
+
+  private schedule(): void {
+    if (this.stopped) {
+      return;
+    }
+    this.timer = setTimeout(() => {
+      this.timer = null;
+      void this.pollOnce().finally(() => this.schedule());
+    }, this.pollIntervalMs);
+    this.timer.unref?.();
+  }
+}
+
+/** `43867 → 43.9k`, `718592 → 719k`, `14058 → 14.1k`. */
+function formatTokens(count: number): string {
+  if (count < 1_000) {
+    return String(Math.round(count));
+  }
+  if (count < 1_000_000) {
+    const thousands = count / 1_000;
+    return `${thousands < 10 ? thousands.toFixed(1) : Math.round(thousands)}k`;
+  }
+  return `${(count / 1_000_000).toFixed(1)}m`;
+}
+
+function formatTokenUsage(totals: DshTokenTotals): string {
+  const parts = [`${formatTokens(totals.inputTokens)} in`, `${formatTokens(totals.outputTokens)} out`];
+  if (totals.cachedInputTokens > 0) {
+    parts.push(`${formatTokens(totals.cachedInputTokens)} cached`);
+  }
+  return parts.join(" · ");
+}
