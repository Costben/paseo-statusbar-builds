+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import * as zlib from "node:zlib";
+import { afterEach, describe, expect, test } from "vitest";
+
+import { createTestLogger } from "../../../../test-utils/test-logger.js";
+import type { AgentStreamEvent } from "../../agent-sdk-types.js";
+import { DshSubagentBridge } from "./native-bridge.js";
+
+// The typings this repo builds against do not name zstd yet; the runtime has it.
+const zstdCompressSync = (zlib as unknown as { zstdCompressSync: (buffer: Buffer) => Buffer })
+  .zstdCompressSync;
+
+const tempDirs: string[] = [];
+
+function createTempDir(): string {
+  const dir = mkdtempSync(path.join(tmpdir(), "paseo-dsh-bridge-"));
+  tempDirs.push(dir);
+  return dir;
+}
+
+afterEach(() => {
+  while (tempDirs.length > 0) {
+    const dir = tempDirs.pop();
+    if (dir) {
+      rmSync(dir, { recursive: true, force: true });
+    }
+  }
+});
+
+const SESSION = "ff8f7020-8f6b-45c8-a24d-8082bf797232";
+const CHILD = "d50f5a53-c77d-4bcf-b573-d419d8844e12";
+
+function frame(lines: unknown[]): Buffer {
+  return zstdCompressSync(Buffer.from(`${lines.map((line) => JSON.stringify(line)).join("\n")}\n`, "utf8"));
+}
+
+function sessionFile(home: string): string {
+  const dir = path.join(home, "sessions", "--Users-me-Projects-demo--", SESSION);
+  mkdirSync(dir, { recursive: true });
+  const file = path.join(dir, "session.v4.jsonl.zstd");
+  writeFileSync(file, Buffer.alloc(0));
+  return file;
+}
+
+function catalogFrame(): Buffer {
+  return frame([
+    { type: "session", version: 4, id: SESSION, cwd: "/tmp/demo" },
+    {
+      type: "subagent/catalog",
+      data: { version: 0, childId: CHILD, childCreatedAt: 1_700_000_000_000, mode: "continuable", label: "Inspect the toolbar" },
+    },
+  ]);
+}
+
+function settleFrame(text: string): Buffer {
+  return frame([
+    {
+      type: "user/message",
+      data: {
+        source: { kind: "subagent-settled" },
+        content: [{ type: "text", text }],
+      },
+    },
+  ]);
+}
+
+function createBridge(home: string, events: AgentStreamEvent[]): DshSubagentBridge {
+  return new DshSubagentBridge({
+    sessionId: SESSION,
+    home,
+    provider: "dsh",
+    logger: createTestLogger(),
+    emit: (event) => events.push(event),
+  });
+}
+
+describe("DshSubagentBridge", () => {
+  test("reports a child the transcript registers", async () => {
+    const home = createTempDir();
+    writeFileSync(sessionFile(home), catalogFrame());
+    const events: AgentStreamEvent[] = [];
+    const bridge = createBridge(home, events);
+
+    await bridge.pollOnce();
+
+    expect(events).toEqual([
+      {
+        type: "provider_subagent",
+        provider: "dsh",
+        event: {
+          type: "upsert",
+          id: CHILD,
+          title: null,
+          description: "Inspect the toolbar",
+          status: "running",
+          toolCallId: null,
+          subtitle: null,
+        },
+      },
+    ]);
+    bridge.stop();
+  });
+
+  test("closes the row and carries the closing message once", async () => {
+    const home = createTempDir();
+    const file = sessionFile(home);
+    const head = catalogFrame();
+    writeFileSync(file, head);
+    const events: AgentStreamEvent[] = [];
+    const bridge = createBridge(home, events);
+    await bridge.pollOnce();
+    events.length = 0;
+
+    writeFileSync(
+      file,
+      Buffer.concat([
+        head,
+        settleFrame(
+          `Background subagent ${CHILD} finished and will do no further work unless you send it more. Its closing message: 6 checks passed`,
+        ),
+      ]),
+    );
+    await bridge.pollOnce();
+
+    expect(events).toEqual([
+      {
+        type: "provider_subagent",
+        provider: "dsh",
+        event: {
+          type: "upsert",
+          id: CHILD,
+          title: null,
+          description: "Inspect the toolbar",
+          status: "completed",
+          toolCallId: null,
+          subtitle: null,
+        },
+      },
+      {
+        type: "provider_subagent",
+        provider: "dsh",
+        event: {
+          type: "timeline",
+          id: CHILD,
+          item: { type: "assistant_message", text: "6 checks passed", messageId: `${CHILD}:final` },
+        },
+      },
+    ]);
+
+    // A second pass over the same transcript must not repeat the row.
+    events.length = 0;
+    await bridge.pollOnce();
+    expect(events).toEqual([]);
+    bridge.stop();
+  });
+
+  test("reports a child that was stopped as canceled", async () => {
+    const home = createTempDir();
+    writeFileSync(
+      sessionFile(home),
+      settleFrame(`Background subagent ${CHILD} was stopped before it finished. It left no closing message.`),
+    );
+    const events: AgentStreamEvent[] = [];
+    const bridge = createBridge(home, events);
+
+    await bridge.pollOnce();
+
+    expect(events).toHaveLength(1);
+    const [event] = events;
+    expect(event?.type === "provider_subagent" && event.event.type === "upsert" && event.event.status).toBe(
+      "canceled",
+    );
+    bridge.stop();
+  });
+
+  test("puts the child's token totals on the rail row", async () => {
+    const home = createTempDir();
+    writeFileSync(sessionFile(home), catalogFrame());
+    const cacheDir = path.join(home, "storages", "session_projcache", "sessions");
+    mkdirSync(cacheDir, { recursive: true });
+    writeFileSync(
+      path.join(cacheDir, `${CHILD}.json`),
+      JSON.stringify({
+        record: {
+          rows: {
+            tokenUsage: {
+              val: {
+                totals: {
+                  uncachedInputTokens: 43_867,
+                  outputTokens: 14_058,
+                  cacheReadTokens: 718_592,
+                  cacheWriteTokens: 0,
+                },
+              },
+            },
+          },
+        },
+      }),
+    );
+    const events: AgentStreamEvent[] = [];
+    const bridge = createBridge(home, events);
+
+    await bridge.pollOnce();
+
+    const [event] = events;
+    const subtitle =
+      event?.type === "provider_subagent" && event.event.type === "upsert"
+        ? event.event.subtitle
+        : null;
+    expect(subtitle).toBe("44k in · 14k out · 719k cached");
+    bridge.stop();
+  });
+
+  test("re-sends a running row when its spend moves", async () => {
+    const home = createTempDir();
+    writeFileSync(sessionFile(home), catalogFrame());
+    const cacheDir = path.join(home, "storages", "session_projcache", "sessions");
+    mkdirSync(cacheDir, { recursive: true });
+    const cacheFile = path.join(cacheDir, `${CHILD}.json`);
+    const writeTotals = (input: number) =>
+      writeFileSync(
+        cacheFile,
+        JSON.stringify({
+          record: { rows: { tokenUsage: { val: { totals: { uncachedInputTokens: input, outputTokens: 0, cacheReadTokens: 0, cacheWriteTokens: 0 } } } } },
+        }),
+      );
+    writeTotals(1_000);
+    const events: AgentStreamEvent[] = [];
+    const bridge = createBridge(home, events);
+
+    await bridge.pollOnce();
+    writeTotals(2_000);
+    await bridge.pollOnce();
+
+    expect(events).toHaveLength(2);
+    const subtitles = events.map((event) =>
+      event.type === "provider_subagent" && event.event.type === "upsert" ? event.event.subtitle : null,
+    );
+    expect(subtitles).toEqual(["1.0k in · 0 out", "2.0k in · 0 out"]);
+    bridge.stop();
+  });
+
+  test("waits for the transcript to exist", async () => {
+    const home = createTempDir();
+    mkdirSync(path.join(home, "sessions"), { recursive: true });
+    const events: AgentStreamEvent[] = [];
+    const bridge = createBridge(home, events);
+
+    await expect(bridge.pollOnce()).resolves.toBeUndefined();
+    expect(events).toEqual([]);
+    bridge.stop();
+  });
+});
