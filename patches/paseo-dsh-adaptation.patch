@@ -0,0 +1,68 @@
+import { useState, type ReactElement } from "react";
+import { Pressable, Text, View } from "react-native";
+import { Route } from "lucide-react-native";
+import { StyleSheet, withUnistyles } from "react-native-unistyles";
+import { useTranslation } from "react-i18next";
+import { DshTrajectorySheet } from "@/components/dsh-trajectory-sheet";
+
+const ThemedRoute = withUnistyles(Route, (theme) => ({ color: theme.colors.foregroundMuted }));
+
+/**
+ * dsh's trajectory table, one press away. Only dsh keeps a transcript this
+ * readable, so the caller mounts it for that provider alone.
+ */
+export function TrajectoryPill({
+  serverId,
+  agentId,
+  compact = false,
+  contextPercent = null,
+}: {
+  serverId: string;
+  agentId: string;
+  compact?: boolean;
+  contextPercent?: number | null;
+}): ReactElement {
+  const { t } = useTranslation();
+  const [open, setOpen] = useState(false);
+
+  return (
+    <>
+      <Pressable
+        accessibilityRole="button"
+        accessibilityLabel={t("dshTrajectory.open")}
+        onPress={() => setOpen(true)}
+        style={({ pressed }) => [styles.pill, pressed ? styles.pillPressed : null]}
+      >
+        <View style={styles.icon}>
+          <ThemedRoute size={compact ? 16 : 14} />
+        </View>
+        <Text style={styles.label}>{t("dshTrajectory.title")}</Text>
+      </Pressable>
+      <DshTrajectorySheet
+        serverId={serverId}
+        agentId={agentId}
+        open={open}
+        onClose={() => setOpen(false)}
+        contextPercent={contextPercent}
+      />
+    </>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  pill: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: 4,
+    minHeight: 24,
+    paddingHorizontal: 8,
+    paddingVertical: 2,
+    borderRadius: 9999,
+    borderWidth: 1,
+    borderColor: theme.colors.border,
+    backgroundColor: theme.colors.surface1,
+  },
+  pillPressed: { backgroundColor: theme.colors.surface2 },
+  icon: { alignItems: "center", justifyContent: "center" },
+  label: { color: theme.colors.foregroundMuted, fontSize: 12, lineHeight: 14 },
+}));
