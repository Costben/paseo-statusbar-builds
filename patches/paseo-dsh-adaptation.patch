+import { readFileSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+import type { Logger } from "pino";
+
+import type {
+  AgentGoal,
+  AgentGoalStatus,
+  AgentProvider,
+  AgentStreamEvent,
+} from "../../agent-sdk-types.js";
+
+/**
+ * dsh keeps one projection cache per session under its home. The goal domain
+ * writes its whole row here on every transition, so the file — not the ACP
+ * stream — is the only cross-process truth about a goal.
+ */
+const GOAL_CACHE_DIR = ["storages", "session_projcache", "sessions"] as const;
+
+const DEFAULT_POLL_INTERVAL_MS = 1_000;
+
+/** Resolve dsh's home directory: explicit option, `DSH_HOME`, then `~/.dsh`. */
+export function resolveDshHome(override?: string): string {
+  const configured = override?.trim();
+  if (configured) {
+    return configured;
+  }
+  const fromEnv = process.env["DSH_HOME"]?.trim();
+  return fromEnv && fromEnv.length > 0 ? fromEnv : join(homedir(), ".dsh");
+}
+
+/**
+ * Every file a session's goal row may live in. Newer builds name the cache
+ * `<sessionId>.json`; builds before that used `session-<sessionId>.json`.
+ */
+export function dshGoalCacheCandidates(home: string, sessionId: string): string[] {
+  const directory = join(home, ...GOAL_CACHE_DIR);
+  return [join(directory, `${sessionId}.json`), join(directory, `session-${sessionId}.json`)];
+}
+
+export type DshGoalReadResult =
+  | { kind: "goal"; goal: AgentGoal }
+  /** The cache exists and says the session has no goal. */
+  | { kind: "none" }
+  /** No cache yet, or it is mid-write / unreadable; keep the previous state. */
+  | { kind: "unknown" };
+
+/** Read one projection cache file into the goal it describes. */
+export function readDshGoalFromCache(file: string): DshGoalReadResult {
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(readFileSync(file, "utf8"));
+  } catch {
+    return { kind: "unknown" };
+  }
+  const value = readGoalRowValue(parsed);
+  if (value === undefined) {
+    return { kind: "unknown" };
+  }
+  if (value["current"] === null) {
+    return { kind: "none" };
+  }
+  const current = readRecord(value["current"]);
+  const goal = current ? readRecord(current["goal"]) : null;
+  if (!current || !goal) {
+    return { kind: "unknown" };
+  }
+  const goalId = readNonEmptyString(goal["id"]);
+  const objective = typeof goal["objective"] === "string" ? goal["objective"] : undefined;
+  const status = mapDshGoalPhase(goal["phase"]);
+  if (!goalId || objective === undefined || status === undefined) {
+    return { kind: "unknown" };
+  }
+  const updatedAt = readFiniteNumber(current["updatedAt"]) ?? Date.now();
+  const terminalReason = readBlockedReason(goal["blockedReason"]);
+  return {
+    kind: "goal",
+    goal: {
+      goalId,
+      objective,
+      status,
+      turnsUsed: readFiniteNumber(current["roundsStarted"]) ?? 0,
+      // The goal domain counts rounds, not tokens, so nothing here is a token count.
+      tokensUsed: 0,
+      startedAt: readFiniteNumber(current["createdAt"]),
+      endedAt: status === "complete" ? updatedAt : null,
+      updatedAt,
+      ...(terminalReason === undefined ? {} : { terminalReason }),
+    },
+  };
+}
+
+/** dsh's durable phases map one-to-one onto the statuses Paseo renders. */
+function mapDshGoalPhase(phase: unknown): AgentGoalStatus | undefined {
+  switch (phase) {
+    case "active":
+      return "active";
+    case "paused":
+      return "paused";
+    case "blocked":
+      return "blocked";
+    case "complete":
+      return "complete";
+    default:
+      return undefined;
+  }
+}
+
+function readBlockedReason(value: unknown): string | undefined {
+  const reason = readRecord(value);
+  if (!reason) {
+    return undefined;
+  }
+  const code = readNonEmptyString(reason["code"]);
+  const message = readNonEmptyString(reason["message"]);
+  if (code && message) {
+    return `${code}: ${message}`;
+  }
+  return message ?? code;
+}
+
+function readGoalRowValue(parsed: unknown): Record<string, unknown> | undefined {
+  const rows = readRecord(readRecord(readRecord(parsed)?.["record"])?.["rows"]);
+  const row = rows ? readRecord(rows["goal"]) : null;
+  const value = row ? readRecord(row["val"]) : null;
+  return value ?? undefined;
+}
+
+export interface DshGoalWatcherOptions {
+  sessionId: string;
+  home: string;
+  provider: AgentProvider;
+  logger: Logger;
+  emit: (event: AgentStreamEvent) => void;
+  pollIntervalMs?: number;
+}
+
+export interface DshGoalWatcher {
+  stop(): void;
+}
+
+/**
+ * Poll one session's goal row and emit `goal_updated` whenever it changes.
+ *
+ * Polling beats `fs.watch` here: the cache is replaced atomically (tmp file then
+ * rename), and a rename lands as an unrelated event on Windows. A one-second
+ * read of a file this small costs nothing next to a model turn.
+ */
+export function watchDshGoal(options: DshGoalWatcherOptions): DshGoalWatcher {
+  const candidates = dshGoalCacheCandidates(options.home, options.sessionId);
+  const intervalMs = options.pollIntervalMs ?? DEFAULT_POLL_INTERVAL_MS;
+  let lastSignature: string | null = null;
+  let stopped = false;
+  let warnedUnreadable = false;
+
+  const poll = (): void => {
+    if (stopped) {
+      return;
+    }
+    let result: DshGoalReadResult = { kind: "unknown" };
+    for (const candidate of candidates) {
+      const read = readDshGoalFromCache(candidate);
+      if (read.kind !== "unknown") {
+        result = read;
+        break;
+      }
+    }
+    if (result.kind === "unknown") {
+      // A session that never creates a goal keeps no row to read; that is normal
+      // until the first `/goal`, so warn once rather than every tick.
+      if (!warnedUnreadable && lastSignature === null) {
+        warnedUnreadable = true;
+        options.logger.debug(
+          { sessionId: options.sessionId, home: options.home },
+          "dsh goal projection cache is not readable yet",
+        );
+      }
+      return;
+    }
+    const goal = result.kind === "goal" ? result.goal : null;
+    const signature = goal === null ? "none" : JSON.stringify(goal);
+    if (signature === lastSignature) {
+      return;
+    }
+    const isFirstObservation = lastSignature === null;
+    lastSignature = signature;
+    if (goal === null && isFirstObservation) {
+      // A session that has never had a goal has nothing to clear, and saying so
+      // on every fresh session would just be noise on the wire.
+      return;
+    }
+    options.emit({ type: "goal_updated", provider: options.provider, goal });
+  };
+
+  poll();
+  const timer = setInterval(poll, intervalMs);
+  timer.unref?.();
+
+  return {
+    stop: () => {
+      stopped = true;
+      clearInterval(timer);
+    },
+  };
+}
+
+function readRecord(value: unknown): Record<string, unknown> | null {
+  return typeof value === "object" && value !== null && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : null;
+}
+
+function readNonEmptyString(value: unknown): string | undefined {
+  return typeof value === "string" && value.length > 0 ? value : undefined;
+}
+
+function readFiniteNumber(value: unknown): number | undefined {
+  return typeof value === "number" && Number.isFinite(value) ? value : undefined;
+}
