+
+    const events: AgentStreamEvent[] = [];
+    const watcher = watchDshGoal({
+      sessionId,
+      home,
+      provider: "dsh",
+      logger: createTestLogger(),
+      emit: (event) => events.push(event),
+      pollIntervalMs: 5,
+    });
+    try {
+      await new Promise((resolve) => setTimeout(resolve, 30));
+      expect(events).toHaveLength(1);
+      expect(events[0]).toMatchObject({ type: "goal_updated", goal: { goalId: "goal-1" } });
+    } finally {
+      watcher.stop();
+    }
+  });
+
+  test("stays quiet for a session whose cache says it has no goal", async () => {
+    const home = createTempDir();
+    writeCacheFile(home, "session-1", buildCache(null));
+    const events: AgentStreamEvent[] = [];
+    const watcher = watchDshGoal({
+      sessionId: "session-1",
+      home,
+      provider: "dsh",
+      logger: createTestLogger(),
+      emit: (event) => events.push(event),
+      pollIntervalMs: 5,
+    });
+    try {
+      await new Promise((resolve) => setTimeout(resolve, 30));
+      expect(events).toEqual([]);
+    } finally {
+      watcher.stop();
+    }
+  });
+
+  test("stops emitting after stop()", async () => {
+    const home = createTempDir();
+    const events: AgentStreamEvent[] = [];
+    const watcher = watchDshGoal({
+      sessionId: "session-1",
+      home,
+      provider: "dsh",
+      logger: createTestLogger(),
+      emit: (event) => events.push(event),
+      pollIntervalMs: 5,
+    });
+    watcher.stop();
+    writeCacheFile(home, "session-1", buildCache(ACTIVE_GOAL));
+    await new Promise((resolve) => setTimeout(resolve, 40));
+    expect(events).toEqual([]);
+  });
+});
