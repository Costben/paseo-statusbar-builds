+            failure: null,
+          },
+        },
+      },
+    },
+  };
+}
+
+function writeCacheFile(home: string, sessionId: string, document: unknown): string {
+  const [file] = dshGoalCacheCandidates(home, sessionId);
+  if (!file) {
+    throw new Error("expected a cache candidate");
+  }
+  mkdirSync(path.dirname(file), { recursive: true });
+  writeFileSync(file, JSON.stringify(document));
+  return file;
+}
+
+const ACTIVE_GOAL = {
+  id: "goal-1",
+  revision: 1,
+  objective: "验证 dsh goal 适配",
+  phase: "active",
+  maxGoalRounds: 256,
+};
+
+describe("resolveDshHome", () => {
+  test("prefers an explicit override", () => {
+    expect(resolveDshHome("D:\\dsh-home")).toBe("D:\\dsh-home");
+  });
+
+  test("falls back to DSH_HOME, then the default location", () => {
+    const previous = process.env["DSH_HOME"];
+    try {
+      process.env["DSH_HOME"] = "D:\\from-env";
+      expect(resolveDshHome()).toBe("D:\\from-env");
+      process.env["DSH_HOME"] = "   ";
+      expect(resolveDshHome()).toContain(".dsh");
+    } finally {
+      if (previous === undefined) {
+        delete process.env["DSH_HOME"];
+      } else {
+        process.env["DSH_HOME"] = previous;
+      }
+    }
+  });
+});
+
+describe("dshGoalCacheCandidates", () => {
+  test("lists both the current and the legacy file name", () => {
+    expect(dshGoalCacheCandidates("C:\\dsh", "abc")).toEqual([
+      path.join("C:\\dsh", "storages", "session_projcache", "sessions", "abc.json"),
+      path.join("C:\\dsh", "storages", "session_projcache", "sessions", "session-abc.json"),
+    ]);
+  });
+});
+
+describe("readDshGoalFromCache", () => {
+  test("maps an active goal onto the Paseo payload", () => {
+    const home = createTempDir();
+    const file = writeCacheFile(home, "session-1", buildCache(ACTIVE_GOAL, { roundsStarted: 3 }));
+
+    expect(readDshGoalFromCache(file)).toEqual({
+      kind: "goal",
+      goal: {
+        goalId: "goal-1",
+        objective: "验证 dsh goal 适配",
+        status: "active",
+        turnsUsed: 3,
+        tokensUsed: 0,
+        startedAt: 1_700_000_000_000,
+        endedAt: null,
+        updatedAt: 1_700_000_005_000,
+      },
+    });
+  });
+
+  test("carries a blocked reason through as the terminal reason", () => {
+    const home = createTempDir();
+    const file = writeCacheFile(
+      home,
+      "session-1",
+      buildCache({
+        ...ACTIVE_GOAL,
+        phase: "blocked",
+        blockedReason: { code: "GOAL_BLOCKED", message: "waiting on a human" },
+      }),
+    );
+
+    const result = readDshGoalFromCache(file);
+    expect(result.kind).toBe("goal");
+    if (result.kind !== "goal") {
+      throw new Error("expected a goal");
+    }
+    expect(result.goal.status).toBe("blocked");
+    expect(result.goal.terminalReason).toBe("GOAL_BLOCKED: waiting on a human");
+  });
+
+  test("marks a complete goal as ended at its last update", () => {
+    const home = createTempDir();
+    const file = writeCacheFile(home, "session-1", buildCache({ ...ACTIVE_GOAL, phase: "complete" }));
+
+    const result = readDshGoalFromCache(file);
+    expect(result.kind).toBe("goal");
+    if (result.kind !== "goal") {
+      throw new Error("expected a goal");
+    }
+    expect(result.goal.status).toBe("complete");
+    expect(result.goal.endedAt).toBe(1_700_000_005_000);
+  });
+
+  test("reports a cleared goal as none", () => {
+    const home = createTempDir();
+    const file = writeCacheFile(home, "session-1", buildCache(null));
+
+    expect(readDshGoalFromCache(file)).toEqual({ kind: "none" });
+  });
+
+  test("treats an unreadable or half-written cache as unknown", () => {
+    const home = createTempDir();
+    const [file] = dshGoalCacheCandidates(home, "session-1");
+    mkdirSync(path.dirname(file!), { recursive: true });
+    writeFileSync(file!, '{"version":7,"record":{"rows":{"goal":');
+    expect(readDshGoalFromCache(file!)).toEqual({ kind: "unknown" });
+
+    writeFileSync(file!, JSON.stringify({ version: 7, record: { rows: {} } }));
+    expect(readDshGoalFromCache(file!)).toEqual({ kind: "unknown" });
+
+    expect(readDshGoalFromCache(path.join(home, "missing.json"))).toEqual({ kind: "unknown" });
+  });
+
+  test("ignores a goal whose phase it does not know", () => {
+    const home = createTempDir();
+    const file = writeCacheFile(home, "session-1", buildCache({ ...ACTIVE_GOAL, phase: "unknown" }));
+
+    expect(readDshGoalFromCache(file)).toEqual({ kind: "unknown" });
+  });
+});
+
+describe("watchDshGoal", () => {
+  test("emits the goal once and only again when it changes", async () => {
+    const home = createTempDir();
+    const events: AgentStreamEvent[] = [];
+    const watcher = watchDshGoal({
+      sessionId: "session-1",
+      home,
+      provider: "dsh",
+      logger: createTestLogger(),
+      emit: (event) => events.push(event),
+      pollIntervalMs: 5,
+    });
+    try {
+      // A session with no cache yet emits nothing.
+      await new Promise((resolve) => setTimeout(resolve, 30));
+      expect(events).toEqual([]);
+
+      writeCacheFile(home, "session-1", buildCache(ACTIVE_GOAL));
+      await new Promise((resolve) => setTimeout(resolve, 40));
+      expect(events).toHaveLength(1);
+      expect(events[0]).toMatchObject({
+        type: "goal_updated",
+        provider: "dsh",
+        goal: { goalId: "goal-1", status: "active" },
+      });
+
+      // Rewriting the same row is not a change.
+      writeCacheFile(home, "session-1", buildCache(ACTIVE_GOAL));
+      await new Promise((resolve) => setTimeout(resolve, 40));
+      expect(events).toHaveLength(1);
+
+      writeCacheFile(home, "session-1", buildCache({ ...ACTIVE_GOAL, phase: "complete" }));
+      await new Promise((resolve) => setTimeout(resolve, 40));
+      expect(events).toHaveLength(2);
+      expect(events[1]).toMatchObject({ type: "goal_updated", goal: { status: "complete" } });
+
+      writeCacheFile(home, "session-1", buildCache(null));
+      await new Promise((resolve) => setTimeout(resolve, 40));
+      expect(events[2]).toEqual({ type: "goal_updated", provider: "dsh", goal: null });
+    } finally {
+      watcher.stop();
+    }
+  });
+
+  test("falls back to the legacy file name", async () => {
+    const home = createTempDir();
+    const sessionId = "session-1";
+    const legacy = path.join(
+      home,
+      "storages",
+      "session_projcache",
+      "sessions",
+      `session-${sessionId}.json`,
+    );
+    mkdirSync(path.dirname(legacy), { recursive: true });
