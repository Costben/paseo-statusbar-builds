@@ -0,0 +1,169 @@
+import { mkdtempSync, mkdirSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, test } from "vitest";
+
+import { createTestLogger } from "../../../../test-utils/test-logger.js";
+import { dshGoalCacheCandidates } from "./goal-projection.js";
+import { createDshProviderHooks } from "./provider-hooks.js";
+
+const tempDirs: string[] = [];
+
+function createTempDir(): string {
+  const dir = mkdtempSync(path.join(tmpdir(), "paseo-dsh-hooks-"));
+  tempDirs.push(dir);
+  return dir;
+}
+
+afterEach(() => {
+  while (tempDirs.length > 0) {
+    const dir = tempDirs.pop();
+    if (dir) {
+      rmSync(dir, { recursive: true, force: true });
+    }
+  }
+});
+
+/** Build the projection-cache document dsh writes for one session. */
+function buildCache(phase: string | null) {
+  return {
+    version: 7,
+    record: {
+      rows: {
+        goal: {
+          ver: 3,
+          seq: 12,
+          val: {
+            current:
+              phase === null
+                ? null
+                : {
+                    goal: {
+                      id: "goal-1",
+                      revision: 1,
+                      objective: "写一万字",
+                      phase,
+                      maxGoalRounds: 256,
+                    },
+                    roundsStarted: 1,
+                    createdAt: 1_700_000_000_000,
+                    updatedAt: 1_700_000_005_000,
+                  },
+            seenGoalIds: [],
+            failure: null,
+          },
+        },
+      },
+    },
+  };
+}
+
+function cacheFile(home: string, sessionId: string): string {
+  const [file] = dshGoalCacheCandidates(home, sessionId);
+  if (!file) {
+    throw new Error("expected a cache candidate");
+  }
+  return file;
+}
+
+function writeCacheFile(home: string, sessionId: string, document: unknown): string {
+  const file = cacheFile(home, sessionId);
+  mkdirSync(path.dirname(file), { recursive: true });
+  writeFileSync(file, JSON.stringify(document));
+  return file;
+}
+
+function hookContext(sessionId: string) {
+  return {
+    acpSessionId: sessionId,
+    provider: "dsh" as const,
+    logger: createTestLogger(),
+    emit: () => {},
+  };
+}
+
+function continuationContext(sessionId: string, sawTimeline = true) {
+  return { ...hookContext(sessionId), sawTimeline };
+}
+
+describe("dsh goal continuation", () => {
+  test("asks for another round while the goal is active", () => {
+    const home = createTempDir();
+    writeCacheFile(home, "session-1", buildCache("active"));
+    const hooks = createDshProviderHooks({ dshHome: home });
+
+    expect(hooks.continueTurn?.(continuationContext("session-1"))).toBe("继续");
+  });
+
+  test("stays idle for a paused goal", () => {
+    const home = createTempDir();
+    writeCacheFile(home, "session-1", buildCache("paused"));
+    const hooks = createDshProviderHooks({ dshHome: home });
+
+    expect(hooks.continueTurn?.(continuationContext("session-1"))).toBeNull();
+  });
+
+  test("stays idle once the goal is complete", () => {
+    const home = createTempDir();
+    writeCacheFile(home, "session-1", buildCache("complete"));
+    const hooks = createDshProviderHooks({ dshHome: home });
+
+    expect(hooks.continueTurn?.(continuationContext("session-1"))).toBeNull();
+  });
+
+  test("stays idle for a session with no goal", () => {
+    const home = createTempDir();
+    writeCacheFile(home, "session-1", buildCache(null));
+    const hooks = createDshProviderHooks({ dshHome: home });
+
+    expect(hooks.continueTurn?.(continuationContext("session-1"))).toBeNull();
+  });
+
+  test("never starts a round on a guess when the cache is missing", () => {
+    const home = createTempDir();
+    const hooks = createDshProviderHooks({ dshHome: home });
+
+    expect(hooks.continueTurn?.(continuationContext("session-1"))).toBeNull();
+  });
+
+  test("does not continue a round that produced nothing", () => {
+    const home = createTempDir();
+    writeCacheFile(home, "session-1", buildCache("active"));
+    const hooks = createDshProviderHooks({ dshHome: home });
+
+    expect(hooks.continueTurn?.(continuationContext("session-1", false))).toBeNull();
+  });
+
+  test("continues once after /goal even before the cache is flushed", () => {
+    const home = createTempDir();
+    const hooks = createDshProviderHooks({ dshHome: home });
+    hooks.onForegroundTurnStarting?.(hookContext("session-1"), "/goal 写一万字的成人小说");
+
+    expect(hooks.continueTurn?.(continuationContext("session-1"))).toBe("继续");
+    // The goal row is still missing, so the second look has nothing to go on.
+    expect(hooks.continueTurn?.(continuationContext("session-1"))).toBeNull();
+  });
+
+  test("does not treat a /goal subcommand as a new goal", () => {
+    const home = createTempDir();
+    const hooks = createDshProviderHooks({ dshHome: home });
+    hooks.onForegroundTurnStarting?.(hookContext("session-1"), "/goal pause");
+
+    expect(hooks.continueTurn?.(continuationContext("session-1"))).toBeNull();
+  });
+
+  test("keeps going while the watcher last saw the goal active", () => {
+    const home = createTempDir();
+    const file = writeCacheFile(home, "session-1", buildCache("active"));
+    const hooks = createDshProviderHooks({ dshHome: home });
+    const close = hooks.onSessionReady?.(hookContext("session-1"));
+
+    try {
+      // The cache is replaced between turns, so a read can land on no file at all.
+      rmSync(file);
+      expect(hooks.continueTurn?.(continuationContext("session-1"))).toBe("继续");
+    } finally {
+      close?.onClose?.();
+    }
+  });
+});
diff --git a/packages/server/src/server/agent/providers/dsh/provider-hooks.ts b/packages/server/src/server/agent/providers/dsh/provider-hooks.ts
