@@ -0,0 +1,160 @@
+import type { AgentPromptInput } from "../../agent-sdk-types.js";
+import type { AgentGoal } from "../../agent-sdk-types.js";
+import type { ACPProviderHooks } from "../acp-agent.js";
+import {
+  type DshGoalWatcher,
+  dshGoalCacheCandidates,
+  readDshGoalFromCache,
+  resolveDshHome,
+  watchDshGoal,
+} from "./goal-projection.js";
+import { DshSubagentProjector } from "./subagents.js";
+
+export interface DshProviderHooksOptions {
+  /** Overrides dsh's home directory; defaults to `DSH_HOME` or `~/.dsh`. */
+  dshHome?: string;
+  /** Overrides the goal poll cadence; the default is one second. */
+  pollIntervalMs?: number;
+}
+
+/**
+ * What Paseo sends to keep an armed goal moving. dsh activates an armed goal at
+ * the start of the next turn and injects its own round instructions there, so the
+ * text itself carries no instructions — it only has to be a prompt.
+ */
+const GOAL_CONTINUATION_PROMPT = "继续";
+
+/** `/goal` subcommands that never create a goal. */
+const GOAL_SUBCOMMANDS = new Set([
+  "pause",
+  "resume",
+  "clear",
+  "edit",
+  "status",
+  "show",
+  "done",
+  "cancel",
+]);
+
+/** The text of a prompt, whichever shape the caller handed over. */
+function promptText(prompt: AgentPromptInput): string {
+  if (typeof prompt === "string") {
+    return prompt;
+  }
+  const parts: string[] = [];
+  for (const block of prompt) {
+    if (block && typeof block === "object" && "text" in block && typeof block.text === "string") {
+      parts.push(block.text);
+    }
+  }
+  return parts.join("\n");
+}
+
+/** Whether this prompt is the `/goal <objective>` that creates a goal. */
+function startsGoal(text: string): boolean {
+  const match = /^\/goal(?:\s+([\s\S]*))?$/.exec(text.trim());
+  if (!match) {
+    return false;
+  }
+  const argument = (match[1] ?? "").trim();
+  if (argument.length === 0) {
+    return false;
+  }
+  const [head] = argument.split(/\s+/);
+  return !GOAL_SUBCOMMANDS.has(head.toLowerCase());
+}
+
+/**
+ * Provider hooks for dsh: the ACP stream carries no goal state, so each live
+ * session watches the goal row dsh persists for it and reports the changes as
+ * `goal_updated`.
+ *
+ * dsh also never advances a goal on its own under ACP: it arms the goal, ends the
+ * turn, and waits for the next prompt. Without a continuation the goal would stay
+ * active forever while Paseo shows an idle session, so the same hook asks for the
+ * next round whenever the goal is still active and the turn actually produced
+ * output.
+ *
+ * The same stream carries the child sessions dsh spawns for `subagent` and
+ * `subagent_fork`, tagged with `_meta.dsh`. Those are claimed here and reported as
+ * `provider_subagent` events, which is the same rail Kimi Code's subagents use.
+ */
+export function createDshProviderHooks(options: DshProviderHooksOptions = {}): ACPProviderHooks {
+  const watchers = new Map<string, DshGoalWatcher>();
+  /** Last goal the watcher reported, kept for the moments the cache lags behind. */
+  const lastObserved = new Map<string, AgentGoal>();
+  /** Sessions whose newest turn created a goal the cache has not flushed yet. */
+  const pendingGoalStart = new Set<string>();
+  /** dsh forwards child sessions onto this stream; they belong on their own rail. */
+  const subagents = new DshSubagentProjector();
+
+  return {
+    onSessionReady(ctx) {
+      const watcher = watchDshGoal({
+        sessionId: ctx.acpSessionId,
+        home: resolveDshHome(options.dshHome),
+        provider: ctx.provider,
+        logger: ctx.logger,
+        emit: (event) => {
+          if (event.type === "goal_updated" && event.goal) {
+            lastObserved.set(ctx.acpSessionId, event.goal);
+            if (event.goal.status === "active") {
+              pendingGoalStart.delete(ctx.acpSessionId);
+            }
+          }
+          ctx.emit(event);
+        },
+        pollIntervalMs: options.pollIntervalMs,
+      });
+      watchers.set(ctx.acpSessionId, watcher);
+      return {
+        onClose: () => {
+          watchers.delete(ctx.acpSessionId);
+          lastObserved.delete(ctx.acpSessionId);
+          pendingGoalStart.delete(ctx.acpSessionId);
+          watcher.stop();
+        },
+      };
+    },
+    onSubagentUpdate(update, ctx) {
+      return subagents.handle(update, ctx);
+    },
+    onForegroundTurnStarting(ctx, prompt) {
+      // The goal row is written write-behind, so right after `/goal` there may be
+      // no cache file at all. Remember that this session just asked for a goal.
+      if (startsGoal(promptText(prompt))) {
+        pendingGoalStart.add(ctx.acpSessionId);
+      }
+    },
+    continueTurn(ctx) {
+      // A round that produced nothing is not worth another round; the caller
+      // stops the loop after a few of those as well.
+      if (!ctx.sawTimeline) {
+        return null;
+      }
+      const home = resolveDshHome(options.dshHome);
+      for (const candidate of dshGoalCacheCandidates(home, ctx.acpSessionId)) {
+        const result = readDshGoalFromCache(candidate);
+        if (result.kind === "unknown") {
+          // No cache yet, or it is mid-write: never start a round on a guess.
+          continue;
+        }
+        if (result.kind === "none" || result.goal.status !== "active") {
+          pendingGoalStart.delete(ctx.acpSessionId);
+          return null;
+        }
+        pendingGoalStart.delete(ctx.acpSessionId);
+        return GOAL_CONTINUATION_PROMPT;
+      }
+      // The cache has not caught up with the turn that just ended. Continue only
+      // when something already told us a goal exists and is running.
+      if (lastObserved.get(ctx.acpSessionId)?.status === "active") {
+        return GOAL_CONTINUATION_PROMPT;
+      }
+      if (pendingGoalStart.delete(ctx.acpSessionId)) {
+        return GOAL_CONTINUATION_PROMPT;
+      }
+      return null;
+    },
+  };
+}
diff --git a/packages/server/src/server/agent/providers/dsh/subagents.test.ts b/packages/server/src/server/agent/providers/dsh/subagents.test.ts
new file mode 100644
index 000000000..bafafdb04
--- /dev/null
+++ b/packages/server/src/server/agent/providers/dsh/subagents.test.ts
@@ -0,0 +1,256 @@
+import type { SessionUpdate } from "@agentclientprotocol/sdk";
+import { describe, expect, test } from "vitest";
+
+import { createTestLogger } from "../../../../test-utils/test-logger.js";
+import type { AgentStreamEvent } from "../../agent-sdk-types.js";
+import type { ACPProviderSubagentUpdateContext, ACPToolSnapshot } from "../acp-agent.js";
+import { DshSubagentProjector } from "./subagents.js";
+
+const SUBAGENT_TOOL_CALL: ACPToolSnapshot = {
+  toolCallId: "subagent:run-1",
+  title: "Delegating to a subagent",
+  initialTitle: "subagent",
+  kind: "other",
+  rawInput: { description: "scan the repo", prompt: "Read every spec in docs/specs." },
+};
+
+/** Mirrors the client: the update's own `_meta` is what the hook receives. */
+function createContext(
+  update: SessionUpdate,
+  options: {
+    toolCalls?: Record<string, ACPToolSnapshot>;
+    translate?: () => AgentStreamEvent[];
+  } = {},
+): ACPProviderSubagentUpdateContext {
+  const toolCalls = options.toolCalls ?? {};
+  return {
+    acpSessionId: "parent-session",
+    provider: "acp",
+    logger: createTestLogger(),
+    emit: () => {},
+    meta: update._meta,
+    translate: options.translate ?? (() => []),
+    findToolCall: (toolCallId) => toolCalls[toolCallId] ?? null,
+  };
+}
+
+function sessionInfoUpdate(meta: Record<string, unknown>): SessionUpdate {
+  return { sessionUpdate: "session_info_update", _meta: meta };
+}
+
+function lifecycle(subagent: Record<string, unknown>): SessionUpdate {
+  return sessionInfoUpdate({ dsh: { event: "subagent/lifecycle", subagent } });
+}
+
+function childUpdate(childSessionId: string): Record<string, unknown> {
+  return { dsh: { subagent: { childSessionId, provider: "dsh" } } };
+}
+
+describe("DshSubagentProjector", () => {
+  test("leaves updates the agent did not attribute to a child", () => {
+    const projector = new DshSubagentProjector();
+    const plain = sessionInfoUpdate({});
+    expect(projector.handle(plain, createContext(plain))).toBeNull();
+
+    const message: SessionUpdate = {
+      sessionUpdate: "agent_message_chunk",
+      content: { type: "text", text: "hi" },
+    };
+    expect(projector.handle(message, createContext(message))).toBeNull();
+  });
+
+  test("opens a rail row from the lifecycle event and names it after the parent tool call", () => {
+    const projector = new DshSubagentProjector();
+    const update = lifecycle({
+      state: "started",
+      runId: "run-1",
+      childSessionId: "child-1",
+      provider: "dsh",
+    });
+    const events = projector.handle(
+      update,
+      createContext(update, { toolCalls: { "subagent:run-1": SUBAGENT_TOOL_CALL } }),
+    );
+
+    expect(events).toEqual([
+      {
+        type: "provider_subagent",
+        provider: "dsh",
+        event: {
+          type: "upsert",
+          id: "child-1",
+          title: "subagent",
+          description: "scan the repo",
+          status: "running",
+          toolCallId: "subagent:run-1",
+          subtitle: null,
+        },
+      },
+    ]);
+  });
+
+  test("routes a child's content to its own timeline", () => {
+    const projector = new DshSubagentProjector();
+    const update: SessionUpdate = {
+      sessionUpdate: "agent_message_chunk",
+      content: { type: "text", text: "working" },
+      _meta: childUpdate("child-1"),
+    };
+    const events = projector.handle(
+      update,
+      createContext(update, {
+        toolCalls: { "subagent:run-1": SUBAGENT_TOOL_CALL },
+        translate: () => [
+          {
+            type: "timeline",
+            provider: "acp",
+            item: { type: "assistant_message", text: "working", messageId: "m-1" },
+          },
+        ],
+      }),
+    );
+
+    // The first update of an unknown child still needs a rail row to hang on.
+    expect(events).toHaveLength(2);
+    expect(events?.[0]).toMatchObject({
+      type: "provider_subagent",
+      event: { type: "upsert", id: "child-1", status: "running" },
+    });
+    expect(events?.[1]).toEqual({
+      type: "provider_subagent",
+      provider: "dsh",
+      event: {
+        type: "timeline",
+        id: "child-1",
+        item: { type: "assistant_message", text: "working", messageId: "m-1" },
+      },
+    });
+  });
+
+  test("swallows child updates that only describe the child's own session", () => {
+    const projector = new DshSubagentProjector();
+    const title = sessionInfoUpdate({
+      dsh: { event: "session/title", subagent: { childSessionId: "child-1", provider: "dsh" } },
+    });
+    expect(projector.handle(title, createContext(title))).toEqual([]);
+
+    const usage: SessionUpdate = { sessionUpdate: "usage_update", _meta: childUpdate("child-1") };
+    expect(projector.handle(usage, createContext(usage))).toEqual([]);
+  });
+
+  test("closes the row with the stop reason dsh reported", () => {
+    const projector = new DshSubagentProjector();
+    const started = lifecycle({
+      state: "started",
+      runId: "run-1",
+      childSessionId: "child-1",
+      provider: "dsh",
+    });
+    projector.handle(started, createContext(started));
+
+    const finished = lifecycle({
+      state: "finished",
+      runId: "run-1",
+      childSessionId: "child-1",
+      provider: "dsh",
+      stopReason: "aborted",
+      lastAssistantMessage: "Stopped after the first file.",
+    });
+    const events = projector.handle(finished, createContext(finished));
+
+    expect(events?.[0]).toMatchObject({
+      type: "provider_subagent",
+      event: { type: "upsert", id: "child-1", status: "canceled" },
+    });
+    expect(events?.[1]).toEqual({
+      type: "provider_subagent",
+      provider: "dsh",
+      event: {
+        type: "timeline",
+        id: "child-1",
+        item: {
+          type: "assistant_message",
+          text: "Stopped after the first file.",
+          messageId: "child-1:final",
+        },
+      },
+    });
+  });
+
+  test.each([
+    ["completed", "completed"],
+    ["max-tokens", "completed"],
+    ["aborted", "canceled"],
+    ["error", "failed"],
+    ["refusal", "failed"],
+  ])("maps stop reason %s to %s", (stopReason, status) => {
+    const projector = new DshSubagentProjector();
+    const update = lifecycle({
+      state: "finished",
+      runId: "run-1",
+      childSessionId: "child-1",
+      stopReason,
+    });
+    const events = projector.handle(update, createContext(update));
+    expect(events?.[0]).toMatchObject({ event: { type: "upsert", status } });
+  });
+
+  test("skips the timeline of a fork, which already shares the parent's history", () => {
+    const projector = new DshSubagentProjector();
+    const forkCall: ACPToolSnapshot = {
+      ...SUBAGENT_TOOL_CALL,
+      toolCallId: "subagent:run-2",
+      initialTitle: "subagent_fork",
+      title: "Forking the conversation",
+    };
+    const started = lifecycle({
+      state: "started",
+      runId: "run-2",
+      childSessionId: "child-2",
+      provider: "dsh",
+    });
+    projector.handle(started, createContext(started, { toolCalls: { "subagent:run-2": forkCall } }));
+
+    const toolCall: SessionUpdate = {
+      sessionUpdate: "tool_call",
+      toolCallId: "call-1",
+      title: "read",
+      _meta: childUpdate("child-2"),
+    };
+    expect(projector.handle(toolCall, createContext(toolCall))).toEqual([]);
+
+    const finished = lifecycle({
+      state: "finished",
+      runId: "run-2",
+      childSessionId: "child-2",
+      stopReason: "completed",
+    });
+    const closed = projector.handle(finished, createContext(finished))?.[0];
+    expect(closed).toMatchObject({ event: { status: "completed", id: "child-2" } });
+    // The row keeps the `fork` subtitle it was opened with.
+    expect(closed).not.toHaveProperty("event.subtitle");
+  });
+
+  test("names the parent subagent for a nested child", () => {
+    const projector = new DshSubagentProjector();
+    const parent = lifecycle({
+      state: "started",
+      runId: "run-1",
+      childSessionId: "child-1",
+      provider: "dsh",
+    });
+    projector.handle(parent, createContext(parent));
+
+    const nested = lifecycle({
+      state: "started",
+      runId: "run-3",
+      childSessionId: "child-3",
+      provider: "dsh",
+      parentToolCallId: "subagent:run-1",
+    });
+    const events = projector.handle(nested, createContext(nested));
+    expect(events?.[0]).toMatchObject({
+      event: { type: "upsert", id: "child-3", parentSubagentId: "child-1" },
+    });
+  });
+});
diff --git a/packages/server/src/server/agent/providers/dsh/subagents.ts b/packages/server/src/server/agent/providers/dsh/subagents.ts
new file mode 100644
index 000000000..50baf0282
--- /dev/null
+++ b/packages/server/src/server/agent/providers/dsh/subagents.ts
@@ -0,0 +1,300 @@
+import type { SessionUpdate } from "@agentclientprotocol/sdk";
+
+import type { AgentStreamEvent } from "../../agent-sdk-types.js";
+import type { ProviderSubagentStatus } from "../../provider-subagents/store.js";
+import type { ACPProviderSubagentUpdateContext, ACPToolSnapshot } from "../acp-agent.js";
+
+/** Provider id the app labels these subagents with. */
+const DSH_PROVIDER = "dsh";
+
+/**
+ * Session updates that carry a child's own work. Everything else on a child —
+ * usage, mode, config options, the session title — describes the child's session
+ * bookkeeping, and forwarding it would overwrite the parent's state with it.
+ */
+const CHILD_CONTENT_UPDATES = new Set<SessionUpdate["sessionUpdate"]>([
+  "user_message_chunk",
+  "agent_message_chunk",
+  "agent_thought_chunk",
+  "tool_call",
+  "tool_call_update",
+  "plan",
+]);
+
+interface DshSubagentMeta {
+  childSessionId: string;
+  /**
+   * For a nested child, the spawn card of its parent in the grandparent's
+   * transcript. A top-level child has none.
+   */
+  parentToolCallId?: string;
+  provider?: string;
+  local?: boolean;
+  state?: "started" | "finished";
+  runId?: string;
+  stopReason?: string;
+  lastAssistantMessage?: string;
+}
+
+interface DshMeta {
+  event?: string;
+  subagent?: DshSubagentMeta;
+}
+
+interface ChildIdentity {
+  /** The parent's tool call for this child, as `subagent:<runId>`. */
+  toolCallId: string | null;
+  parentSubagentId: string | null;
+}
+
+function readRecord(value: unknown): Record<string, unknown> | null {
+  return value !== null && typeof value === "object" ? (value as Record<string, unknown>) : null;
+}
+
+function readString(value: unknown): string | undefined {
+  return typeof value === "string" && value.length > 0 ? value : undefined;
+}
+
+function readDshMeta(meta: ACPProviderSubagentUpdateContext["meta"]): DshMeta | null {
+  const dsh = readRecord(readRecord(meta)?.["dsh"]);
+  if (!dsh) {
+    return null;
+  }
+  const subagent = readRecord(dsh["subagent"]);
+  const childSessionId = readString(subagent?.["childSessionId"]);
+  if (!subagent || !childSessionId) {
+    return { event: readString(dsh["event"]) };
+  }
+  const state = readString(subagent["state"]);
+  return {
+    event: readString(dsh["event"]),
+    subagent: {
+      childSessionId,
+      parentToolCallId: readString(subagent["parentToolCallId"]),
+      provider: readString(subagent["provider"]),
+      local: subagent["local"] === true,
+      state: state === "started" || state === "finished" ? state : undefined,
+      runId: readString(subagent["runId"]),
+      stopReason: readString(subagent["stopReason"]),
+      lastAssistantMessage: readString(subagent["lastAssistantMessage"]),
+    },
+  };
+}
+
+/** dsh ends a child with one of `completed | max-tokens | aborted | error | refusal`. */
+function statusForStopReason(reason: string | undefined): ProviderSubagentStatus {
+  switch (reason) {
+    case undefined:
+    case "completed":
+    case "max-tokens":
+      return "completed";
+    case "aborted":
+      return "canceled";
+    default:
+      return "failed";
+  }
+}
+
+function readRawInputString(snapshot: ACPToolSnapshot | null, key: string): string | null {
+  const rawInput = readRecord(snapshot?.rawInput);
+  const value = rawInput?.[key];
+  return typeof value === "string" && value.trim().length > 0 ? value.trim() : null;
+}
+
+/** The parent tool call's own name, which is where a fork announces itself. */
+function isForkToolCall(snapshot: ACPToolSnapshot | null): boolean {
+  if (!snapshot) {
+    return false;
+  }
+  const names = [snapshot.initialTitle, snapshot.title].filter(
+    (value): value is string => typeof value === "string",
+  );
+  return names.some((name) => name.toLowerCase().includes("fork"));
+}
+
+/**
+ * Turns dsh's child-session stream into `provider_subagent` events.
+ *
+ * The ACP bridge only forwards child work when the client declares
+ * `subagent-transcript`, and it marks every forwarded update with
+ * `_meta.dsh.subagent`. Those updates arrive on the parent's session, so they have
+ * to be claimed here: left alone they would be translated into the parent's
+ * transcript and every child step would appear twice.
+ */
+export class DshSubagentProjector {
+  /** `subagent:<runId>` → the child session it belongs to. */
+  private readonly childByToolCall = new Map<string, string>();
+  /** Children whose timeline is skipped because they already share the parent's. */
+  private readonly forkedChildren = new Set<string>();
+  private readonly knownChildren = new Set<string>();
+
+  constructor(private readonly providerId: string = DSH_PROVIDER) {}
+
+  /**
+   * Returns the events to emit in place of `update`, or null when the update
+   * belongs to the parent's own transcript.
+   */
+  handle(update: SessionUpdate, ctx: ACPProviderSubagentUpdateContext): AgentStreamEvent[] | null {
+    const dsh = readDshMeta(ctx.meta);
+    const child = dsh?.subagent;
+    if (!dsh || !child) {
+      return null;
+    }
+    if (dsh.event === "subagent/lifecycle") {
+      return this.handleLifecycle(child, ctx);
+    }
+    if (!CHILD_CONTENT_UPDATES.has(update.sessionUpdate)) {
+      return [];
+    }
+    return [
+      ...this.announceIfUnknown(child, ctx),
+      ...this.wrapTimeline(child.childSessionId, ctx.translate()),
+    ];
+  }
+
+  private handleLifecycle(
+    child: DshSubagentMeta,
+    ctx: ACPProviderSubagentUpdateContext,
+  ): AgentStreamEvent[] {
+    const identity = this.registerChild(child);
+    const snapshot = identity.toolCallId ? ctx.findToolCall(identity.toolCallId) : null;
+    if (child.state === "started") {
+      if (isForkToolCall(snapshot)) {
+        this.forkedChildren.add(child.childSessionId);
+      }
+      return this.upsert(child.childSessionId, {
+        ...identity,
+        snapshot,
+        status: "running",
+        subtitle: this.forkedChildren.has(child.childSessionId) ? "fork" : null,
+      });
+    }
+
+    const events = this.upsert(child.childSessionId, {
+      ...identity,
+      snapshot,
+      status: statusForStopReason(child.stopReason),
+    });
+    const finalMessage = child.lastAssistantMessage;
+    if (finalMessage && !this.forkedChildren.has(child.childSessionId)) {
+      events.push(
+        ...this.wrapTimeline(child.childSessionId, [
+          {
+            type: "timeline",
+            provider: this.providerId,
+            item: {
+              type: "assistant_message",
+              text: finalMessage,
+              messageId: `${child.childSessionId}:final`,
+            },
+          },
+        ]),
+      );
+    }
+    this.releaseChild(child.childSessionId);
+    return events;
+  }
+
+  /**
+   * A child the bridge started reporting without a lifecycle event — a resumed
+   * session, or a first update that outran its start — still needs a rail row.
+   */
+  private announceIfUnknown(
+    child: DshSubagentMeta,
+    ctx: ACPProviderSubagentUpdateContext,
+  ): AgentStreamEvent[] {
+    if (this.knownChildren.has(child.childSessionId)) {
+      return [];
+    }
+    const identity = this.registerChild(child);
+    const snapshot = identity.toolCallId ? ctx.findToolCall(identity.toolCallId) : null;
+    return this.upsert(child.childSessionId, {
+      ...identity,
+      snapshot,
+      status: "running",
+      subtitle: null,
+    });
+  }
+
+  /**
+   * Records the child and resolves where its rail row hangs. A child's own tool
+   * call is `subagent:<runId>`, the same id the bridge builds; a nested child's
+   * `parentToolCallId` names its parent's spawn card instead, which maps back to
+   * the parent's subagent id.
+   */
+  private registerChild(child: DshSubagentMeta): ChildIdentity {
+    const toolCallId = child.runId ? `subagent:${child.runId}` : (child.parentToolCallId ?? null);
+    const parent = child.parentToolCallId
+      ? (this.childByToolCall.get(child.parentToolCallId) ?? null)
+      : null;
+    if (toolCallId) {
+      this.childByToolCall.set(toolCallId, child.childSessionId);
+    }
+    this.knownChildren.add(child.childSessionId);
+    return {
+      toolCallId,
+      parentSubagentId: parent === child.childSessionId ? null : parent,
+    };
+  }
+
+  private releaseChild(childSessionId: string): void {
+    for (const [toolCallId, owner] of this.childByToolCall) {
+      if (owner === childSessionId) {
+        this.childByToolCall.delete(toolCallId);
+      }
+    }
+    this.forkedChildren.delete(childSessionId);
+    this.knownChildren.delete(childSessionId);
+  }
+
+  private upsert(
+    childSessionId: string,
+    detail: ChildIdentity & {
+      snapshot: ACPToolSnapshot | null;
+      status: ProviderSubagentStatus;
+      subtitle?: string | null;
+    },
+  ): AgentStreamEvent[] {
+    const description =
+      readRawInputString(detail.snapshot, "description") ??
+      readRawInputString(detail.snapshot, "label") ??
+      detail.snapshot?.title ??
+      null;
+    const title =
+      readRawInputString(detail.snapshot, "role") ??
+      detail.snapshot?.initialTitle ??
+      detail.snapshot?.title ??
+      null;
+    return [
+      {
+        type: "provider_subagent",
+        provider: this.providerId,
+        event: {
+          type: "upsert",
+          id: childSessionId,
+          title,
+          description,
+          status: detail.status,
+          toolCallId: detail.toolCallId,
+          ...(detail.subtitle === undefined ? {} : { subtitle: detail.subtitle }),
+          ...(detail.parentSubagentId === null ? {} : { parentSubagentId: detail.parentSubagentId }),
+        },
+      },
+    ];
+  }
+
+  private wrapTimeline(childSessionId: string, events: AgentStreamEvent[]): AgentStreamEvent[] {
+    const wrapped: AgentStreamEvent[] = [];
+    for (const event of events) {
+      if (event.type !== "timeline") {
+        continue;
+      }
+      wrapped.push({
+        type: "provider_subagent",
+        provider: this.providerId,
+        event: { type: "timeline", id: childSessionId, item: event.item },
+      });
+    }
+    return wrapped;
+  }
+}
