diff --git a/packages/app/src/components/dsh-trajectory-sheet.tsx b/packages/app/src/components/dsh-trajectory-sheet.tsx
new file mode 100644
index 000000000..5faadf9c1
--- /dev/null
+++ b/packages/app/src/components/dsh-trajectory-sheet.tsx
@@ -0,0 +1,416 @@
+import { useEffect, useMemo, useState } from "react";
+import { ActivityIndicator, FlatList, Pressable, Text, TextInput, View } from "react-native";
+import { StyleSheet, withUnistyles } from "react-native-unistyles";
+import { useTranslation } from "react-i18next";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+import type { DshTrajectoryPayload } from "@getpaseo/client/internal/daemon-client";
+import { BottomSheetScrollView } from "@gorhom/bottom-sheet";
+import { SheetHeaderView } from "@/components/adaptive-modal-sheet";
+import {
+  IsolatedBottomSheetModal,
+  useIsolatedBottomSheetVisibility,
+} from "@/components/ui/isolated-bottom-sheet-modal";
+import { useHostRuntimeClient } from "@/runtime/host-runtime";
+
+const ThemedBottomSheetModal = withUnistyles(IsolatedBottomSheetModal, (theme) => ({
+  backgroundStyle: {
+    backgroundColor: theme.colors.surface0,
+    borderTopLeftRadius: theme.borderRadius["2xl"],
+    borderTopRightRadius: theme.borderRadius["2xl"],
+  },
+  handleIndicatorStyle: { backgroundColor: theme.colors.palette.zinc[600] },
+}));
+
+type Row = DshTrajectoryPayload["rows"][number];
+type Turn = DshTrajectoryPayload["turns"][number];
+type Bucket = "duration" | "turns" | "calls";
+
+/** dsh's own colour language: model work reads violet, tool work reads amber. */
+const TOOL_COLOR = "#f59e0b";
+const ASSISTANT_COLOR = "#a855f7";
+const USER_COLOR = "#71717a";
+
+/**
+ * dsh's trajectory table: what the agent actually did, in its own terms — turn,
+ * step, tool, result. The rows come from the session transcript, which the
+ * daemon reads; the ACP stream carries none of it.
+ */
+export function DshTrajectorySheet({
+  serverId,
+  agentId,
+  open,
+  onClose,
+  contextPercent = null,
+}: {
+  serverId: string;
+  agentId: string;
+  open: boolean;
+  onClose: () => void;
+  /** The composer's context meter, so the summary matches the rest of the app. */
+  contextPercent?: number | null;
+}) {
+  const { t } = useTranslation();
+  const insets = useSafeAreaInsets();
+  const client = useHostRuntimeClient(serverId);
+  const [payload, setPayload] = useState<DshTrajectoryPayload | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [query, setQuery] = useState("");
+  const [bucket, setBucket] = useState<Bucket>("calls");
+
+  const { sheetRef, handleSheetChange, handleSheetDismiss } = useIsolatedBottomSheetVisibility({
+    visible: open,
+    onClose,
+  });
+
+  useEffect(() => {
+    if (!open || !client) {
+      return;
+    }
+    let cancelled = false;
+    setLoading(true);
+    setError(null);
+    void client
+      .getDshTrajectory(agentId)
+      .then((next) => {
+        if (!cancelled) {
+          setPayload(next);
+        }
+      })
+      .catch((cause: unknown) => {
+        if (!cancelled) {
+          setError(cause instanceof Error ? cause.message : String(cause));
+        }
+      })
+      .finally(() => {
+        if (!cancelled) {
+          setLoading(false);
+        }
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [agentId, client, open]);
+
+  const rows = useMemo(() => {
+    const all = payload?.rows ?? [];
+    const needle = query.trim().toLowerCase();
+    if (needle.length === 0) {
+      return all;
+    }
+    return all.filter((row) =>
+      `${row.name ?? ""}\n${row.text}\n${row.result ?? ""}`.toLowerCase().includes(needle),
+    );
+  }, [payload, query]);
+
+  const header = useMemo(() => ({ title: t("dshTrajectory.title") }), [t]);
+  const contentStyle = useMemo(() => ({ paddingBottom: insets.bottom + 16 }), [insets.bottom]);
+  const summary = payload?.summary ?? null;
+
+  return (
+    <ThemedBottomSheetModal
+      ref={sheetRef}
+      contextBridge={null}
+      enableDynamicSizing
+      maxDynamicContentSize={720}
+      onChange={handleSheetChange}
+      onDismiss={handleSheetDismiss}
+      backdropOpacity={0.45}
+      enablePanDownToClose
+    >
+      <SheetHeaderView header={header} onClose={onClose} />
+      <BottomSheetScrollView contentContainerStyle={contentStyle}>
+        {summary ? <SummaryBar summary={summary} contextPercent={contextPercent} /> : null}
+        {payload ? <Strip rows={payload.rows} turns={payload.turns} bucket={bucket} /> : null}
+        <View style={styles.toolbar}>
+          <View style={styles.buckets}>
+            {(["duration", "turns", "calls"] as const).map((value) => (
+              <Pressable
+                key={value}
+                onPress={() => setBucket(value)}
+                style={[styles.bucket, bucket === value ? styles.bucketActive : null]}
+              >
+                <Text
+                  style={[styles.bucketLabel, bucket === value ? styles.bucketLabelActive : null]}
+                >
+                  {t(`dshTrajectory.mode.${value}`)}
+                </Text>
+              </Pressable>
+            ))}
+          </View>
+          <TextInput
+            value={query}
+            onChangeText={setQuery}
+            placeholder={t("dshTrajectory.search")}
+            placeholderTextColor="#8b8b8b"
+            style={styles.search}
+            autoCapitalize="none"
+            autoCorrect={false}
+          />
+        </View>
+
+        {loading ? (
+          <View style={styles.state}>
+            <ActivityIndicator />
+          </View>
+        ) : error ? (
+          <Text style={styles.stateText}>{error}</Text>
+        ) : rows.length === 0 ? (
+          <Text style={styles.stateText}>{t("dshTrajectory.empty")}</Text>
+        ) : (
+          <FlatList
+            data={rows}
+            scrollEnabled={false}
+            keyExtractor={(row) => row.id}
+            renderItem={({ item }) => <TrajectoryRow row={item} />}
+          />
+        )}
+        {payload?.truncated ? (
+          <Text style={styles.stateText}>{t("dshTrajectory.truncated")}</Text>
+        ) : null}
+      </BottomSheetScrollView>
+    </ThemedBottomSheetModal>
+  );
+}
+
+function SummaryBar({
+  summary,
+  contextPercent,
+}: {
+  summary: DshTrajectoryPayload["summary"];
+  contextPercent: number | null;
+}) {
+  const { t } = useTranslation();
+  const seconds = summary.durationMs / 1_000;
+  const rate = seconds > 0 ? Math.round(summary.outputTokens / seconds) : 0;
+  const promptTokens = summary.inputTokens + summary.cachedInputTokens;
+  const cacheHit = promptTokens > 0 ? Math.round((summary.cachedInputTokens / promptTokens) * 100) : 0;
+  const total = summary.inputTokens + summary.cachedInputTokens + summary.outputTokens;
+  return (
+    <View style={styles.summary}>
+      <Text style={styles.summaryItem}>
+        {t("dshTrajectory.summary.turnsSteps", { turns: summary.turns, steps: summary.steps })}
+        {"  ·  "}
+        {t("dshTrajectory.summary.rate", { rate })}
+      </Text>
+      <Text style={styles.summaryItem}>
+        {t("dshTrajectory.summary.tokens", { tokens: formatTokens(total) })}
+        {"  ·  "}
+        {t("dshTrajectory.summary.cacheHit", { percent: cacheHit })}
+      </Text>
+      {contextPercent === null ? null : (
+        <Text style={styles.summaryItem}>
+          {t("dshTrajectory.summary.context", { percent: Math.round(contextPercent) })}
+        </Text>
+      )}
+    </View>
+  );
+}
+
+/**
+ * The strip above the table. dsh draws one bar per bucket; the toggles pick the
+ * bucket — every call, every turn, or a time slice — so a long session has a
+ * shape you can scan before reading any row.
+ */
+function Strip({ rows, turns, bucket }: { rows: Row[]; turns: Turn[]; bucket: Bucket }) {
+  const columns = useMemo(() => {
+    if (bucket === "calls") {
+      return rows.slice(-120).map((row) => ({
+        id: row.id,
+        tool: row.kind === "tool" ? 1 : 0,
+        assistant: row.kind === "assistant" ? 1 : 0,
+      }));
+    }
+    if (bucket === "turns") {
+      return turns.slice(-60).map((turn) => {
+        const mine = rows.filter((row) => row.turn === turn.turn);
+        return {
+          id: `turn-${turn.turn}`,
+          tool: mine.filter((row) => row.kind === "tool").length,
+          assistant: mine.filter((row) => row.kind === "assistant").length,
+        };
+      });
+    }
+    // Duration: one column per minute of the session's wall clock.
+    const start = turns.find((turn) => turn.startedAt !== null)?.startedAt ?? null;
+    if (start === null) {
+      return [];
+    }
+    const byMinute = new Map<number, { tool: number; assistant: number }>();
+    for (const row of rows) {
+      if (row.at === null) {
+        continue;
+      }
+      const minute = Math.floor((row.at - start) / 60_000);
+      const entry = byMinute.get(minute) ?? { tool: 0, assistant: 0 };
+      if (row.kind === "tool") {
+        entry.tool += 1;
+      } else if (row.kind === "assistant") {
+        entry.assistant += 1;
+      }
+      byMinute.set(minute, entry);
+    }
+    return Array.from(byMinute.entries())
+      .sort((left, right) => left[0] - right[0])
+      .map(([minute, counts]) => ({ id: `min-${minute}`, ...counts }));
+  }, [bucket, rows, turns]);
+
+  if (columns.length === 0) {
+    return null;
+  }
+  const peak = Math.max(1, ...columns.map((column) => Math.max(column.tool, column.assistant)));
+  return (
+    <View style={styles.strip}>
+      {columns.map((column) => (
+        <View key={column.id} style={styles.stripColumn}>
+          <View
+            style={[
+              styles.stripBar,
+              {
+                backgroundColor: ASSISTANT_COLOR,
+                height: 2 + (column.assistant / peak) * 12,
+                opacity: column.assistant > 0 ? 0.9 : 0.15,
+              },
+            ]}
+          />
+          <View
+            style={[
+              styles.stripBar,
+              {
+                backgroundColor: TOOL_COLOR,
+                height: 2 + (column.tool / peak) * 12,
+                opacity: column.tool > 0 ? 0.9 : 0.15,
+              },
+            ]}
+          />
+        </View>
+      ))}
+    </View>
+  );
+}
+
+function TrajectoryRow({ row }: { row: Row }) {
+  const { t } = useTranslation();
+  const color =
+    row.kind === "tool" ? TOOL_COLOR : row.kind === "assistant" ? ASSISTANT_COLOR : USER_COLOR;
+  const label =
+    row.kind === "tool"
+      ? (row.name ?? t("dshTrajectory.kind.tool"))
+      : t(`dshTrajectory.kind.${row.kind}`);
+  return (
+    <View style={styles.row}>
+      <View style={styles.rowHead}>
+        <View style={[styles.badge, { borderColor: color }]}>
+          <Text style={[styles.badgeLabel, { color }]}>{label}</Text>
+        </View>
+        {row.turn > 0 ? (
+          <Text style={styles.rowMeta}>
+            {t("dshTrajectory.turn")} {row.turn}
+            {row.step === null ? "" : ` · ${row.step}`}
+          </Text>
+        ) : null}
+        {row.status === "error" ? <Text style={styles.rowError}>{t("dshTrajectory.failed")}</Text> : null}
+      </View>
+      <Text style={styles.rowText} numberOfLines={4}>
+        {row.text}
+      </Text>
+      {row.result ? (
+        <Text style={styles.rowResult} numberOfLines={4}>
+          → {row.result}
+        </Text>
+      ) : null}
+    </View>
+  );
+}
+
+function formatTokens(count: number): string {
+  if (count < 1_000) {
+    return String(count);
+  }
+  if (count < 1_000_000) {
+    const thousands = count / 1_000;
+    return `${thousands < 10 ? thousands.toFixed(1) : Math.round(thousands)}k`;
+  }
+  return `${(count / 1_000_000).toFixed(1)}M`;
+}
+
+const styles = StyleSheet.create((theme) => ({
+  summary: {
+    flexDirection: "row",
+    flexWrap: "wrap",
+    gap: 12,
+    paddingHorizontal: 16,
+    paddingTop: 4,
+    paddingBottom: 8,
+  },
+  summaryItem: { color: theme.colors.foregroundMuted, fontSize: 12 },
+  strip: {
+    flexDirection: "row",
+    alignItems: "flex-end",
+    gap: 2,
+    paddingHorizontal: 16,
+    paddingBottom: 10,
+    height: 44,
+  },
+  stripColumn: { flex: 1, gap: 2, justifyContent: "flex-end" },
+  stripBar: { borderRadius: 2 },
+  toolbar: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: 8,
+    paddingHorizontal: 16,
+    paddingVertical: 8,
+  },
+  buckets: { flexDirection: "row", gap: 6 },
+  bucket: {
+    paddingHorizontal: 10,
+    paddingVertical: 4,
+    borderRadius: 9999,
+    borderWidth: 1,
+    borderColor: theme.colors.border,
+  },
+  bucketActive: { backgroundColor: theme.colors.surface2, borderColor: theme.colors.borderAccent },
+  bucketLabel: { color: theme.colors.foregroundMuted, fontSize: 12 },
+  bucketLabelActive: { color: theme.colors.foreground },
+  search: {
+    flex: 1,
+    borderWidth: 1,
+    borderColor: theme.colors.border,
+    borderRadius: theme.borderRadius.lg,
+    paddingHorizontal: 10,
+    paddingVertical: 6,
+    color: theme.colors.foreground,
+    backgroundColor: theme.colors.surface1,
+  },
+  state: { paddingVertical: 32, alignItems: "center" },
+  stateText: { paddingHorizontal: 16, paddingVertical: 24, color: theme.colors.foregroundMuted },
+  row: {
+    paddingHorizontal: 16,
+    paddingVertical: 10,
+    borderTopWidth: StyleSheet.hairlineWidth,
+    borderTopColor: theme.colors.border,
+    gap: 4,
+  },
+  rowHead: { flexDirection: "row", alignItems: "center", gap: 8 },
+  badge: {
+    paddingHorizontal: 6,
+    paddingVertical: 1,
+    borderRadius: 4,
+    borderWidth: 1,
+  },
+  badgeLabel: { fontSize: 10, fontWeight: theme.fontWeight.medium, letterSpacing: 0.5 },
+  rowMeta: { color: theme.colors.foregroundMuted, fontSize: 11 },
+  rowError: { color: theme.colors.statusDanger, fontSize: 11 },
+  rowText: {
+    color: theme.colors.foreground,
+    fontSize: 12,
+    lineHeight: 16,
+    fontFamily: theme.fontFamily.mono,
+  },
+  rowResult: {
+    color: theme.colors.foregroundMuted,
+    fontSize: 12,
+    lineHeight: 16,
+    fontFamily: theme.fontFamily.mono,
+  },
+}));
