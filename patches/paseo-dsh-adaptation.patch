+describe("ACP provider hook continuation", () => {
+  /** Runs turns until the session settles and reports what the loop produced. */
+  async function runContinuationLoop(
+    hooks: ACPProviderHooks,
+    options: { stopAfterCompletions: number; stopReason?: PromptResponse["stopReason"] },
+  ): Promise<{ events: AgentStreamEvent[]; prompt: ReturnType<typeof vi.fn> }> {
+    const events: AgentStreamEvent[] = [];
+    const prompt = vi.fn(
+      async (): Promise<PromptResponse> => ({ stopReason: options.stopReason ?? "end_turn" }),
+    );
+    const session = createSessionWithConfig({}, createTestLogger(), {}, hooks);
+    asInternals<ACPSessionInternals>(session).sessionId = "session-1";
+    asInternals<ACPSessionInternals>(session).connection = {
+      prompt,
+      cancel: vi.fn(async () => {}),
+    };
+
+    let settle!: () => void;
+    const settled = new Promise<void>((resolve) => {
+      settle = resolve;
+    });
+    session.subscribe((event) => {
+      events.push(event);
+      const endings = events.filter(
+        (entry) => entry.type === "turn_completed" || entry.type === "turn_canceled",
+      );
+      if (endings.length >= options.stopAfterCompletions) {
+        settle();
+      }
+    });
+
+    await session.startTurn("hello");
+    await Promise.race([settled, new Promise((resolve) => setTimeout(resolve, 300))]);
+    // Give a runaway loop the chance to show itself before the assertions run.
+    await new Promise((resolve) => setTimeout(resolve, 20));
+    return { events, prompt };
+  }
+
+  test("starts the round a provider asks for without a user message", async () => {
+    let rounds = 0;
+    const continueTurn = vi.fn(() => (++rounds === 1 ? "继续" : null));
+    const { events, prompt } = await runContinuationLoop({ continueTurn }, { stopAfterCompletions: 2 });
+
+    expect(continueTurn).toHaveBeenCalledTimes(2);
+    expect(prompt).toHaveBeenCalledTimes(2);
+    const secondPrompt = JSON.stringify(prompt.mock.calls[1]?.[0] ?? {});
+    expect(secondPrompt).toContain("继续");
+    const userMessages = events.filter(
+      (event) => event.type === "timeline" && event.item.type === "user_message",
+    );
+    expect(userMessages).toHaveLength(1);
+  });
+
+  test("leaves the session idle when the provider declines", async () => {
+    const continueTurn = vi.fn(() => null);
+    const { events, prompt } = await runContinuationLoop({ continueTurn }, { stopAfterCompletions: 1 });
+
+    expect(continueTurn).toHaveBeenCalledTimes(1);
+    expect(prompt).toHaveBeenCalledTimes(1);
+    expect(events.filter((event) => event.type === "turn_completed")).toHaveLength(1);
+  });
+
+  test("does not continue a cancelled turn", async () => {
+    const continueTurn = vi.fn(() => "继续");
+    const { prompt } = await runContinuationLoop(
+      { continueTurn },
+      { stopAfterCompletions: 1, stopReason: "cancelled" },
+    );
+
+    expect(continueTurn).not.toHaveBeenCalled();
+    expect(prompt).toHaveBeenCalledTimes(1);
+  });
+
+  test("stops a loop that keeps returning empty rounds", async () => {
+    const continueTurn = vi.fn(() => "继续");
+    const { prompt } = await runContinuationLoop({ continueTurn }, { stopAfterCompletions: 4 });
+
+    // The opening turn plus three continuation rounds, then the stall guard stops it.
+    expect(prompt).toHaveBeenCalledTimes(4);
+  });
+
+  test("reports the turn's output to the provider", async () => {
+    const seen: boolean[] = [];
+    const continueTurn = vi.fn((ctx: { sawTimeline: boolean }) => {
+      seen.push(ctx.sawTimeline);
+      return null;
+    });
+    await runContinuationLoop({ continueTurn }, { stopAfterCompletions: 1 });
+
+    expect(seen).toEqual([false]);
+  });
+});
