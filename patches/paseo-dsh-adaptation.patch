+  });
+
+  test("ignores a goal whose phase it does not know", () => {
+    const home = createTempDir();
+    const file = writeCacheFile(home, "session-1", buildCache({ ...ACTIVE_GOAL, phase: "unknown" }));
+
+    expect(readDshGoalFromCache(file)).toEqual({ kind: "unknown" });
+  });
+});
+
+describe("watchDshGoal", () => {
