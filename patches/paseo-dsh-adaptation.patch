--- /dev/null
+++ b/packages/server/src/server/agent/providers/dsh/trajectory.test.ts
@@ -0,0 +1,130 @@
+import { describe, expect, test } from "vitest";
+
+import { parseDshTrajectory } from "./trajectory.js";
+
+function record(value: unknown): string {
+  return JSON.stringify(value);
+}
+
+const TURN_ONE = [
+  record({ type: "session", version: 4, id: "parent-1" }),
+  record({ type: "turn/start", seq: 1, time: 1_000, data: { turn: 1 } }),
+  record({
+    type: "tool/call",
+    seq: 2,
+    time: 1_100,
+    data: { turn: 1, step: 1, callId: "call-1", name: "bash", arguments: '{"command":"ls"}' },
+  }),
+  record({
+    type: "tool/result",
+    seq: 3,
+    time: 1_400,
+    data: {
+      turn: 1,
+      step: 1,
+      message: { role: "tool", toolCallId: "call-1", content: [{ type: "text", text: "a.txt" }] },
+    },
+  }),
+  record({
+    type: "assistant/message",
+    seq: 4,
+    time: 1_500,
+    data: { turn: 1, step: 1, message: { role: "assistant", content: [{ type: "text", text: "只有一个文件" }] } },
+  }),
+  record({ type: "turn/end", seq: 5, time: 2_000, data: { turn: 1, reason: { kind: "completed" } } }),
+];
+
+describe("parseDshTrajectory", () => {
+  test("builds turns with their duration and reason", () => {
+    const { turns } = parseDshTrajectory(TURN_ONE);
+    expect(turns).toEqual([{ turn: 1, startedAt: 1_000, endedAt: 2_000, reason: "completed" }]);
+  });
+
+  test("pairs a tool call with its result", () => {
+    const { rows } = parseDshTrajectory(TURN_ONE);
+    const tool = rows.find((row) => row.kind === "tool");
+    expect(tool).toMatchObject({
+      turn: 1,
+      step: 1,
+      name: "bash",
+      text: '{"command":"ls"}',
+      result: "a.txt",
+      status: "ok",
+    });
+  });
+
+  test("keeps the assistant's text and drops reasoning blocks", () => {
+    const lines = [
+      record({
+        type: "assistant/message",
+        seq: 9,
+        time: 1_500,
+        data: {
+          turn: 2,
+          step: 1,
+          message: {
+            role: "assistant",
+            content: [
+              { type: "reasoning", text: "先想想" },
+              { type: "text", text: "做完了" },
+            ],
+          },
+        },
+      }),
+    ];
+    const { rows } = parseDshTrajectory(lines);
+    expect(rows).toHaveLength(1);
+    expect(rows[0]).toMatchObject({ kind: "assistant", text: "做完了", name: null });
+  });
+
+  test("marks a failed tool result", () => {
+    const lines = [
+      record({
+        type: "tool/call",
+        seq: 1,
+        time: 1,
+        data: { turn: 1, step: 1, callId: "c", name: "bash", arguments: "{}" },
+      }),
+      record({
+        type: "tool/result",
+        seq: 2,
+        time: 2,
+        data: {
+          turn: 1,
+          step: 1,
+          message: { role: "tool", toolCallId: "c", isError: true, content: [{ type: "text", text: "boom" }] },
+        },
+      }),
+    ];
+    const { rows } = parseDshTrajectory(lines);
+    expect(rows[0]).toMatchObject({ status: "error", result: "boom" });
+  });
+
+  test("ignores records it does not model", () => {
+    const { rows, turns } = parseDshTrajectory([
+      record({ type: "usage", data: {} }),
+      "not json",
+      "",
+    ]);
+    expect(rows).toEqual([]);
+    expect(turns).toEqual([]);
+  });
+
+  test("truncates a very long session from the front", () => {
+    const lines: string[] = [];
+    for (let index = 0; index < 2_100; index += 1) {
+      lines.push(
+        record({
+          type: "tool/call",
+          seq: index,
+          time: index,
+          data: { turn: 1, step: index, callId: `c${index}`, name: "bash", arguments: "{}" },
+        }),
+      );
+    }
+    const { rows, truncated } = parseDshTrajectory(lines);
+    expect(truncated).toBe(true);
+    expect(rows).toHaveLength(2_000);
+    expect(rows[0]?.id).toBe("call:c100");
+  });
+});
diff --git a/packages/server/src/server/agent/providers/dsh/trajectory.ts b/packages/server/src/server/agent/providers/dsh/trajectory.ts
new file mode 100644
index 000000000..ba9ed9020
--- /dev/null
+++ b/packages/server/src/server/agent/providers/dsh/trajectory.ts
@@ -0,0 +1,294 @@
+import { readDshSessionLog, readDshTokenTotals, resolveDshSessionLogPath } from "./session-store.js";
+
+/** Rows past this are dropped from the front; the table is a view, not an archive. */
+export const MAX_TRAJECTORY_ROWS = 2_000;
+/** Preview length per text field. The transcript holds megabytes; a row holds a glance. */
+const PREVIEW_CHARS = 600;
+
+export interface DshTrajectoryRow {
+  id: string;
+  turn: number;
+  step: number | null;
+  kind: "tool" | "assistant" | "user";
+  /** Tool name for `tool` rows; null otherwise. */
+  name: string | null;
+  /** Tool arguments, assistant text, or the user's prompt. */
+  text: string;
+  /** Tool result, once the call settles. */
+  result: string | null;
+  status: "ok" | "error" | null;
+  at: number | null;
+}
+
+export interface DshTrajectoryTurn {
+  turn: number;
+  startedAt: number | null;
+  endedAt: number | null;
+  /** dsh's own end reason: `completed`, `interrupted`, … */
+  reason: string | null;
+}
+
+/** The strip dsh puts above its table: how much ran, how fast, and what it cost. */
+export interface DshTrajectorySummary {
+  turns: number;
+  steps: number;
+  toolCalls: number;
+  assistantMessages: number;
+  /** Summed turn duration; turns without an end are left out. */
+  durationMs: number;
+  inputTokens: number;
+  cachedInputTokens: number;
+  outputTokens: number;
+}
+
+export interface DshTrajectory {
+  turns: DshTrajectoryTurn[];
+  rows: DshTrajectoryRow[];
+  /** Turns and rows the preview dropped because the session is long. */
+  truncated: boolean;
+  summary: DshTrajectorySummary;
+}
+
+/**
+ * Build the trajectory table out of a session transcript.
+ *
+ * This is dsh's own view of its work — turn, step, tool, result — which the ACP
+ * stream never carries. The transcript is the only place all four survive, and
+ * reading it is the same move the goal projection and the subagent rail make.
+ */
+export function parseDshTrajectory(lines: Iterable<string>): DshTrajectory {
+  const turns = new Map<number, DshTrajectoryTurn>();
+  const rows: DshTrajectoryRow[] = [];
+  const rowByCallId = new Map<string, DshTrajectoryRow>();
+
+  const turnFor = (turn: number): DshTrajectoryTurn => {
+    const existing = turns.get(turn);
+    if (existing) {
+      return existing;
+    }
+    const created: DshTrajectoryTurn = { turn, startedAt: null, endedAt: null, reason: null };
+    turns.set(turn, created);
+    return created;
+  };
+
+  for (const line of lines) {
+    if (line.length === 0) {
+      continue;
+    }
+    let record: Record<string, unknown>;
+    try {
+      record = JSON.parse(line) as Record<string, unknown>;
+    } catch {
+      continue;
+    }
+    const type = asString(record["type"]);
+    const data = asRecord(record["data"]);
+    const at = typeof record["time"] === "number" ? (record["time"] as number) : null;
+    if (type === "turn/start") {
+      const turn = asNumber(data?.["turn"]);
+      if (turn !== null) {
+        const entry = turnFor(turn);
+        entry.startedAt ??= at;
+      }
+      continue;
+    }
+    if (type === "turn/end") {
+      const turn = asNumber(data?.["turn"]);
+      if (turn !== null) {
+        const entry = turnFor(turn);
+        entry.endedAt = at;
+        entry.reason = asString(asRecord(data?.["reason"])?.["kind"]);
+      }
+      continue;
+    }
+    if (type === "tool/call") {
+      const callId = asString(data?.["callId"]);
+      const turn = asNumber(data?.["turn"]) ?? 0;
+      if (!callId) {
+        continue;
+      }
+      turnFor(turn);
+      const row: DshTrajectoryRow = {
+        id: `call:${callId}`,
+        turn,
+        step: asNumber(data?.["step"]),
+        kind: "tool",
+        name: asString(data?.["name"]),
+        text: preview(asString(data?.["arguments"]) ?? ""),
+        result: null,
+        status: null,
+        at,
+      };
+      rows.push(row);
+      rowByCallId.set(callId, row);
+      continue;
+    }
+    if (type === "tool/result") {
+      const message = asRecord(data?.["message"]);
+      const callId = asString(message?.["toolCallId"]);
+      if (!callId) {
+        continue;
+      }
+      const row = rowByCallId.get(callId);
+      if (!row) {
+        continue;
+      }
+      row.result = preview(messageText(message?.["content"]));
+      row.status = message?.["isError"] === true ? "error" : "ok";
+      continue;
+    }
+    if (type === "assistant/message") {
+      const message = asRecord(data?.["message"]);
+      const text = preview(assistantText(message?.["content"]));
+      if (text.length === 0) {
+        continue;
+      }
+      rows.push({
+        id: `assistant:${String(record["seq"] ?? rows.length)}`,
+        turn: asNumber(data?.["turn"]) ?? 0,
+        step: asNumber(data?.["step"]),
+        kind: "assistant",
+        name: null,
+        text,
+        result: null,
+        status: null,
+        at,
+      });
+      continue;
+    }
+    if (type === "user/message") {
+      const source = asRecord(data?.["source"]);
+      const kind = asString(source?.["kind"]);
+      const text = preview(messageText(data?.["content"]));
+      if (text.length === 0) {
+        continue;
+      }
+      rows.push({
+        id: `user:${String(record["seq"] ?? rows.length)}`,
+        turn: 0,
+        step: null,
+        kind: "user",
+        name: kind,
+        text,
+        result: null,
+        status: null,
+        at,
+      });
+    }
+  }
+
+  const truncated = rows.length > MAX_TRAJECTORY_ROWS;
+  const kept = truncated ? rows.slice(rows.length - MAX_TRAJECTORY_ROWS) : rows;
+  const turnList = Array.from(turns.values()).sort((left, right) => left.turn - right.turn);
+  return {
+    turns: turnList,
+    rows: kept,
+    truncated,
+    summary: summarize(turnList, kept),
+  };
+}
+
+function summarize(turns: DshTrajectoryTurn[], rows: DshTrajectoryRow[]): DshTrajectorySummary {
+  const steps = new Set<string>();
+  let toolCalls = 0;
+  let assistantMessages = 0;
+  for (const row of rows) {
+    if (row.step !== null) {
+      steps.add(`${row.turn}:${row.step}`);
+    }
+    if (row.kind === "tool") {
+      toolCalls += 1;
+    } else if (row.kind === "assistant") {
+      assistantMessages += 1;
+    }
+  }
+  let durationMs = 0;
+  for (const turn of turns) {
+    if (turn.startedAt !== null && turn.endedAt !== null && turn.endedAt > turn.startedAt) {
+      durationMs += turn.endedAt - turn.startedAt;
+    }
+  }
+  return {
+    turns: turns.length,
+    steps: steps.size,
+    toolCalls,
+    assistantMessages,
+    durationMs,
+    inputTokens: 0,
+    cachedInputTokens: 0,
+    outputTokens: 0,
+  };
+}
+
+/** Read one session's trajectory straight from its transcript. */
+export function readDshTrajectory(home: string, sessionId: string): DshTrajectory | null {
+  const file = resolveDshSessionLogPath(home, sessionId);
+  if (!file) {
+    return null;
+  }
+  const read = readDshSessionLog(file, 0);
+  const trajectory = parseDshTrajectory(read.text.split("\n"));
+  const totals = readDshTokenTotals(home, sessionId);
+  return {
+    ...trajectory,
+    summary: {
+      ...trajectory.summary,
+      inputTokens: totals?.inputTokens ?? 0,
+      cachedInputTokens: totals?.cachedInputTokens ?? 0,
+      outputTokens: totals?.outputTokens ?? 0,
+    },
+  };
+}
+
+function assistantText(content: unknown): string {
+  if (!Array.isArray(content)) {
+    return "";
+  }
+  const parts: string[] = [];
+  for (const block of content) {
+    const record = asRecord(block);
+    if (asString(record?.["type"]) !== "text") {
+      continue;
+    }
+    const text = asString(record?.["text"]);
+    if (text) {
+      parts.push(text);
+    }
+  }
+  return parts.join("\n");
+}
+
+function messageText(content: unknown): string {
+  if (typeof content === "string") {
+    return content;
+  }
+  if (!Array.isArray(content)) {
+    return "";
+  }
+  const parts: string[] = [];
+  for (const block of content) {
+    const record = asRecord(block);
+    const text = asString(record?.["text"]);
+    if (text) {
+      parts.push(text);
+    }
+  }
+  return parts.join("\n");
+}
+
+function preview(text: string): string {
+  const trimmed = text.trim();
+  return trimmed.length > PREVIEW_CHARS ? `${trimmed.slice(0, PREVIEW_CHARS)}…` : trimmed;
+}
+
+function asRecord(value: unknown): Record<string, unknown> | null {
+  return value !== null && typeof value === "object" ? (value as Record<string, unknown>) : null;
+}
+
+function asString(value: unknown): string | null {
+  return typeof value === "string" && value.length > 0 ? value : null;
+}
+
+function asNumber(value: unknown): number | null {
+  return typeof value === "number" && Number.isFinite(value) ? value : null;
+}
