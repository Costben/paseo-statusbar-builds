@@ -0,0 +1,371 @@
+import { readdirSync, readFileSync, statSync } from "node:fs";
+import path from "node:path";
+import * as zlib from "node:zlib";
+
+/**
+ * dsh keeps a session's transcript in `session.v4.jsonl.zstd`: newline-delimited
+ * JSON, compressed as a sequence of independent zstd frames — one frame per
+ * flush. Node's zstd decoder stops at the first frame, so a reader has to walk
+ * the frames itself; that walk is also what makes an incremental read possible.
+ */
+
+/**
+ * Node 24 ships a zstd decoder; the TypeScript DOM/Node typings this repo
+ * compiles against do not name it yet, and an older runtime would simply not
+ * have it — hence the cast and the null check rather than a static import.
+ */
+const zstdDecompress = (zlib as unknown as { zstdDecompressSync?: (buffer: Buffer) => Buffer })
+  .zstdDecompressSync;
+
+/** `28 B5 2F FD`, the frame magic as it appears on the wire. */
+const ZSTD_MAGIC = [0x28, 0xb5, 0x2f, 0xfd];
+
+/** A transcript past this size is not worth decoding on a poll; dsh rotates nothing, so this is a guard, not a limit we expect to hit. */
+const MAX_LOG_BYTES = 64 * 1024 * 1024;
+
+/** Where dsh writes one session's transcript, or null when the session has not flushed yet. */
+export function resolveDshSessionLogPath(home: string, sessionId: string): string | null {
+  if (sessionId.length === 0) {
+    return null;
+  }
+  const sessionsDir = path.join(home, "sessions");
+  let entries: string[];
+  try {
+    entries = readdirSync(sessionsDir);
+  } catch {
+    return null;
+  }
+  for (const entry of entries) {
+    const candidate = path.join(sessionsDir, entry, sessionId, "session.v4.jsonl.zstd");
+    try {
+      if (statSync(candidate).isFile()) {
+        return candidate;
+      }
+    } catch {
+      // Keep scanning; one unreadable workspace directory must not hide the real one.
+    }
+  }
+  return null;
+}
+
+export interface DshLogRead {
+  /** Decoded text that starts exactly at the requested offset. */
+  text: string;
+  /** Offset to pass on the next read. Only complete frames advance it. */
+  offset: number;
+  /** True when the file ends mid-frame; the next poll picks it up. */
+  pending: boolean;
+}
+
+/**
+ * Read the frames appended after `offset`.
+ *
+ * A frame is only decoded once it is whole: a flush may be in progress, and
+ * decoding half a frame would either throw or quietly drop the tail. Anything
+ * already consumed is never re-read, which is what keeps a 20 MB transcript from
+ * costing 20 MB per poll.
+ */
+export function readDshSessionLog(file: string, offset: number): DshLogRead {
+  let size: number;
+  try {
+    size = statSync(file).size;
+  } catch {
+    return { text: "", offset, pending: true };
+  }
+  if (size <= offset) {
+    return { text: "", offset, pending: size < offset };
+  }
+  if (size > MAX_LOG_BYTES) {
+    return { text: "", offset: size, pending: false };
+  }
+
+  let buffer: Buffer;
+  try {
+    buffer = readFileSync(file);
+  } catch {
+    return { text: "", offset, pending: true };
+  }
+
+  let start = offset;
+  // The offset always lands on a frame boundary. If it does not, the file was
+  // rewritten rather than appended to, and the only safe move is a fresh read.
+  if (start > 0 && !hasMagic(buffer, start)) {
+    start = 0;
+  }
+
+  const chunks: string[] = [];
+  let cursor = start;
+  for (;;) {
+    const end = nextFrameEnd(buffer, cursor);
+    if (end === null || end <= cursor) {
+      break;
+    }
+    if (!zstdDecompress) {
+      return { text: chunks.join(""), offset: cursor, pending: true };
+    }
+    try {
+      chunks.push(zstdDecompress(buffer.subarray(cursor, end)).toString("utf8"));
+    } catch {
+      // A frame we cannot decode is worse than a stale row; stop where we are
+      // and let the caller retry from the same offset.
+      return { text: chunks.join(""), offset: cursor, pending: true };
+    }
+    cursor = end;
+  }
+  return { text: chunks.join(""), offset: cursor, pending: cursor < buffer.length };
+}
+
+function hasMagic(buffer: Buffer, offset: number): boolean {
+  if (offset + ZSTD_MAGIC.length > buffer.length) {
+    return false;
+  }
+  return ZSTD_MAGIC.every((byte, index) => buffer[offset + index] === byte);
+}
+
+/**
+ * Byte offset just past the frame starting at `start`, or null when the frame is
+ * incomplete. Walks the header and the block table without decompressing: raw
+ * and RLE blocks are skipped, compressed blocks are skipped by their declared
+ * size.
+ */
+function nextFrameEnd(buffer: Buffer, start: number): number | null {
+  if (!hasMagic(buffer, start)) {
+    return start;
+  }
+  let cursor = start + ZSTD_MAGIC.length;
+  if (cursor >= buffer.length) {
+    return null;
+  }
+  const descriptor = buffer[cursor]!;
+  cursor += 1;
+
+  const frameContentSizeFlag = descriptor >> 6;
+  const singleSegment = (descriptor & 0x20) !== 0;
+  const checksum = (descriptor & 0x04) !== 0;
+  const dictionaryFlag = descriptor & 0x03;
+
+  if (!singleSegment) {
+    cursor += 1; // window descriptor
+  }
+  cursor += dictionaryFlag === 3 ? 4 : dictionaryFlag; // 0/1/2/4 bytes
+  cursor +=
+    frameContentSizeFlag === 0
+      ? singleSegment
+        ? 1
+        : 0
+      : frameContentSizeFlag === 1
+        ? 2
+        : frameContentSizeFlag === 2
+          ? 4
+          : 8;
+  if (cursor > buffer.length) {
+    return null;
+  }
+
+  for (;;) {
+    if (cursor + 3 > buffer.length) {
+      return null;
+    }
+    const header = buffer.readUIntLE(cursor, 3);
+    cursor += 3;
+    const lastBlock = (header & 0x01) !== 0;
+    const blockType = (header >> 1) & 0x03;
+    const blockSize = header >> 3;
+    if (blockType === 0) {
+      cursor += blockSize; // raw
+    } else if (blockType === 1) {
+      cursor += 1; // RLE: one byte, repeated
+    } else if (blockType === 2) {
+      cursor += blockSize; // compressed
+    } else {
+      return null; // reserved block type: give up on this frame
+    }
+    if (cursor > buffer.length) {
+      return null;
+    }
+    if (lastBlock) {
+      if (checksum) {
+        cursor += 4;
+      }
+      return cursor <= buffer.length ? cursor : null;
+    }
+  }
+}
+
+/** Tokens one session has spent, as dsh's projection cache totals them. */
+export interface DshTokenTotals {
+  /** Prompt tokens that missed the cache, plus any cache writes. */
+  inputTokens: number;
+  /** Prompt tokens served from the provider's cache. */
+  cachedInputTokens: number;
+  outputTokens: number;
+}
+
+/**
+ * Read a session's token totals out of its projection cache.
+ *
+ * dsh keeps `tokenUsage.totals` per session — the parent's and every child's —
+ * and writes it write-behind while the session runs. It is the only place the
+ * numbers survive: the transcript carries no usage at all.
+ */
+export function readDshTokenTotals(home: string, sessionId: string): DshTokenTotals | null {
+  const file = path.join(home, "storages", "session_projcache", "sessions", `${sessionId}.json`);
+  let document: unknown;
+  try {
+    document = JSON.parse(readFileSync(file, "utf8"));
+  } catch {
+    return null;
+  }
+  const buckets = asRecord(pick(document, "record", "rows", "tokenUsage", "val", "totals"));
+  if (!buckets) {
+    return null;
+  }
+  const input = readCount(buckets["uncachedInputTokens"]);
+  const cacheWrite = readCount(buckets["cacheWriteTokens"]);
+  const cached = readCount(buckets["cacheReadTokens"]);
+  const output = readCount(buckets["outputTokens"]);
+  if (input === null && cacheWrite === null && cached === null && output === null) {
+    return null;
+  }
+  return {
+    inputTokens: (input ?? 0) + (cacheWrite ?? 0),
+    cachedInputTokens: cached ?? 0,
+    outputTokens: output ?? 0,
+  };
+}
+
+function pick(value: unknown, ...keys: string[]): unknown {
+  let current: unknown = value;
+  for (const key of keys) {
+    const record = asRecord(current);
+    if (!record) {
+      return undefined;
+    }
+    current = record[key];
+  }
+  return current;
+}
+
+function readCount(value: unknown): number | null {
+  return typeof value === "number" && Number.isFinite(value) && value >= 0 ? value : null;
+}
+
+/** One child session as dsh records it in the parent's transcript. */
+export interface DshSubagentFacts {
+  childId: string;
+  createdAt: number | null;
+  label: string | null;
+  /** `continuable`, or `fork` for a child that shares its parent's transcript. */
+  mode: string | null;
+  settled: "completed" | "canceled" | null;
+  closingMessage: string | null;
+}
+
+const CHILD_ID = /subagent ([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/i;
+
+/**
+ * Read the subagent edges out of decoded transcript lines.
+ *
+ * dsh writes the registry row as `subagent/catalog` and the end as a notice on
+ * the parent's own stream (`source.kind === "subagent-settled"`), so the
+ * transcript — not the ACP stream — is where both halves live.
+ */
+export function collectDshSubagentFacts(lines: Iterable<string>): DshSubagentFacts[] {
+  const facts = new Map<string, DshSubagentFacts>();
+  const ensure = (childId: string): DshSubagentFacts => {
+    const existing = facts.get(childId);
+    if (existing) {
+      return existing;
+    }
+    const created: DshSubagentFacts = {
+      childId,
+      createdAt: null,
+      label: null,
+      mode: null,
+      settled: null,
+      closingMessage: null,
+    };
+    facts.set(childId, created);
+    return created;
+  };
+
+  for (const line of lines) {
+    if (line.length === 0) {
+      continue;
+    }
+    let record: Record<string, unknown>;
+    try {
+      record = JSON.parse(line) as Record<string, unknown>;
+    } catch {
+      continue;
+    }
+    const type = record["type"];
+    if (type === "subagent/catalog") {
+      const data = asRecord(record["data"]);
+      const childId = asString(data?.["childId"]);
+      if (!childId) {
+        continue;
+      }
+      const entry = ensure(childId);
+      entry.label = asString(data?.["label"]) ?? entry.label;
+      entry.mode = asString(data?.["mode"]) ?? entry.mode;
+      const createdAt = data?.["childCreatedAt"];
+      entry.createdAt = typeof createdAt === "number" ? createdAt : entry.createdAt;
+      continue;
+    }
+    if (type !== "user/message") {
+      continue;
+    }
+    const data = asRecord(record["data"]);
+    const source = asRecord(data?.["source"]);
+    if (asString(source?.["kind"]) !== "subagent-settled") {
+      continue;
+    }
+    const text = messageText(data?.["content"]);
+    const childId = CHILD_ID.exec(text)?.[1];
+    if (!childId) {
+      continue;
+    }
+    const entry = ensure(childId);
+    entry.settled = text.includes("was stopped before it finished") ? "canceled" : "completed";
+    entry.closingMessage = closingMessage(text) ?? entry.closingMessage;
+  }
+
+  return Array.from(facts.values());
+}
+
+function closingMessage(text: string): string | null {
+  const marker = "Its closing message:";
+  const index = text.indexOf(marker);
+  if (index < 0) {
+    return null;
+  }
+  const message = text.slice(index + marker.length).trim();
+  return message.length > 0 ? message : null;
+}
+
+function messageText(content: unknown): string {
+  if (typeof content === "string") {
+    return content;
+  }
+  if (!Array.isArray(content)) {
+    return "";
+  }
+  const parts: string[] = [];
+  for (const block of content) {
+    const record = asRecord(block);
+    const text = asString(record?.["text"]);
+    if (text) {
+      parts.push(text);
+    }
+  }
+  return parts.join("\n");
+}
+
+function asRecord(value: unknown): Record<string, unknown> | null {
+  return value !== null && typeof value === "object" ? (value as Record<string, unknown>) : null;
+}
+
+function asString(value: unknown): string | null {
+  return typeof value === "string" && value.length > 0 ? value : null;
+}
diff --git a/packages/server/src/server/agent/providers/dsh/subagents.test.ts b/packages/server/src/server/agent/providers/dsh/subagents.test.ts
