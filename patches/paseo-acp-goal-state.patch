+  /**
+   * Read Paseo's goal extension notification into a goal state event.
+   *
+   * The payload is provider-supplied and flat, like the compaction marker. Only
+   * `status` is load-bearing: without a known one there is no goal to describe,
+   * so the report degrades to a null goal and the agent drops what it held.
+   * Text and counters degrade to empty and zero rather than rejecting the
+   * report.
+   */
+  private mapGoalExtension(params: Record<string, unknown>): AgentStreamEvent[] {
+    const status = params.status;
+    if (
+      status !== "active" &&
+      status !== "complete" &&
+      status !== "blocked" &&
+      status !== "cleared"
