@@ -0,0 +1,389 @@
+import { randomUUID } from "node:crypto";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, test, vi } from "vitest";
+import { createTestLogger } from "../../test-utils/test-logger.js";
+import { AgentManager } from "./agent-manager.js";
+import type {
+  AgentClient,
+  AgentLaunchContext,
+  AgentPersistenceHandle,
+  AgentProvider,
+  AgentRunResult,
+  AgentSession,
+  AgentSessionConfig,
+  AgentStreamEvent,
+} from "./agent-sdk-types.js";
+import { AgentStorage } from "./agent-storage.js";
+
+const logger = createTestLogger();
+
+async function drainAsyncGenerator<T>(generator: AsyncGenerator<T>): Promise<void> {
+  for await (const _ of generator) {
+    // Drain provider events while AgentManager subscribers observe them.
+  }
+}
+
+const TEST_CAPABILITIES = {
+  supportsStreaming: false,
+  supportsSessionPersistence: false,
+  supportsSessionListing: true,
+  supportsDynamicModes: false,
+  supportsMcpServers: false,
+  supportsReasoningStream: false,
+  supportsToolInvocations: false,
+} as const;
+
+class TestAgentSession implements AgentSession {
+  readonly provider = "codex" as const;
+  readonly capabilities = TEST_CAPABILITIES;
+  readonly id = randomUUID();
+  private runtimeModel: string | null = null;
+  private subscribers = new Set<(event: AgentStreamEvent) => void>();
+  private turnIdCounter = 0;
+
+  constructor(private readonly config: AgentSessionConfig) {}
+
+  async run(): Promise<AgentRunResult> {
+    return {
+      sessionId: this.id ?? this.config.provider,
+      finalText: "",
+      timeline: [],
+    };
+  }
+
+  async startTurn(): Promise<{ turnId: string }> {
+    const turnId = `turn-${this.id}-${++this.turnIdCounter}`;
+    setTimeout(() => {
+      this.pushEvent({ type: "turn_started", provider: this.provider, turnId });
+      this.pushEvent({ type: "turn_completed", provider: this.provider, turnId });
+      this.runtimeModel = "gpt-5.2-codex";
+    }, 0);
+    return { turnId };
+  }
+
+  subscribe(callback: (event: AgentStreamEvent) => void): () => void {
+    this.subscribers.add(callback);
+    return () => {
+      this.subscribers.delete(callback);
+    };
+  }
+
+  pushEvent(event: AgentStreamEvent): void {
+    for (const cb of this.subscribers) {
+      try {
+        cb(event);
+      } catch {
+        // error isolation per design
+      }
+    }
+  }
+
+  async *streamHistory(): AsyncGenerator<AgentStreamEvent> {}
+
+  async getRuntimeInfo() {
+    return {
+      provider: this.provider,
+      sessionId: this.id,
+      model: this.runtimeModel ?? this.config.model ?? null,
+      modeId: this.config.modeId ?? null,
+    };
+  }
+
+  async getAvailableModes() {
+    return [];
+  }
+
+  async getCurrentMode() {
+    return null;
+  }
+
+  async setMode(): Promise<void> {}
+
+  getPendingPermissions() {
+    return [];
+  }
+
+  async respondToPermission(): Promise<void> {}
+
+  describePersistence() {
+    return {
+      provider: this.provider,
+      sessionId: this.id,
+    };
+  }
+
+  async interrupt(): Promise<void> {}
+
+  async close(): Promise<void> {}
+}
+
+class TestAgentClient implements AgentClient {
+  readonly provider: AgentProvider;
+  readonly capabilities = TEST_CAPABILITIES;
+  readonly createdConfigs: AgentSessionConfig[] = [];
+  readonly resumeOverrides: Array<Partial<AgentSessionConfig> | undefined> = [];
+
+  constructor(provider: AgentProvider = "codex") {
+    this.provider = provider;
+  }
+
+  async isAvailable(): Promise<boolean> {
+    return true;
+  }
+
+  async createSession(config: AgentSessionConfig): Promise<AgentSession> {
+    this.createdConfigs.push(config);
+    return new TestAgentSession(config);
+  }
+
+  async fetchCatalog() {
+    return {
+      models: [
+        {
+          provider: this.provider,
+          id: "gpt-5.4",
+          label: "GPT-5.4",
+          isDefault: true,
+        },
+      ],
+      modes: [],
+    };
+  }
+
+  async resumeSession(
+    _handle: AgentPersistenceHandle,
+    config?: Partial<AgentSessionConfig>,
+    _launchContext?: AgentLaunchContext,
+  ): Promise<AgentSession> {
+    this.resumeOverrides.push(config);
+    return new TestAgentSession({
+      provider: this.provider,
+      cwd: config?.cwd ?? process.cwd(),
+      daemonAppendSystemPrompt: config?.daemonAppendSystemPrompt,
+    });
+  }
+}
+
+test("defers finished attention while blocking background work is active and clears deferral on wakeup turn", async () => {
+  const workdir = mkdtempSync(join(tmpdir(), "agent-manager-deferred-wakeup-"));
+  const storage = new AgentStorage(join(workdir, "agents"), logger);
+  let activeSession: TestAgentSession | null = null;
+  class DeferredBackgroundClient extends TestAgentClient {
+    override async createSession(config: AgentSessionConfig): Promise<AgentSession> {
+      activeSession = new (class extends TestAgentSession {
+        override async startTurn(): Promise<{ turnId: string }> {
+          const turnId = "turn-initial-bg";
+          setTimeout(() => {
+            this.pushEvent({ type: "turn_started", provider: this.provider, turnId });
+            this.pushEvent({
+              type: "background_work",
+              provider: this.provider,
+              items: [{ id: "bash-1", kind: "shell", description: "sleep 20" }],
+            });
+            this.pushEvent({ type: "turn_completed", provider: this.provider, turnId });
+          }, 0);
+          return { turnId };
+        }
+      })(config);
+      return activeSession;
+    }
+  }
+  const attentionReasons: Array<"finished" | "error" | "permission"> = [];
+  const manager = new AgentManager({
+    clients: { codex: new DeferredBackgroundClient() },
+    registry: storage,
+    logger,
+    onAgentAttention: ({ reason }) => attentionReasons.push(reason),
+  });
+  try {
+    const agent = await manager.createAgent({ provider: "codex", cwd: workdir }, undefined, {
+      workspaceId: undefined,
+    });
+    await drainAsyncGenerator(
+      manager.streamAgent(agent.id, "start background job", { clientMessageId: "m1" }),
+    );
+
+    expect(manager.getAgent(agent.id)?.lifecycle).toBe("idle");
+    expect(manager.getAgent(agent.id)?.attention.requiresAttention).toBe(false);
+    expect(attentionReasons).toEqual([]);
+
+    // Wakeup turn clears the background work and completes.
+    activeSession?.pushEvent({ type: "turn_started", provider: "codex", turnId: "wakeup-1" });
+    await vi.waitFor(() => expect(manager.getAgent(agent.id)?.lifecycle).toBe("running"));
+
+    vi.useFakeTimers();
+    activeSession?.pushEvent({ type: "background_work", provider: "codex", items: [] });
+    activeSession?.pushEvent({ type: "turn_completed", provider: "codex", turnId: "wakeup-1" });
+    await vi.advanceTimersByTimeAsync(50);
+
+    // The work settled in the same instant this turn ended, so the finish waits
+    // out the settle window before it is announced.
+    expect(manager.getAgent(agent.id)?.lifecycle).toBe("idle");
+    expect(attentionReasons).toEqual([]);
+
+    await vi.advanceTimersByTimeAsync(6_050);
+    expect(attentionReasons).toEqual(["finished"]);
+    vi.useRealTimers();
+    expect(manager.getAgent(agent.id)?.lifecycle).toBe("idle");
+    expect(manager.getAgent(agent.id)?.attention).toMatchObject({
+      requiresAttention: true,
+      attentionReason: "finished",
+    });
+
+    await manager.closeAgent(agent.id);
+  } finally {
+    await storage.flush();
+    rmSync(workdir, { recursive: true, force: true });
+  }
+});
+
+test("raises deferred finished attention after the settle window once background tasks clear while idle", async () => {
+  const workdir = mkdtempSync(join(tmpdir(), "agent-manager-deferred-settle-"));
+  const storage = new AgentStorage(join(workdir, "agents"), logger);
+  let activeSession: TestAgentSession | null = null;
+  class DeferredTaskClient extends TestAgentClient {
+    override async createSession(config: AgentSessionConfig): Promise<AgentSession> {
+      activeSession = new (class extends TestAgentSession {
+        override async startTurn(): Promise<{ turnId: string }> {
+          const turnId = "turn-bg-task";
+          setTimeout(() => {
+            this.pushEvent({ type: "turn_started", provider: this.provider, turnId });
+            this.pushEvent({
+              type: "background_tasks_updated",
+              provider: this.provider,
+              backgroundTasks: {
+                count: 1,
+                tasks: [{ id: "task-1", command: "sleep 10", status: "running" }],
+              },
+            });
+            this.pushEvent({ type: "turn_completed", provider: this.provider, turnId });
+          }, 0);
+          return { turnId };
+        }
+      })(config);
+      return activeSession;
+    }
+  }
+  const attentionReasons: Array<"finished" | "error" | "permission"> = [];
+  const manager = new AgentManager({
+    clients: { codex: new DeferredTaskClient() },
+    registry: storage,
+    logger,
+    onAgentAttention: ({ reason }) => attentionReasons.push(reason),
+  });
+  try {
+    const agent = await manager.createAgent({ provider: "codex", cwd: workdir }, undefined, {
+      workspaceId: undefined,
+    });
+    await drainAsyncGenerator(
+      manager.streamAgent(agent.id, "start background task", { clientMessageId: "m1" }),
+    );
+
+    expect(manager.getAgent(agent.id)?.lifecycle).toBe("idle");
+    expect(attentionReasons).toEqual([]);
+
+    vi.useFakeTimers();
+    activeSession?.pushEvent({
+      type: "background_tasks_updated",
+      provider: "codex",
+      backgroundTasks: { count: 0, tasks: [] },
+    });
+    await vi.advanceTimersByTimeAsync(100);
+    expect(manager.getAgent(agent.id)?.backgroundTasks?.count).toBe(0);
+    expect(attentionReasons).toEqual([]);
+
+    await vi.advanceTimersByTimeAsync(6_050);
+    expect(attentionReasons).toEqual(["finished"]);
+    expect(manager.getAgent(agent.id)?.attention).toMatchObject({
+      requiresAttention: true,
+      attentionReason: "finished",
+    });
+
+    vi.useRealTimers();
+    await manager.closeAgent(agent.id);
+  } finally {
+    vi.useRealTimers();
+    await storage.flush();
+    rmSync(workdir, { recursive: true, force: true });
+  }
+});
+
+test("a finish that a background task wake-up follows is announced once, after that turn", async () => {
+  const workdir = mkdtempSync(join(tmpdir(), "agent-manager-deferred-race-"));
+  const storage = new AgentStorage(join(workdir, "agents"), logger);
+  let activeSession: TestAgentSession | null = null;
+  class RaceClient extends TestAgentClient {
+    override async createSession(config: AgentSessionConfig): Promise<AgentSession> {
+      activeSession = new (class extends TestAgentSession {
+        override async startTurn(): Promise<{ turnId: string }> {
+          const turnId = "turn-race";
+          setTimeout(() => {
+            this.pushEvent({ type: "turn_started", provider: this.provider, turnId });
+            this.pushEvent({
+              type: "background_tasks_updated",
+              provider: this.provider,
+              backgroundTasks: {
+                count: 1,
+                tasks: [{ id: "task-race", command: "sleep 1", status: "running" }],
+              },
+            });
+            this.pushEvent({ type: "turn_completed", provider: this.provider, turnId });
+          }, 0);
+          return { turnId };
+        }
+      })(config);
+      return activeSession;
+    }
+  }
+  const attentionReasons: Array<"finished" | "error" | "permission"> = [];
+  const manager = new AgentManager({
+    clients: { codex: new RaceClient() },
+    registry: storage,
+    logger,
+    onAgentAttention: ({ reason }) => attentionReasons.push(reason),
+  });
+  try {
+    const agent = await manager.createAgent({ provider: "codex", cwd: workdir }, undefined, {
+      workspaceId: undefined,
+    });
+    await drainAsyncGenerator(
+      manager.streamAgent(agent.id, "start a task that finishes with the turn", {
+        clientMessageId: "m1",
+      }),
+    );
+    expect(manager.getAgent(agent.id)?.lifecycle).toBe("idle");
+    expect(attentionReasons).toEqual([]);
+
+    vi.useFakeTimers();
+    // The task settles and the turn ends in the same instant.
+    activeSession?.pushEvent({
+      type: "background_tasks_updated",
+      provider: "codex",
+      backgroundTasks: { count: 0, tasks: [] },
+    });
+    await vi.advanceTimersByTimeAsync(20);
+    expect(attentionReasons).toEqual([]);
+
+    // The task's completion notification starts the next turn before the settle
+    // window is out, so the finish it woke is never announced.
+    activeSession?.pushEvent({ type: "turn_started", provider: "codex", turnId: "wakeup-race" });
+    await vi.advanceTimersByTimeAsync(6_050);
+    expect(manager.getAgent(agent.id)?.lifecycle).toBe("running");
+    expect(attentionReasons).toEqual([]);
+
+    activeSession?.pushEvent({ type: "turn_completed", provider: "codex", turnId: "wakeup-race" });
+    await vi.advanceTimersByTimeAsync(50);
+    // That turn cleared the task well before it ended, so nothing holds its finish.
+    await vi.advanceTimersByTimeAsync(6_050);
+    expect(attentionReasons).toEqual(["finished"]);
+    vi.useRealTimers();
+
+    await manager.closeAgent(agent.id);
+  } finally {
+    vi.useRealTimers();
+    await storage.flush();
+    rmSync(workdir, { recursive: true, force: true });
+  }
+});
