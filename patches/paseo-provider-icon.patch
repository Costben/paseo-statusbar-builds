diff --git a/packages/server/src/server/agent/provider-icon.ts b/packages/server/src/server/agent/provider-icon.ts
new file mode 100644
index 000000000..1a298d5c2
--- /dev/null
+++ b/packages/server/src/server/agent/provider-icon.ts
@@ -0,0 +1,83 @@
+import { readFileSync, statSync } from "node:fs";
+import { homedir } from "node:os";
+import { isAbsolute, resolve } from "node:path";
+
+const MAX_PROVIDER_ICON_BYTES = 64 * 1024;
+
+export interface ProviderIconLogger {
+  warn: (context: Record<string, unknown>, message: string) => void;
+}
+
+/**
+ * Resolves the `icon` field of a provider override. The value is either inline
+ * SVG markup or a path to an .svg file (`~` expands to the home directory).
+ * A broken icon is reported and dropped so it can never prevent the provider
+ * from starting.
+ */
+export function resolveProviderIconSvg(
+  provider: string,
+  icon: string | undefined,
+  logger: ProviderIconLogger,
+): string | undefined {
+  if (!icon) return undefined;
+  const value = icon.trim();
+  if (!value) return undefined;
+  try {
+    const svg = value.startsWith("<") ? value : readIconFile(value);
+    validateProviderIconSvg(svg);
+    return svg;
+  } catch (error) {
+    logger.warn(
+      { provider, err: error },
+      "Ignoring provider icon; falling back to the default icon",
+    );
+    return undefined;
+  }
+}
+
+function readIconFile(iconPath: string): string {
+  const resolvedPath = resolveIconPath(iconPath);
+  const stats = statSync(resolvedPath);
+  if (!stats.isFile()) {
+    throw new Error(`provider icon path is not a file: ${resolvedPath}`);
+  }
+  if (stats.size > MAX_PROVIDER_ICON_BYTES) {
+    throw new Error(`provider icon exceeds ${MAX_PROVIDER_ICON_BYTES} bytes: ${resolvedPath}`);
+  }
+  return readFileSync(resolvedPath, "utf8");
+}
+
+function resolveIconPath(iconPath: string): string {
+  if (iconPath === "~") return homedir();
+  if (iconPath.startsWith("~/") || iconPath.startsWith("~\\")) {
+    return resolve(homedir(), iconPath.slice(2));
+  }
+  return isAbsolute(iconPath) ? iconPath : resolve(process.cwd(), iconPath);
+}
+
+function validateProviderIconSvg(svg: string): void {
+  if (!/^\s*<svg(?:\s|>)/i.test(svg)) {
+    throw new Error("provider icon is not an SVG document");
+  }
+  if (Buffer.byteLength(svg, "utf8") > MAX_PROVIDER_ICON_BYTES) {
+    throw new Error(`provider icon exceeds ${MAX_PROVIDER_ICON_BYTES} bytes`);
+  }
+  if (/<script(?:\s|>)/i.test(svg)) {
+    throw new Error("provider icon must not contain script elements");
+  }
+  if (/<foreignObject(?:\s|>)/i.test(svg)) {
+    throw new Error("provider icon must not contain foreignObject elements");
+  }
+  if (/<style(?:\s|>)/i.test(svg)) {
+    throw new Error("provider icon must not contain style elements");
+  }
+  if (/\son[a-z]+\s*=/i.test(svg)) {
+    throw new Error("provider icon must not contain event handler attributes");
+  }
+  if (/javascript\s*:/i.test(svg)) {
+    throw new Error("provider icon must not contain javascript URLs");
+  }
+  if (/(?:href|src)\s*=\s*["']\s*(?:[a-z][a-z0-9+.-]*:)?\/\//i.test(svg)) {
+    throw new Error("provider icon must not reference external resources");
+  }
+}
