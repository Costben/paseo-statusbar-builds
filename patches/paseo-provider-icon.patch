+test("custom ACP provider exposes an inline SVG icon", () => {
+  const icon = '<svg viewBox="0 0 24 24"><path d="M4 4h16v16H4z" /></svg>';
+  const registry = buildProviderRegistry(logger, {
+    providerOverrides: {
+      "my-agent": {
+        extends: "acp",
+        label: "My Agent",
+        command: ["my-agent", "--acp"],
+        icon,
+      },
+    },
+  });
+
+  expect(registry["my-agent"].iconSvg).toBe(icon);
+});
+
+test("custom ACP provider reads its icon from an SVG file", () => {
+  const directory = mkdtempSync(join(tmpdir(), "paseo-provider-icon-"));
+  const iconPath = join(directory, "icon.svg");
+  const icon = '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /></svg>';
+  writeFileSync(iconPath, icon, "utf8");
+  const registry = buildProviderRegistry(logger, {
+    providerOverrides: {
+      "my-agent": {
+        extends: "acp",
+        label: "My Agent",
+        command: ["my-agent", "--acp"],
+        icon: iconPath,
+      },
+    },
+  });
+
+  expect(registry["my-agent"].iconSvg).toBe(icon);
+});
+
+test("invalid provider icons fall back to the default icon", () => {
+  const registry = buildProviderRegistry(logger, {
+    providerOverrides: {
+      "my-agent": {
+        extends: "acp",
+        label: "My Agent",
+        command: ["my-agent", "--acp"],
+        icon: "<svg><script>alert(1)</script></svg>",
+      },
+    },
+  });
+
+  expect(registry["my-agent"].iconSvg).toBeUndefined();
+});
