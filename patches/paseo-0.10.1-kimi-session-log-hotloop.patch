+/**
+ * Move `end` forward to just past the next newline, so a budget-sized read stops
+ * on a record boundary. A range that ends inside a multi-byte UTF-8 sequence is
+ * decoded with a replacement character on both sides of the cut, and because the
+ * two halves are decoded separately they no longer rejoin into the original text
+ * — the record still parses, but its strings silently acquire garbage. Cutting on
+ * a newline avoids that, and `0x0a` never occurs inside a UTF-8 sequence, so the
+ * scan can work on raw bytes.
+ *
+ * Returns `end` unchanged when no newline turns up inside the window, which is
+ * the only case that leaves a read ending mid-line.
+ *
+ * Exported for the per-subagent tailer, which reads the same way.
+ */
+export function alignRangeEndToNewline(filePath: string, end: number, size: number): number {
+  const limit = Math.min(size, end + ALIGN_SCAN_MAX_BYTES);
+  if (limit <= end) {
+    return end;
+  }
+  let fd: number | null = null;
+  try {
+    fd = openSync(filePath, "r");
+    const slab = Buffer.alloc(Math.min(ALIGN_SCAN_SLAB_BYTES, limit - end));
+    for (let from = end; from < limit; from += slab.length) {
+      const read = readSync(fd, slab, 0, Math.min(slab.length, limit - from), from);
