+interface ParsedACPElicitation {
+  toolCallId: string;
+  message: string;
+  fields: ACPElicitationField[];
+}
+
+function readElicitationChoiceList(rawList: unknown): ACPElicitationOption[] {
+  if (!Array.isArray(rawList)) {
+    return [];
+  }
+  const options: ACPElicitationOption[] = [];
+  for (const item of rawList) {
+    if (typeof item === "string") {
+      options.push({ constValue: item, label: item });
+      continue;
+    }
+    const record = readRecord(item);
+    if (!record) {
+      continue;
+    }
+    const constValue =
+      typeof record["const"] === "string"
+        ? record["const"]
+        : typeof record["const"] === "number"
+          ? String(record["const"])
+          : undefined;
+    const title = typeof record["title"] === "string" ? record["title"] : undefined;
+    const description =
+      typeof record["description"] === "string" ? record["description"] : undefined;
+    if (constValue !== undefined && title) {
+      options.push({
+        constValue,
+        label: title,
+        ...(description !== undefined ? { description } : {}),
+      });
+    } else if (title) {
+      options.push({
+        constValue: title,
+        label: title,
+        ...(description !== undefined ? { description } : {}),
+      });
+    }
+  }
+  return options;
+}
+
+function extractElicitationFieldOptions(prop: Record<string, unknown>): {
+  multiSelect: boolean;
+  options: ACPElicitationOption[];
+} {
+  if (prop["type"] === "array") {
+    const items = readRecord(prop["items"]);
+    if (items) {
+      const fromAnyOf = readElicitationChoiceList(items["anyOf"]);
+      if (fromAnyOf.length > 0) {
+        return { multiSelect: true, options: fromAnyOf };
+      }
+      const fromOneOf = readElicitationChoiceList(items["oneOf"]);
+      if (fromOneOf.length > 0) {
+        return { multiSelect: true, options: fromOneOf };
+      }
+      const fromEnum = readElicitationChoiceList(items["enum"]);
+      if (fromEnum.length > 0) {
+        return { multiSelect: true, options: fromEnum };
+      }
+    }
+    return { multiSelect: true, options: [] };
+  }
+
+  const fromOneOf = readElicitationChoiceList(prop["oneOf"]);
+  if (fromOneOf.length > 0) {
+    return { multiSelect: false, options: fromOneOf };
+  }
+  const fromAnyOf = readElicitationChoiceList(prop["anyOf"]);
+  if (fromAnyOf.length > 0) {
+    return { multiSelect: false, options: fromAnyOf };
+  }
+  const fromEnum = readElicitationChoiceList(prop["enum"]);
+  if (fromEnum.length > 0) {
+    return { multiSelect: false, options: fromEnum };
+  }
+  return { multiSelect: false, options: [] };
+}
+
+function isPlainStringProperty(prop: Record<string, unknown> | null | undefined): boolean {
+  if (!prop || prop["type"] !== "string") {
+    return false;
+  }
+  return !("oneOf" in prop) && !("anyOf" in prop) && !("enum" in prop);
+}
+
+export function parseACPElicitationRequest(
+  params: Record<string, unknown>,
+): ParsedACPElicitation | null {
+  const mode = typeof params["mode"] === "string" ? params["mode"] : "form";
+  if (mode !== "form") {
+    return null;
+  }
+  const schema = readRecord(params["requestedSchema"]);
+  const properties = readRecord(schema?.["properties"]);
+  if (!properties) {
+    return null;
+  }
+
+  const requiredKeys = new Set<string>(
+    Array.isArray(schema?.["required"])
+      ? schema["required"].filter((entry): entry is string => typeof entry === "string")
+      : [],
+  );
+  const consumedKeys = new Set<string>();
+  const entries = Object.entries(properties);
+
+  const rawFields: Array<Omit<ACPElicitationField, "header">> = [];
+  for (const [key, rawProp] of entries) {
+    if (consumedKeys.has(key)) {
+      continue;
+    }
+    const prop = readRecord(rawProp);
+    if (!prop) {
+      continue;
+    }
+
+    const otherKeyCandidate = `${key}_other`;
+    const otherProp = readRecord(properties[otherKeyCandidate]);
+    const hasPairedOther = isPlainStringProperty(otherProp);
+    if (hasPairedOther) {
+      consumedKeys.add(otherKeyCandidate);
+    }
+
+    const { multiSelect, options } = extractElicitationFieldOptions(prop);
+    const question =
+      (typeof prop["title"] === "string" && prop["title"].trim()) ||
+      (typeof prop["description"] === "string" && prop["description"].trim()) ||
+      key;
+
+    rawFields.push({
+      key,
+      ...(hasPairedOther ? { otherKey: otherKeyCandidate } : {}),
+      question,
+      multiSelect,
+      allowOther: hasPairedOther || options.length === 0,
+      allowEmpty: options.length === 0 && !requiredKeys.has(key),
+      options,
+    });
+  }
+
+  const fields: ACPElicitationField[] = rawFields.map((field, index) => ({
+    ...field,
+    header: rawFields.length === 1 ? "Question" : `Question ${index + 1}`,
+  }));
+
+  const toolCallId =
+    typeof params["toolCallId"] === "string" && params["toolCallId"].trim().length > 0
+      ? params["toolCallId"]
+      : randomUUID();
+  const message =
+    typeof params["message"] === "string" && params["message"].trim().length > 0
+      ? params["message"].trim()
+      : "Question";
+
+  return {
+    toolCallId,
+    message,
+    fields,
+  };
+}
+
+function buildACPElicitationPermissionRequest(
+  provider: string,
+  requestId: string,
+  parsed: ParsedACPElicitation,
+): AgentPermissionRequest {
+  const questionPrompts = parsed.fields.map((field) => ({
+    question: field.question,
+    header: field.header,
+    options: field.options.map((option) => ({
+      label: option.label,
+      ...(option.description !== undefined ? { description: option.description } : {}),
+    })),
+    multiSelect: field.multiSelect,
+    allowOther: field.allowOther,
+    allowEmpty: field.allowEmpty,
+  }));
+
+  return {
+    id: requestId,
+    provider,
+    name: "ask_question",
+    kind: "question",
+    title: parsed.message,
+    detail: {
+      type: "plain_text",
+      label: parsed.message,
+      text: questionPrompts.map((item) => item.question).join("\n"),
+      icon: "wrench",
+    },
+    input: { questions: questionPrompts },
+    actions: [
+      { id: "accept", label: "Submit", behavior: "allow" },
+      { id: "decline", label: "Dismiss", behavior: "deny" },
+    ],
+    metadata: {
+      toolCallId: parsed.toolCallId,
+      questions: questionPrompts,
+    },
+  };
+}
+
+function splitMultiSelectElicitationAnswer(
+  rawAnswer: string,
+  options: ACPElicitationOption[],
+): { matchedConsts: string[]; otherText: string | null } {
+  const sortedOptions = [...options].sort((a, b) => b.label.length - a.label.length);
+  const matchedConsts: string[] = [];
+  let remaining = rawAnswer.trim();
+
+  while (remaining.length > 0) {
+    let matched: ACPElicitationOption | undefined;
+    for (const option of sortedOptions) {
+      if (remaining === option.label || remaining.startsWith(`${option.label}, `)) {
+        matched = option;
+        break;
+      }
+    }
+    if (!matched) {
+      break;
+    }
+    matchedConsts.push(matched.constValue);
+    remaining = remaining.slice(matched.label.length).replace(/^,\s*/, "");
+  }
+
+  return {
+    matchedConsts,
+    otherText: remaining.length > 0 ? remaining : null,
+  };
+}
+
+export function buildACPElicitationContent(
+  fields: ACPElicitationField[],
+  rawAnswers: Record<string, string>,
+): Record<string, unknown> {
+  const content: Record<string, unknown> = {};
+  for (const field of fields) {
+    const rawAnswer = rawAnswers[field.question] ?? rawAnswers[field.header];
+    if (typeof rawAnswer !== "string") {
+      continue;
+    }
+    const trimmed = rawAnswer.trim();
+    if (!trimmed) {
+      continue;
+    }
+    if (field.options.length === 0) {
+      content[field.key] = trimmed;
+      continue;
+    }
+    if (!field.multiSelect) {
+      const matched = field.options.find((option) => option.label === trimmed);
+      if (matched) {
+        content[field.key] = matched.constValue;
+      } else if (field.otherKey) {
+        content[field.otherKey] = trimmed;
+      } else {
+        content[field.key] = trimmed;
+      }
+      continue;
+    }
+    const { matchedConsts, otherText } = splitMultiSelectElicitationAnswer(trimmed, field.options);
+    if (matchedConsts.length > 0) {
+      content[field.key] = matchedConsts;
+    }
+    if (otherText) {
+      if (field.otherKey) {
+        content[field.otherKey] = otherText;
+      } else if (matchedConsts.length === 0) {
+        content[field.key] = [otherText];
+      }
+    }
+  }
+  return content;
+}
