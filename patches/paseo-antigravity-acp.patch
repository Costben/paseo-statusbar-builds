+              anyOf: [
+                { const: "1", title: "X" },
+                { const: "2", title: "Y" },
+              ],
+            },
+          },
+          q2_other: {
+            type: "string",
+            title: "Other",
+            description: "Optional free-form answer to: Pick tags?",
+          },
+        },
+      },
+    };
+
+    const parsed = parseACPElicitationRequest(rawParams);
+    expect(parsed?.fields).toHaveLength(2);
+    expect(
+      buildACPElicitationContent(parsed!.fields, {
+        "Question 1": "Alpha",
+        "Question 2": "X, Custom tag",
+      }),
+    ).toEqual({
+      q1: "1",
+      q2: ["1"],
+      q2_other: "Custom tag",
+    });
+
+    const session = createSessionWithConfig({ provider: "antigravity" });
+    const events: AgentStreamEvent[] = [];
+    const internals = asInternals<ACPSessionInternals>(session);
+    internals.sessionId = "session-1";
+    internals.activeForegroundTurnId = "turn-1";
+    session.subscribe((event) => events.push(event));
+
+    const acceptPromise = session.extMethod("elicitation/create", rawParams);
+    await Promise.resolve();
+
+    const pendingList = session.getPendingPermissions();
+    expect(pendingList).toHaveLength(1);
+    expect(pendingList[0]?.kind).toBe("question");
+    expect(pendingList[0]?.input).toEqual({
+      questions: [
+        {
+          question: "Pick one?",
+          header: "Question 1",
+          options: [{ label: "Alpha" }, { label: "Beta" }],
+          multiSelect: false,
+          allowOther: true,
+          allowEmpty: false,
+        },
+        {
+          question: "Pick tags?",
+          header: "Question 2",
+          options: [{ label: "X" }, { label: "Y" }],
+          multiSelect: true,
+          allowOther: true,
+          allowEmpty: false,
+        },
+      ],
+    });
+
+    await session.respondToPermission(pendingList[0]!.id, {
+      behavior: "allow",
+      updatedInput: {
+        answers: {
+          "Question 1": "Custom single",
+          "Question 2": "X, Y, Extra tag",
+        },
+      },
+    });
+    await expect(acceptPromise).resolves.toEqual({
+      action: "accept",
+      content: {
+        q1_other: "Custom single",
+        q2: ["1", "2"],
+        q2_other: "Extra tag",
+      },
+    });
+    expect(session.getPendingPermissions()).toEqual([]);
+
+    const declinePromise = session.extMethod("elicitation/create", rawParams);
+    await Promise.resolve();
+    const pendingDecline = session.getPendingPermissions();
+    expect(pendingDecline).toHaveLength(1);
+    await session.respondToPermission(pendingDecline[0]!.id, {
+      behavior: "deny",
+      message: "Dismissed by user",
+    });
+    await expect(declinePromise).resolves.toEqual({ action: "decline" });
