+
+    const catalog = await resolveAntigravityCatalogModels(context);
+    const hydrogen = catalog.find((m) => m.id === "gemini-4-hydrogen");
+    expect(hydrogen?.thinkingOptions?.map((o) => o.id)).toEqual(["low", "medium", "high", "xhigh"]);
+    expect(hydrogen?.aliases).toEqual([
