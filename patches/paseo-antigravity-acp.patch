@@ -0,0 +1,337 @@
+import { ANTIGRAVITY_MODES } from "@getpaseo/protocol/provider-manifest";
+import type { SessionConfigOption } from "@agentclientprotocol/sdk";
+import type { Logger } from "pino";
+
+import type {
+  AgentCapabilityFlags,
+  AgentMode,
+  AgentModelDefinition,
+  AgentSessionConfig,
+} from "../agent-sdk-types.js";
+import {
+  checkProviderLaunchAvailable,
+  resolveProviderLaunch,
+  type ProviderRuntimeSettings,
+} from "../provider-launch-config.js";
+import {
+  ACPAgentClient,
+  type ACPCatalogModelResolverContext,
+  type ACPConfiguredSelectionContext,
+  type ACPProviderModeWriteResult,
+  type ACPProviderModeWriterContext,
+  type SessionStateResponse,
+  DEFAULT_ACP_CAPABILITIES,
+  deriveSelectorOptions,
+  findSelectConfigOption,
+} from "./acp-agent.js";
+import {
+  buildBinaryDiagnosticRows,
+  buildCommandResolutionDiagnosticRows,
+  formatProviderDiagnostic,
+  formatProviderDiagnosticError,
+  toDiagnosticErrorMessage,
+} from "./diagnostic-utils.js";
+
+const ANTIGRAVITY_CAPABILITIES: AgentCapabilityFlags = {
+  ...DEFAULT_ACP_CAPABILITIES,
+};
+
+export const ANTIGRAVITY_DEFAULT_MODE_ID = "default";
+export const ANTIGRAVITY_FULL_ACCESS_MODE_ID = "full-access";
+
+const FULL_ACCESS_MODE_DESCRIPTION = "Skip all permission prompts";
+const LEGACY_THINKING_SUFFIX_PATTERN = /^(.*)-(low|medium|high|xhigh)$/;
+
+type SelectConfigOption = Extract<SessionConfigOption, { type: "select" }>;
+
+interface AntigravityACPAgentClientOptions {
+  logger: Logger;
+  runtimeSettings?: ProviderRuntimeSettings;
+}
+
+export function resolveAntigravityDefaultCommand(
+  runtimeSettings?: ProviderRuntimeSettings,
+): [string, ...string[]] {
+  if (
+    runtimeSettings?.command?.mode === "replace" &&
+    runtimeSettings.command.argv.length > 0 &&
+    runtimeSettings.command.argv.includes("acp")
+  ) {
+    return [runtimeSettings.command.argv[0]];
+  }
+  return ["agy", "acp"];
+}
+
+export function buildAntigravitySessionMeta(
+  config: AgentSessionConfig,
+): Record<string, unknown> | undefined {
+  const sections = [config.systemPrompt, config.daemonAppendSystemPrompt]
+    .map((entry) => entry?.trim())
+    .filter((entry): entry is string => Boolean(entry && entry.length > 0));
+  if (sections.length === 0) {
+    return undefined;
+  }
+  return {
+    antigravity: {
+      systemPrompt: {
+        append: sections.join("\n\n"),
+      },
+    },
+  };
+}
+
+export function transformAntigravitySessionResponse(
+  response: SessionStateResponse,
+): SessionStateResponse {
+  // Drop compound `models.availableModels` so Paseo derives the 9 base models
+  // from `configOptions[category="model"]` paired with per-model `thought_level`.
+  const { models: _models, ...withoutCompoundModels } = response;
+  if (!withoutCompoundModels.modes) {
+    return withoutCompoundModels;
+  }
+
+  const availableModes = withoutCompoundModels.modes.availableModes ?? [];
+  const hasFullAccess = availableModes.some((mode) => mode.id === ANTIGRAVITY_FULL_ACCESS_MODE_ID);
+  return {
+    ...withoutCompoundModels,
+    modes: {
+      ...withoutCompoundModels.modes,
+      availableModes: hasFullAccess
+        ? availableModes
+        : [
+            ...availableModes,
+            {
+              id: ANTIGRAVITY_FULL_ACCESS_MODE_ID,
+              name: "Full Access",
+              description: FULL_ACCESS_MODE_DESCRIPTION,
+            },
+          ],
+    },
+  };
+}
+
+export function transformAntigravityConfigOptions(
+  configOptions: SessionConfigOption[],
+): SessionConfigOption[] {
+  return configOptions.map((option) => {
+    if (option.type !== "select" || option.category !== "mode") {
+      return option;
+    }
+    const flattened = flattenModeSelectOptions(option.options);
+    if (flattened.some((choice) => choice.value === ANTIGRAVITY_FULL_ACCESS_MODE_ID)) {
+      return option;
+    }
+    return {
+      ...option,
+      options: [
+        ...flattened,
+        {
+          value: ANTIGRAVITY_FULL_ACCESS_MODE_ID,
+          name: "Full Access",
+          description: FULL_ACCESS_MODE_DESCRIPTION,
+        },
+      ],
+    };
+  });
+}
+
+function flattenModeSelectOptions(
+  options: SelectConfigOption["options"],
+): Array<{ value: string; name: string; description?: string | null }> {
+  const flattened: Array<{ value: string; name: string; description?: string | null }> = [];
+  for (const option of options) {
+    if ("value" in option) {
+      flattened.push(option);
+      continue;
+    }
+    flattened.push(...option.options);
+  }
+  return flattened;
+}
+
+export async function writeAntigravityProviderMode(
+  context: ACPProviderModeWriterContext,
+): Promise<ACPProviderModeWriteResult> {
+  if (context.requestedModeId !== ANTIGRAVITY_FULL_ACCESS_MODE_ID) {
+    return { handled: false };
+  }
+  // `agy acp` does not have a native `full-access` session mode; park the ACP
+  // runtime in `default` (instead of `plan` which refuses edits) while Paseo
+  // auto-accepts permission prompts for this mode.
+  await context.connection.setSessionMode({
+    sessionId: context.sessionId,
+    modeId: ANTIGRAVITY_DEFAULT_MODE_ID,
+  });
+  return {
+    handled: true,
+    currentModeId: ANTIGRAVITY_FULL_ACCESS_MODE_ID,
+  };
+}
+
+export function resolveAntigravityConfiguredSelection(
+  context: ACPConfiguredSelectionContext,
+): { model?: string; thinkingOptionId?: string } {
+  if (!context.model) {
+    return { model: context.model, thinkingOptionId: context.thinkingOptionId };
+  }
+  const baseModels = new Set(deriveSelectorOptions(context.configOptions, "model").map((m) => m.id));
+  if (baseModels.has(context.model)) {
+    return { model: context.model, thinkingOptionId: context.thinkingOptionId };
+  }
+  const match = LEGACY_THINKING_SUFFIX_PATTERN.exec(context.model);
+  if (match) {
+    const [, baseModelId, effort] = match;
+    if (baseModelId && baseModels.has(baseModelId)) {
+      return {
+        model: baseModelId,
+        thinkingOptionId: context.thinkingOptionId ?? effort,
+      };
+    }
+  }
+  return { model: context.model, thinkingOptionId: context.thinkingOptionId };
+}
+
+export async function resolveAntigravityCatalogModels({
+  connection,
+  sessionId,
+  models,
+  configOptions,
+  runRequest,
+  transformConfigOptions,
+  logger,
+  provider,
+}: ACPCatalogModelResolverContext): Promise<AgentModelDefinition[]> {
+  if (models.length === 0) {
+    return models;
+  }
+  const modelOption = findSelectConfigOption({ configOptions, category: "model" });
+  if (!modelOption) {
+    return models;
+  }
+
+  const resolved: AgentModelDefinition[] = [];
+  for (const model of models) {
+    try {
+      const response = await runRequest(() =>
+        connection.setSessionConfigOption({
+          sessionId,
+          configId: modelOption.id,
+          value: model.id,
+        }),
+      );
+      const modelConfigOptions = transformConfigOptions(response.configOptions ?? []);
+      const thinkingOptions = deriveSelectorOptions(modelConfigOptions, "thought_level");
+      const aliases =
+        thinkingOptions.length > 0
+          ? thinkingOptions.map((option) => `${model.id}-${option.id}`)
+          : undefined;
+      resolved.push({
+        ...model,
+        aliases,
+        thinkingOptions: thinkingOptions.length > 0 ? thinkingOptions : undefined,
+        defaultThinkingOptionId:
+          thinkingOptions.find((option) => option.isDefault)?.id ?? undefined,
+      });
+    } catch (error) {
+      const errorMessage = toDiagnosticErrorMessage(error);
+      if (model.isDefault) {
+        logger.warn(
+          { modelId: model.id, error: errorMessage },
+          `${provider} catalog probe could not refresh thinking options for current model "${model.id}"; keeping session options`,
+        );
+        const aliases =
+          model.thinkingOptions && model.thinkingOptions.length > 0
+            ? model.thinkingOptions.map((option) => `${model.id}-${option.id}`)
+            : undefined;
+        resolved.push({ ...model, aliases });
+        continue;
+      }
+      logger.warn(
+        { modelId: model.id, error: errorMessage },
+        `${provider} catalog probe could not resolve thinking options for model "${model.id}"; omitting thinking options`,
+      );
+      resolved.push({
+        ...model,
+        thinkingOptions: undefined,
+        defaultThinkingOptionId: undefined,
+      });
+    }
+  }
+  return resolved;
+}
+
+const ANTIGRAVITY_FALLBACK_MODES: AgentMode[] = ANTIGRAVITY_MODES.map(
+  ({ id, label, description, icon, colorTier, isUnattended }) => ({
+    id,
+    label,
+    description,
+    icon,
+    colorTier,
+    isUnattended,
+  }),
+);
+
+export class AntigravityACPAgentClient extends ACPAgentClient {
+  constructor(options: AntigravityACPAgentClientOptions) {
+    super({
+      provider: "antigravity",
+      usageProvider: "antigravity",
+      logger: options.logger,
+      runtimeSettings: options.runtimeSettings,
+      defaultCommand: resolveAntigravityDefaultCommand(options.runtimeSettings),
+      defaultModes: ANTIGRAVITY_FALLBACK_MODES,
+      capabilities: ANTIGRAVITY_CAPABILITIES,
+      clientCapabilities: {
+        elicitation: { form: {} },
+      },
+      sessionMeta: buildAntigravitySessionMeta,
+      sessionResponseTransformer: transformAntigravitySessionResponse,
+      configOptionsTransformer: transformAntigravityConfigOptions,
+      providerModeWriter: writeAntigravityProviderMode,
+      catalogModelResolver: resolveAntigravityCatalogModels,
+      configuredSelectionResolver: resolveAntigravityConfiguredSelection,
+      autoAcceptModeId: ANTIGRAVITY_FULL_ACCESS_MODE_ID,
+      autoAcceptUnderlyingModeId: ANTIGRAVITY_DEFAULT_MODE_ID,
+      waitForInitialCommands: true,
+      catalogCacheKey: "host",
+      supportsAutoAccept: false,
+    });
+  }
+
+  override async isAvailable(): Promise<boolean> {
+    try {
+      const launch = await resolveProviderLaunch({
+        commandConfig: this.runtimeSettings?.command,
+        defaultBinary: "agy",
+      });
+      return (await checkProviderLaunchAvailable(launch)).available;
+    } catch {
+      return false;
+    }
+  }
+
+  async getDiagnostic(): Promise<{ diagnostic: string }> {
+    try {
+      const launch = await resolveProviderLaunch({
+        commandConfig: this.runtimeSettings?.command,
+        defaultBinary: "agy",
+      });
+      const availability = await checkProviderLaunchAvailable(launch);
+      const probeRows = availability.available ? await this.buildACPProbeDiagnosticRows() : [];
+
+      return {
+        diagnostic: formatProviderDiagnostic("Antigravity", [
+          ...(await buildCommandResolutionDiagnosticRows(launch, {
+            knownBinaryNames: ["agy"],
+          })),
+          ...(await buildBinaryDiagnosticRows(launch, availability)),
+          ...probeRows,
+        ]),
+      };
+    } catch (error) {
+      return {
+        diagnostic: formatProviderDiagnosticError("Antigravity", error),
+      };
+    }
+  }
+}
