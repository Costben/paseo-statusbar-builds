@@ -7830,4 +7830,103 @@ describe("ACPAgentSession AskUserQuestion _meta question form", () => {
       terminal: true,
     });
   });
+
+  test("promptTurnTakeoverSteer lets a second prompt take over without premature turn completion", async () => {
+    const logger = createTestLogger();
+    let resolveFirst!: (val: PromptResponse) => void;
+    let resolveSecond!: (val: PromptResponse) => void;
+    const prompt = vi
+      .fn<() => Promise<PromptResponse>>()
+      .mockImplementationOnce(
+        () =>
+          new Promise<PromptResponse>((resolve) => {
+            resolveFirst = resolve;
+          }),
+      )
+      .mockImplementationOnce(
+        () =>
+          new Promise<PromptResponse>((resolve) => {
+            resolveSecond = resolve;
+          }),
+      );
+
+    const onSteered = vi.fn();
+    const session = createSessionWithConfig(
+      { provider: "antigravity" },
+      logger,
+      { promptTurnTakeoverSteer: true },
+      { onForegroundTurnSteered: onSteered },
+    );
+    asInternals<ACPSessionInternals>(session).sessionId = "session-1";
+    asInternals<ACPSessionInternals>(session).connection = {
+      prompt,
+      cancel: vi.fn(async () => {}),
+      signal: new AbortController().signal,
+    };
+
+    const events: AgentStreamEvent[] = [];
+    session.subscribe((e) => events.push(e));
+
+    await session.startTurn("first prompt");
+    const steerResult = await session.steerActiveTurn?.("steer takeover");
+    expect(steerResult).toEqual({ status: "accepted" });
+    expect(onSteered).toHaveBeenCalledTimes(1);
+    expect(prompt).toHaveBeenCalledTimes(2);
+
+    resolveFirst({ stopReason: "end_turn" });
+    await new Promise((r) => setTimeout(r, 20));
+    expect(events.filter((e) => e.type === "turn_completed")).toHaveLength(0);
+
+    resolveSecond({ stopReason: "end_turn" });
+    await new Promise((r) => setTimeout(r, 20));
+    expect(events.filter((e) => e.type === "turn_completed")).toHaveLength(1);
+  });
+
+  test("maybeOpenAutonomousTurn skips events that already carry an explicit turnId or duplicate trailing output", () => {
+    const logger = createTestLogger();
+    const session = createSessionWithConfig({ provider: "kimi" }, logger);
+    const internals = asInternals<
+      ACPSessionInternals & { pushProviderEvent(event: AgentStreamEvent): void }
+    >(session);
+    internals.sessionId = "session-1";
+
+    const events: AgentStreamEvent[] = [];
+    session.subscribe((e) => events.push(e));
+
+    internals.pushProviderEvent({
+      type: "turn_started",
+      provider: "kimi",
+      turnId: "kimi-turn-1",
+    });
+    internals.pushProviderEvent({
+      type: "timeline",
+      provider: "kimi",
+      turnId: "kimi-turn-1",
+      item: { type: "assistant_message", text: "Completed everything cleanly." },
+    });
+    internals.pushProviderEvent({
+      type: "turn_completed",
+      provider: "kimi",
+      turnId: "kimi-turn-1",
+    });
+
+    // An explicit turnId event arriving while idle must NOT wrap another auto-* turn around it.
+    internals.pushProviderEvent({
+      type: "timeline",
+      provider: "kimi",
+      turnId: "kimi-turn-2",
+      item: { type: "assistant_message", text: "Follow-up turn" },
+    });
+    // A duplicate trailing replay without turnId must also be suppressed.
+    internals.pushProviderEvent({
+      type: "timeline",
+      provider: "kimi",
+      item: { type: "assistant_message", text: "Completed everything cleanly." },
+    });
+
+    const autoTurnStarts = events.filter(
+      (e) => e.type === "turn_started" && e.turnId?.startsWith("auto-"),
+    );
+    expect(autoTurnStarts).toHaveLength(0);
+  });
 });
