+/**
+ * Read Paseo's compaction extension notification into a timeline marker.
+ *
+ * `status` decides whether the marker is still open or settled, matching the
+ * `loading` / `completed` pair the app merges into one row. `trigger` and
+ * `preTokens` are optional and only shape the label.
+ */
+function mapCompactionExtension(params: Record<string, unknown>): CompactionTimelineItem | null {
+  const status = params.status;
+  if (status !== "in_progress" && status !== "completed") {
+    return null;
+  }
+  const preTokens = params.preTokens;
+  return {
+    type: "compaction",
+    status: status === "in_progress" ? "loading" : "completed",
+    trigger: params.trigger === "manual" ? "manual" : "auto",
+    ...(typeof preTokens === "number" && preTokens > 0 ? { preTokens } : {}),
+  };
+}
