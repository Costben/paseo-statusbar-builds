+const taskPillStyles = StyleSheet.create((theme) => ({
+  pill: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: 4,
+    minHeight: 24,
+    paddingHorizontal: 8,
+    paddingVertical: 2,
