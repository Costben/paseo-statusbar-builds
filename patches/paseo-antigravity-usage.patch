+        expiry: "2026-11-14T18:32:07.000Z",
+      },
+      id_token_email: "user@example.com",
+      auth_method: "consumer",
+    });
+
+    const decoded = decodeKeyringPayload(raw);
+    expect(decoded).toEqual({
+      accessToken: "ya29.test-token",
+      email: "user@example.com",
+      expiresAtMs: Date.parse("2026-11-14T18:32:07.000Z"),
+      authMethod: "consumer",
