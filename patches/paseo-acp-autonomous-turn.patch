+  /**
+   * dsh 会在内部自己开 turn——子 agent 交回结果、goal 续跑、后台任务回调——这些
+   * turn 不走 ACP 的 prompt 请求，Paseo 收不到 turn_started，会话就一直停在
+   * 「已完成」，可它明明还在推工具调用。
+   *
+   * 只要没有前台 turn、却有内容在推进，就在这里补一个 turn 边界。turn_started
+   * 必须先于 activeForegroundTurnId 落定发出：manager 用
+   * `activeForegroundTurnId === eventTurnId` 判断前台事件，早一步它才会把这一轮
+   * 认成 autonomous 并点亮 running。
+   *
+   * `user_message` 与 `compaction` 不算「内容推进」：前者是用户输入的回显，
+   * 后者是上下文压缩的界面标记，两者都不代表 agent 在干活，凭空开 turn 只会
+   * 让侧栏闪一下运行中。
+   */
+  private maybeOpenAutonomousTurn(event: AgentStreamEvent): void {
+    if (this.closed) {
+      return;
+    }
+    if (this.autonomousTurn) {
+      // 每个事件都重置静默计时，否则阈值就成了「从开局算起的硬上限」。
+      this.armAutonomousIdle();
+      return;
+    }
+    if (this.activeForegroundTurnId) {
+      return;
+    }
+    if (
+      event.type !== "timeline" ||
+      event.item.type === "user_message" ||
+      event.item.type === "compaction"
+    ) {
+      return;
+    }
+    const turnId = `auto-${Date.now().toString(36)}-${this.autonomousOrdinal++}`;
+    this.pushEvent({ type: "turn_started", provider: this.provider, turnId });
+    this.activeForegroundTurnId = turnId;
+    this.autonomousTurn = { id: turnId };
+    this.armAutonomousIdle();
+  }
+
+  /** 静默收尾：没有新事件就认为这一轮结束了。 */
