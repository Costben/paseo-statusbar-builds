index 000000000..ed1765b7c
--- /dev/null
+++ b/packages/app/src/android/rotation-delay.ts
@@ -0,0 +1,32 @@
+import * as FileSystem from "expo-file-system/legacy";
+import { Platform } from "react-native";
+
+/**
+ * Where the Android build reads the auto-rotate switch.
+ *
+ * The rotation controller lives in MainActivity (injected by the build repo's
+ * `with-android-rotation-delay` plugin) because only native code can hold an
+ * orientation. `documentDirectory` is the app's `filesDir`, so the controller
+ * reads the same path the app writes here. No file means enabled, which is what
+ * a fresh install gets.
+ */
+export const ROTATION_DELAY_FILE = "paseo-rotation.json";
+
+/** Last value written, so the many components reading settings write the file once. */
+let lastWritten: boolean | undefined;
+
+export async function syncRotationDelay(autoRotate: boolean): Promise<void> {
+  if (Platform.OS !== "android") return;
+  if (lastWritten === autoRotate) return;
+  const directory = FileSystem.documentDirectory;
+  if (!directory) return;
+  try {
+    await FileSystem.writeAsStringAsync(
+      `${directory}${ROTATION_DELAY_FILE}`,
+      JSON.stringify({ autoRotate }),
+    );
+    lastWritten = autoRotate;
+  } catch (error) {
+    console.warn("[rotation-delay] could not persist the auto-rotate switch", error);
+  }
+}
