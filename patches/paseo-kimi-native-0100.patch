+        contextWindowUsedTokens: this.contextWindowUsedTokens,
+        modelAlias: this.modelAlias,
+        goalInputTokens: this.goalInputTokens,
+        goalCachedInputTokens: this.goalCachedInputTokens,
+        subagents: this.subagents,
+        turnGeneration: this.turnGeneration,
+        settledThroughTurn: this.settledThroughTurn,
