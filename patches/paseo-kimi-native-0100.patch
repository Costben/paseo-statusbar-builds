new file mode 100644
index 0000000..81fc174
--- /dev/null
+++ b/packages/server/src/server/agent/providers/kimi/subagent-log.ts
@@ -0,0 +1,206 @@
+import { stat } from "node:fs/promises";
+import path from "node:path";
+
+import type { Logger } from "pino";
+
+import type { AgentTimelineItem } from "../../agent-sdk-types.js";
+import { asRecord, mergePendingFragment, readLinesFromRange, readString } from "./session-log.js";
+
+/**
+ * Each subagent writes its own wire log next to the main one, in the same
+ * format and at `agents/<subagentId>/wire.jsonl`. The main log only announces
+ * a subagent; its transcript lives here.
+ *
+ * Returns null for an id that could walk out of the session directory, so a
+ * crafted log entry cannot direct a read at an arbitrary file.
+ */
+export function resolveKimiSubagentLogPath(sessionDir: string, subagentId: string): string | null {
+  if (!isSafeSubagentId(subagentId)) {
+    return null;
+  }
+  return path.join(sessionDir, "agents", subagentId, "wire.jsonl");
+}
+
+function isSafeSubagentId(subagentId: string): boolean {
+  return (
+    subagentId.length > 0 &&
+    !subagentId.includes("/") &&
+    !subagentId.includes("\\") &&
+    !subagentId.includes("..")
+  );
+}
+
+export interface KimiSubagentCallRecord {
+  name: string;
+  input: unknown;
+}
+
+/**
+ * Replay raw subagent log lines into timeline items.
+ *
+ * `calls` is the only state, and it outlives one batch: a `tool.result` record
+ * carries neither the tool name nor its arguments, while the client merges a
+ * tool call by spreading the new item over the old one. Re-supplying both from
+ * the recorded call is what keeps a completed call from losing its name.
+ *
+ * Anything unparseable is skipped, because a half-written line must not abort
+ * a replay.
+ */
+export function mapKimiSubagentLogLines(
+  lines: Iterable<string>,
+  calls: Map<string, KimiSubagentCallRecord>,
+): AgentTimelineItem[] {
+  const items: AgentTimelineItem[] = [];
+  for (const raw of lines) {
+    const line = raw.trim();
+    if (line.length === 0) {
+      continue;
+    }
+    let parsed: unknown;
+    try {
+      parsed = JSON.parse(line);
+    } catch {
+      continue;
+    }
+    const record = asRecord(parsed);
+    if (record === null || record.type !== "context.append_loop_event") {
+      continue;
+    }
+    const event = asRecord(record.event);
+    if (event === null) {
+      continue;
+    }
+    mapKimiLoopEvent(event, calls, items);
+  }
+  return items;
+}
+
+function mapKimiLoopEvent(
+  event: Record<string, unknown>,
+  calls: Map<string, KimiSubagentCallRecord>,
+  items: AgentTimelineItem[],
+): void {
+  switch (event.type) {
+    case "content.part": {
+      const part = asRecord(event.part);
+      if (part === null) {
+        return;
+      }
+      // A thinking part carries its text under `think`, a spoken one under
+      // `text`. Reading the wrong key drops every reasoning block silently.
+      const text = readString(part.type === "think" ? part.think : part.text);
+      if (text === undefined || text.length === 0) {
+        return;
+      }
+      if (part.type === "text") {
+        items.push({ type: "assistant_message", text });
+      } else if (part.type === "think") {
+        items.push({ type: "reasoning", text });
+      }
+      return;
+    }
+    case "tool.call": {
+      const callId = readString(event.toolCallId);
+      if (callId === undefined) {
+        return;
+      }
+      const name = readString(event.name) ?? "tool";
+      const input = event.args ?? null;
+      calls.set(callId, { name, input });
+      items.push({
+        type: "tool_call",
+        callId,
+        name,
+        detail: { type: "unknown", input, output: null },
+        status: "running",
+        error: null,
+      });
+      return;
+    }
+    case "tool.result": {
+      const callId = readString(event.toolCallId);
+      if (callId === undefined) {
+        return;
+      }
+      const call = calls.get(callId);
+      const result = asRecord(event.result);
+      items.push({
+        type: "tool_call",
+        callId,
+        name: call?.name ?? "tool",
+        detail: {
+          type: "unknown",
+          input: call?.input ?? null,
+          output: result?.output ?? null,
+        },
+        status: "completed",
+        error: null,
+      });
+      return;
+    }
+    default:
+      return;
+  }
+}
+
+export interface KimiSubagentLogTailerOptions {
+  subagentId: string;
+  /** The `<sessionId>` directory, parent of the per-agent `agents/` directory. */
+  sessionDir: string;
+  logger: Logger;
+}
+
+/**
+ * Tails one subagent's wire log.
+ *
+ * Reads incrementally by byte offset, but the first read starts at byte 0, so a
+ * subagent that finished before the tailer attached is replayed in full instead
+ * of showing up empty.
+ */
+export class KimiSubagentLogTailer {
+  private readonly subagentId: string;
+  private readonly sessionDir: string;
+  private readonly logger: Logger;
+  private readonly calls = new Map<string, KimiSubagentCallRecord>();
+  private offset = 0;
+  /** Bytes of an unterminated trailing line, held until the next tick completes it. */
+  private pending = "";
+
+  constructor(options: KimiSubagentLogTailerOptions) {
+    this.subagentId = options.subagentId;
+    this.sessionDir = options.sessionDir;
+    this.logger = options.logger;
+  }
+
+  /** Returns the items produced by bytes appended since the previous call. */
+  async readAppended(): Promise<AgentTimelineItem[]> {
+    const filePath = resolveKimiSubagentLogPath(this.sessionDir, this.subagentId);
+    if (filePath === null) {
+      return [];
+    }
+    let size: number;
+    try {
+      size = (await stat(filePath)).size;
+    } catch {
+      // The log may simply not exist yet; the caller re-checks on its next tick.
+      return [];
+    }
+    if (size < this.offset) {
+      // Truncated or replaced: rebuild from the beginning.
+      this.logger.debug(
+        { subagentId: this.subagentId },
+        "Kimi subagent log shrank, replaying from the start",
+      );
+      this.offset = 0;
+      this.pending = "";
+    }
+    if (size === this.offset) {
+      return [];
+    }
+    const { lines, fragment } = await readLinesFromRange(filePath, this.offset, size);
+    this.offset = size;
+    const merged = mergePendingFragment(this.pending, lines);
+    this.pending = fragment;
+    return mapKimiSubagentLogLines(merged, this.calls);
+  }
+}
