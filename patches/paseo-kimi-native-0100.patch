+   * side of a goal itself (`goal.update.tokensUsed`) but never the input side,
+   * so this is summed here from the per-step records while the goal runs.
+   */
+  goalInputTokens: number | null;
+  /** The part of `goalInputTokens` that came from a cache read. */
+  goalCachedInputTokens: number | null;
+  /** Subagents of the session, in spawn order. */
+  subagents: KimiSubagentRecord[];
+  /** Count of `agent.turn.started` records seen. */
+  turnGeneration: number;
+  /** Highest turn known to be over. Starts at -1 so no boundary is assumed before one is seen. */
+  settledThroughTurn: number;
+}
+
+export const EMPTY_KIMI_SESSION_LOG_STATE: KimiSessionLogState = Object.freeze({
+  goal: null,
+  contextWindowUsedTokens: null,
+  modelAlias: null,
+  goalInputTokens: null,
+  goalCachedInputTokens: null,
+  subagents: [],
+  turnGeneration: 0,
+  settledThroughTurn: -1,
+});
+
+/**
+ * Replay raw log lines onto a previous state. Pure and side-effect free so the
+ * derivation rules are testable without a filesystem.
+ *
+ * Records the daemon relies on:
+ * - `goal.create` sets the goal to `active` with zeroed counters and stamps `startedAt`.
+ * - `goal.update` carries either `tokensUsed` (one per goal turn) or `status`; a
+ *   terminal status stamps `endedAt`.
+ * - `goal.clear` retires the goal without discarding it. Kimi emits it right
+ *   after the goal ends, so dropping the goal here would erase the only record
+ *   of what the session was asked to do, along with the final counters.
+ * - `profile.bind` and `llm.request` carry the bound model alias; the later
+ *   record wins, because the alias changes when the user switches model.
+ * - `usage.record` and `context.append_loop_event` of type `step.end` carry the
+ *   context size of one step. `token_counting.turn_recorded` is deliberately not
+ *   read: its `tokens` measures something else and lands well below the real
+ *   context size.
+ * - The input side of those same step records is summed while the goal is
+ *   active, because Kimi reports nothing else about a goal's input tokens. Only
+ *   `usage.record` is read for it: the `step.end` copy of a step is byte-identical
+ *   in `usage`, so reading both would double every step. Records whose
+ *   `usageScope` is `session` are cumulative counters, not one step's usage, and
+ *   they land after the goal ended anyway; none of them are summed.
+ * - `subagent.spawned`, `subagent.started`, `subagent.completed` and
+ *   `subagent.cancelled` maintain the subagent registry. Only the lifecycle is
+ *   read here; each subagent's transcript lives in its own log.
+ * - `agent.turn.started` and `agent.turn.ended` move the turn watermark that
+ *   closes out subagents whose turn is over.
+ *
+ * Anything unparseable is skipped; a half-written line must not abort a replay.
+ */
+export function parseKimiSessionLogLines(
+  lines: Iterable<string>,
+  previous: KimiSessionLogState,
+): KimiSessionLogState {
+  let goal = previous.goal;
+  let contextWindowUsedTokens = previous.contextWindowUsedTokens;
+  let modelAlias = previous.modelAlias;
+  let goalInputTokens = previous.goalInputTokens;
+  let goalCachedInputTokens = previous.goalCachedInputTokens;
+  let turnGeneration = previous.turnGeneration;
+  let settledThroughTurn = previous.settledThroughTurn;
+  // Keyed by id, so a lifecycle record updates its entry in place and the
+  // iteration order stays the spawn order.
+  const subagents = new Map<string, KimiSubagentRecord>();
+  for (const subagent of previous.subagents) {
+    subagents.set(subagent.id, subagent);
+  }
+
+  for (const raw of lines) {
+    const line = raw.trim();
+    if (line.length === 0) {
+      continue;
+    }
+    const entry = parseKimiLogLine(line);
+    if (entry === null) {
+      continue;
+    }
+    switch (entry.type) {
+      case "goal.create":
+        goal = createGoalFromRecord(entry);
+        // A new goal starts its own input tally; the previous goal's total is
+        // already on the goal the client is showing.
+        goalInputTokens = 0;
+        goalCachedInputTokens = 0;
+        break;
+      case "goal.update":
+        goal = applyGoalUpdate(goal, entry);
+        break;
+      case "goal.clear":
+        goal = clearGoal(goal, readNumber(entry.time));
+        break;
+      case "profile.bind":
+      case "llm.request": {
