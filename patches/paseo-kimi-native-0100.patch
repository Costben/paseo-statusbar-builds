+        break;
+      case "subagent.cancelled":
+        applySubagentTerminal(subagents, entry, "canceled", turnGeneration);
+        break;
+      default:
+        contextWindowUsedTokens = nextContextUsage(entry, contextWindowUsedTokens);
+        // Only a running goal tallies input: once it settles the number is the
+        // one the goal finished with, and later steps belong to whatever the
+        // session does next rather than to this goal.
+        if (goal !== null && isAgentGoalLive(goal)) {
+          const stepInput = stepInputUsage(entry);
+          if (stepInput !== null) {
+            goalInputTokens = (goalInputTokens ?? 0) + stepInput.used;
+            goalCachedInputTokens = (goalCachedInputTokens ?? 0) + stepInput.cached;
+          }
+        }
+        break;
+    }
+  }
+
+  return {
+    goal,
+    contextWindowUsedTokens,
+    modelAlias,
+    goalInputTokens,
+    goalCachedInputTokens,
+    subagents: [...subagents.values()],
+    turnGeneration,
+    settledThroughTurn,
+  };
+}
+
+/**
+ * Parse one log line into a record, or null when it is blank, truncated, or not
+ * an object. A half-written line must not abort a replay.
+ */
+function parseKimiLogLine(line: string): Record<string, unknown> | null {
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(line);
+  } catch {
+    return null;
+  }
+  return asRecord(parsed);
+}
+
+function applySubagentSpawn(
+  subagents: Map<string, KimiSubagentRecord>,
+  entry: Record<string, unknown>,
+  turn: number,
+): void {
+  const id = readString(entry.subagentId);
+  if (id === undefined || id.length === 0) {
+    return;
+  }
+  const previous = subagents.get(id);
+  const toolCallId = readString(entry.parentToolCallId);
+  // Kimi recycles `agent-N` ids, so a spawn that names a different `Agent` tool
+  // call is a new subagent that must start fresh: inheriting the previous
+  // incarnation's status would report a live subagent as complete. Its panel
+  // still shows both runs, because Kimi appends both to the one log for this id
+  // and nothing on those records separates them.
+  const recycled =
+    previous !== undefined && toolCallId !== undefined && previous.toolCallId !== toolCallId;
+  const existing = recycled ? undefined : previous;
+  const time = readNumber(entry.time) ?? previous?.spawnedAt ?? 0;
+  subagents.set(
+    id,
+    mergeSubagentRecord(id, existing, {
+      name: readString(entry.subagentName),
+      description: readString(entry.description),
+      toolCallId,
+      updatedAt: time,
+      turn,
+      runInBackground: readBoolean(entry.runInBackground),
+    }),
+  );
+}
+
+function applySubagentStarted(
+  subagents: Map<string, KimiSubagentRecord>,
+  entry: Record<string, unknown>,
+  turn: number,
+): void {
+  const id = readString(entry.subagentId);
+  if (id === undefined || id.length === 0) {
+    return;
+  }
+  const existing = subagents.get(id);
+  const time = readNumber(entry.time) ?? existing?.spawnedAt ?? 0;
+  subagents.set(
+    id,
+    mergeSubagentRecord(id, existing, { updatedAt: time, turn: existing?.turn ?? turn }),
+  );
+}
+
+function applySubagentTerminal(
+  subagents: Map<string, KimiSubagentRecord>,
+  entry: Record<string, unknown>,
+  status: "completed" | "canceled",
+  turn: number,
+): void {
+  const id = readString(entry.subagentId);
+  if (id === undefined || id.length === 0) {
+    return;
+  }
+  // A completion always creates the record: its upsert is the only signal the
+  // client ever gets that this subagent existed.
+  const existing = subagents.get(id);
+  const time = readNumber(entry.time) ?? existing?.updatedAt ?? 0;
+  subagents.set(
+    id,
+    mergeSubagentRecord(id, existing, {
+      status,
+      updatedAt: time,
+      resultSummary: readString(entry.resultSummary),
+      turn: existing?.turn ?? turn,
+    }),
+  );
+}
+
+/** Fields a lifecycle record changes. Anything absent keeps the previous value. */
+interface KimiSubagentPatch {
+  name?: string;
+  description?: string;
+  toolCallId?: string;
+  status?: KimiSubagentStatus;
+  updatedAt: number;
+  resultSummary?: string;
+  turn: number;
+  runInBackground?: boolean;
+}
+
+/**
+ * Build the next record from a partial update. A lifecycle record only carries
+ * the fields that changed, so an absent one keeps whatever the spawn announced.
+ */
+function mergeSubagentRecord(
+  id: string,
+  existing: KimiSubagentRecord | undefined,
+  patch: KimiSubagentPatch,
+): KimiSubagentRecord {
+  return {
+    id,
+    name: stickyField(patch.name, existing?.name),
+    description: stickyField(patch.description, existing?.description),
+    toolCallId: stickyField(patch.toolCallId, existing?.toolCallId),
+    // A repeated spawn must not resurrect a subagent that already finished.
+    status: patch.status ?? existing?.status ?? "running",
+    spawnedAt: existing?.spawnedAt ?? patch.updatedAt,
+    updatedAt: patch.updatedAt,
+    resultSummary: stickyField(patch.resultSummary, existing?.resultSummary),
+    turn: patch.turn,
+    runInBackground: stickyField(patch.runInBackground, existing?.runInBackground),
+  };
+}
+
+/** An absent value keeps the stored one; a present value replaces it. */
+function stickyField<T>(next: T | undefined, previous: T | null | undefined): T | null {
+  return next ?? previous ?? null;
+}
+
+/**
+ * Close out the subagents of turns that are already over.
+ *
+ * A foreground subagent blocks the turn that spawned it, so it cannot still be
+ * alive once that turn ends. Kimi writes no terminal record when the user
+ * interrupts an `Agent` call and sends a new prompt, and it has no heartbeat to
+ * fall back on, so the turn boundary is the only evidence that the subagent is
+ * gone. Without this, an abandoned subagent is reported as running forever.
+ *
+ * `canceled` rather than a new status because Kimi already uses that word for
+ * its own `subagent.cancelled`, and the client renders it as an ordinary, done
+ * row instead of claiming attention.
+ */
+function demoteSettledSubagents(
+  subagents: Map<string, KimiSubagentRecord>,
+  settledThroughTurn: number,
+): void {
+  for (const [id, subagent] of subagents) {
+    if (subagent.status !== "running" || subagent.runInBackground === true) {
+      continue;
+    }
+    if (subagent.turn > settledThroughTurn) {
+      continue;
+    }
+    subagents.set(id, { ...subagent, status: "canceled" });
+  }
+}
+
+function readBoolean(value: unknown): boolean | undefined {
+  return typeof value === "boolean" ? value : undefined;
+}
+
+/**
+ * What one tick's read consumed, for the tick's own telemetry and for choosing
+ * the next cadence.
