+function createTailerHome(): { subagentId: string; sessionDir: string; file: string } {
+  const sessionDir = mkdtempSync(path.join(tmpdir(), "kimi-subagent-log-"));
+  const file = path.join(sessionDir, "agents", SUBAGENT_ID, "wire.jsonl");
+  mkdirSync(path.dirname(file), { recursive: true });
