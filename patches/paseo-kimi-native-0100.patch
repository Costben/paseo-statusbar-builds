+  pollIntervalMs?: number;
+  /** Cadence used right after the log grew. Defaults to 1000ms. */
+  activeIntervalMs?: number;
+  onGoal?: (goal: AgentGoal | null) => void;
+  onUsage?: (usage: AgentUsage) => void;
+  onSubagent?: (event: ProviderSubagentInputEvent) => void;
