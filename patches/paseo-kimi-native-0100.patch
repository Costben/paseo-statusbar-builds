+describe("ACP provider hook prompt transform", () => {
+  function createHookTestSession(providerHooks: ACPProviderHooks) {
+    const events: AgentStreamEvent[] = [];
+    const prompt = vi.fn(async (): Promise<PromptResponse> => ({ stopReason: "end_turn" }));
+    let settleTurn!: () => void;
+    const settled = new Promise<void>((resolve) => {
+      settleTurn = resolve;
+    });
+
+    const session = createSessionWithConfig({}, createTestLogger(), {}, providerHooks);
+    asInternals<ACPSessionInternals>(session).sessionId = "session-1";
+    asInternals<ACPSessionInternals>(session).connection = { prompt };
+    session.subscribe((event) => {
+      events.push(event);
+      if (
+        event.type === "turn_completed" ||
+        event.type === "turn_failed" ||
+        event.type === "turn_canceled"
+      ) {
+        settleTurn();
+      }
+    });
+
+    return { session, events, prompt, settled };
+  }
+
+  function submittedUserMessages(events: AgentStreamEvent[]): AgentStreamEvent[] {
+    return events.filter(
+      (event) => event.type === "timeline" && event.item.type === "user_message",
+    );
+  }
+
+  test("rewrites the prompt sent to the agent and the submitted user message", async () => {
+    const seen: AgentPromptInput[] = [];
+    const { session, events, prompt, settled } = createHookTestSession({
+      transformPrompt: (outgoing) => {
+        seen.push(outgoing);
+        return "Write the runbook.";
+      },
+    });
+
+    const { turnId } = await session.startTurn("/goal write the runbook", {
+      clientMessageId: "msg-client-1",
+    });
+
+    expect(seen).toEqual(["/goal write the runbook"]);
+    expect(prompt).toHaveBeenCalledWith({
+      sessionId: "session-1",
+      messageId: "msg-client-1",
+      prompt: [{ type: "text", text: "Write the runbook." }],
+    });
+    expect(submittedUserMessages(events)).toEqual([
+      {
+        type: "timeline",
+        provider: "claude-acp",
+        turnId,
+        item: {
+          type: "user_message",
+          text: "Write the runbook.",
+          messageId: "msg-client-1",
+          clientMessageId: "msg-client-1",
+        },
+      },
+    ]);
+
+    await settled;
+  });
+
+  test("a Kimi /goal command reaches the agent as a rewritten prompt", async () => {
+    const prompt = vi.fn(async (): Promise<PromptResponse> => ({ stopReason: "end_turn" }));
+    const session = createSessionWithConfig(
+      { provider: "kimi-acp" },
+      createTestLogger(),
+      {},
+      createKimiProviderHooks(),
+    );
+    asInternals<ACPSessionInternals>(session).sessionId = "session_goal-test";
+    asInternals<ACPSessionInternals>(session).connection = { prompt };
+
+    await session.startTurn("/goal write the runbook");
+
+    const sent = prompt.mock.calls[0]?.[0] as { prompt: Array<{ text: string }> };
+    expect(sent.prompt[0]?.text).not.toBe("/goal write the runbook");
+    expect(sent.prompt[0]?.text).toContain("write the runbook");
+  });
+
+  test("returning null leaves the prompt untouched", async () => {
+    const { session, events, prompt, settled } = createHookTestSession({
+      transformPrompt: () => null,
+    });
+
+    await session.startTurn("hello", { clientMessageId: "msg-client-1" });
+
+    expect(prompt).toHaveBeenCalledWith({
+      sessionId: "session-1",
+      messageId: "msg-client-1",
+      prompt: [{ type: "text", text: "hello" }],
+    });
+    expect(submittedUserMessages(events)).toEqual([
+      expect.objectContaining({
+        item: expect.objectContaining({ type: "user_message", text: "hello" }),
+      }),
+    ]);
+
+    await settled;
+  });
+
+  test("throwing falls back to the original prompt and does not fail the turn", async () => {
+    const { session, events, prompt, settled } = createHookTestSession({
+      transformPrompt: () => {
+        throw new Error("transformPrompt exploded");
+      },
+    });
+
+    const { turnId } = await session.startTurn("hello", { clientMessageId: "msg-client-1" });
+
+    expect(prompt).toHaveBeenCalledWith({
+      sessionId: "session-1",
+      messageId: "msg-client-1",
+      prompt: [{ type: "text", text: "hello" }],
+    });
+
+    await settled;
+
+    expect(events).toContainEqual(expect.objectContaining({ type: "turn_completed", turnId }));
+    expect(events.some((event) => event.type === "turn_failed")).toBe(false);
+  });
+});
