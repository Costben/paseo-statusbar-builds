+function writeKimiConfig(home: string, text: string): string {
+  const configPath = path.join(home, "config.toml");
+  writeFileSync(configPath, text);
+  return configPath;
+}
+
+function setConfigMtime(configPath: string, mtime: Date): void {
+  utimesSync(configPath, mtime, mtime);
+}
