+interface TickRead {
+  /** Bytes consumed from the log this tick. */
+  bytes: number;
+  /** Lines handed to the parser, the joined pending fragment included. */
+  lines: number;
+  /** Bytes left unread when the budget ran out; the next tick picks them up. */
+  backlogBytes: number;
