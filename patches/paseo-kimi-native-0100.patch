+
+function tokensUpdateLine(tokensUsed: number, time = 1790486855291): string {
+  return JSON.stringify({ type: "goal.update", agentId: "main", tokensUsed, time });
+}
+
+function statusUpdateLine(status: string, time = 1790486861722): string {
+  return JSON.stringify({
+    type: "goal.update",
+    agentId: "main",
+    status,
+    wallClockMs: 9004,
+    actor: "model",
+    time,
+  });
+}
+
+function clearLine(time = 1790486861722): string {
+  return JSON.stringify({ type: "goal.clear", agentId: "main", time });
+}
+
+function turnRecordedLine(tokens: number, turnId = 1): string {
+  return JSON.stringify({
+    type: "token_counting.turn_recorded",
