diff --git a/packages/app/src/composer/goal-pill.browser.test.tsx b/packages/app/src/composer/goal-pill.browser.test.tsx
new file mode 100644
index 000000000..2272776c4
--- /dev/null
+++ b/packages/app/src/composer/goal-pill.browser.test.tsx
@@ -0,0 +1,155 @@
+import React, { act, type ReactNode } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { AgentGoalPayload } from "@getpaseo/protocol/messages";
+import { GoalPill } from "./goal-pill";
+
+// App sources compile against the classic JSX runtime, which expects React on the global.
+beforeEach(() => vi.stubGlobal("React", React));
+
+/**
+ * The real menu engine in a real browser: the pill only becomes a trigger there, and the panel is
+ * a portal, so a jsdom run would prove neither.
+ */
+
+const PANEL = "composer-goal-pill-panel";
+const STARTED_AT = Date.now() - 3_600_000;
+const ENDED_AT = STARTED_AT + 900_000;
+
+const GOAL: AgentGoalPayload = {
+  goalId: "goal-1",
+  objective: "在当前目录创建 goal-ok.txt 并写入 hello",
+  completionCriterion: "goal-ok.txt 存在，且内容为 hello",
+  status: "active",
+  turnsUsed: 7,
+  tokensUsed: 136_400,
+  inputTokens: 6_398_865,
+  startedAt: STARTED_AT,
+  updatedAt: STARTED_AT + 60_000,
+};
+
+/** A goal whose log carried cache reads, which the input row has to name. */
+const CACHED_GOAL: AgentGoalPayload = {
+  ...GOAL,
+  inputTokens: 1_203_194,
+  cachedInputTokens: 1_108_328,
+};
+/** A goal whose log carried no input measurement at all. */
+const OUTPUT_ONLY_GOAL: AgentGoalPayload = { ...GOAL, inputTokens: undefined };
+
+const CLEARED_GOAL: AgentGoalPayload = { ...GOAL, status: "cleared", endedAt: ENDED_AT };
+/** A goal whose create record carried no `time`, which the panel has to render without a start. */
+const UNSTARTED_GOAL: AgentGoalPayload = { ...GOAL, startedAt: undefined };
+
+interface Mounted {
+  root: Root;
+  container: HTMLDivElement;
+}
+
+const mounted: Mounted[] = [];
+
+function mount(node: ReactNode): void {
+  const container = document.createElement("div");
+  document.body.appendChild(container);
+  const root = createRoot(container);
+  act(() => root.render(node));
+  mounted.push({ root, container });
+}
+
+afterEach(() => {
+  for (const entry of mounted.splice(0)) {
+    act(() => entry.root.unmount());
+    entry.container.remove();
+  }
+});
+
+function element(testID: string): HTMLElement | null {
+  const found = document.querySelector(`[data-testid="${testID}"]`);
+  return found instanceof HTMLElement ? found : null;
+}
+
+function pill(): HTMLElement {
+  const trigger = element("composer-goal-pill");
+  if (trigger === null) {
+    throw new Error("goal pill did not render");
+  }
+  return trigger;
+}
+
+function openPanel(): void {
+  act(() => {
+    pill().click();
+  });
+}
+
+function fieldText(name: string): string | null {
+  return element(`${PANEL}-${name}`)?.textContent ?? null;
+}
+
+describe("goal pill detail panel", () => {
+  it("opens the details the pill has no room for", () => {
+    mount(<GoalPill goal={GOAL} />);
+
+    expect(pill().textContent).toContain("目标进行中");
+    expect(pill().textContent).toContain("· 7 回合 · 136K · 入 6.4M");
+    expect(pill().getAttribute("aria-expanded")).toBe("false");
+    expect(element(PANEL)).toBeNull();
+
+    openPanel();
+
+    expect(pill().getAttribute("aria-expanded")).toBe("true");
+    expect(fieldText("objective")).toContain("goal-ok.txt");
+    expect(fieldText("criterion")).toContain("内容为 hello");
+    expect(fieldText("turns")).toContain("7 回合");
+    expect(fieldText("turns")).toContain("Paseo 按会话日志统计");
+    expect(fieldText("tokens")).toContain("136K tokens");
+    expect(fieldText("tokens")).toContain("136,400");
+    expect(fieldText("input-tokens")).toContain("6.4M tokens");
+    expect(fieldText("input-tokens")).toContain("6,398,865");
+    expect(fieldText("elapsed")).toBe("已跑1h");
+    expect(fieldText("started")).not.toBeNull();
+    expect(element(`${PANEL}-ended`)).toBeNull();
+  });
+
+  it("names the cache-read part of the input when the log reported one", () => {
+    mount(<GoalPill goal={CACHED_GOAL} />);
+    openPanel();
+
+    expect(fieldText("input-tokens")).toContain("1.2M tokens");
+    expect(fieldText("input-tokens")).toContain("其中缓存 1,108,328");
+  });
+
+  it("drops the input row when the log carried no input measurement", () => {
+    mount(<GoalPill goal={OUTPUT_ONLY_GOAL} />);
+
+    expect(pill().textContent).not.toContain("入 ");
+    openPanel();
+
+    expect(element(`${PANEL}-input-tokens`)).toBeNull();
+    expect(fieldText("tokens")).toContain("136K tokens");
+  });
+
+  it("keeps a finished goal readable after it is cleared", () => {
+    mount(<GoalPill goal={CLEARED_GOAL} />);
+
+    expect(pill().textContent).toContain("目标已清除");
+    openPanel();
+
+    expect(fieldText("elapsed")).toBe("已跑15m");
+    expect(fieldText("ended")).not.toBeNull();
+  });
+
+  it("drops the elapsed rows when the log never recorded a start", () => {
+    mount(<GoalPill goal={UNSTARTED_GOAL} />);
+    openPanel();
+
+    expect(element(`${PANEL}-started`)).toBeNull();
+    expect(element(`${PANEL}-elapsed`)).toBeNull();
+  });
+
+  it("renders nothing without a goal", () => {
+    mount(<GoalPill goal={null} />);
+
+    expect(element("composer-goal-pill")).toBeNull();
+  });
+});
diff --git a/packages/app/src/composer/goal-pill.test.ts b/packages/app/src/composer/goal-pill.test.ts
new file mode 100644
index 000000000..a3832bc4a
--- /dev/null
