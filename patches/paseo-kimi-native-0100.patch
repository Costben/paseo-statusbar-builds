+
+export type KimiSubagentStatus = "running" | "completed" | "canceled";
+
+/** Lifecycle of one subagent, as announced by the main log. */
+export interface KimiSubagentRecord {
+  id: string;
+  name: string | null;
+  description: string | null;
+  toolCallId: string | null;
+  status: KimiSubagentStatus;
+  spawnedAt: number;
+  updatedAt: number;
+  resultSummary: string | null;
