+} from "../../agent-sdk-types.js";
+import type { ProviderSubagentInputEvent } from "../../provider-subagents/store.js";
+import { KimiSubagentLogTailer } from "./subagent-log.js";
+
+/**
+ * Kimi Code writes one JSON object per line to
+ * `<kimiHome>/sessions/<wd-slug>/<sessionId>/agents/main/wire.jsonl`.
+ *
+ * That file is the only cross-process source of truth for a session's goal and
+ * context usage: the `kimi web` HTTP server materializes a *separate, empty*
+ * runtime for a session another process owns, so it reports zeros and accepts
+ * goals the talking agent never sees. The owning process appends to this log,
+ * and both processes share it on disk.
+ *
+ * The ACP session id is the `<sessionId>` directory name, so the log path is
+ * derivable from the id the daemon already holds.
+ */
+
+/**
+ * Polling cadences. The two fastest were slowed down after a hang where the
+ * daemon stopped answering on its port while the process stayed alive: each poll
+ * read and parsed everything appended since the last one, so the per-tick cost
+ * was unbounded and the main thread could be held for as long as the log had
+ * grown. The reads are now budgeted and the parse yields (see below); a slower
+ * cadence keeps the number of those bounded ticks down.
+ */
+const ACTIVE_POLL_INTERVAL_MS = 1_000;
+const LIVE_POLL_INTERVAL_MS = 2_000;
+const IDLE_POLL_INTERVAL_MS = 10_000;
+const SETTLE_POLL_INTERVAL_MS = 1_000;
+/** Unchanged goals are re-announced once per bucket so a late subscriber still sees them. */
+const GOAL_REANNOUNCE_BUCKET_MS = 30_000;
+const DEFAULT_KIMI_HOME = "~/.kimi-code";
+const KIMI_CONFIG_FILENAME = "config.toml";
+/** Reading every subagent log from byte 0 is unbounded; tail only the newest few. */
+const TAILED_SUBAGENT_LIMIT = 8;
+/**
+ * Bytes one tick may read, so no single poll can monopolize the event loop.
+ * Measured on a real 82 MB wire log, streaming and parsing 512 KiB takes ~2.6ms,
+ * while a live session appends a few kilobytes per step — so this is orders of
+ * magnitude more than one cadence needs and the budget only binds while catching
+ * up on a long pre-existing log. The upper end of that range is the right one
+ * because the budget also sets catch-up throughput (budget per active cadence),
+ * and a cold replay starts at byte 0.
+ */
+export const MAX_BYTES_PER_TICK = 512 * 1024;
+/**
+ * Lines handed to the parser between two yields. Parsing is the expensive half
+ * of a tick, and this caps how long it can run before the loop gets a turn.
+ */
+export const PARSE_LINES_PER_CHUNK = 1_000;
+/**
+ * How far past the budget a read may look for a line terminator before giving up
+ * and cutting where it is. Real records run long — the longest line measured in
+ * a live wire log was 2.03 MB — so the window has to clear them comfortably, and
+ * the scan only runs at all while a log is being read in pieces.
+ */
+const ALIGN_SCAN_MAX_BYTES = 4 * 1024 * 1024;
+/** Slab the alignment scan reads at a time, so a miss does not allocate the window. */
+const ALIGN_SCAN_SLAB_BYTES = 4 * 1024;
+/**
+ * Cap on the unterminated trailing line held between reads. It has to clear the
+ * longest record a read can leave open, which is one budget plus one alignment
+ * window; past that the line is pathological, and holding it would make every
+ * later read copy it whole. Counted in string units, which is what the copy
+ * costs.
+ */
+const MAX_PENDING_FRAGMENT_CHARS = 8 * 1024 * 1024;
+/** Wall-clock budget a single tick may take before it is worth reporting. */
+const SLOW_TICK_WARN_MS = 250;
+
+/**
+ * Locate the wire log for a Kimi session. Returns null when the file does not
+ * exist yet (the session may not have produced output) or the home directory is
+ * unreadable; callers retry on their next poll.
+ */
+export function resolveKimiWireLogPath(
+  kimiSessionId: string,
+  options: { kimiHome?: string } = {},
+): string | null {
+  if (kimiSessionId.length === 0) {
+    return null;
+  }
+  const sessionsDir = path.join(resolveKimiHome(options.kimiHome), "sessions");
+  let entries: string[];
+  try {
+    entries = readdirSync(sessionsDir);
+  } catch {
+    return null;
+  }
+  for (const entry of entries) {
+    const candidate = path.join(sessionsDir, entry, kimiSessionId, "agents", "main", "wire.jsonl");
+    try {
+      if (existsSync(candidate)) {
+        return candidate;
+      }
+    } catch {
+      // Keep scanning; one unreadable slug must not hide the real one.
+    }
+  }
+  return null;
