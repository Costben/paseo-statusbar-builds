+
+import {
+  isAgentGoalLive,
+  type AgentGoal,
+  type AgentGoalStatus,
+  type AgentTimelineItem,
+  type AgentUsage,
+} from "../../agent-sdk-types.js";
+import type { ProviderSubagentInputEvent } from "../../provider-subagents/store.js";
+import { KimiSubagentLogTailer } from "./subagent-log.js";
+
+/**
+ * Kimi Code writes one JSON object per line to
+ * `<kimiHome>/sessions/<wd-slug>/<sessionId>/agents/main/wire.jsonl`.
+ *
+ * That file is the only cross-process source of truth for a session's goal and
+ * context usage: the `kimi web` HTTP server materializes a *separate, empty*
+ * runtime for a session another process owns, so it reports zeros and accepts
+ * goals the talking agent never sees. The owning process appends to this log,
+ * and both processes share it on disk.
+ *
+ * The ACP session id is the `<sessionId>` directory name, so the log path is
+ * derivable from the id the daemon already holds.
+ */
+
+const ACTIVE_POLL_INTERVAL_MS = 500;
+const LIVE_POLL_INTERVAL_MS = 2_000;
+const IDLE_POLL_INTERVAL_MS = 10_000;
+const SETTLE_POLL_INTERVAL_MS = 250;
+/** Unchanged goals are re-announced once per bucket so a late subscriber still sees them. */
+const GOAL_REANNOUNCE_BUCKET_MS = 30_000;
+const DEFAULT_KIMI_HOME = "~/.kimi-code";
+const KIMI_CONFIG_FILENAME = "config.toml";
+/** Reading every subagent log from byte 0 is unbounded; tail only the newest few. */
+const TAILED_SUBAGENT_LIMIT = 8;
+
+/**
+ * Locate the wire log for a Kimi session. Returns null when the file does not
+ * exist yet (the session may not have produced output) or the home directory is
+ * unreadable; callers retry on their next poll.
+ */
+export function resolveKimiWireLogPath(
+  kimiSessionId: string,
+  options: { kimiHome?: string } = {},
+): string | null {
+  if (kimiSessionId.length === 0) {
+    return null;
+  }
+  const sessionsDir = path.join(resolveKimiHome(options.kimiHome), "sessions");
+  let entries: string[];
+  try {
+    entries = readdirSync(sessionsDir);
+  } catch {
+    return null;
+  }
+  for (const entry of entries) {
+    const candidate = path.join(sessionsDir, entry, kimiSessionId, "agents", "main", "wire.jsonl");
+    try {
+      if (existsSync(candidate)) {
+        return candidate;
+      }
+    } catch {
+      // Keep scanning; one unreadable slug must not hide the real one.
+    }
+  }
+  return null;
+}
+
+export type KimiSubagentStatus = "running" | "completed" | "canceled";
+
+/** Lifecycle of one subagent, as announced by the main log. */
+export interface KimiSubagentRecord {
+  id: string;
+  name: string | null;
+  description: string | null;
+  toolCallId: string | null;
+  status: KimiSubagentStatus;
+  spawnedAt: number;
+  updatedAt: number;
+  resultSummary: string | null;
+  /** Turn generation that spawned it; the boundary of that turn bounds its life. */
+  turn: number;
+  /** From the spawn record. Null when the log did not say, which is treated as foreground. */
+  runInBackground: boolean | null;
+}
+
+/** Derived state of a session log after replaying a batch of lines. */
+export interface KimiSessionLogState {
+  goal: AgentGoal | null;
+  contextWindowUsedTokens: number | null;
+  /** Model alias bound by the last `profile.bind` or `llm.request`; keys the config lookup. */
+  modelAlias: string | null;
+  /** Subagents of the session, in spawn order. */
+  subagents: KimiSubagentRecord[];
+  /** Count of `agent.turn.started` records seen. */
+  turnGeneration: number;
+  /** Highest turn known to be over. Starts at -1 so no boundary is assumed before one is seen. */
+  settledThroughTurn: number;
+}
+
+export const EMPTY_KIMI_SESSION_LOG_STATE: KimiSessionLogState = Object.freeze({
+  goal: null,
+  contextWindowUsedTokens: null,
+  modelAlias: null,
+  subagents: [],
+  turnGeneration: 0,
+  settledThroughTurn: -1,
+});
+
+/**
+ * Replay raw log lines onto a previous state. Pure and side-effect free so the
+ * derivation rules are testable without a filesystem.
+ *
+ * Records the daemon relies on:
+ * - `goal.create` sets the goal to `active` with zeroed counters.
+ * - `goal.update` carries either `tokensUsed` (one per goal turn) or `status`.
+ * - `goal.clear` drops the goal.
+ * - `profile.bind` and `llm.request` carry the bound model alias; the later
+ *   record wins, because the alias changes when the user switches model.
+ * - `usage.record` and `context.append_loop_event` of type `step.end` carry the
+ *   context size of one step. `token_counting.turn_recorded` is deliberately not
+ *   read: its `tokens` measures something else and lands well below the real
+ *   context size.
+ * - `subagent.spawned`, `subagent.started`, `subagent.completed` and
+ *   `subagent.cancelled` maintain the subagent registry. Only the lifecycle is
+ *   read here; each subagent's transcript lives in its own log.
+ * - `agent.turn.started` and `agent.turn.ended` move the turn watermark that
+ *   closes out subagents whose turn is over.
+ *
+ * Anything unparseable is skipped; a half-written line must not abort a replay.
+ */
+export function parseKimiSessionLogLines(
+  lines: Iterable<string>,
+  previous: KimiSessionLogState,
+): KimiSessionLogState {
+  let goal = previous.goal;
+  let contextWindowUsedTokens = previous.contextWindowUsedTokens;
+  let modelAlias = previous.modelAlias;
+  let turnGeneration = previous.turnGeneration;
+  let settledThroughTurn = previous.settledThroughTurn;
+  // Keyed by id, so a lifecycle record updates its entry in place and the
+  // iteration order stays the spawn order.
+  const subagents = new Map<string, KimiSubagentRecord>();
+  for (const subagent of previous.subagents) {
+    subagents.set(subagent.id, subagent);
+  }
+
+  for (const raw of lines) {
+    const line = raw.trim();
+    if (line.length === 0) {
+      continue;
+    }
+    const entry = parseKimiLogLine(line);
+    if (entry === null) {
+      continue;
+    }
+    switch (entry.type) {
+      case "goal.create":
+        goal = createGoalFromRecord(entry);
+        break;
+      case "goal.update":
+        goal = applyGoalUpdate(goal, entry);
+        break;
+      case "goal.clear":
+        goal = null;
+        break;
+      case "profile.bind":
+      case "llm.request": {
+        const alias = readString(entry.modelAlias);
+        if (alias !== undefined && alias.length > 0) {
+          modelAlias = alias;
+        }
+        break;
+      }
+      case "agent.turn.started":
+        turnGeneration += 1;
+        // A new turn proves every earlier one is over.
+        settledThroughTurn = Math.max(settledThroughTurn, turnGeneration - 1);
+        demoteSettledSubagents(subagents, settledThroughTurn);
+        break;
+      case "agent.turn.ended":
+        // A turn ending proves its own turn is over.
+        settledThroughTurn = Math.max(settledThroughTurn, turnGeneration);
+        demoteSettledSubagents(subagents, settledThroughTurn);
+        break;
+      case "subagent.spawned":
+        applySubagentSpawn(subagents, entry, turnGeneration);
+        break;
+      case "subagent.started":
+        applySubagentStarted(subagents, entry, turnGeneration);
+        break;
+      case "subagent.completed":
+        applySubagentTerminal(subagents, entry, "completed", turnGeneration);
+        break;
+      case "subagent.cancelled":
+        applySubagentTerminal(subagents, entry, "canceled", turnGeneration);
+        break;
+      default:
+        contextWindowUsedTokens = nextContextUsage(entry, contextWindowUsedTokens);
+        break;
+    }
+  }
+
+  return {
+    goal,
+    contextWindowUsedTokens,
+    modelAlias,
+    subagents: [...subagents.values()],
+    turnGeneration,
+    settledThroughTurn,
+  };
+}
+
+/**
+ * Parse one log line into a record, or null when it is blank, truncated, or not
+ * an object. A half-written line must not abort a replay.
+ */
+function parseKimiLogLine(line: string): Record<string, unknown> | null {
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(line);
+  } catch {
+    return null;
+  }
+  return asRecord(parsed);
+}
+
+function applySubagentSpawn(
+  subagents: Map<string, KimiSubagentRecord>,
+  entry: Record<string, unknown>,
+  turn: number,
+): void {
+  const id = readString(entry.subagentId);
+  if (id === undefined || id.length === 0) {
+    return;
+  }
+  const previous = subagents.get(id);
+  const toolCallId = readString(entry.parentToolCallId);
+  // Kimi recycles `agent-N` ids, so a spawn that names a different `Agent` tool
+  // call is a new subagent that must start fresh: inheriting the previous
+  // incarnation's status would report a live subagent as complete. Its panel
+  // still shows both runs, because Kimi appends both to the one log for this id
+  // and nothing on those records separates them.
+  const recycled =
+    previous !== undefined && toolCallId !== undefined && previous.toolCallId !== toolCallId;
+  const existing = recycled ? undefined : previous;
+  const time = readNumber(entry.time) ?? previous?.spawnedAt ?? 0;
+  subagents.set(
+    id,
+    mergeSubagentRecord(id, existing, {
+      name: readString(entry.subagentName),
+      description: readString(entry.description),
+      toolCallId,
+      updatedAt: time,
+      turn,
+      runInBackground: readBoolean(entry.runInBackground),
+    }),
+  );
+}
+
+function applySubagentStarted(
+  subagents: Map<string, KimiSubagentRecord>,
+  entry: Record<string, unknown>,
+  turn: number,
+): void {
+  const id = readString(entry.subagentId);
+  if (id === undefined || id.length === 0) {
+    return;
+  }
+  const existing = subagents.get(id);
+  const time = readNumber(entry.time) ?? existing?.spawnedAt ?? 0;
+  subagents.set(
+    id,
+    mergeSubagentRecord(id, existing, { updatedAt: time, turn: existing?.turn ?? turn }),
+  );
+}
+
+function applySubagentTerminal(
+  subagents: Map<string, KimiSubagentRecord>,
+  entry: Record<string, unknown>,
+  status: "completed" | "canceled",
+  turn: number,
+): void {
+  const id = readString(entry.subagentId);
+  if (id === undefined || id.length === 0) {
+    return;
+  }
+  // A completion always creates the record: its upsert is the only signal the
+  // client ever gets that this subagent existed.
+  const existing = subagents.get(id);
+  const time = readNumber(entry.time) ?? existing?.updatedAt ?? 0;
+  subagents.set(
+    id,
+    mergeSubagentRecord(id, existing, {
+      status,
+      updatedAt: time,
+      resultSummary: readString(entry.resultSummary),
+      turn: existing?.turn ?? turn,
+    }),
+  );
+}
+
+/** Fields a lifecycle record changes. Anything absent keeps the previous value. */
+interface KimiSubagentPatch {
+  name?: string;
+  description?: string;
+  toolCallId?: string;
+  status?: KimiSubagentStatus;
+  updatedAt: number;
+  resultSummary?: string;
+  turn: number;
+  runInBackground?: boolean;
+}
+
+/**
+ * Build the next record from a partial update. A lifecycle record only carries
+ * the fields that changed, so an absent one keeps whatever the spawn announced.
+ */
+function mergeSubagentRecord(
+  id: string,
+  existing: KimiSubagentRecord | undefined,
+  patch: KimiSubagentPatch,
+): KimiSubagentRecord {
+  return {
+    id,
+    name: stickyField(patch.name, existing?.name),
+    description: stickyField(patch.description, existing?.description),
+    toolCallId: stickyField(patch.toolCallId, existing?.toolCallId),
+    // A repeated spawn must not resurrect a subagent that already finished.
+    status: patch.status ?? existing?.status ?? "running",
+    spawnedAt: existing?.spawnedAt ?? patch.updatedAt,
+    updatedAt: patch.updatedAt,
+    resultSummary: stickyField(patch.resultSummary, existing?.resultSummary),
+    turn: patch.turn,
+    runInBackground: stickyField(patch.runInBackground, existing?.runInBackground),
+  };
+}
+
+/** An absent value keeps the stored one; a present value replaces it. */
+function stickyField<T>(next: T | undefined, previous: T | null | undefined): T | null {
+  return next ?? previous ?? null;
+}
+
+/**
+ * Close out the subagents of turns that are already over.
+ *
+ * A foreground subagent blocks the turn that spawned it, so it cannot still be
+ * alive once that turn ends. Kimi writes no terminal record when the user
+ * interrupts an `Agent` call and sends a new prompt, and it has no heartbeat to
+ * fall back on, so the turn boundary is the only evidence that the subagent is
+ * gone. Without this, an abandoned subagent is reported as running forever.
+ *
+ * `canceled` rather than a new status because Kimi already uses that word for
+ * its own `subagent.cancelled`, and the client renders it as an ordinary, done
+ * row instead of claiming attention.
+ */
+function demoteSettledSubagents(
+  subagents: Map<string, KimiSubagentRecord>,
+  settledThroughTurn: number,
+): void {
+  for (const [id, subagent] of subagents) {
+    if (subagent.status !== "running" || subagent.runInBackground === true) {
+      continue;
+    }
+    if (subagent.turn > settledThroughTurn) {
+      continue;
+    }
+    subagents.set(id, { ...subagent, status: "canceled" });
+  }
+}
+
+function readBoolean(value: unknown): boolean | undefined {
+  return typeof value === "boolean" ? value : undefined;
+}
+
+export interface KimiSessionLogOptions {
+  kimiSessionId: string;
+  kimiHome?: string;
+  logger: Logger;
+  /**
+   * Overrides all three cadences. Defaults to 500ms right after the log grew,
+   * 2000ms while a goal is live, and 10000ms otherwise.
+   */
+  pollIntervalMs?: number;
+  /** Cadence used right after the log grew. Defaults to 500ms. */
+  activeIntervalMs?: number;
+  onGoal?: (goal: AgentGoal | null) => void;
+  onUsage?: (usage: AgentUsage) => void;
+  onSubagent?: (event: ProviderSubagentInputEvent) => void;
+}
+
+/**
+ * Tails one session's wire log and reports the goal/usage/subagents it
+ * describes.
+ *
+ * Reads incrementally by byte offset, so a long session is never re-read. A
+ * goal created before the tailer attached is still picked up because the first
+ * read starts at byte 0.
+ *
+ * Usage needs both numbers: the used side comes from the log, the max side from
+ * the model alias plus `<kimiHome>/config.toml`. While either is unknown nothing
+ * is reported, because the client renders a context ring only for a full pair.
+ *
+ * Subagent transcripts are not in this log. Only their lifecycle is, and each
+ * one is tailed from its own `agents/<subagentId>/wire.jsonl`.
+ */
+export class KimiSessionLog {
+  private readonly kimiSessionId: string;
+  private readonly kimiHome: string | undefined;
+  private readonly logger: Logger;
+  private readonly activeIntervalMs: number;
+  private readonly liveIntervalMs: number;
+  private readonly idleIntervalMs: number;
+  private readonly onGoal: ((goal: AgentGoal | null) => void) | undefined;
+  private readonly onUsage: ((usage: AgentUsage) => void) | undefined;
+  private readonly onSubagent: ((event: ProviderSubagentInputEvent) => void) | undefined;
+
+  private resolvedPath: string | null = null;
+  private offset = 0;
+  /** Bytes of an unterminated trailing line, held until the next tick completes it. */
+  private pending = "";
+  private goal: AgentGoal | null = null;
+  private contextWindowUsedTokens: number | null = null;
+  private modelAlias: string | null = null;
+  private subagents: KimiSubagentRecord[] = [];
+  private turnGeneration = 0;
+  private settledThroughTurn = -1;
+  /** Value signature of the last goal considered; null means "nothing considered yet". */
+  private goalSignature: string | null = null;
+  private goalBucket = -1;
+  private emittedGoal = false;
+  private usageSignature: string | null = null;
+  private readonly subagentTailers = new Map<string, KimiSubagentLogTailer>();
+  /** Value signature of the last upsert emitted per subagent. */
+  private readonly subagentSignatures = new Map<string, string>();
+  /**
+   * Subagents whose own log has yielded assistant text. Kept past the tailer,
+   * because a subagent can fall out of the tailer cap before it finishes.
+   */
+  private readonly subagentsWithText = new Set<string>();
+  /** Subagents whose result summary has already been emitted as a fallback. */
+  private readonly summarisedSubagents = new Set<string>();
+  /**
+   * `Agent` tool call id of the incarnation last reported per subagent id, which
+   * is how a recycled id is told apart from a repeated record.
+   */
+  private readonly subagentIncarnations = new Map<string, string | null>();
+
+  private timer: ReturnType<typeof setTimeout> | null = null;
+  private started = false;
+  private stopped = false;
+
+  constructor(options: KimiSessionLogOptions) {
+    this.kimiSessionId = options.kimiSessionId;
+    this.kimiHome = options.kimiHome;
+    this.logger = options.logger;
+    this.activeIntervalMs =
+      options.pollIntervalMs ?? options.activeIntervalMs ?? ACTIVE_POLL_INTERVAL_MS;
+    this.liveIntervalMs = options.pollIntervalMs ?? LIVE_POLL_INTERVAL_MS;
+    this.idleIntervalMs = options.pollIntervalMs ?? IDLE_POLL_INTERVAL_MS;
+    this.onGoal = options.onGoal;
+    this.onUsage = options.onUsage;
+    this.onSubagent = options.onSubagent;
+  }
+
+  /** Idempotent. Starts tailing. */
+  start(): void {
+    if (this.started || this.stopped) {
+      return;
+    }
+    this.started = true;
+    this.scheduleTick(0);
+  }
+
+  /** Idempotent. Stops tailing. */
+  stop(): void {
+    if (this.stopped) {
+      return;
+    }
+    this.stopped = true;
+    this.clearTimer();
+    this.pending = "";
+  }
+
+  /** Latest derived goal, or null. */
+  getGoal(): AgentGoal | null {
+    return this.goal;
+  }
+
+  /** True while the goal is still being pursued. */
+  isLive(): boolean {
+    return isAgentGoalLive(this.goal);
+  }
+
+  /**
+   * Resolves once the goal stops being live, on timeout, or as soon as `signal`
+   * aborts. The abort path is what keeps a held ACP turn from outliving the
+   * turn it belongs to.
+   */
+  async waitForSettled(timeoutMs: number, signal?: AbortSignal): Promise<void> {
+    if (signal?.aborted === true) {
+      return;
+    }
+    if (!this.isLive()) {
+      return;
+    }
+    const deadline = Date.now() + Math.max(0, timeoutMs);
+    if (!signal) {
+      await this.pollUntilSettled(deadline);
+      return;
+    }
+    // Race the polling loop against the signal so an aborted turn is released
+    // immediately instead of at the next 250ms check.
+    const abortPromise = new Promise<void>((resolve) => {
+      signal.addEventListener("abort", () => resolve(), { once: true });
+    });
+    await Promise.race([abortPromise, this.pollUntilSettled(deadline, signal)]);
+  }
+
+  /** Re-check the goal every 250ms until it settles, the deadline passes, or the signal aborts. */
+  private async pollUntilSettled(deadline: number, signal?: AbortSignal): Promise<void> {
+    while (!this.stopped && this.isLive() && Date.now() < deadline) {
+      if (signal?.aborted === true) {
+        return;
+      }
+      const remaining = deadline - Date.now();
+      await delay(Math.min(SETTLE_POLL_INTERVAL_MS, remaining));
+    }
+  }
+
+  private scheduleTick(delayMs: number): void {
+    this.clearTimer();
+    if (this.stopped) {
+      return;
+    }
+    this.timer = setTimeout(() => {
+      this.timer = null;
+      void this.tick();
+    }, delayMs);
+    // Never hold the daemon open for a poll.
+    this.timer.unref();
+  }
+
+  private clearTimer(): void {
+    if (this.timer) {
+      clearTimeout(this.timer);
+      this.timer = null;
+    }
+  }
+
+  private async tick(): Promise<void> {
+    let readNewBytes = false;
+    try {
+      readNewBytes = await this.readAppended();
+    } catch (error) {
+      this.logger.warn(
+        { err: error, sessionId: this.kimiSessionId },
+        "Kimi session log poll failed",
+      );
+    }
+    if (this.stopped) {
+      return;
+    }
+    this.publishGoal();
+    await this.publishUsage();
+    if (this.stopped) {
+      return;
+    }
+    await this.publishSubagents();
+    if (this.stopped) {
+      return;
+    }
+    this.scheduleTick(this.nextIntervalMs(readNewBytes));
+  }
+
+  /**
+   * A log that just grew is polled fast, so a step's number lands while the turn
+   * is still running; a live goal is polled slowly, an idle session slower still.
+   */
+  private nextIntervalMs(readNewBytes: boolean): number {
+    if (readNewBytes) {
+      return this.activeIntervalMs;
+    }
+    return this.isLive() ? this.liveIntervalMs : this.idleIntervalMs;
+  }
+
+  /** Returns whether the file yielded bytes this tick. */
+  private async readAppended(): Promise<boolean> {
+    const filePath = this.resolvePath();
+    if (!filePath) {
+      return false;
+    }
+    let size: number;
+    try {
+      size = (await stat(filePath)).size;
+    } catch {
+      // The file vanished; re-resolve on the next tick.
+      this.resolvedPath = null;
+      return false;
+    }
+    if (size < this.offset) {
+      // Truncated or replaced: rebuild from the beginning.
+      this.offset = 0;
+      this.pending = "";
+      this.resetDerivedState();
+    }
+    if (size === this.offset) {
+      return false;
+    }
+    const { lines, fragment } = await readLinesFromRange(filePath, this.offset, size);
+    this.offset = size;
+    const merged = mergePendingFragment(this.pending, lines);
+    this.pending = fragment;
+    this.applyLines(merged);
+    return true;
+  }
+
+  private resolvePath(): string | null {
+    const cached = this.resolvedPath;
+    if (cached !== null && existsSync(cached)) {
+      return cached;
+    }
+    const resolved = resolveKimiWireLogPath(this.kimiSessionId, { kimiHome: this.kimiHome });
+    this.resolvedPath = resolved;
+    return resolved;
+  }
+
+  private resetDerivedState(): void {
+    this.goal = null;
+    this.contextWindowUsedTokens = null;
+    this.modelAlias = null;
+    this.subagents = [];
+    this.turnGeneration = 0;
+    this.settledThroughTurn = -1;
+    this.subagentTailers.clear();
+    this.subagentSignatures.clear();
+    this.subagentsWithText.clear();
+    this.summarisedSubagents.clear();
+    this.subagentIncarnations.clear();
+  }
+
+  private applyLines(lines: string[]): void {
+    const next = parseKimiSessionLogLines(lines, {
+      goal: this.goal,
+      contextWindowUsedTokens: this.contextWindowUsedTokens,
+      modelAlias: this.modelAlias,
+      subagents: this.subagents,
+      turnGeneration: this.turnGeneration,
+      settledThroughTurn: this.settledThroughTurn,
+    });
+    this.goal = next.goal;
+    this.contextWindowUsedTokens = next.contextWindowUsedTokens;
+    this.modelAlias = next.modelAlias;
+    this.subagents = next.subagents;
+    this.turnGeneration = next.turnGeneration;
+    this.settledThroughTurn = next.settledThroughTurn;
+  }
+
+  private publishGoal(): void {
+    const goal = this.goal;
+    const signature = goalValueSignature(goal);
+    const bucket = Math.floor(Date.now() / GOAL_REANNOUNCE_BUCKET_MS);
+    if (signature === this.goalSignature && bucket === this.goalBucket) {
+      return;
+    }
+    const changed = signature !== this.goalSignature;
+    const wasEmitted = this.emittedGoal;
+    this.goalSignature = signature;
+    this.goalBucket = bucket;
+    // Suppress the first observation when it is null (nothing to report) and
+    // never re-announce a null goal just because the bucket rolled.
+    if (goal === null && (!wasEmitted || !changed)) {
+      return;
+    }
+    this.emittedGoal = true;
+    try {
+      this.onGoal?.(goal);
+    } catch (error) {
+      this.logger.warn(
+        { err: error, sessionId: this.kimiSessionId },
+        "Kimi session log goal listener failed",
+      );
+    }
+  }
+
+  private async publishUsage(): Promise<void> {
+    const used = this.contextWindowUsedTokens;
+    if (used === null) {
+      return;
+    }
+    let max: number | null;
+    try {
+      max = await this.contextWindowMax();
+    } catch (error) {
+      this.logger.warn(
+        { err: error, sessionId: this.kimiSessionId },
+        "Kimi session log context window lookup failed",
+      );
+      return;
+    }
+    // The client draws the context ring only when both numbers are present, so a
+    // half-known pair would be reported and then dropped.
+    if (max === null) {
+      return;
+    }
+    const signature = `${used}:${max}`;
+    if (signature === this.usageSignature) {
+      return;
+    }
+    this.usageSignature = signature;
+    try {
+      this.onUsage?.({ contextWindowUsedTokens: used, contextWindowMaxTokens: max });
+    } catch (error) {
+      this.logger.warn(
+        { err: error, sessionId: this.kimiSessionId },
+        "Kimi session log usage listener failed",
+      );
+    }
+  }
+
+  /**
+   * Reports the subagent registry, then the transcript of the newest few.
+   *
+   * Replaying every subagent log from byte 0 is unbounded, so only the most
+   * recently spawned are tailed; the rest keep a lifecycle row and no timeline.
+   */
+  private async publishSubagents(): Promise<void> {
+    for (const subagent of this.subagents) {
+      if (this.incarnationChanged(subagent)) {
+        // The latches describe the previous run of a recycled id, and would
+        // otherwise suppress this run's summary or mis-report its text.
+        this.subagentsWithText.delete(subagent.id);
+        this.summarisedSubagents.delete(subagent.id);
+      }
+      this.subagentIncarnations.set(subagent.id, subagent.toolCallId);
+
+      const signature = subagentValueSignature(subagent);
+      if (this.subagentSignatures.get(subagent.id) === signature) {
+        continue;
+      }
+      this.subagentSignatures.set(subagent.id, signature);
+      this.emitSubagent({
+        type: "upsert",
+        id: subagent.id,
+        title: subagent.name,
+        description: subagent.description,
+        toolCallId: subagent.toolCallId,
+        status: subagent.status,
+      });
+    }
+
+    const tailed = selectTailedSubagents(this.subagents);
+    const tailedIds = new Set(tailed.map((subagent) => subagent.id));
+    // Deleting from a Map while iterating its keys is well defined: the removed
+    // entry is simply skipped.
+    for (const subagentId of this.subagentTailers.keys()) {
+      if (!tailedIds.has(subagentId)) {
+        this.subagentTailers.delete(subagentId);
+      }
+    }
+
+    const sessionDir = this.resolveSessionDir();
+    if (sessionDir !== null) {
+      for (const subagent of tailed) {
+        const tailer = this.attachSubagentTailer(subagent.id, sessionDir);
+        let items: AgentTimelineItem[];
+        try {
+          items = await tailer.readAppended();
+        } catch (error) {
+          this.logger.warn(
+            { err: error, sessionId: this.kimiSessionId, subagentId: subagent.id },
+            "Kimi subagent log poll failed",
+          );
+          continue;
+        }
+        for (const item of items) {
+          this.emitSubagent({ type: "timeline", id: subagent.id, item });
+        }
+        // Read the latch off this batch rather than the tailer's sticky flag: a
+        // recycled id shares one log, so the previous run's text must not carry
+        // over to the new run.
+        if (items.some((item) => item.type === "assistant_message")) {
+          this.subagentsWithText.add(subagent.id);
+        }
+      }
+    }
