+        settledThroughTurn = Math.max(settledThroughTurn, turnGeneration - 1);
+        demoteSettledSubagents(subagents, settledThroughTurn);
+        break;
+      case "agent.turn.ended":
+        // A turn ending proves its own turn is over.
+        settledThroughTurn = Math.max(settledThroughTurn, turnGeneration);
+        demoteSettledSubagents(subagents, settledThroughTurn);
+        break;
+      case "subagent.spawned":
+        applySubagentSpawn(subagents, entry, turnGeneration);
+        break;
+      case "subagent.started":
+        applySubagentStarted(subagents, entry, turnGeneration);
+        break;
+      case "subagent.completed":
