+    appendFileSync(file, `${textPartLine("finished before attach")}\n`);
+
+    const tailer = createTailer(file);
+
+    expect(await tailer.readAppended()).toEqual([
+      { type: "assistant_message", text: "finished before attach" },
+    ]);
+  });
+
+  test("holds an unterminated trailing line until the rest of it arrives", async () => {
+    const { file } = createTailerHome();
+    const line = textPartLine("split across reads");
+    appendFileSync(file, line.slice(0, 30));
+    const tailer = createTailer(file);
+
+    expect(await tailer.readAppended()).toEqual([]);
+
+    appendFileSync(file, `${line.slice(30)}\n`);
+
+    expect(await tailer.readAppended()).toEqual([
+      { type: "assistant_message", text: "split across reads" },
+    ]);
+  });
+
+  test("replays from the start after the log is replaced with a shorter one", async () => {
+    const { file } = createTailerHome();
+    appendFileSync(file, `${textPartLine("old one")}\n${textPartLine("old two")}\n`);
+    const tailer = createTailer(file);
+    await tailer.readAppended();
+
+    writeFileSync(file, `${textPartLine("fresh")}\n`);
+
+    expect(await tailer.readAppended()).toEqual([{ type: "assistant_message", text: "fresh" }]);
+  });
+
+  test("a thinking part yields reasoning, not assistant text", async () => {
+    const { file } = createTailerHome();
+    appendFileSync(file, `${thinkPartLine("thinking")}\n`);
+    const tailer = createTailer(file);
+
+    expect(await tailer.readAppended()).toEqual([{ type: "reasoning", text: "thinking" }]);
+
+    appendFileSync(file, `${textPartLine("the answer")}\n`);
+
+    expect(await tailer.readAppended()).toEqual([
+      { type: "assistant_message", text: "the answer" },
+    ]);
+  });
+
+  test("returns nothing while the subagent log does not exist", async () => {
+    const { sessionDir } = createTailerHome();
+    const tailer = new KimiSubagentLogTailer({
+      subagentId: "agent_missing",
+      sessionDir,
+      logger: createTestLogger(),
+    });
+
+    expect(await tailer.readAppended()).toEqual([]);
+  });
+});
