+    this.publishSubagentSummaries();
+  }
+
+  /**
+   * A finished subagent normally reports itself through the last message of its
+   * own log, which is the same text as `resultSummary`; emitting the summary
+   * unconditionally would duplicate it. The summary is the only copy left when
+   * the log could not be read, which happens for a subagent over the tailer cap
+   * or one whose file is gone.
+   */
+  private publishSubagentSummaries(): void {
+    for (const subagent of this.subagents) {
+      if (subagent.status === "running" || this.summarisedSubagents.has(subagent.id)) {
+        continue;
+      }
+      const summary = subagent.resultSummary;
+      if (summary === null || summary.length === 0) {
+        continue;
+      }
+      if (this.subagentsWithText.has(subagent.id)) {
+        continue;
+      }
+      this.summarisedSubagents.add(subagent.id);
+      this.emitSubagent({
+        type: "timeline",
+        id: subagent.id,
+        item: { type: "assistant_message", text: summary },
+      });
+    }
+  }
+
+  /**
+   * True when this record is a different subagent than the last one reported for
+   * the same id. Kimi recycles `agent-N` ids, and the two runs share one log and
+   * one client row, so only the `Agent` tool call tells them apart.
+   */
+  private incarnationChanged(subagent: KimiSubagentRecord): boolean {
+    if (!this.subagentIncarnations.has(subagent.id)) {
+      return false;
+    }
+    return this.subagentIncarnations.get(subagent.id) !== subagent.toolCallId;
+  }
+
+  private attachSubagentTailer(subagentId: string, sessionDir: string): KimiSubagentLogTailer {
+    const existing = this.subagentTailers.get(subagentId);
+    if (existing !== undefined) {
+      return existing;
+    }
+    const tailer = new KimiSubagentLogTailer({ subagentId, sessionDir, logger: this.logger });
+    this.subagentTailers.set(subagentId, tailer);
+    return tailer;
+  }
+
+  private emitSubagent(event: ProviderSubagentInputEvent): void {
+    try {
+      this.onSubagent?.(event);
+    } catch (error) {
+      this.logger.warn(
+        { err: error, sessionId: this.kimiSessionId },
+        "Kimi session log subagent listener failed",
+      );
+    }
+  }
+
+  /** The `<sessionId>` directory, derived from the main log it contains. */
+  private resolveSessionDir(): string | null {
+    const filePath = this.resolvePath();
+    if (filePath === null) {
+      return null;
+    }
+    return path.dirname(path.dirname(path.dirname(filePath)));
+  }
+
+  /** Context window of the bound model, or null while the alias or the config is unknown. */
+  private async contextWindowMax(): Promise<number | null> {
+    const alias = this.modelAlias;
+    if (alias === null) {
+      return null;
+    }
+    const windows = await loadKimiModelContextWindows(resolveKimiHome(this.kimiHome));
+    const max = windows[alias];
+    return Number.isFinite(max) && max > 0 ? max : null;
+  }
+}
+
+export interface RangeReadResult {
+  lines: string[];
+  fragment: string;
+}
+
+/**
+ * Stream lines out of `[start, end)` without buffering the range. A trailing
+ * line with no newline is returned separately so the caller can prepend it to
+ * the next read instead of losing a record split across ticks.
+ */
+export async function readLinesFromRange(
+  filePath: string,
+  start: number,
+  end: number,
+): Promise<RangeReadResult> {
+  const lines: string[] = [];
+  const stream = createReadStream(filePath, { start, end: end - 1, encoding: "utf8" });
+  const reader = createInterface({ input: stream, crlfDelay: Number.POSITIVE_INFINITY });
+  try {
+    for await (const line of reader) {
+      lines.push(line);
+    }
+  } finally {
+    reader.close();
+    stream.destroy();
+  }
+  if (lines.length === 0 || rangeEndsWithNewline(filePath, end)) {
+    return { lines, fragment: "" };
+  }
+  return { lines, fragment: lines.pop() ?? "" };
+}
+
+function rangeEndsWithNewline(filePath: string, end: number): boolean {
+  if (end <= 0) {
+    return true;
+  }
+  let fd: number | null = null;
+  try {
+    fd = openSync(filePath, "r");
+    const buffer = Buffer.alloc(1);
+    readSync(fd, buffer, 0, 1, end - 1);
+    return buffer[0] === 0x0a;
+  } catch {
+    // Treat an unreadable byte as terminated: dropping a fragment is safer than
+    // concatenating the same bytes twice.
+    return true;
+  } finally {
+    if (fd !== null) {
+      try {
+        closeSync(fd);
+      } catch {
+        // ignore
+      }
+    }
+  }
+}
+
+/**
+ * Join a line held back from the previous read onto the first line of this one.
+ * Exported for the per-subagent tailer, which reads the same way.
+ */
+export function mergePendingFragment(pending: string, lines: string[]): string[] {
+  const first = lines[0];
+  if (pending.length === 0 || first === undefined) {
+    return lines;
+  }
+  return [pending + first, ...lines.slice(1)];
+}
+
+function createGoalFromRecord(entry: Record<string, unknown>): AgentGoal {
+  const completionCriterion = readString(entry.completionCriterion);
+  return {
+    goalId: readString(entry.goalId) ?? "",
+    objective: readString(entry.objective) ?? "",
+    status: "active",
+    turnsUsed: 0,
+    tokensUsed: 0,
+    updatedAt: readNumber(entry.time) ?? 0,
+    ...(completionCriterion !== undefined ? { completionCriterion } : {}),
+  };
+}
+
+function applyGoalUpdate(goal: AgentGoal | null, entry: Record<string, unknown>): AgentGoal | null {
+  if (!goal) {
+    return null;
+  }
+  const time = readNumber(entry.time) ?? goal.updatedAt;
+  let next = goal;
+
+  const tokensUsed = readNumber(entry.tokensUsed);
+  if (tokensUsed !== undefined) {
+    // One `tokensUsed` update per goal turn; that count is `turnsUsed`.
+    next = { ...next, turnsUsed: next.turnsUsed + 1, tokensUsed, updatedAt: time };
+  }
+
+  const status = readString(entry.status);
+  if (status !== undefined) {
+    const reason = readString(entry.reason);
+    next = {
+      ...next,
+      status: mapGoalStatus(status),
+      updatedAt: time,
+      ...(reason !== undefined ? { terminalReason: reason } : {}),
+    };
+  }
+
+  return next;
+}
+
+function mapGoalStatus(value: string): AgentGoalStatus {
+  switch (value) {
+    case "active":
+    case "paused":
+    case "blocked":
+    case "complete":
+    case "cleared":
+      return value;
+    default:
+      // Any other reported status is terminal; the exact label is not part of
+      // the shared vocabulary, so the goal is reported as cleared.
+      return "cleared";
+  }
+}
+
+/**
+ * Change detector for goal emission. `updatedAt` is deliberately excluded: it
+ * advances with the log and would make every replay look like a change.
+ */
+function goalValueSignature(goal: AgentGoal | null): string {
+  if (!goal) {
+    return "null";
+  }
+  return JSON.stringify([
+    goal.goalId,
+    goal.objective,
+    goal.status,
+    goal.turnsUsed,
+    goal.tokensUsed,
+    goal.completionCriterion ?? "",
+    goal.terminalReason ?? "",
+  ]);
+}
+
+/**
+ * Change detector for subagent upserts, covering the fields the client renders.
+ * The timestamps are excluded for the same reason as in the goal signature.
+ */
+function subagentValueSignature(subagent: KimiSubagentRecord): string {
+  return JSON.stringify([
+    subagent.status,
+    subagent.name,
+    subagent.description,
+    subagent.toolCallId,
+    subagent.resultSummary !== null,
+  ]);
+}
+
+function selectTailedSubagents(subagents: KimiSubagentRecord[]): KimiSubagentRecord[] {
+  const byRecency = [...subagents].sort((left, right) => right.spawnedAt - left.spawnedAt);
+  return byRecency.slice(0, TAILED_SUBAGENT_LIMIT);
+}
+
+function resolveKimiHome(kimiHome?: string): string {
+  const raw =
+    firstNonEmpty(kimiHome, process.env.KIMI_HOME, process.env.KIMI_CODE_HOME) ?? DEFAULT_KIMI_HOME;
+  return expandHome(raw);
+}
+
+function firstNonEmpty(...values: Array<string | undefined>): string | undefined {
+  for (const value of values) {
+    if (value !== undefined && value.length > 0) {
+      return value;
+    }
+  }
+  return undefined;
+}
+
+function expandHome(value: string): string {
+  if (value === "~") {
+    return os.homedir();
+  }
+  if (value.startsWith("~/") || value.startsWith("~\\")) {
+    return path.join(os.homedir(), value.slice(2));
+  }
+  return value;
+}
+
+/** A log value is only a string when it is still a string after parsing. */
+export function readString(value: unknown): string | undefined {
+  return typeof value === "string" ? value : undefined;
+}
+
+function readNumber(value: unknown): number | undefined {
+  return typeof value === "number" && Number.isFinite(value) ? value : undefined;
+}
+
+/** Narrow a parsed log record to an object before reading its fields. */
+export function asRecord(value: unknown): Record<string, unknown> | null {
+  return typeof value === "object" && value !== null ? (value as Record<string, unknown>) : null;
+}
+
+/** A usage part that is missing, non-numeric, or non-positive counts as zero. */
+function positiveNumber(value: unknown): number {
+  return typeof value === "number" && Number.isFinite(value) && value > 0 ? value : 0;
+}
+
+/**
+ * Context tokens of one logged step, matching the number Kimi itself reports.
+ *
+ * Only the per-step records are read: Kimi writes them while the turn runs,
+ * whereas `token_counting.turn_recorded` measures a different quantity and
+ * lands far below the real context size. `output` is part of the count because
+ * it is what the next step's context starts from.
+ */
+function stepContextUsage(entry: Record<string, unknown>): number | null {
+  let usage: Record<string, unknown> | null = null;
+  if (entry.type === "usage.record") {
+    usage = asRecord(entry.usage);
+  } else if (entry.type === "context.append_loop_event") {
+    const event = asRecord(entry.event);
+    if (event === null || event.type !== "step.end") {
+      return null;
+    }
+    usage = asRecord(event.usage);
+  }
+  if (usage === null) {
+    return null;
+  }
+  const used =
+    positiveNumber(usage.inputOther) +
+    positiveNumber(usage.inputCacheRead) +
+    positiveNumber(usage.inputCacheCreation) +
+    positiveNumber(usage.output);
+  return used > 0 ? used : null;
+}
+
+/** The context size this record reports, or the previous value when it reports none. */
+function nextContextUsage(entry: Record<string, unknown>, previous: number | null): number | null {
+  return stepContextUsage(entry) ?? previous;
+}
+
+interface ConfigWindowCacheEntry {
+  mtimeMs: number;
+  windows: Record<string, number>;
+}
+
+/** Keyed by config path, so two Kimi homes in one process never share an entry. */
+const configWindowCache = new Map<string, ConfigWindowCacheEntry>();
+
+/**
+ * Reads `[models."<alias>"] max_context_size` pairs out of Kimi's `config.toml`.
+ *
+ * A line scan rather than a TOML parse: the file is user-edited, so a value the
+ * daemon cannot read is skipped instead of thrown. The result is cached by
+ * mtime, and a config that disappears keeps serving the last good read.
+ */
+export async function loadKimiModelContextWindows(
+  kimiHome: string,
+): Promise<Record<string, number>> {
+  const configPath = path.join(kimiHome, KIMI_CONFIG_FILENAME);
+  const cached = configWindowCache.get(configPath);
+  let mtimeMs: number;
+  try {
+    mtimeMs = (await stat(configPath)).mtimeMs;
+  } catch {
+    return cached?.windows ?? {};
+  }
+  if (cached !== undefined && cached.mtimeMs === mtimeMs) {
+    return cached.windows;
+  }
+  let text: string;
+  try {
+    text = await readFile(configPath, "utf8");
+  } catch {
+    return cached?.windows ?? {};
+  }
+  const windows = parseModelContextWindows(text);
+  configWindowCache.set(configPath, { mtimeMs, windows });
+  return windows;
+}
+
+function parseModelContextWindows(text: string): Record<string, number> {
+  const windows: Record<string, number> = {};
+  let currentModel: string | null = null;
+  for (const rawLine of text.split("\n")) {
+    const line = rawLine.trim();
+    if (line.length === 0 || line.startsWith("#")) {
+      continue;
+    }
+    const section = /^\[models\s*\.\s*"([^"]+)"\s*\]$/.exec(line);
+    if (section) {
+      currentModel = section[1];
+      continue;
+    }
+    if (line.startsWith("[")) {
+      currentModel = null;
+      continue;
+    }
+    if (currentModel === null) {
+      continue;
+    }
+    const value = /^max_context_size\s*=\s*(\d+)\s*$/.exec(line);
+    if (value) {
+      const size = Number.parseInt(value[1], 10);
+      if (Number.isFinite(size) && size > 0) {
+        windows[currentModel] = size;
+      }
+    }
+  }
+  return windows;
+}
+
+function delay(ms: number): Promise<void> {
+  return new Promise((resolve) => {
+    setTimeout(resolve, ms);
+  });
+}
