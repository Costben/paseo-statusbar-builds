+function createSessionHome(sessionId: string): {
+  home: string;
+  file: string;
+  sessionDir: string;
+} {
+  const home = mkdtempSync(path.join(tmpdir(), "kimi-session-log-"));
+  const sessionDir = path.join(home, "sessions", "D--tmp-kimi-workspace", sessionId);
+  const file = path.join(sessionDir, "agents", "main", "wire.jsonl");
+  mkdirSync(path.dirname(file), { recursive: true });
+  writeFileSync(file, "");
+  return { home, file, sessionDir };
+}
+
+async function waitFor(condition: () => boolean, timeoutMs = 5_000): Promise<void> {
+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    if (condition()) {
+      return;
+    }
+    await delay(10);
+  }
+  throw new Error("Timed out waiting for condition");
+}
+
+function delay(ms: number): Promise<void> {
+  return new Promise((resolve) => {
+    setTimeout(resolve, ms);
+  });
+}
