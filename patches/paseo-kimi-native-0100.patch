+function loopEventLine(event: unknown, agentId = SUBAGENT_ID, time = TIME): string {
+  return JSON.stringify({ type: "context.append_loop_event", agentId, event, time });
+}
+
+function textPartLine(text: string): string {
+  return loopEventLine({ type: "content.part", part: { type: "text", text } });
+}
+
+function thinkPartLine(text: string): string {
+  // Kimi keys a thinking part's text as `think`, not `text`; a real log line is
+  // `{"part":{"type":"think","think":"..."}}`.
+  return loopEventLine({ type: "content.part", part: { type: "think", think: text } });
+}
+
+function toolCallLine(callId: string, name: string, args: unknown): string {
+  return loopEventLine({ type: "tool.call", toolCallId: callId, name, args });
+}
+
+function toolResultLine(callId: string, output: string): string {
+  return loopEventLine({
+    type: "tool.result",
+    toolCallId: callId,
+    result: { output, durationMs: 222 },
+  });
