+    goalId: overrides.goalId ?? GOAL_ID,
+    objective: overrides.objective ?? OBJECTIVE,
+    completionCriterion: overrides.completionCriterion ?? CRITERION,
+    wallClockResumedAt: 1790486852717,
+    time: 1790486852717,
+  });
