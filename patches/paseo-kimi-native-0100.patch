+function writeSubagentLog(sessionDir: string, subagentId: string, contents: string): string {
+  const file = path.join(sessionDir, "agents", subagentId, "wire.jsonl");
+  mkdirSync(path.dirname(file), { recursive: true });
+  writeFileSync(file, contents);
+  return file;
+}
+
+function hasSubagentTimeline(events: ProviderSubagentInputEvent[]): boolean {
+  return events.some((event) => event.type === "timeline");
+}
+
+function hasAssistantTimeline(events: ProviderSubagentInputEvent[]): boolean {
+  return events.some(
+    (event) => event.type === "timeline" && event.item.type === "assistant_message",
+  );
+}
+
+function hasCompletedUpsert(events: ProviderSubagentInputEvent[]): boolean {
+  return events.some((event) => event.type === "upsert" && event.status === "completed");
+}
+
+function hasCanceledUpsert(events: ProviderSubagentInputEvent[]): boolean {
+  return events.some((event) => event.type === "upsert" && event.status === "canceled");
+}
+
+function countUpserts(events: ProviderSubagentInputEvent[]): number {
+  return events.filter((event) => event.type === "upsert").length;
+}
+
+function upsertStatuses(events: ProviderSubagentInputEvent[]): string[] {
+  const statuses: string[] = [];
+  for (const event of events) {
+    if (event.type === "upsert" && event.status !== undefined) {
+      statuses.push(event.status);
+    }
+  }
+  return statuses;
+}
+
+function assistantTimelineTexts(events: ProviderSubagentInputEvent[]): string[] {
+  const texts: string[] = [];
+  for (const event of events) {
+    if (event.type === "timeline" && event.item.type === "assistant_message") {
+      texts.push(event.item.text);
+    }
+  }
+  return texts;
+}
