+
+    const permission = session.requestPermission({
+      sessionId: "session-1",
+      toolCall: {
+        toolCallId: "q-1",
+        title: "AskUserQuestion",
+        content: [{ type: "content", content: { type: "text", text: "Pick a page?" } }],
+      },
+      options: [
+        { optionId: "q0_opt_0", name: "Page A", kind: "allow_once" },
+        { optionId: "q0_opt_1", name: "Page B", kind: "allow_once" },
+        { optionId: "q0_skip", name: "Skip", kind: "reject_once" },
+      ],
+      _meta: {
+        questions: [
+          {
+            question: "Pick a page?",
+            header: "Page",
+            options: [
+              { label: "Page A", description: "First" },
+              { label: "Page B" },
+            ],
+            multiSelect: false,
+            allowOther: true,
+          },
+          {
+            question: "Pick tags?",
