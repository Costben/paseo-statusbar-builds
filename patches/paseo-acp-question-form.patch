+interface ACPQuestionPrompt {
+  question: string;
+  header: string;
+  options: Array<{ label: string; description?: string }>;
+  multiSelect: boolean;
+  allowOther: boolean;
+}
+
+function extractACPQuestionPrompts(params: RequestPermissionRequest): ACPQuestionPrompt[] | null {
+  const rawQuestions = isRecord(params._meta) ? params._meta["questions"] : undefined;
+  if (!Array.isArray(rawQuestions) || rawQuestions.length === 0) {
+    return null;
+  }
+
+  const questions: ACPQuestionPrompt[] = [];
+  for (let index = 0; index < rawQuestions.length; index += 1) {
+    const item = rawQuestions[index];
+    if (!isRecord(item)) {
+      return null;
+    }
+    const question = typeof item["question"] === "string" ? item["question"].trim() : "";
+    const rawOptions = item["options"];
+    if (!question || !Array.isArray(rawOptions)) {
+      return null;
+    }
+    const options: Array<{ label: string; description?: string }> = [];
+    for (const rawOption of rawOptions) {
+      if (!isRecord(rawOption) || typeof rawOption["label"] !== "string") {
+        return null;
+      }
+      const description =
+        typeof rawOption["description"] === "string" ? rawOption["description"] : undefined;
+      options.push({
+        label: rawOption["label"],
+        ...(description !== undefined ? { description } : {}),
+      });
+    }
+    const rawHeader = typeof item["header"] === "string" ? item["header"].trim() : "";
+    const header =
+      rawHeader.length > 0
+        ? rawHeader
+        : rawQuestions.length === 1
+          ? "Question"
+          : `Question ${index + 1}`;
+    questions.push({
+      question,
+      header,
+      options,
+      multiSelect: item["multiSelect"] === true,
+      allowOther: item["allowOther"] !== false,
+    });
+  }
+  return questions;
+}
+
+function resolveACPQuestionAnswers(
+  pending: PendingPermission,
+  response: AgentPermissionResponse,
+): Record<string, string> | null {
+  if (pending.request.kind !== "question" || response.behavior !== "allow") {
+    return null;
+  }
+  const rawAnswers = readQuestionFormAnswers(response.updatedInput);
+  if (!rawAnswers) {
+    return null;
+  }
+
+  const rawQuestions = pending.request.input?.["questions"];
+  if (!Array.isArray(rawQuestions) || rawQuestions.length === 0) {
+    return rawAnswers;
+  }
+
+  const normalized: Record<string, string> = {};
+  for (const item of rawQuestions) {
+    if (!isRecord(item) || typeof item["question"] !== "string") {
+      continue;
+    }
+    const questionText = item["question"];
+    const header = typeof item["header"] === "string" ? item["header"] : undefined;
+    const answer =
+      rawAnswers[questionText] ?? (header !== undefined ? rawAnswers[header] : undefined);
+    if (typeof answer === "string" && answer.trim().length > 0) {
+      normalized[questionText] = answer.trim();
+    }
+  }
+  return Object.keys(normalized).length > 0 ? normalized : rawAnswers;
+}
+
+function resolveACPQuestionOptionId(
+  pending: PendingPermission,
+  answers: Record<string, string>,
+  fallbackSelected: PermissionOption | null,
+): string {
+  const entries = Object.values(answers);
+  if (entries.length === 1) {
+    const matched = pending.options.find(
+      (option) => option.kind.startsWith("allow") && option.name === entries[0],
+    );
+    if (matched) {
+      return matched.optionId;
+    }
+  }
+  return fallbackSelected?.optionId ?? "q0_opt_0";
+}
