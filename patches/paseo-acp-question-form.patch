+
+    await expect(permission).resolves.toEqual({
+      outcome: {
+        outcome: "selected",
+        optionId: "q0_opt_0",
+        _meta: {
+          answers: {
+            "Pick a page?": "Custom page URL",
+            "Pick tags?": "Tag 1, Custom tag",
+          },
+        },
+      },
+      _meta: {
+        answers: {
+          "Pick a page?": "Custom page URL",
+          "Pick tags?": "Tag 1, Custom tag",
+        },
+      },
+    });
+  });
+
+  test("relays Skip when QuestionFormCard is dismissed and ignores auto_accept", async () => {
+    const session = createSessionWithConfig({
+      provider: "kimi-acp",
+      providerOptions: { auto_accept: true },
+    });
+    const events: AgentStreamEvent[] = [];
+    const internals = asInternals<ACPSessionInternals>(session);
+
+    internals.sessionId = "session-1";
+    internals.activeForegroundTurnId = "turn-1";
+    session.subscribe((event) => events.push(event));
+
+    const permission = session.requestPermission({
+      sessionId: "session-1",
+      toolCall: { toolCallId: "q-2", title: "AskUserQuestion" },
+      options: [
+        { optionId: "q0_opt_0", name: "Only option", kind: "allow_once" },
+        { optionId: "q0_skip", name: "Skip", kind: "reject_once" },
+      ],
+      _meta: {
+        questions: [{ question: "Confirm?", options: [{ label: "Only option" }] }],
+      },
+    } satisfies RequestPermissionRequest);
+
+    await Promise.resolve();
+
+    const requested = events.find((event) => event.type === "permission_requested");
