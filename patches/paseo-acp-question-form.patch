+      throw new Error("Expected permission request");
+    }
+    expect(requested.request.kind).toBe("question");
+    expect(requested.request.input).toEqual({
+      questions: [
+        {
+          question: "Pick a page?",
+          header: "Page",
+          options: [
+            { label: "Page A", description: "First" },
+            { label: "Page B" },
+          ],
+          multiSelect: false,
+          allowOther: true,
+        },
+        {
+          question: "Pick tags?",
+          header: "Question 2",
+          options: [{ label: "Tag 1" }, { label: "Tag 2" }],
+          multiSelect: true,
+          allowOther: true,
+        },
+      ],
