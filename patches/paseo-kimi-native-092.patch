@@ -0,0 +1,715 @@
+import type { ChildProcess } from "node:child_process";
+import { existsSync, mkdirSync, readFileSync } from "node:fs";
+import net from "node:net";
+import os from "node:os";
+import path from "node:path";
+import pino, { type Logger } from "pino";
+
+import { spawnProcess, type SpawnProcessOptions } from "../../../../utils/spawn.js";
+import { terminateWithTreeKill, type ProcessTerminator } from "../../../../utils/tree-kill.js";
+import {
+  createManagedProcessRegistry,
+  createSystemManagedProcessTable,
+  type ManagedProcessRegistry,
+} from "../../../managed-processes/managed-processes.js";
+import { resolvePaseoHome } from "../../../paseo-home.js";
+
+/** Budget for the Kimi HTTP server to answer an authenticated request after spawn. */
+export const KIMI_SERVER_STARTUP_TIMEOUT_MS = 30_000;
+/** Every goal read/write gives up after this; a stalled sidecar must not hang a turn. */
+export const KIMI_SERVER_REQUEST_TIMEOUT_MS = 5_000;
+const KIMI_SERVER_GRACEFUL_SHUTDOWN_TIMEOUT_MS = 5_000;
+const KIMI_SERVER_FORCE_SHUTDOWN_TIMEOUT_MS = 1_000;
+const KIMI_SERVER_READINESS_POLL_INTERVAL_MS = 250;
+const KIMI_STARTUP_OUTPUT_CAP = 8_192;
+const KIMI_SERVER_TOKEN_FILE_NAME = "server.token";
+// The banner is the only place the token appears on stdout; it is a fallback for
+// a missing `server.token` file, never the primary source.
+const KIMI_SERVER_BANNER_PATTERN = /Kimi server: http:\/\/127\.0\.0\.1:(\d+)\/#token=(\S+)/;
+
+export interface KimiServerHandle {
+  /** e.g. "http://127.0.0.1:53123" (no trailing slash) */
+  baseUrl: string;
+  token: string;
+}
+
+export interface KimiServerBanner {
+  port: number;
+  token: string;
+}
+
+export interface KimiServerAcquireOptions {
+  kimiExecutable?: string;
+  logger?: Logger;
+  /** Overrides the Kimi home that holds `server.token`; also the server cwd. */
+  kimiHome?: string;
+  managedProcesses?: ManagedProcessRegistry;
+  terminateProcess?: ProcessTerminator;
+  portAllocator?: KimiPortAllocator;
+  spawnServerProcess?: KimiServerProcessSpawner;
+}
+
+export type KimiPortAllocator = () => Promise<number>;
+export type KimiServerProcessSpawner = (
+  command: string,
+  args: string[],
+  options: SpawnProcessOptions,
+) => ChildProcess;
+
+interface KimiServerGeneration {
+  process: ChildProcess;
+  port: number;
+  baseUrl: string;
+  token: string;
+  refCount: number;
+  ready: Promise<void>;
+  logger: Logger;
+  managedProcesses: ManagedProcessRegistry;
+  terminateProcess: ProcessTerminator;
+  managedProcessId?: string;
+  managedProcessRecord?: Promise<{ id: string } | null>;
+}
+
+let currentGeneration: KimiServerGeneration | null = null;
+let startPromise: Promise<KimiServerGeneration> | null = null;
+let exitHandlerRegistered = false;
+// Bumped by shutdown. A start captures the epoch before spawning and discards
+// its generation if the epoch moved, so a start racing shutdown cannot leave a
+// live process behind after shutdown() returns.
+let epoch = 0;
+let defaultLogger: Logger | null = null;
+let defaultManagedProcesses: ManagedProcessRegistry | null = null;
+
+/**
+ * Lazily starts the sidecar if needed and returns a live handle. Throws if it cannot start.
+ *
+ * The process is shared across every caller; a failure inside one acquire tears
+ * that generation down so the next acquire starts a fresh one.
+ */
+export async function acquireKimiServer(
+  options: KimiServerAcquireOptions = {},
+): Promise<KimiServerHandle> {
+  registerExitHandler();
+  const startedEpoch = epoch;
+  const generation = await getOrStartGeneration(options);
+  if (startedEpoch !== epoch) {
+    // Shutdown moved the epoch while this acquisition was waiting on a start
+    // another caller owned. Never hand back a handle to a torn-down process.
+    await killGeneration(generation);
+    throw new Error("Kimi server manager is shutting down");
+  }
+  generation.refCount += 1;
+  return { baseUrl: generation.baseUrl, token: generation.token };
+}
+
+/** Drop one reference; the process keeps running (it is shared across agents). */
+export function releaseKimiServer(): void {
+  if (!currentGeneration) {
+    return;
+  }
+  currentGeneration.refCount = Math.max(0, currentGeneration.refCount - 1);
+}
+
+/** Kill the sidecar and clear state. Called from daemon shutdown. */
+export async function shutdownKimiServer(): Promise<void> {
+  epoch += 1;
+  const pending = startPromise;
+  if (pending) {
+    // A start in flight sees the moved epoch and tears its own generation down;
+    // awaiting it here keeps shutdown from returning before that teardown.
+    await pending.catch(() => undefined);
+  }
+  const generation = currentGeneration;
+  currentGeneration = null;
+  if (generation) {
+    await killGeneration(generation);
+  }
+}
+
+/** Outcome of one sidecar HTTP call. `ok` is false for any transport or envelope failure. */
+export interface KimiServerResult<T = unknown> {
+  ok: boolean;
+  data: T | null;
+}
+
+/** Cheap GET against the sidecar. Returns null on any failure (never throws). */
+export async function kimiServerGet<T = unknown>(
+  handle: KimiServerHandle,
+  requestPath: string,
+): Promise<T | null> {
+  const result = await requestKimiServer<T>(handle, requestPath, { method: "GET" });
+  return result.data;
+}
+
+/** Cheap POST JSON against the sidecar. Returns null on any failure (never throws). */
+export async function kimiServerPost<T = unknown>(
+  handle: KimiServerHandle,
+  requestPath: string,
+  body: unknown,
+): Promise<T | null> {
+  const result = await requestKimiServer<T>(handle, requestPath, { method: "POST", body });
+  return result.data;
+}
+
+/**
+ * POST JSON and report whether the call itself succeeded.
+ *
+ * `kimiServerPost` cannot tell "transport failed" apart from "succeeded with an
+ * empty payload". Side-effect calls such as goal control only care about the
+ * former, so they use this variant.
+ */
+export async function kimiServerPostChecked<T = unknown>(
+  handle: KimiServerHandle,
+  requestPath: string,
+  body: unknown,
+): Promise<KimiServerResult<T>> {
+  return requestKimiServer<T>(handle, requestPath, { method: "POST", body });
+}
+
+/**
+ * Resolve the Kimi executable: explicit argument, else KIMI_EXECUTABLE env, else
+ * `~/.kimi-code/bin/kimi.exe` on win32 / `~/.kimi-code/bin/kimi` otherwise, else
+ * `kimi` on PATH.
+ */
+export function resolveKimiExecutable(
+  explicit?: string,
+  options: KimiExecutableResolutionOptions = {},
+): string {
+  if (explicit && explicit.trim().length > 0) {
+    return explicit;
+  }
+
+  const env = options.env ?? process.env;
+  const fromEnv = env.KIMI_EXECUTABLE?.trim();
+  if (fromEnv) {
+    return fromEnv;
+  }
+
+  const platform = options.platform ?? process.platform;
+  const homeDir = options.homeDir ?? resolveKimiHomeDir(env);
+  const candidate = path.join(homeDir, "bin", platform === "win32" ? "kimi.exe" : "kimi");
+  const exists = options.exists ?? existsSync;
+  return exists(candidate) ? candidate : "kimi";
+}
+
+export interface KimiExecutableResolutionOptions {
+  env?: NodeJS.ProcessEnv;
+  platform?: NodeJS.Platform;
+  homeDir?: string;
+  exists?: (filePath: string) => boolean;
+}
+
+/** Kimi home that holds `server.token`; KIMI_HOME wins, then KIMI_CODE_HOME. */
+export function resolveKimiHomeDir(env: NodeJS.ProcessEnv = process.env): string {
+  const raw = env.KIMI_HOME ?? env.KIMI_CODE_HOME ?? "~/.kimi-code";
+  return path.resolve(expandTilde(raw));
+}
+
+function expandTilde(input: string): string {
+  if (input === "~") {
+    return os.homedir();
+  }
+  if (input.startsWith("~/") || input.startsWith("~\\")) {
+    return path.join(os.homedir(), input.slice(2));
+  }
+  return input;
+}
+
+/** Extract port and bearer token from the startup banner line. */
+export function parseKimiServerBanner(stdout: string): KimiServerBanner | null {
+  const match = KIMI_SERVER_BANNER_PATTERN.exec(stdout);
+  if (!match) {
+    return null;
+  }
+  const port = Number.parseInt(match[1], 10);
+  if (!Number.isInteger(port) || port <= 0) {
+    return null;
+  }
+  const token = match[2];
+  if (token.length === 0) {
+    return null;
+  }
+  return { port, token };
+}
+
+/** Token from the startup banner line, or null when the line never appeared. */
+export function extractKimiServerToken(stdout: string): string | null {
+  return parseKimiServerBanner(stdout)?.token ?? null;
+}
+
+/**
+ * Unwrap the `{ code, msg, data, request_id }` envelope every Kimi endpoint
+ * returns. A non-zero `code`, a missing envelope, or unparseable JSON all
+ * collapse to null so callers treat "no usable answer" as one case.
+ */
+export function isKimiEnvelopeSuccess(payload: unknown): boolean {
+  if (typeof payload !== "object" || payload === null) {
+    return false;
+  }
+  return (payload as { code?: unknown }).code === 0;
+}
+
+export function unwrapKimiEnvelope<T = unknown>(payload: unknown): T | null {
+  if (!isKimiEnvelopeSuccess(payload)) {
+    return null;
+  }
+  return ((payload as { data?: unknown }).data ?? null) as T;
+}
+
+interface KimiServerRequestInit {
+  method: "GET" | "POST";
+  body?: unknown;
+}
+
+async function requestKimiServer<T>(
+  handle: KimiServerHandle,
+  requestPath: string,
+  init: KimiServerRequestInit,
+): Promise<KimiServerResult<T>> {
+  const headers: Record<string, string> = {
+    accept: "application/json",
+    authorization: `Bearer ${handle.token}`,
+  };
+  const requestInit: RequestInit = { method: init.method, headers };
+  if (init.body !== undefined) {
+    headers["content-type"] = "application/json";
+    requestInit.body = JSON.stringify(init.body);
+  }
+  requestInit.signal = AbortSignal.timeout(KIMI_SERVER_REQUEST_TIMEOUT_MS);
+
+  try {
+    const response = await fetch(joinKimiServerUrl(handle.baseUrl, requestPath), requestInit);
+    if (!response.ok) {
+      return { ok: false, data: null };
+    }
+    const payload: unknown = await response.json();
+    return { ok: isKimiEnvelopeSuccess(payload), data: unwrapKimiEnvelope<T>(payload) };
+  } catch {
+    return { ok: false, data: null };
+  }
+}
+
+function joinKimiServerUrl(baseUrl: string, requestPath: string): string {
+  const trimmedBase = baseUrl.replace(/\/+$/, "");
+  if (requestPath.startsWith("/")) {
+    return `${trimmedBase}${requestPath}`;
+  }
+  return `${trimmedBase}/${requestPath}`;
+}
+
+async function getOrStartGeneration(
+  options: KimiServerAcquireOptions,
+): Promise<KimiServerGeneration> {
+  if (startPromise) {
+    return startPromise;
+  }
+  if (currentGeneration && isGenerationLive(currentGeneration)) {
+    return currentGeneration;
+  }
+
+  const startedEpoch = epoch;
+  const start = startGeneration(options);
+  startPromise = start;
+  try {
+    const generation = await start;
+    if (startedEpoch !== epoch) {
+      await killGeneration(generation);
+      throw new Error("Kimi server manager is shutting down");
+    }
+    currentGeneration = generation;
+    return generation;
+  } finally {
+    if (startPromise === start) {
+      startPromise = null;
+    }
+  }
+}
+
+async function startGeneration(
+  options: KimiServerAcquireOptions,
+): Promise<KimiServerGeneration> {
+  const logger = (options.logger ?? getDefaultLogger()).child({ module: "kimi.server" });
+  const managedProcesses = options.managedProcesses ?? getDefaultManagedProcesses(logger);
+  const port = await (options.portAllocator ?? allocateLoopbackPort)();
+  const baseUrl = `http://127.0.0.1:${port}`;
+  const command = resolveKimiExecutable(options.kimiExecutable);
+  const args = ["web", "--port", String(port), "--no-open", "--log-level", "silent"];
+  // Run from the Kimi home so the server keeps its token file and caches in one
+  // place, and never inherits a random workspace as its cwd.
+  const kimiHome = options.kimiHome ?? resolveKimiHomeDir();
+  mkdirSync(kimiHome, { recursive: true });
+
+  const spawnServerProcess = options.spawnServerProcess ?? spawnProcess;
+  const serverProcess = spawnServerProcess(command, args, {
+    cwd: kimiHome,
+    detached: process.platform !== "win32",
+    stdio: ["ignore", "pipe", "pipe"],
+    windowsHide: true,
+  });
+  const managedProcessRecord = recordManagedServerProcess({
+    managedProcesses,
+    logger,
+    process: serverProcess,
+    command,
+    args,
+    port,
+  });
+  const generation: KimiServerGeneration = {
+    process: serverProcess,
+    port,
+    baseUrl,
+    token: "",
+    refCount: 0,
+    ready: Promise.resolve(),
+    logger,
+    managedProcesses,
+    terminateProcess: options.terminateProcess ?? terminateWithTreeKill,
+    managedProcessRecord,
+  };
+  logger.info({ pid: serverProcess.pid, port, baseUrl }, "Kimi server generation started");
+  void managedProcessRecord.then((record) => {
+    if (record && generation.managedProcessRecord === managedProcessRecord) {
+      generation.managedProcessId = record.id;
+    }
+    return undefined;
+  });
+
+  generation.ready = waitForServerReady({ generation, kimiHome, logger });
+  try {
+    await generation.ready;
+  } catch (error) {
+    await killGeneration(generation);
+    if (currentGeneration === generation) {
+      currentGeneration = null;
+    }
+    throw error;
+  }
+  return generation;
+}
+
+interface WaitForServerReadyInput {
+  generation: KimiServerGeneration;
+  kimiHome: string;
+  logger: Logger;
+}
+
+function waitForServerReady(input: WaitForServerReadyInput): Promise<void> {
+  const { generation, kimiHome, logger } = input;
+  const serverProcess = generation.process;
+  const tokenFilePath = path.join(kimiHome, KIMI_SERVER_TOKEN_FILE_NAME);
+  let stderrBuffer = "";
+  let stdoutBuffer = "";
+  let bannerToken: string | null = null;
+
+  return new Promise<void>((resolve, reject) => {
+    let settled = false;
+    let timer: NodeJS.Timeout | null = null;
+    const deadline = Date.now() + KIMI_SERVER_STARTUP_TIMEOUT_MS;
+
+    const stopTimer = () => {
+      if (timer) {
+        clearTimeout(timer);
+        timer = null;
+      }
+    };
+    const fail = (headline: string) => {
+      if (settled) {
+        return;
+      }
+      settled = true;
+      stopTimer();
+      const message = buildStartupErrorMessage(headline, stderrBuffer, stdoutBuffer, bannerToken);
+      reject(new Error(message));
+    };
+    const succeed = (token: string) => {
+      if (settled) {
+        return;
+      }
+      settled = true;
+      stopTimer();
+      generation.token = token;
+      resolve();
+    };
+
+    const tokenCandidates = (): string[] => {
+      const fileToken = readKimiTokenFile(tokenFilePath);
+      const candidates = fileToken ? [fileToken] : [];
+      if (bannerToken && bannerToken !== fileToken) {
+        candidates.push(bannerToken);
+      }
+      return candidates;
+    };
+
+    const poll = async (): Promise<void> => {
+      if (settled) {
+        return;
+      }
+      for (const candidate of tokenCandidates()) {
+        if (await probeKimiServerMeta(generation.baseUrl, candidate)) {
+          succeed(candidate);
+          return;
+        }
+      }
+      if (serverProcess.exitCode !== null || serverProcess.signalCode !== null) {
+        fail("Kimi server exited before it became ready");
+        return;
+      }
+      if (Date.now() >= deadline) {
+        fail("Kimi server startup timeout");
+        return;
+      }
+      timer = setTimeout(() => {
+        void poll();
+      }, KIMI_SERVER_READINESS_POLL_INTERVAL_MS);
+    };
+
+    serverProcess.stdout?.on("data", (data: Buffer) => {
+      const output = data.toString();
+      stdoutBuffer = appendCapped(stdoutBuffer, output, KIMI_STARTUP_OUTPUT_CAP);
+      const banner = parseKimiServerBanner(output) ?? parseKimiServerBanner(stdoutBuffer);
+      if (banner) {
+        bannerToken = banner.token;
+      }
+    });
+
+    serverProcess.stderr?.on("data", (data: Buffer) => {
+      const output = data.toString();
+      stderrBuffer = appendCapped(stderrBuffer, output, KIMI_STARTUP_OUTPUT_CAP);
+      logger.error({ stderr: redactKimiToken(output.trim(), bannerToken) }, "Kimi server stderr");
+    });
+
+    serverProcess.on("error", (error) => {
+      const headline = error instanceof Error ? error.message : String(error);
+      fail(headline);
+    });
+
+    serverProcess.on("exit", (code, signal) => {
+      logger.info(
+        { pid: serverProcess.pid, port: generation.port, code, signal },
+        "Kimi server generation exited",
+      );
+      removeManagedServerRecord(generation);
+      if (currentGeneration === generation) {
+        currentGeneration = null;
+      }
+      fail(`Kimi server exited with code ${code}`);
+    });
+
+    void poll();
+  });
+}
+
+async function probeKimiServerMeta(baseUrl: string, token: string): Promise<boolean> {
+  try {
+    const response = await fetch(`${baseUrl}/api/v1/meta`, {
+      method: "GET",
+      headers: { authorization: `Bearer ${token}` },
+      signal: AbortSignal.timeout(KIMI_SERVER_REQUEST_TIMEOUT_MS),
+    });
+    return response.status === 200;
+  } catch {
+    return false;
+  }
+}
+
+function readKimiTokenFile(tokenFilePath: string): string | null {
+  try {
+    const token = readFileSync(tokenFilePath, "utf8").trim();
+    return token.length > 0 ? token : null;
+  } catch {
+    return null;
+  }
+}
+
+function buildStartupErrorMessage(
+  headline: string,
+  stderrBuffer: string,
+  stdoutBuffer: string,
+  token: string | null,
+): string {
+  const sections = [headline];
+  const stderr = stderrBuffer.trim();
+  if (stderr.length > 0) {
+    sections.push(`stderr: ${redactKimiToken(stderr, token)}`);
+  }
+  const stdout = stdoutBuffer.trim();
+  if (stdout.length > 0) {
+    sections.push(`stdout: ${redactKimiToken(stdout, token)}`);
+  }
+  return sections.join("\n");
+}
+
+function redactKimiToken(text: string, token: string | null): string {
+  let redacted = text.replace(/([#?&]token=)[^\s&"']+/gi, "$1<redacted>");
+  if (token && token.length > 0) {
+    redacted = redacted.split(token).join("<redacted>");
+  }
+  return redacted;
+}
+
+function appendCapped(current: string, chunk: string, cap: number): string {
+  if (current.length >= cap) {
+    return current;
+  }
+  return current + chunk.slice(0, cap - current.length);
+}
+
+function isGenerationLive(generation: KimiServerGeneration): boolean {
+  return (
+    !generation.process.killed &&
+    generation.process.exitCode === null &&
+    generation.process.signalCode === null
+  );
+}
+
+async function killGeneration(generation: KimiServerGeneration): Promise<void> {
+  const { process: child, logger } = generation;
+  if (child.exitCode !== null || child.signalCode !== null) {
+    removeManagedServerRecord(generation);
+    return;
+  }
+
+  const result = await generation.terminateProcess(child, {
+    gracefulTimeoutMs: KIMI_SERVER_GRACEFUL_SHUTDOWN_TIMEOUT_MS,
+    forceTimeoutMs: KIMI_SERVER_FORCE_SHUTDOWN_TIMEOUT_MS,
+    onForceSignal: () => {
+      logger.warn(
+        { timeoutMs: KIMI_SERVER_GRACEFUL_SHUTDOWN_TIMEOUT_MS },
+        "Kimi server did not exit after SIGTERM; sending SIGKILL",
+      );
+    },
+  });
+  if (result === "kill-timeout") {
+    logger.warn(
+      { timeoutMs: KIMI_SERVER_FORCE_SHUTDOWN_TIMEOUT_MS },
+      "Kimi server did not report exit after SIGKILL",
+    );
+  }
+
+  if (generation.managedProcessId) {
+    const id = generation.managedProcessId;
+    generation.managedProcessId = undefined;
+    generation.managedProcessRecord = undefined;
+    await removeManagedProcessId(generation.managedProcesses, id, logger);
+    return;
+  }
+  removeManagedServerRecord(generation);
+}
+
+function recordManagedServerProcess(input: {
+  managedProcesses: ManagedProcessRegistry;
+  logger: Logger;
+  process: ChildProcess;
+  command: string;
+  args: string[];
+  port: number;
+}): Promise<{ id: string } | null> {
+  const pid = input.process.pid;
+  if (typeof pid !== "number" || pid <= 0) {
+    return Promise.resolve(null);
+  }
+
+  return input.managedProcesses
+    .record({
+      owner: { provider: "kimi", kind: "helper-server" },
+      pid,
+      command: input.command,
+      args: input.args,
+      metadata: { port: input.port },
+    })
+    .catch((error: unknown) => {
+      input.logger.warn(
+        { err: error, pid, port: input.port },
+        "Failed to record Kimi helper process",
+      );
+      return null;
+    });
+}
+
+function removeManagedServerRecord(generation: KimiServerGeneration): void {
+  const record = generation.managedProcessRecord;
+  generation.managedProcessRecord = undefined;
+  if (generation.managedProcessId) {
+    const id = generation.managedProcessId;
+    generation.managedProcessId = undefined;
+    void removeManagedProcessId(generation.managedProcesses, id, generation.logger);
+    return;
+  }
+  if (record) {
+    void record.then((resolved) => {
+      if (resolved) {
+        return removeManagedProcessId(
+          generation.managedProcesses,
+          resolved.id,
+          generation.logger,
+        );
+      }
+      return undefined;
+    });
+  }
+}
+
+async function removeManagedProcessId(
+  managedProcesses: ManagedProcessRegistry,
+  id: string,
+  logger: Logger,
+): Promise<void> {
+  try {
+    await managedProcesses.remove(id);
+  } catch (error) {
+    logger.warn({ err: error, id }, "Failed to remove Kimi helper process record");
+  }
+}
+
+function allocateLoopbackPort(): Promise<number> {
+  return new Promise((resolve, reject) => {
+    const server = net.createServer();
+    server.on("error", reject);
+    server.listen(0, "127.0.0.1", () => {
+      const address = server.address();
+      server.close(() => {
+        if (typeof address === "object" && address) {
+          resolve(address.port);
+        } else {
+          reject(new Error("Failed to allocate a loopback port for the Kimi server"));
+        }
+      });
+    });
+  });
+}
+
+function getDefaultLogger(): Logger {
+  if (!defaultLogger) {
+    defaultLogger = pino({
+      level: process.env.PASEO_LOG_LEVEL ?? "info",
+    }).child({ module: "kimi.server" });
+  }
+  return defaultLogger;
+}
+
+function getDefaultManagedProcesses(logger: Logger): ManagedProcessRegistry {
+  if (!defaultManagedProcesses) {
+    defaultManagedProcesses = createManagedProcessRegistry({
+      paseoHome: resolvePaseoHome(),
+      processTable: createSystemManagedProcessTable(),
+      terminateProcess: terminateWithTreeKill,
+      logger,
+    });
+  }
+  return defaultManagedProcesses;
+}
+
+function registerExitHandler(): void {
+  if (exitHandlerRegistered) {
+    return;
+  }
+  exitHandlerRegistered = true;
+
+  const cleanup = () => {
+    void shutdownKimiServer();
+  };
+
+  process.on("exit", cleanup);
+  process.on("SIGTERM", cleanup);
+  process.on("SIGINT", cleanup);
+}
