+  /** Latest derived goal, or null. */
+  getGoal(): AgentGoal | null {
+    return this.goal;
+  }
+
+  /** True while the goal is still being pursued. */
+  isLive(): boolean {
+    return isAgentGoalLive(this.goal);
+  }
+
+  /**
+   * Resolves once the goal stops being live, on timeout, or as soon as `signal`
+   * aborts. The abort path is what keeps a held ACP turn from outliving the
+   * turn it belongs to.
+   */
+  async waitForSettled(timeoutMs: number, signal?: AbortSignal): Promise<void> {
+    if (signal?.aborted === true) {
+      return;
+    }
+    if (!this.isLive()) {
+      return;
+    }
