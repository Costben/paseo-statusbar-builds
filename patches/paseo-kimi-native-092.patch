+        : `Failed to ${command.action} the goal.`;
+    case "status":
+      return describeKimiGoal(bridge.getGoal());
+  }
+}
+
+function describeKimiGoal(goal: AgentGoal | null): string {
+  if (!goal) {
+    return "No goal is set.";
+  }
+  const counters = `${goal.turnsUsed} turns, ${goal.tokensUsed} tokens`;
+  const reason = goal.terminalReason ? ` (${goal.terminalReason})` : "";
+  return `Goal "${goal.objective}" is ${goal.status} (${counters})${reason}.`;
+}
diff --git a/packages/server/src/server/agent/providers/kimi/native-bridge.ts b/packages/server/src/server/agent/providers/kimi/native-bridge.ts
new file mode 100644
index 0000000..4662b08
--- /dev/null
+++ b/packages/server/src/server/agent/providers/kimi/native-bridge.ts
@@ -0,0 +1,344 @@
+import type { Logger } from "pino";
+
+import {
+  isAgentGoalLive,
+  type AgentGoal,
+  type AgentGoalStatus,
+  type AgentProvider,
+  type AgentStreamEvent,
+  type AgentUsage,
+} from "../../agent-sdk-types.js";
+import {
+  acquireKimiServer,
+  kimiServerGet,
+  kimiServerPostChecked,
+  releaseKimiServer,
+  type KimiServerHandle,
+} from "./web-server-manager.js";
+
+// Kimi keeps driving a goal after the ACP prompt returns, so the bridge watches
+// the local HTTP server instead of the ACP stream. Polling is deliberately
+// coarse: the old sidecar proxy was criticised for hammering the daemon.
+const LIVE_POLL_INTERVAL_MS = 2_000;
+const IDLE_POLL_INTERVAL_MS = 10_000;
+const SETTLE_POLL_INTERVAL_MS = 250;
+
+type KimiServerPayload = Record<string, unknown>;
+
+export interface KimiNativeBridgeOptions {
+  kimiSessionId: string;
+  kimiExecutable?: string;
+  logger: Logger;
+  /** Push a provider stream event into the owning ACP session. */
+  emit: (event: AgentStreamEvent) => void;
+  /** Provider id, for the events' `provider` field. */
+  provider: AgentProvider;
+}
+
+/**
+ * Native goal/usage bridge for one live Kimi ACP session. Every ACP session id
+ * is also a Kimi session id, so the same id addresses the local HTTP routes.
+ *
+ * The bridge is inert when the sidecar cannot be acquired: it never throws, so
+ * a missing `kimi web` server degrades to "no goal tracking" instead of
+ * breaking the agent.
+ */
+export class KimiNativeBridge {
+  private readonly kimiSessionId: string;
+  private readonly kimiExecutable?: string;
+  private readonly logger: Logger;
+  private readonly emit: (event: AgentStreamEvent) => void;
+  private readonly provider: AgentProvider;
+
+  private handle: KimiServerHandle | null = null;
+  private timer: ReturnType<typeof setTimeout> | null = null;
+  private started = false;
+  private stopped = false;
+  private goal: AgentGoal | null = null;
+  /** null means "nothing reported yet", so the first observation can be silent. */
+  private goalSignature: string | null = null;
+  private usageSignature: string | null = null;
+
+  constructor(options: KimiNativeBridgeOptions) {
+    this.kimiSessionId = options.kimiSessionId;
+    this.kimiExecutable = options.kimiExecutable;
+    this.logger = options.logger;
+    this.emit = options.emit;
+    this.provider = options.provider;
+  }
+
+  /** Idempotent. Starts polling. */
+  start(): void {
+    if (this.started || this.stopped) {
+      return;
+    }
+    this.started = true;
+    void this.acquire();
+  }
+
+  /** Idempotent. Stops polling and releases the sidecar reference. */
+  stop(): void {
+    if (this.stopped) {
+      return;
+    }
+    this.stopped = true;
+    this.clearTimer();
+    if (this.handle) {
+      this.handle = null;
+      releaseKimiServer();
+    }
+  }
+
+  /** Latest known goal, or null. */
+  getGoal(): AgentGoal | null {
+    return this.goal;
+  }
+
+  /** True while the provider is still working toward the goal. */
+  isGoalLive(): boolean {
+    return isAgentGoalLive(this.goal);
+  }
+
+  /** Resolves when the goal stops being live, or after `timeoutMs`. */
+  async waitForGoalSettled(timeoutMs: number): Promise<void> {
+    if (!this.isGoalLive()) {
+      return;
+    }
+    const deadline = Date.now() + Math.max(0, timeoutMs);
+    while (!this.stopped && this.isGoalLive()) {
+      const remaining = deadline - Date.now();
+      if (remaining <= 0) {
+        return;
+      }
+      await delay(Math.min(SETTLE_POLL_INTERVAL_MS, remaining));
+    }
+  }
+
+  /** Issue a goal control call. Returns true on success. */
+  async control(action: "pause" | "resume" | "cancel"): Promise<boolean> {
+    const handle = this.handle;
+    if (!handle) {
+      return false;
+    }
+    const result = await kimiServerPostChecked(handle, this.profilePath(), {
+      agent_config: { goal_control: action },
+    });
+    if (!result.ok) {
+      return false;
+    }
+    this.refreshSoon();
+    return true;
+  }
+
+  /** Create a goal. Returns true on success. */
+  async createGoal(objective: string): Promise<boolean> {
+    const handle = this.handle;
+    if (!handle) {
+      return false;
+    }
+    const result = await kimiServerPostChecked(handle, this.profilePath(), {
+      agent_config: { goal_objective: objective },
+    });
+    if (!result.ok) {
+      return false;
+    }
+    this.refreshSoon();
+    return true;
+  }
+
+  private async acquire(): Promise<void> {
+    let handle: KimiServerHandle;
+    try {
+      handle = await acquireKimiServer({
+        kimiExecutable: this.kimiExecutable,
+        logger: this.logger,
+      });
+    } catch (error) {
+      this.logger.warn(
+        { err: error, sessionId: this.kimiSessionId },
+        "Kimi native bridge could not acquire the local Kimi server; goal tracking is disabled",
+      );
+      return;
+    }
+    if (this.stopped) {
+      releaseKimiServer();
+      return;
+    }
+    this.handle = handle;
+    this.scheduleTick(0);
+  }
+
+  /** Re-poll as soon as possible so a mutation shows up without waiting for the idle cadence. */
+  private refreshSoon(): void {
+    if (this.handle) {
+      this.scheduleTick(0);
+    }
+  }
+
+  private scheduleTick(delayMs: number): void {
+    this.clearTimer();
+    if (this.stopped) {
+      return;
+    }
+    this.timer = setTimeout(() => {
+      this.timer = null;
+      void this.tick();
+    }, delayMs);
+    this.timer.unref();
+  }
+
+  private clearTimer(): void {
+    if (this.timer) {
+      clearTimeout(this.timer);
+      this.timer = null;
+    }
+  }
+
+  private async tick(): Promise<void> {
+    let intervalMs = IDLE_POLL_INTERVAL_MS;
+    try {
+      const handle = this.handle;
+      if (handle && !this.stopped) {
+        const goalPayload = await kimiServerGet<KimiServerPayload>(
+          handle,
+          this.sessionPath("goal"),
+        );
+        const statusPayload = await kimiServerGet<KimiServerPayload>(
+          handle,
+          this.sessionPath("status"),
+        );
+        if (!this.stopped) {
+          this.applyGoal(goalPayload);
+          this.applyUsage(statusPayload);
+          if (this.isGoalLive() || statusPayload?.busy === true) {
+            intervalMs = LIVE_POLL_INTERVAL_MS;
+          }
+        }
+      }
+    } catch (error) {
+      this.logger.warn(
+        { err: error, sessionId: this.kimiSessionId },
+        "Kimi native bridge poll failed",
+      );
+    }
+    this.scheduleTick(intervalMs);
+  }
+
+  private applyGoal(payload: KimiServerPayload | null): void {
+    const goal = mapKimiGoal(payload);
+    const signature = goalSignature(goal);
+    if (this.goalSignature === signature) {
+      return;
+    }
+    const isFirstObservation = this.goalSignature === null;
+    this.goalSignature = signature;
+    this.goal = goal;
+    if (isFirstObservation && goal === null) {
+      return;
+    }
+    this.emit({ type: "goal_updated", provider: this.provider, goal });
+  }
+
+  private applyUsage(payload: KimiServerPayload | null): void {
+    if (!payload) {
+      return;
+    }
+    const used = readNumber(payload.context_tokens);
+    const max = readNumber(payload.max_context_tokens);
+    if (used === undefined && max === undefined) {
+      return;
+    }
+    const signature = `${used ?? "-"}/${max ?? "-"}`;
+    if (signature === this.usageSignature) {
+      return;
+    }
+    this.usageSignature = signature;
+    const usage: AgentUsage = {};
+    if (used !== undefined) {
+      usage.contextWindowUsedTokens = used;
+    }
+    if (max !== undefined) {
+      usage.contextWindowMaxTokens = max;
+    }
+    this.emit({ type: "usage_updated", provider: this.provider, usage });
+  }
+
+  private sessionPath(route: string): string {
+    return `/api/v1/sessions/${encodeURIComponent(this.kimiSessionId)}/${route}`;
+  }
+
+  private profilePath(): string {
+    return this.sessionPath("profile");
+  }
+}
+
+function mapKimiGoal(payload: KimiServerPayload | null): AgentGoal | null {
+  if (!payload) {
+    return null;
+  }
+  const status = payload.status;
+  if (!isGoalStatus(status)) {
+    return null;
+  }
+  const terminalReason = readString(payload.terminalReason);
+  return {
+    goalId: readString(payload.goalId) ?? "",
+    objective: readString(payload.objective) ?? "",
+    status,
+    turnsUsed: readNumber(payload.turnsUsed) ?? 0,
+    tokensUsed: readNumber(payload.tokensUsed) ?? 0,
+    // Kimi reports no timestamps; `wallClockMs` advances every tick and would
+    // make every poll look like a change, so it stays out of the goal.
+    updatedAt: Date.now(),
+    ...(terminalReason !== undefined ? { terminalReason } : {}),
+  };
+}
+
+/**
+ * Change detector for `goal_updated`. Only fields a reader can act on take part:
+ * `updatedAt` is stamped locally and `wallClockMs` moves on every poll.
+ *
+ * The signature is bucketed by time so an unchanged goal is re-announced every
+ * 30s. The bridge emits only on change, so a state that arrived before the
+ * consumer subscribed would otherwise be lost for the lifetime of the session.
+ * Re-announcing is free on the client: the app's directory-update policy
+ * compares goals by value and keeps the existing object when they are equal.
+ */
+function goalSignature(goal: AgentGoal | null): string {
+  const bucket = Math.floor(Date.now() / 30_000);
+  if (!goal) {
+    return `null#${bucket}`;
+  }
+  return `${JSON.stringify([
+    goal.goalId,
+    goal.objective,
+    goal.status,
+    goal.turnsUsed,
+    goal.tokensUsed,
+    goal.terminalReason ?? "",
+  ])}#${bucket}`;
+}
+
+function isGoalStatus(value: unknown): value is AgentGoalStatus {
+  return (
+    value === "active" ||
+    value === "paused" ||
+    value === "blocked" ||
+    value === "complete" ||
+    value === "cleared"
+  );
+}
+
+function readString(value: unknown): string | undefined {
+  return typeof value === "string" ? value : undefined;
+}
+
+function readNumber(value: unknown): number | undefined {
+  return typeof value === "number" && Number.isFinite(value) ? value : undefined;
+}
+
+function delay(ms: number): Promise<void> {
+  return new Promise((resolve) => {
+    setTimeout(resolve, ms);
+  });
+}
diff --git a/packages/server/src/server/agent/providers/kimi/web-server-manager.test.ts b/packages/server/src/server/agent/providers/kimi/web-server-manager.test.ts
