+import { closeSync, createReadStream, existsSync, openSync, readdirSync, readSync } from "node:fs";
+import { stat } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { createInterface } from "node:readline";
+
+import type { Logger } from "pino";
+
+import {
+  isAgentGoalLive,
+  type AgentGoal,
+  type AgentGoalStatus,
+  type AgentUsage,
+} from "../../agent-sdk-types.js";
+
+/**
+ * Kimi Code writes one JSON object per line to
+ * `<kimiHome>/sessions/<wd-slug>/<sessionId>/agents/main/wire.jsonl`.
+ *
+ * That file is the only cross-process source of truth for a session's goal and
+ * context usage: the `kimi web` HTTP server materializes a *separate, empty*
+ * runtime for a session another process owns, so it reports zeros and accepts
+ * goals the talking agent never sees. The owning process appends to this log,
+ * and both processes share it on disk.
+ *
+ * The ACP session id is the `<sessionId>` directory name, so the log path is
+ * derivable from the id the daemon already holds.
+ */
+
+const LIVE_POLL_INTERVAL_MS = 2_000;
+const IDLE_POLL_INTERVAL_MS = 10_000;
+const SETTLE_POLL_INTERVAL_MS = 250;
+/** Unchanged goals are re-announced once per bucket so a late subscriber still sees them. */
+const GOAL_REANNOUNCE_BUCKET_MS = 30_000;
+const DEFAULT_KIMI_HOME = "~/.kimi-code";
+
+/**
+ * Locate the wire log for a Kimi session. Returns null when the file does not
+ * exist yet (the session may not have produced output) or the home directory is
+ * unreadable; callers retry on their next poll.
+ */
+export function resolveKimiWireLogPath(
+  kimiSessionId: string,
+  options: { kimiHome?: string } = {},
+): string | null {
+  if (kimiSessionId.length === 0) {
+    return null;
+  }
+  const sessionsDir = path.join(resolveKimiHome(options.kimiHome), "sessions");
+  let entries: string[];
+  try {
+    entries = readdirSync(sessionsDir);
+  } catch {
+    return null;
+  }
+  for (const entry of entries) {
+    const candidate = path.join(sessionsDir, entry, kimiSessionId, "agents", "main", "wire.jsonl");
+    try {
+      if (existsSync(candidate)) {
+        return candidate;
+      }
+    } catch {
+      // Keep scanning; one unreadable slug must not hide the real one.
+    }
+  }
+  return null;
+}
+
+/** Derived state of a session log after replaying a batch of lines. */
+export interface KimiSessionLogState {
+  goal: AgentGoal | null;
+  contextWindowUsedTokens: number | null;
+}
+
+export const EMPTY_KIMI_SESSION_LOG_STATE: KimiSessionLogState = Object.freeze({
+  goal: null,
+  contextWindowUsedTokens: null,
+});
+
+/**
+ * Replay raw log lines onto a previous state. Pure and side-effect free so the
+ * derivation rules are testable without a filesystem.
+ *
+ * Records the daemon relies on:
+ * - `goal.create` sets the goal to `active` with zeroed counters.
+ * - `goal.update` carries either `tokensUsed` (one per goal turn) or `status`.
+ * - `goal.clear` drops the goal.
+ * - `token_counting.turn_recorded` reports the real context size.
+ *
+ * Anything unparseable is skipped; a half-written line must not abort a replay.
+ */
+export function parseKimiSessionLogLines(
+  lines: Iterable<string>,
+  previous: KimiSessionLogState,
+): KimiSessionLogState {
+  let goal = previous.goal;
+  let contextWindowUsedTokens = previous.contextWindowUsedTokens;
+
+  for (const raw of lines) {
+    const line = raw.trim();
+    if (line.length === 0) {
+      continue;
+    }
+    let record: unknown;
+    try {
+      record = JSON.parse(line);
+    } catch {
+      continue;
+    }
+    if (typeof record !== "object" || record === null) {
+      continue;
+    }
+    const entry = record as Record<string, unknown>;
+    switch (entry.type) {
+      case "goal.create":
+        goal = createGoalFromRecord(entry);
+        break;
+      case "goal.update":
+        goal = applyGoalUpdate(goal, entry);
+        break;
+      case "goal.clear":
+        goal = null;
+        break;
+      case "token_counting.turn_recorded": {
+        const tokens = readNumber(entry.tokens);
+        if (tokens !== undefined) {
+          contextWindowUsedTokens = tokens;
+        }
+        break;
+      }
+      default:
+        break;
+    }
+  }
+
+  return { goal, contextWindowUsedTokens };
+}
+
+export interface KimiSessionLogOptions {
+  kimiSessionId: string;
+  kimiHome?: string;
+  logger: Logger;
+  /** Overrides both cadences. Defaults to 2000ms while a goal is live, 10000ms otherwise. */
+  pollIntervalMs?: number;
+  onGoal?: (goal: AgentGoal | null) => void;
+  onUsage?: (usage: AgentUsage) => void;
+}
+
+/**
+ * Tails one session's wire log and reports the goal/usage it describes.
+ *
+ * Reads incrementally by byte offset, so a long session is never re-read. A
+ * goal created before the tailer attached is still picked up because the first
+ * read starts at byte 0.
+ */
+export class KimiSessionLog {
+  private readonly kimiSessionId: string;
+  private readonly kimiHome: string | undefined;
+  private readonly logger: Logger;
+  private readonly liveIntervalMs: number;
+  private readonly idleIntervalMs: number;
+  private readonly onGoal: ((goal: AgentGoal | null) => void) | undefined;
+  private readonly onUsage: ((usage: AgentUsage) => void) | undefined;
+
+  private resolvedPath: string | null = null;
+  private offset = 0;
+  /** Bytes of an unterminated trailing line, held until the next tick completes it. */
+  private pending = "";
+  private goal: AgentGoal | null = null;
+  private contextWindowUsedTokens: number | null = null;
+  /** Value signature of the last goal considered; null means "nothing considered yet". */
+  private goalSignature: string | null = null;
+  private goalBucket = -1;
+  private emittedGoal = false;
+  private usageSignature: string | null = null;
+
+  private timer: ReturnType<typeof setTimeout> | null = null;
+  private started = false;
+  private stopped = false;
+
+  constructor(options: KimiSessionLogOptions) {
+    this.kimiSessionId = options.kimiSessionId;
+    this.kimiHome = options.kimiHome;
+    this.logger = options.logger;
+    this.liveIntervalMs = options.pollIntervalMs ?? LIVE_POLL_INTERVAL_MS;
+    this.idleIntervalMs = options.pollIntervalMs ?? IDLE_POLL_INTERVAL_MS;
+    this.onGoal = options.onGoal;
+    this.onUsage = options.onUsage;
+  }
