+import path from "node:path";
+import { describe, expect, test } from "vitest";
+
+import {
+  extractKimiServerToken,
+  parseKimiServerBanner,
+  resolveKimiExecutable,
+  unwrapKimiEnvelope,
+} from "./web-server-manager.js";
+
+describe("resolveKimiExecutable", () => {
+  test("prefers an explicit path over the env and the home binary", () => {
+    expect(
+      resolveKimiExecutable("C:/tools/kimi.exe", {
+        env: { KIMI_EXECUTABLE: "/env/kimi" },
+        platform: "win32",
+        homeDir: "/home/.kimi-code",
+        exists: () => true,
+      }),
+    ).toBe("C:/tools/kimi.exe");
+  });
+
+  test("falls back to KIMI_EXECUTABLE when no explicit path is given", () => {
+    expect(
+      resolveKimiExecutable(undefined, {
+        env: { KIMI_EXECUTABLE: "/env/kimi" },
+        platform: "linux",
+        homeDir: "/home/.kimi-code",
+        exists: () => true,
+      }),
+    ).toBe("/env/kimi");
+  });
+
+  test("uses the Kimi home binary when it exists", () => {
+    const homeDir = path.join("home", ".kimi-code");
+    const expected = path.join(homeDir, "bin", "kimi.exe");
+    expect(
+      resolveKimiExecutable(undefined, {
+        env: {},
+        platform: "win32",
+        homeDir,
+        exists: (filePath) => filePath === expected,
+      }),
+    ).toBe(expected);
+  });
+
+  test("falls back to the bare command when the home binary is missing", () => {
+    expect(
+      resolveKimiExecutable(undefined, {
+        env: {},
+        platform: "linux",
+        homeDir: "/home/.kimi-code",
+        exists: () => false,
+      }),
+    ).toBe("kimi");
+  });
+});
+
+describe("Kimi server banner", () => {
+  test("extracts the port and token from the startup banner", () => {
+    const stdout = "Kimi server: http://127.0.0.1:53123/#token=abc123\n";
+
+    expect(parseKimiServerBanner(stdout)).toEqual({ port: 53123, token: "abc123" });
+    expect(extractKimiServerToken(stdout)).toBe("abc123");
+  });
+
+  test("finds the banner inside a larger stdout chunk", () => {
+    const stdout = "booting\nKimi server: http://127.0.0.1:41000/#token=TOKEN-XYZ\nready\n";
+
+    expect(extractKimiServerToken(stdout)).toBe("TOKEN-XYZ");
+  });
+
+  test("returns null when the banner never appeared", () => {
+    expect(parseKimiServerBanner("starting up\n")).toBe(null);
+    expect(extractKimiServerToken("")).toBe(null);
+  });
+});
+
+describe("unwrapKimiEnvelope", () => {
+  test("returns the data payload for a success envelope", () => {
+    const payload = { code: 0, msg: "success", data: { goal: "g" }, request_id: "r" };
+
+    expect(unwrapKimiEnvelope<{ goal: string }>(payload)).toEqual({ goal: "g" });
+  });
+
+  test("returns null for a non-zero code", () => {
+    expect(unwrapKimiEnvelope({ code: 401, msg: "unauthorized", data: null })).toBe(null);
+  });
+
+  test("returns null for a missing or non-object envelope", () => {
+    expect(unwrapKimiEnvelope(null)).toBe(null);
+    expect(unwrapKimiEnvelope("not json")).toBe(null);
+    expect(unwrapKimiEnvelope({ goal: "g" })).toBe(null);
+  });
+
+  test("maps an absent data field to null", () => {
+    expect(unwrapKimiEnvelope({ code: 0, msg: "success" })).toBe(null);
+  });
+});
