+      return;
+    }
+    // Race the polling loop against the signal so an aborted turn is released
+    // immediately instead of at the next 250ms check.
+    const abortPromise = new Promise<void>((resolve) => {
+      signal.addEventListener("abort", () => resolve(), { once: true });
+    });
+    await Promise.race([abortPromise, this.pollUntilSettled(deadline, signal)]);
+  }
+
+  /** Re-check the goal every 250ms until it settles, the deadline passes, or the signal aborts. */
+  private async pollUntilSettled(deadline: number, signal?: AbortSignal): Promise<void> {
+    while (!this.stopped && this.isLive() && Date.now() < deadline) {
+      if (signal?.aborted === true) {
+        return;
+      }
+      const remaining = deadline - Date.now();
+      await delay(Math.min(SETTLE_POLL_INTERVAL_MS, remaining));
+    }
+  }
+
+  private scheduleTick(delayMs: number): void {
+    this.clearTimer();
+    if (this.stopped) {
+      return;
+    }
+    this.timer = setTimeout(() => {
+      this.timer = null;
+      void this.tick();
+    }, delayMs);
+    // Never hold the daemon open for a poll.
+    this.timer.unref();
+  }
+
+  private clearTimer(): void {
+    if (this.timer) {
+      clearTimeout(this.timer);
+      this.timer = null;
+    }
+  }
+
+  private async tick(): Promise<void> {
+    try {
+      await this.readAppended();
+    } catch (error) {
+      this.logger.warn(
+        { err: error, sessionId: this.kimiSessionId },
