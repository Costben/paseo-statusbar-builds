diff --git a/packages/app/src/composer/goal-pill.test.ts b/packages/app/src/composer/goal-pill.test.ts
new file mode 100644
index 0000000..1e8901c
--- /dev/null
+++ b/packages/app/src/composer/goal-pill.test.ts
@@ -0,0 +1,49 @@
+import { describe, expect, it } from "vitest";
+import {
+  formatCompactTokens,
+  formatGoalUsageSuffix,
+  resolveGoalStatusLabel,
+} from "./goal-pill";
+
+describe("resolveGoalStatusLabel", () => {
+  it.each([
+    ["active", "目标进行中"],
+    ["paused", "目标已暂停"],
+    ["blocked", "目标受阻"],
+    ["complete", "目标已完成"],
+  ] as const)("labels %s", (status, label) => {
+    expect(resolveGoalStatusLabel(status)).toBe(label);
+  });
+
+  it("renders nothing for a cleared goal", () => {
+    expect(resolveGoalStatusLabel("cleared")).toBeNull();
+  });
+});
+
+describe("formatCompactTokens", () => {
+  it.each([
+    [0, "0"],
+    [-1, "0"],
+    [999, "999"],
+    [12_300, "12.3K"],
+    [100_000, "100K"],
+    [1_234_567, "1.2M"],
+  ] as const)("formats %i as %s", (tokens, expected) => {
+    expect(formatCompactTokens(tokens)).toBe(expected);
+  });
+});
+
+describe("formatGoalUsageSuffix", () => {
+  it("joins turns and tokens", () => {
+    expect(formatGoalUsageSuffix(3, 12_300)).toBe("· 3 回合 · 12.3K");
+  });
+
+  it("drops the side that is zero", () => {
+    expect(formatGoalUsageSuffix(2, 0)).toBe("· 2 回合");
+    expect(formatGoalUsageSuffix(0, 500)).toBe("· 500");
+  });
+
+  it("returns null when the goal has no usage yet", () => {
+    expect(formatGoalUsageSuffix(0, 0)).toBeNull();
+  });
+});
diff --git a/packages/app/src/composer/goal-pill.tsx b/packages/app/src/composer/goal-pill.tsx
new file mode 100644
index 0000000..db8fd08
--- /dev/null
+++ b/packages/app/src/composer/goal-pill.tsx
@@ -0,0 +1,147 @@
+import { useCallback, useMemo, useState, type ReactElement } from "react";
+import { Pressable, Text } from "react-native";
+import { CircleAlert, CircleCheck, CircleDot, CircleSlash } from "lucide-react-native";
+import { StyleSheet, withUnistyles } from "react-native-unistyles";
+import type { AgentGoalPayload } from "@getpaseo/protocol/messages";
+import { composerPillStyles } from "@/composer/pill-styles";
+import { ICON_SIZE, type Theme } from "@/styles/theme";
+import { assertUnreachable } from "@/utils/exhaustive";
+
+export type AgentGoalStatus = AgentGoalPayload["status"];
+
+const GOAL_STATUS_LABELS: Record<AgentGoalStatus, string | null> = {
+  active: "目标进行中",
+  paused: "目标已暂停",
+  blocked: "目标受阻",
+  complete: "目标已完成",
+  cleared: null,
+};
+
+const ThemedActiveGlyph = withUnistyles(CircleDot);
+const ThemedPausedGlyph = withUnistyles(CircleSlash);
+const ThemedBlockedGlyph = withUnistyles(CircleAlert);
+const ThemedCompleteGlyph = withUnistyles(CircleCheck);
+
+const GOAL_STATUS_GLYPHS = {
+  active: ThemedActiveGlyph,
+  paused: ThemedPausedGlyph,
+  blocked: ThemedBlockedGlyph,
+  complete: ThemedCompleteGlyph,
+  cleared: ThemedPausedGlyph,
+} as const;
+
+const accentMapping = (theme: Theme) => ({ color: theme.colors.accent });
+const mutedMapping = (theme: Theme) => ({ color: theme.colors.foregroundMuted });
+const warningMapping = (theme: Theme) => ({ color: theme.colors.statusWarning });
+const successMapping = (theme: Theme) => ({ color: theme.colors.statusSuccess });
+
+/** Built once: a mapping rebuilt inline would hand `withUnistyles` a new function every render. */
+const GOAL_STATUS_COLOR_MAPPINGS: Record<AgentGoalStatus, (theme: Theme) => { color: string }> = {
+  active: accentMapping,
+  paused: mutedMapping,
+  blocked: warningMapping,
+  complete: successMapping,
+  cleared: mutedMapping,
+};
+
+const goalPillStyles = StyleSheet.create((theme) => ({
+  labelActive: {
+    color: theme.colors.accent,
+  },
+  labelPaused: {
+    color: theme.colors.foregroundMuted,
+  },
+  labelBlocked: {
+    color: theme.colors.statusWarning,
+  },
+  labelComplete: {
+    color: theme.colors.statusSuccess,
+  },
+  usage: {
+    color: theme.colors.foregroundExtraMuted,
+  },
+}));
+
+const COMPACT_TOKEN_UNITS = [
+  { threshold: 1_000_000_000, divisor: 1_000_000_000, suffix: "B" },
+  { threshold: 1_000_000, divisor: 1_000_000, suffix: "M" },
+  { threshold: 1_000, divisor: 1_000, suffix: "K" },
+] as const;
+
+export function resolveGoalStatusLabel(status: AgentGoalStatus): string | null {
+  return GOAL_STATUS_LABELS[status];
+}
+
+/** One decimal below 100 of the unit, whole numbers above it. */
+export function formatCompactTokens(tokens: number): string {
+  if (!Number.isFinite(tokens) || tokens <= 0) return "0";
+  for (const { threshold, divisor, suffix } of COMPACT_TOKEN_UNITS) {
+    if (tokens < threshold) continue;
+    const rounded = Math.round((tokens / divisor) * 10) / 10;
+    return `${rounded < 100 ? rounded.toFixed(1) : Math.round(rounded)}${suffix}`;
+  }
+  return String(Math.round(tokens));
+}
+
+export function formatGoalUsageSuffix(turnsUsed: number, tokensUsed: number): string | null {
+  const parts: string[] = [];
+  if (turnsUsed > 0) parts.push(`${Math.round(turnsUsed)} 回合`);
+  if (tokensUsed > 0) parts.push(formatCompactTokens(tokensUsed));
+  return parts.length > 0 ? `· ${parts.join(" · ")}` : null;
+}
+
+function goalLabelStyle(status: AgentGoalStatus) {
+  switch (status) {
+    case "active":
+      return goalPillStyles.labelActive;
+    case "paused":
+    case "cleared":
+      return goalPillStyles.labelPaused;
+    case "blocked":
+      return goalPillStyles.labelBlocked;
+    case "complete":
+      return goalPillStyles.labelComplete;
+    default:
+      return assertUnreachable(status);
+  }
+}
+
+interface GoalPillProps {
+  goal: AgentGoalPayload | null | undefined;
+}
+
+export function GoalPill({ goal }: GoalPillProps): ReactElement | null {
+  const [isHovered, setIsHovered] = useState(false);
+  const handleHoverIn = useCallback(() => setIsHovered(true), []);
+  const handleHoverOut = useCallback(() => setIsHovered(false), []);
+  const bodyStyle = useMemo(
+    () => [composerPillStyles.body, isHovered && composerPillStyles.bodyActive],
+    [isHovered],
+  );
+
+  if (!goal) return null;
+  const label = resolveGoalStatusLabel(goal.status);
+  if (!label) return null;
+
+  const Glyph = GOAL_STATUS_GLYPHS[goal.status];
+  const usageSuffix = formatGoalUsageSuffix(goal.turnsUsed, goal.tokensUsed);
+
+  return (
+    <Pressable
+      testID="composer-goal-pill"
+      onHoverIn={handleHoverIn}
+      onHoverOut={handleHoverOut}
+      style={bodyStyle}
+    >
+      <Glyph size={ICON_SIZE.sm} uniProps={GOAL_STATUS_COLOR_MAPPINGS[goal.status]} />
+      <Text style={[composerPillStyles.label, goalLabelStyle(goal.status)]} numberOfLines={1}>
+        {label}
+      </Text>
+      {usageSuffix ? (
+        <Text style={[composerPillStyles.label, goalPillStyles.usage]} numberOfLines={1}>
+          {usageSuffix}
+        </Text>
+      ) : null}
+    </Pressable>
+  );
+}
