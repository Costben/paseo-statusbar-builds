+  /** Idempotent. Starts tailing. */
+  start(): void {
+    if (this.started || this.stopped) {
+      return;
+    }
+    this.started = true;
+    this.scheduleTick(0);
+  }
+
+  /** Idempotent. Stops tailing. */
+  stop(): void {
+    if (this.stopped) {
+      return;
+    }
+    this.stopped = true;
+    this.clearTimer();
+    this.pending = "";
+  }
