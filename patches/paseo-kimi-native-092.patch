+
+export function forkProcess(
+  modulePath: string,
+  args: string[],
+  options?: ForkProcessOptions,
+): ChildProcess {
+  const forkOptions: ForkProcessOptions = { ...options, windowsHide: true };
+  return fork(modulePath, args, forkOptions);
+}
