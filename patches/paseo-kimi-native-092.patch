+interface ForkProcessOptions extends ForkOptions {
+  /**
+   * `child_process.fork` forwards its options to `spawn`, so `windowsHide` takes
+   * effect at runtime; @types/node just omits the flag from `ForkOptions`.
+   */
+  windowsHide?: boolean;
