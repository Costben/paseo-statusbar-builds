+/**
+ * A turn boundary. Kimi 2.6 opens a turn with the prompt receipt and closes it
+ * with `turn.ended`, and writes no `agent.turn.*` record at all; older logs
+ * carry both pairs. Either way the id decides whether this is one turn seen
+ * twice, and a boundary without an id counts on its own.
+ */
+function noteTurnStart(draft: KimiLogDraft, entry: Record<string, unknown>): void {
+  if (entry.agentId !== undefined && entry.agentId !== "main") {
+    return;
+  }
+  const turnId = readNumber(entry.turnId);
+  if (turnId !== undefined) {
+    if (turnId <= draft.lastTurnId) {
+      return;
+    }
+    draft.lastTurnId = turnId;
+  }
+  draft.turnGeneration += 1;
+  // A new turn proves every earlier one is over.
+  draft.settledThroughTurn = Math.max(draft.settledThroughTurn, draft.turnGeneration - 1);
