+  test("delivers the transcript's last record, which Antigravity leaves unterminated", async () => {
+    const harness = createHarness();
+    const sessionHandle = harness.attach();
+    try {
+      harness.setForeground(true);
+      harness.hooks.onForegroundTurnStarting?.(harness.ctx, "/compact");
+
+      // A `/compact` ends the session with its checkpoint, and the file's last
+      // line carries no newline: it still has to be delivered, or the marker
+      // would wait for a write that never comes.
+      appendFileSync(
+        harness.transcriptPath,
+        JSON.stringify({
+          step_index: 1,
+          source: "SYSTEM",
+          type: "CHECKPOINT",
+          status: "DONE",
+          input_tokens: 1000,
+          cache_read_tokens: 9000,
+          content: "# Resuming from a compaction",
+        }),
+        "utf8",
+      );
+
+      await harness.hooks.holdTurnWhile?.({
+        acpSessionId: harness.sessionId,
+        logger: harness.ctx.logger,
+        signal: new AbortController().signal,
+        sawTimeline: false,
+      });
+
+      const compactions = harness.events.filter(
+        (event): event is Extract<AgentStreamEvent, { type: "timeline" }> =>
+          event.type === "timeline" && event.item.type === "compaction",
+      );
+      expect(compactions).toHaveLength(1);
+      expect(compactions[0]!.item).toMatchObject({
+        type: "compaction",
+        status: "completed",
+        trigger: "manual",
+      });
+    } finally {
+      sessionHandle?.onClose?.();
+    }
+  });
+
