+  test("maps an ExitPlanMode hand-off to the plan card", async () => {
+    const session = createSessionWithConfig({ provider: "kimi-acp" });
+    const events: AgentStreamEvent[] = [];
+    const planText = "Plan saved to: /tmp/plan.md\n\n# Plan\n\n1. Read the code.";
+
+    asInternals<ACPSessionInternals>(session).sessionId = "session-1";
+    session.subscribe((event) => events.push(event));
+
+    session.requestPermission({
+      sessionId: "session-1",
+      toolCall: {
+        toolCallId: "2:ExitPlanMode-1790130392773383053-591",
+        title: "ExitPlanMode",
+        content: [{ type: "content", content: { type: "text", text: planText } }],
+      },
+      options: [
+        { optionId: "plan_opt_0", name: "Do all of it", kind: "allow_once" },
+        { optionId: "plan_revise", name: "Revise", kind: "reject_once" },
+      ],
+    } satisfies RequestPermissionRequest);
+
+    await Promise.resolve();
+
+    const requested = events.find((event) => event.type === "permission_requested");
+    if (requested?.type !== "permission_requested") {
+      throw new Error("Expected permission request");
+    }
+    expect(requested.request.kind).toBe("plan");
+    expect(requested.request.metadata?.planText).toBe(planText);
+    expect(requested.request.actions).toEqual([
+      { id: "plan_opt_0", label: "Do all of it", behavior: "allow" },
+      { id: "plan_revise", label: "Revise", behavior: "deny" },
+    ]);
+  });
+
+  test("keeps an ExitPlanMode request without plan content on the tool card", async () => {
+    const session = createSessionWithConfig({ provider: "kimi-acp" });
+    const events: AgentStreamEvent[] = [];
+
+    asInternals<ACPSessionInternals>(session).sessionId = "session-1";
+    session.subscribe((event) => events.push(event));
+
+    session.requestPermission({
+      sessionId: "session-1",
+      toolCall: { toolCallId: "2:ExitPlanMode-1", title: "ExitPlanMode" },
+      options: [{ optionId: "plan_approve", name: "Approve", kind: "allow_once" }],
+    } satisfies RequestPermissionRequest);
+
+    await Promise.resolve();
+
+    const requested = events.find((event) => event.type === "permission_requested");
+    if (requested?.type !== "permission_requested") {
+      throw new Error("Expected permission request");
+    }
+    expect(requested.request.kind).toBe("tool");
+    expect(requested.request.metadata?.planText).toBeUndefined();
+  });
+
