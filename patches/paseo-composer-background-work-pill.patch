+import type { PaseoAgentBackgroundWorkItem } from "@getpaseo/client";
+
+export interface BackgroundWorkDisplaySnapshot {
+  items: PaseoAgentBackgroundWorkItem[] | null;
+  stops?: Record<string, { status: "pending" | "error"; item: PaseoAgentBackgroundWorkItem }>;
+}
+
+export interface BackgroundWorkDisplay {
+  visible: boolean;
+  rows: PaseoAgentBackgroundWorkItem[];
+  visibleCount: number;
+}
+
+export function resolveBackgroundWorkDisplay(
+  snapshot: BackgroundWorkDisplaySnapshot,
+  count: number,
+): BackgroundWorkDisplay {
+  const missing = Object.values(snapshot.stops ?? {}).filter(
+    (entry) => !snapshot.items?.some((item) => item.stopToken === entry.item.stopToken),
+  );
+  const rows = [...(snapshot.items ?? []), ...missing.map((entry) => entry.item)];
+  const visible = count > 0 || rows.length > 0;
+  const visibleCount = snapshot.items?.length || count || rows.length;
+  return { visible, rows, visibleCount };
+}
