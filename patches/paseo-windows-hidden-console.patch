+interface ForkProcessOptions extends ForkOptions {
+  /**
+   * `child_process.fork` forwards its options to `spawn`, so `windowsHide` takes
+   * effect at runtime; @types/node just omits the flag from `ForkOptions`.
+   */
+  windowsHide?: boolean;
+}
+
+export function forkProcess(
+  modulePath: string,
+  args: string[],
+  options?: ForkProcessOptions,
+): ChildProcess {
+  const forkOptions: ForkProcessOptions = { ...options, windowsHide: true };
+  return fork(modulePath, args, forkOptions);
+}
