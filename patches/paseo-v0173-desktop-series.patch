+
+function extractSessionUpdateToolTarget(
+  update: Extract<SessionUpdate, { sessionUpdate: "tool_call" }>,
+): string | null {
+  const input = asRecord(update.rawInput);
+  if (!input) {
+    return null;
+  }
+  for (const key of [
+    "CommandLine",
+    "commandLine",
+    "command",
+    "cmd",
+    "Path",
+    "filePath",
+    "file_path",
+    "target_file",
+    "path",
+    "query",
+  ]) {
+    const raw = input[key];
+    if (typeof raw === "string" && raw.trim().length > 0) {
+      return raw.trim();
+    }
+  }
+  return null;
