+
+const EMPTY_GOAL_USAGE_TOTALS: GoalUsageTotals = Object.freeze({
+  input: 0,
+  cachedInput: 0,
+  output: 0,
+});
+
+/**
+ * What one response reported it read and wrote, or null when it reported
