+      }),
+    ).toEqual({
+      antigravity: {
+        systemPrompt: {
+          append: "User rule\n\nDaemon appendix",
+        },
+      },
+    });
+  });
+
+  test("transforms session responses to drop compound models and append full-access mode", () => {
+    const response: SessionStateResponse = {
+      sessionId: "sess-1",
+      models: {
+        currentModelId: "gemini-4-hydrogen-high",
+        availableModels: [
+          { modelId: "gemini-4-hydrogen-low", name: "Hydrogen Low" },
+          { modelId: "gemini-4-hydrogen-high", name: "Hydrogen High" },
+        ],
+      },
+      modes: {
+        currentModeId: "default",
+        availableModes: [
+          { id: "default", name: "Ask" },
+          { id: "accept-edits", name: "Accept Edits" },
+          { id: "auto", name: "Auto" },
+          { id: "plan", name: "Plan" },
+        ],
+      },
+      configOptions: createAntigravityConfigOptions(),
+    };
+
+    const transformed = transformAntigravitySessionResponse(response);
+    expect(transformed.models).toBeUndefined();
+    expect(transformed.modes?.availableModes.map((m) => m.id)).toEqual([
+      "default",
+      "accept-edits",
+      "auto",
+      "plan",
+      ANTIGRAVITY_FULL_ACCESS_MODE_ID,
+    ]);
+
+    const derivedModels = deriveModelDefinitionsFromACP(
+      "antigravity",
+      transformed.models,
+      transformed.configOptions,
+    );
+    expect(derivedModels.map((m) => m.id)).toEqual([
+      "gemini-4-hydrogen",
+      "gemini-4-carbon",
+      "gemini-pro-orchestrator",
+      "claude-opus-5-5",
+    ]);
+
+    const transformedConfig = transformAntigravityConfigOptions(createAntigravityConfigOptions());
+    const modeOption = transformedConfig.find((option) => option.category === "mode");
+    expect(modeOption?.type).toBe("select");
+    if (modeOption?.type === "select") {
+      expect(modeOption.options.map((opt) => ("value" in opt ? opt.value : ""))).toContain(
+        ANTIGRAVITY_FULL_ACCESS_MODE_ID,
+      );
+    }
+  });
+
+  test("resolves per-model thinking options and legacy compound aliases during catalog probe", async () => {
+    const baseOptions = createAntigravityConfigOptions();
+    const initialModels = deriveModelDefinitionsFromACP("antigravity", undefined, baseOptions);
+    const setSessionConfigOption = vi.fn(async ({ value }: { value: string }) => {
+      const thoughtLevels =
+        value === "gemini-4-hydrogen"
+          ? ["low", "medium", "high", "xhigh"]
+          : value === "gemini-pro-orchestrator"
+            ? []
+            : ["low", "medium", "high"];
+      return {
+        configOptions: createAntigravityConfigOptions(value, thoughtLevels),
+      };
+    });
+
+    const context: ACPCatalogModelResolverContext = {
+      connection: {
+        setSessionConfigOption,
+        extMethod: vi.fn(),
+      },
+      sessionId: "sess-probe",
+      models: initialModels,
+      configOptions: baseOptions,
+      runRequest: (fn) => fn(),
+      transformConfigOptions: transformAntigravityConfigOptions,
+      logger: createTestLogger(),
+      provider: "antigravity",
+    };
+
+    const catalog = await resolveAntigravityCatalogModels(context);
+    const hydrogen = catalog.find((m) => m.id === "gemini-4-hydrogen");
+    expect(hydrogen?.thinkingOptions?.map((o) => o.id)).toEqual(["low", "medium", "high", "xhigh"]);
+    expect(hydrogen?.aliases).toEqual([
+      "gemini-4-hydrogen-low",
+      "gemini-4-hydrogen-medium",
+      "gemini-4-hydrogen-high",
+      "gemini-4-hydrogen-xhigh",
+    ]);
+
+    const orchestrator = catalog.find((m) => m.id === "gemini-pro-orchestrator");
+    expect(orchestrator?.thinkingOptions).toBeUndefined();
+    expect(orchestrator?.aliases).toBeUndefined();
+
+    const claude = catalog.find((m) => m.id === "claude-opus-5-5");
+    expect(claude?.thinkingOptions?.map((o) => o.id)).toEqual(["low", "medium", "high"]);
+  });
+
+  test("splits legacy compound model IDs back into base model + thought_level", () => {
+    const configOptions = createAntigravityConfigOptions();
+    expect(
+      resolveAntigravityConfiguredSelection({
+        model: "gemini-4-hydrogen-high",
+        availableModels: null,
+        configOptions,
+      }),
+    ).toEqual({
+      model: "gemini-4-hydrogen",
+      thinkingOptionId: "high",
+    });
+
+    expect(
+      resolveAntigravityConfiguredSelection({
+        model: "gemini-4-hydrogen-xhigh",
+        thinkingOptionId: "low",
+        availableModels: null,
+        configOptions,
+      }),
+    ).toEqual({
+      model: "gemini-4-hydrogen",
+      thinkingOptionId: "low",
+    });
+
+    expect(
+      resolveAntigravityConfiguredSelection({
+        model: "claude-opus-5-5",
+        availableModels: null,
+        configOptions,
+      }),
+    ).toEqual({
+      model: "claude-opus-5-5",
+      thinkingOptionId: undefined,
+    });
+  });
+
+  test("switches full-access mode cleanly via default underlying ACP mode", async () => {
+    const setSessionMode = vi.fn(async () => ({}));
