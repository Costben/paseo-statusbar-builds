+describe("nextTickIntervalMs", () => {
+  // Explicit cadences, so each assertion reads as the number it expects rather
+  // than as whichever constants the module happens to use.
+  const cadences = { activeIntervalMs: 1_000, liveIntervalMs: 2_000, idleIntervalMs: 10_000 };
+
+  test("drains a backlog sooner while the tick itself stays cheap", () => {
+    expect(
+      nextTickIntervalMs({
+        readNewBytes: true,
+        deferred: true,
+        lastTickMs: 3,
+        live: true,
+        ...cadences,
+      }),
+    ).toBe(TICK_DRAIN_INTERVAL_MS);
+  });
+
+  test("keeps the normal cadence once the tick has already run long", () => {
+    // Well past twice the tick budget: this session is the one holding the event
+    // loop, so calling it back sooner would only add congestion.
+    expect(
+      nextTickIntervalMs({
+        readNewBytes: true,
+        deferred: true,
+        lastTickMs: 200,
+        live: true,
+        ...cadences,
+      }),
+    ).toBe(1_000);
+  });
+
+  test("polls at the active cadence after the log grew", () => {
+    expect(
+      nextTickIntervalMs({
+        readNewBytes: true,
+        deferred: false,
+        lastTickMs: 3,
+        live: false,
+        ...cadences,
+      }),
+    ).toBe(1_000);
+  });
+
+  test("uses the live cadence for a live goal and the idle one otherwise", () => {
+    const quiet = { readNewBytes: false, deferred: false, lastTickMs: 3, ...cadences };
+
+    expect(nextTickIntervalMs({ ...quiet, live: true })).toBe(2_000);
+    expect(nextTickIntervalMs({ ...quiet, live: false })).toBe(10_000);
+  });
+});
