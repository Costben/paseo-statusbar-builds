+    ]);
+
+    expect(events).toEqual([
+      {
+        type: "timeline",
+        provider: "kimi",
+        item: { type: "compaction", status: "completed", trigger: "auto" },
+      },
+    ]);
+  });
+
+  test("keeps compaction to one row, so no reader is left holding an open marker", () => {
+    const { renderer, events } = createHarness();
+    const start = ATTACHED_AT + 1_000;
+
+    renderer.consume([
+      line({ type: "full_compaction.begin", source: "manual", agentId: "main", time: start }),
+    ]);
+
+    expect(events).toEqual([]);
+  });
+
+  test("renders a compaction whose start predates the bridge, without a trigger", () => {
+    const { renderer, events } = createHarness();
+
+    renderer.consume([
+      line({
+        type: "full_compaction.complete",
+        agentId: "main",
+        time: ATTACHED_AT + 5_000,
+      }),
+    ]);
+
+    expect(events).toEqual([
+      { type: "timeline", provider: "kimi", item: { type: "compaction", status: "completed" } },
+    ]);
+  });
+
+  test("finds the submitted prompt by its text, and only among prompts logged after it was sent", () => {
+    const { renderer } = createHarness();
+    const sentAt = ATTACHED_AT + 10_000;
+
+    renderer.consume([
+      userPrompt(4, "PING-QUEUED", sentAt - 5_000),
+      userPrompt(5, "from another client", sentAt + 1_000),
+      userPrompt(6, "PING-QUEUED", sentAt + 2_000),
+      line({
+        type: "turn.ended",
+        agentId: "main",
+        turnId: 6,
+        reason: "completed",
+        time: sentAt + 9_000,
+      }),
+    ]);
+
+    expect(renderer.findSubmittedPrompt(sentAt, "PING-QUEUED")).toMatchObject({
+      promptTurnId: 6,
+      ended: true,
+    });
+    expect(renderer.findSubmittedPrompt(sentAt, null)).toMatchObject({ promptTurnId: 5 });
+  });
+
+  test("does not take an earlier turn's prompt, however recent, for the submission", () => {
+    const { renderer } = createHarness();
+    const sentAt = ATTACHED_AT + 10_000;
+
+    // The previous turn's prompt was logged a moment before the next one is sent.
+    renderer.consume([userPrompt(4, "FIRST", sentAt - 200)]);
+    renderer.noteForegroundTurnStarting();
+    expect(renderer.findSubmittedPrompt(sentAt, null)).toBeNull();
+
+    renderer.consume([userPrompt(5, "follow-up", sentAt + 100)]);
+    expect(renderer.findSubmittedPrompt(sentAt, null)).toMatchObject({ promptTurnId: 5 });
+  });
+});
