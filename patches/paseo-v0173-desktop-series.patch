+import { stat } from "node:fs/promises";
+import path from "node:path";
+
+import type { Logger } from "pino";
+
+import type { AgentTimelineItem } from "../../agent-sdk-types.js";
+import {
+  PARSE_LINES_PER_CHUNK,
+  alignRangeEndToNewline,
+  asRecord,
+  budgetExhausted,
+  capPendingFragment,
+  createTickBudget,
+  fileReadAllowance,
+  kimiUsageRecordContextTokens,
+  mergePendingFragment,
+  nextPendingFragment,
+  readLinesFromRange,
+  readString,
+  yieldToEventLoop,
+  type TickBudget,
+} from "./session-log.js";
+
+/**
+ * Each subagent writes its own wire log next to the main one, in the same
+ * format and at `agents/<subagentId>/wire.jsonl`. The main log only announces
+ * a subagent; its transcript lives here.
+ *
+ * Returns null for an id that could walk out of the session directory, so a
+ * crafted log entry cannot direct a read at an arbitrary file.
+ */
+export function resolveKimiSubagentLogPath(sessionDir: string, subagentId: string): string | null {
+  if (!isSafeSubagentId(subagentId)) {
+    return null;
+  }
+  return path.join(sessionDir, "agents", subagentId, "wire.jsonl");
+}
+
+function isSafeSubagentId(subagentId: string): boolean {
+  return (
+    subagentId.length > 0 &&
+    !subagentId.includes("/") &&
+    !subagentId.includes("\\") &&
+    !subagentId.includes("..")
+  );
+}
+
+export interface KimiSubagentCallRecord {
+  name: string;
+  input: unknown;
+  /** Set when Kimi displays the call as a shell command. */
+  shell?: { command: string; cwd?: string };
+}
+
+/**
+ * Replay raw subagent log lines into timeline items.
+ *
+ * `calls` is the only state, and it outlives one batch: a `tool.result` record
+ * carries neither the tool name nor its arguments, while the client merges a
+ * tool call by spreading the new item over the old one. Re-supplying both from
+ * the recorded call is what keeps a completed call from losing its name.
+ *
+ * Anything unparseable is skipped, because a half-written line must not abort
+ * a replay.
+ */
+export function mapKimiSubagentLogLines(
+  lines: Iterable<string>,
+  calls: Map<string, KimiSubagentCallRecord>,
+): AgentTimelineItem[] {
+  const items: AgentTimelineItem[] = [];
+  for (const raw of lines) {
+    const line = raw.trim();
+    if (line.length === 0) {
+      continue;
+    }
+    let parsed: unknown;
+    try {
+      parsed = JSON.parse(line);
+    } catch {
+      continue;
+    }
+    const record = asRecord(parsed);
+    if (record === null || record.type !== "context.append_loop_event") {
+      continue;
+    }
+    const event = asRecord(record.event);
+    if (event === null) {
+      continue;
+    }
+    mapKimiLoopEvent(event, calls, items);
+  }
+  return items;
+}
+
+/**
+ * Context tokens of the latest step this subagent's log reports, or null.
+ *
+ * Maximum rather than last: the figure is monotonic in practice, and a maximum
+ * cannot be dragged down by a line being re-read.
+ */
+export function kimiSubagentLatestContextTokens(lines: Iterable<string>): number | null {
+  let tokens: number | null = null;
+  for (const raw of lines) {
+    const line = raw.trim();
+    if (line.length === 0) {
+      continue;
+    }
+    let parsed: unknown;
+    try {
+      parsed = JSON.parse(line);
+    } catch {
+      continue;
+    }
+    const record = asRecord(parsed);
+    if (record === null) {
+      continue;
+    }
+    const contextTokens = kimiUsageRecordContextTokens(record);
+    if (contextTokens !== null && (tokens === null || contextTokens > tokens)) {
+      tokens = contextTokens;
+    }
+  }
+  return tokens;
+}
+
+export function mapKimiLoopEvent(
+  event: Record<string, unknown>,
+  calls: Map<string, KimiSubagentCallRecord>,
+  items: AgentTimelineItem[],
+): void {
+  switch (event.type) {
+    case "content.part": {
+      const part = asRecord(event.part);
+      if (part === null) {
+        return;
+      }
+      // A thinking part carries its text under `think`, a spoken one under
+      // `text`. Reading the wrong key drops every reasoning block silently.
+      const text = readString(part.type === "think" ? part.think : part.text);
+      if (text === undefined || text.length === 0) {
+        return;
+      }
+      if (part.type === "text") {
+        items.push({ type: "assistant_message", text });
+      } else if (part.type === "think") {
+        items.push({ type: "reasoning", text });
+      }
+      return;
+    }
+    case "tool.call":
+      mapKimiToolCall(event, calls, items);
+      return;
+    case "tool.result":
+      mapKimiToolResult(event, calls, items);
+      return;
+    default:
+      return;
+  }
+}
+
+export interface KimiSubagentLogTailerOptions {
+  subagentId: string;
+  /** The `<sessionId>` directory, parent of the per-agent `agents/` directory. */
+  sessionDir: string;
+  logger: Logger;
+}
+
+/**
+ * Tails one subagent's wire log.
+ *
+ * Reads incrementally by byte offset, but the first read starts at byte 0, so a
+ * subagent that finished before the tailer attached is replayed in full instead
+ * of showing up empty.
+ *
+ * One call is bounded the same way the main tailer's tick is: it draws from the
+ * caller's tick budget — at most `TICK_READ_BUDGET_BYTES` for every file
+ * together, of which this one may take `MAX_BYTES_PER_TICK` — and parses what it
+ * read in `PARSE_LINES_PER_CHUNK`-line chunks with an event-loop turn between
+ * them. Subagent logs are read on the main tailer's tick, so an unbounded read
+ * here is an unbounded read there.
+ */
+export class KimiSubagentLogTailer {
+  private readonly subagentId: string;
+  private readonly sessionDir: string;
+  private readonly logger: Logger;
+  private readonly calls = new Map<string, KimiSubagentCallRecord>();
+  private offset = 0;
+  /** Bytes of an unterminated trailing line, held until the next tick completes it. */
+  private pending = "";
+  /** Context tokens of the latest step seen so far; null until a record reports one. */
+  private tokens: number | null = null;
+
+  constructor(options: KimiSubagentLogTailerOptions) {
+    this.subagentId = options.subagentId;
+    this.sessionDir = options.sessionDir;
+    this.logger = options.logger;
+  }
+
+  /** Context tokens of the latest step this subagent's log reports, or null. */
+  get totalTokens(): number | null {
+    return this.tokens;
+  }
+
+  /**
+   * Returns the items produced by bytes appended since the previous call, up to
+   * what the caller's tick budget has left. What is left over is read by the next
+   * call, which resumes at the offset this one stopped at. Called without a
+   * budget it draws one of its own, which is what a single-file caller wants.
+   */
+  async readAppended(budget: TickBudget = createTickBudget()): Promise<AgentTimelineItem[]> {
+    if (budgetExhausted(budget)) {
+      budget.deferred = true;
+      return [];
+    }
+    const filePath = resolveKimiSubagentLogPath(this.sessionDir, this.subagentId);
+    if (filePath === null) {
+      return [];
+    }
+    let size: number;
+    try {
+      size = (await stat(filePath)).size;
+    } catch {
+      // The log may simply not exist yet; the caller re-checks on its next tick.
+      return [];
+    }
+    if (size < this.offset) {
+      // Truncated or replaced: rebuild from the beginning.
+      this.logger.debug(
+        { subagentId: this.subagentId },
+        "Kimi subagent log shrank, replaying from the start",
+      );
+      this.offset = 0;
+      this.pending = "";
+      this.tokens = null;
+    }
+    if (size === this.offset) {
+      return [];
+    }
+    const start = this.offset;
+    const budgetEnd = Math.min(size, start + fileReadAllowance(budget));
+    const end = budgetEnd === size ? size : alignRangeEndToNewline(filePath, budgetEnd, size);
+    const { lines, fragment } = await readLinesFromRange(filePath, start, end);
+    this.offset = end;
+    budget.bytesLeft -= end - start;
+    if (size > end) {
+      budget.deferred = true;
+    }
+    const merged = mergePendingFragment(this.pending, lines);
+    this.pending = capPendingFragment(
+      nextPendingFragment(this.pending, lines, fragment),
+      this.logger,
+      { subagentId: this.subagentId },
+    );
+    const items: AgentTimelineItem[] = [];
+    for (let index = 0; index < merged.length; index += PARSE_LINES_PER_CHUNK) {
+      if (index > 0) {
+        await yieldToEventLoop();
+      }
+      const chunk = merged.slice(index, index + PARSE_LINES_PER_CHUNK);
+      items.push(...mapKimiSubagentLogLines(chunk, this.calls));
+      // Keep the maximum rather than the last value: the figure is monotonic in
+      // practice, and a maximum cannot be dragged down by a smaller later step
+      // or by the same line being read again.
+      const chunkTokens = kimiSubagentLatestContextTokens(chunk);
+      if (chunkTokens !== null && (this.tokens === null || chunkTokens > this.tokens)) {
+        this.tokens = chunkTokens;
+      }
+    }
+    return items;
+  }
+}
+
+function mapKimiToolCall(
+  event: Record<string, unknown>,
+  calls: Map<string, KimiSubagentCallRecord>,
+  items: AgentTimelineItem[],
+): void {
+  const callId = readString(event.toolCallId);
+  if (callId === undefined) {
+    return;
+  }
+  const name = readString(event.name) ?? "tool";
+  const input = event.args ?? null;
+  const shell = readShellDisplay(event.display);
+  calls.set(callId, { name, input, ...(shell ? { shell } : {}) });
+  items.push({
+    type: "tool_call",
+    callId,
+    name,
+    detail: shell ? { type: "shell", ...shell } : { type: "unknown", input, output: null },
+    status: "running",
+    error: null,
+  });
+}
+
+/**
+ * A `tool.result` record carries neither the tool name nor its arguments, so
+ * both are re-supplied from the recorded call; the client merges a tool call by
+ * spreading the new item over the old one.
+ */
+function mapKimiToolResult(
+  event: Record<string, unknown>,
+  calls: Map<string, KimiSubagentCallRecord>,
+  items: AgentTimelineItem[],
+): void {
+  const callId = readString(event.toolCallId);
+  if (callId === undefined) {
+    return;
+  }
+  const call = calls.get(callId);
+  const result = asRecord(event.result);
+  const output = result?.output ?? null;
+  items.push({
+    type: "tool_call",
+    callId,
+    name: call?.name ?? "tool",
+    detail: call?.shell
+      ? { type: "shell", ...call.shell, ...(typeof output === "string" ? { output } : {}) }
+      : { type: "unknown", input: call?.input ?? null, output },
+    status: "completed",
+    error: null,
+  });
+}
+
+/**
+ * Kimi describes how it shows a call; a `command` display is a shell command,
+ * which renders as one rather than as an opaque tool with raw arguments.
+ */
+function readShellDisplay(display: unknown): { command: string; cwd?: string } | null {
+  const record = asRecord(display);
+  if (record?.kind !== "command") {
+    return null;
+  }
+  const command = readString(record.command);
+  if (command === undefined || command.length === 0) {
+    return null;
+  }
+  const cwd = readString(record.cwd);
+  return cwd !== undefined ? { command, cwd } : { command };
+}
