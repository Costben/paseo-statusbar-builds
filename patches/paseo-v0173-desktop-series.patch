+    for (let idx = 1; idx < this.unstreamedRenderedTools.length; idx++) {
+      const candidate = this.unstreamedRenderedTools[idx];
+      if (!candidate) {
+        continue;
+      }
+      if (!matchesCatchupToolEntry(candidate, updateKind, updateTarget)) {
+        continue;
+      }
+      // Only skip past unmatched earlier tools when kind or target explicitly disambiguates them.
+      if (
+        (updateTarget !== null && matchesCatchupTarget(candidate, updateTarget)) ||
+        (updateKind !== null && candidate.kind !== null)
