+
+interface BackgroundTaskPillProps {
+  backgroundTasks?: AgentBackgroundTasksPayload | null;
+}
+
+export function BackgroundTaskPill({
+  backgroundTasks,
+}: BackgroundTaskPillProps): ReactElement | null {
+  if (!backgroundTasks || backgroundTasks.count <= 0) {
+    return null;
+  }
+
+  return (
+    <MenuRoot compactMode="sheet">
+      <BackgroundTaskPillTrigger count={backgroundTasks.count} />
+      <MenuSurface
+        side="top"
+        align="end"
+        offset={6}
+        sheetTitle={`后台任务 (${backgroundTasks.count})`}
+        minWidth={280}
+        maxWidth={460}
+        maxHeight={400}
+        scrollable
+        testID="composer-background-task-panel"
+      >
+        <BackgroundTaskDetail tasks={backgroundTasks.tasks} />
+      </MenuSurface>
+    </MenuRoot>
+  );
+}
+
+export function BackgroundTaskPillTrigger({
+  count,
+  testID = "composer-background-task-pill",
+  accessibilityLabel,
+}: {
+  count: number;
+  testID?: string;
+  accessibilityLabel?: string;
+}): ReactElement {
+  const { open } = useMenuContext("BackgroundTaskPillTrigger");
+  const accessibilityState = useMemo(() => ({ expanded: open }), [open]);
+  const ariaExpandedProps = isWeb ? { "aria-expanded": open } : null;
+  const pillStyle = useCallback(
+    ({ hovered, pressed, open: isOpen }: MenuTriggerState) => [
+      taskPillStyles.pill,
