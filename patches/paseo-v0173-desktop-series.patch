+
+function matchesCatchupTarget(entry: CatchupToolEntry, updateTarget: string): boolean {
+  if (!entry.target) {
+    return false;
+  }
+  return entry.targetPrefix ? updateTarget.startsWith(entry.target) : entry.target === updateTarget;
+}
+
+function matchesCatchupToolEntry(
+  entry: CatchupToolEntry,
+  updateKind: string | null,
+  updateTarget: string | null,
+): boolean {
+  if (entry.kind && updateKind && updateKind !== "other") {
+    const kindMatches =
+      entry.kind === updateKind || (entry.kind === "search" && updateKind === "fetch");
+    if (!kindMatches) {
+      return false;
+    }
+  }
+  if (entry.target && updateTarget) {
+    return matchesCatchupTarget(entry, updateTarget);
+  }
+  return true;
+}
