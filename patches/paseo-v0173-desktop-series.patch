+function parseModelContextWindows(text: string): Record<string, number> {
+  const windows: Record<string, number> = {};
+  let currentModel: string | null = null;
+  for (const rawLine of text.split("\n")) {
+    const line = rawLine.trim();
+    if (line.length === 0 || line.startsWith("#")) {
+      continue;
+    }
+    const section = /^\[models\s*\.\s*"([^"]+)"\s*\]$/.exec(line);
+    if (section) {
+      currentModel = section[1];
+      continue;
+    }
+    if (line.startsWith("[")) {
+      currentModel = null;
+      continue;
+    }
+    if (currentModel === null) {
+      continue;
+    }
+    const value = /^max_context_size\s*=\s*(\d+)\s*$/.exec(line);
+    if (value) {
+      const size = Number.parseInt(value[1], 10);
+      if (Number.isFinite(size) && size > 0) {
+        windows[currentModel] = size;
+      }
+    }
+  }
+  return windows;
+}
+
+function delay(ms: number): Promise<void> {
+  return new Promise((resolve) => {
+    setTimeout(resolve, ms);
+  });
+}
+
+interface KimiTaskFileRecord {
+  taskId?: string;
+  description?: string;
+  status?: string;
+  command?: string;
+  startedAt?: number;
+  pid?: number;
+}
+
+export async function readRunningTasksFromSessionDir(
+  sessionDir: string,
+): Promise<AgentBackgroundTask[]> {
+  const tasksDir = path.join(sessionDir, "agents", "main", "tasks");
+  let entries: string[];
+  try {
+    entries = await readdir(tasksDir);
+  } catch {
+    // No task directory yet, or it is gone; either way there is nothing running.
+    return [];
+  }
+  const runningTasks: AgentBackgroundTask[] = [];
+  for (const entry of entries) {
+    if (!entry.endsWith(".json")) continue;
+    try {
+      const fullPath = path.join(tasksDir, entry);
+      const content = await readFile(fullPath, "utf8");
+      const record = JSON.parse(content) as KimiTaskFileRecord;
+      if (record && record.status === "running") {
+        runningTasks.push({
+          id: record.taskId || path.basename(entry, ".json"),
+          command: record.command ?? null,
+          description: record.description ?? null,
+          status: "running",
+          startedAt: record.startedAt ?? null,
+          pid: record.pid,
+        });
+      }
+    } catch {
+      // Ignore reading / parsing errors on partially written files
+    }
+  }
+  return runningTasks;
+}
