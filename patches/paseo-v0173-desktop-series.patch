+
+function buildCatchupToolEntry(
+  call: AntigravityToolCallEntry,
+  toolsTruncated = false,
+): CatchupToolEntry {
+  const args = call.args ?? {};
+  switch (call.name) {
+    case "run_command":
+      return {
+        kind: "execute",
+        ...buildCatchupToolTarget(args.CommandLine, toolsTruncated),
+      };
+    case "read_file":
+      return {
+        kind: "read",
+        ...buildCatchupToolTarget(args.Path, toolsTruncated),
+      };
+    case "edit_file":
+    case "write_file":
+      return {
+        kind: "edit",
+        ...buildCatchupToolTarget(args.Path, toolsTruncated),
+      };
+    case "search_web":
+      return {
+        kind: "search",
+        ...buildCatchupToolTarget(args.query, toolsTruncated),
+      };
+    default:
+      return { kind: null, target: null, targetPrefix: false };
+  }
