+    expect(client.capabilities.promptTurnTakeoverSteer).toBe(true);
+    expect(
+      client.resolveSessionDefaultCommand({
+        provider: "antigravity",
+        cwd: "/tmp/test",
+        modeId: ANTIGRAVITY_FULL_ACCESS_MODE_ID,
+      }),
