+    canStopRuntime(ctx: ACPProviderHookContext) {
+      return !(bridges.get(ctx.acpSessionId)?.hasBlockingBackgroundWork() ?? false);
+    },
+    shouldDropSessionUpdate(update, ctx) {
+      if (!ctx) {
+        return false;
+      }
+      return bridges.get(ctx.acpSessionId)?.shouldDropSessionUpdate(update, ctx) ?? false;
+    },
+  };
