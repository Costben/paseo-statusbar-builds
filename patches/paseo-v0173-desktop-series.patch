+    return false;
+  }
+  return (
+    /^API error \(attempt \d+\):/i.test(errorText) ||
+    /^Your previous response contained an improperly formatted function call:\s*Malformed function call\b/i.test(
+      errorText,
+    ) ||
+    /\bRetries remaining:\s*[1-9]\d*\s*$/i.test(errorText)
