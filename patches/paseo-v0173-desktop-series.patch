+/**
+ * Join a line held back from the previous read onto the first line of this one.
+ * Exported for the per-subagent tailer, which reads the same way.
+ */
+export function mergePendingFragment(pending: string, lines: string[]): string[] {
+  const first = lines[0];
+  if (pending.length === 0 || first === undefined) {
+    return lines;
+  }
+  return [pending + first, ...lines.slice(1)];
+}
+
+/**
+ * The fragment to hold for the next read. When the range held no complete line
+ * at all, the whole of it is one record still being written, so it threads onto
+ * the fragment already held; replacing the held fragment instead would drop
+ * every byte of it that no parse has seen yet, which is how a record appended in
+ * pieces loses its head.
+ *
+ * Exported for the per-subagent tailer, which reads the same way.
+ */
+export function nextPendingFragment(pending: string, lines: string[], fragment: string): string {
+  if (fragment.length === 0) {
+    return "";
+  }
+  return lines.length === 0 ? pending + fragment : fragment;
+}
+
+/**
+ * Drop a held fragment that has grown past `MAX_PENDING_FRAGMENT_CHARS`. The
+ * bytes are already counted in the offset, so the next read resumes after them;
+ * the line they belonged to no longer parses and is skipped like any other
+ * truncated record. Holding it instead would copy the whole line on every later
+ * read, which is the unbounded work the cap exists to prevent.
+ *
+ * Exported for the per-subagent tailer, which holds fragments the same way.
+ */
+export function capPendingFragment(
+  pending: string,
+  logger: Logger,
+  context: Record<string, unknown>,
+): string {
+  if (pending.length <= MAX_PENDING_FRAGMENT_CHARS) {
+    return pending;
+  }
+  logger.debug(
+    { ...context, pendingChars: pending.length },
+    "Kimi wire log line exceeded the fragment cap, dropping it",
+  );
+  return "";
+}
