+/**
+ * Change detector for subagent upserts, covering the fields the client renders.
+ * The timestamps are excluded for the same reason as in the goal signature, and
+ * the token count is a parameter because it comes from the subagent's own log
+ * rather than from the record.
+ */
+function subagentValueSignature(subagent: KimiSubagentRecord, tokens: number | null): string {
+  return JSON.stringify([
+    subagent.status,
+    subagent.name,
+    subagent.description,
+    subagent.toolCallId,
+    subagent.resultSummary !== null,
+    subagent.model,
+    subagent.thinkingEffort,
