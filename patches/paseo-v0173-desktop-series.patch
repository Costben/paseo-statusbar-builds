+function buildCatchupToolTarget(
+  rawArg: unknown,
+  toolsTruncated: boolean,
+): { target: string | null; targetPrefix: boolean } {
+  const unwrapped = unwrapAntigravityTruncatedArgPrefix(rawArg);
+  if (!unwrapped) {
+    return { target: null, targetPrefix: false };
+  }
+  const target = unwrapped.value.trim() || null;
+  return {
+    target,
+    targetPrefix: Boolean(target && (unwrapped.truncatedQuote || toolsTruncated)),
