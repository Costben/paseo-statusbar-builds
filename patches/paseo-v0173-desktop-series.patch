+ * `inputTokens` is the whole of it, `cachedInput` the part that came from cache.
+ */
+function readResponseUsageTotals(usage: unknown): GoalUsageTotals | null {
+  const record = toObjectRecord(usage);
+  if (!record) {
+    return null;
+  }
+  const read = (key: string): number => {
+    const value = record[key];
+    return typeof value === "number" && Number.isFinite(value) && value > 0 ? value : 0;
+  };
+  const cachedInput = read("cache_read_input_tokens");
+  const input = read("input_tokens") + cachedInput + read("cache_creation_input_tokens");
+  const output = read("output_tokens");
+  if (input <= 0 && output <= 0) {
+    return null;
+  }
+  return { input, cachedInput, output };
