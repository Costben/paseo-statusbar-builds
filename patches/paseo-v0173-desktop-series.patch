+ * describe the same read, and a gateway's echoed frame can carry an input count
+ * it invented. An output count therefore decides between them, and equal output
+ * counts fall back to the larger reading rather than the later frame — a partial
+ * frame never has more to say than the complete one it repeats.
+ */
+function mergeGoalUsageTotals(
+  previous: GoalUsageTotals,
+  incoming: GoalUsageTotals,
+): GoalUsageTotals {
+  if (incoming.output > previous.output) {
+    return incoming;
+  }
+  if (incoming.output < previous.output) {
+    return previous;
+  }
+  return {
+    input: Math.max(previous.input, incoming.input),
+    cachedInput: Math.max(previous.cachedInput, incoming.cachedInput),
+    output: previous.output,
+  };
+}
