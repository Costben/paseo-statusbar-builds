+            isManageTaskNotRunningError(record.content))
+        ) {
+          if (this.removeTrackedTaskMatching(resolvedId)) {
+            backgroundChanged = true;
+          }
+        }
+      } else if (
+        action === "send_input" &&
+        targetTaskId &&
+        isManageTaskNotRunningError(record.content)
+      ) {
+        if (this.removeTrackedTaskMatching(targetTaskId)) {
+          backgroundChanged = true;
+        }
+      } else if (
+        action === "list" &&
+        record.status === "DONE" &&
+        !record.truncatedFields.includes("content")
+      ) {
+        const activeIds = parseManageTaskListIds(record.content);
+        if (activeIds !== null) {
+          for (const key of Array.from(this.trackedTasks.keys())) {
+            if (!activeIds.some((activeId) => matchesAntigravityTaskId(key, activeId))) {
+              this.trackedTasks.delete(key);
+              this.backgroundToolCalls.delete(key);
+              backgroundChanged = true;
+            }
+          }
+        }
+      }
+    }
+
+    if (record.status === "DONE" && call?.name === "manage_subagents") {
+      const action = unwrapAntigravityArgString(call.args?.Action)?.toLowerCase();
+      if (action === "kill_all" && this.trackedSubagents.size > 0) {
+        this.trackedSubagents.clear();
+        backgroundChanged = true;
+      } else if (action === "kill") {
+        for (const childId of unwrapAntigravityStringArrayArg(call.args?.ConversationIds)) {
+          if (this.trackedSubagents.delete(childId)) {
+            backgroundChanged = true;
+          }
+        }
+      }
+    }
