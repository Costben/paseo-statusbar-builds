+
+function encodeGoKeyring(payload: unknown): string {
+  return `go-keyring-base64:${Buffer.from(JSON.stringify(payload), "utf8").toString("base64")}`;
+}
+
+describe("antigravity-usage-source", () => {
+  test("decodes go-keyring-base64 credential payload with email and expiry", () => {
+    const raw = encodeGoKeyring({
+      token: {
+        access_token: "ya29.test-token",
+        refresh_token: "1//refresh",
+        token_type: "Bearer",
+        expiry: "2026-11-14T18:32:07.000Z",
+      },
+      id_token_email: "user@example.com",
+      auth_method: "consumer",
+    });
+
+    const decoded = decodeKeyringPayload(raw);
+    expect(decoded).toEqual({
+      accessToken: "ya29.test-token",
+      email: "user@example.com",
+      expiresAtMs: Date.parse("2026-11-14T18:32:07.000Z"),
+      authMethod: "consumer",
+    });
+  });
+
+  test("discover respects session scope provider filtering and preserves stable key", async () => {
+    const raw = encodeGoKeyring({
+      token: { access_token: "ya29.test-token" },
+      id_token_email: "User@Example.com",
+    });
+
+    const lookup = {
+      platform: "darwin" as const,
+      home: "/tmp/test-home",
+      env: {},
+      readFileRaw: async () => null,
+      readKeyringRaw: async () => raw,
+    };
+
+    const globalAccounts = await discover({ kind: "global" }, lookup);
+    expect(globalAccounts).toHaveLength(1);
+    expect(globalAccounts[0]?.label).toBe("User@Example.com");
+    expect(globalAccounts[0]?.harness).toBe("Antigravity");
+
+    const agySession = await discover(
+      { kind: "session", provider: "antigravity", env: {} },
+      lookup,
+    );
+    expect(agySession).toEqual(globalAccounts);
+
+    const otherSession = await discover(
+      { kind: "session", provider: "claude", env: {} },
+      lookup,
+    );
+    expect(otherSession).toEqual([]);
+  });
+
+  test("fetchUsage maps plan tier, 3P summary windows, deduplicated Gemini bucket, and AI credits", async () => {
+    const raw = encodeGoKeyring({
+      token: {
+        access_token: "ya29.valid-token",
+        expiry: "2026-11-14T19:00:00.000Z",
+      },
+      id_token_email: "user@example.com",
+    });
+
+    const calls: Array<{ url: string; body: unknown; userAgent: string | null }> = [];
+    const fetchApi: typeof fetch = async (input, init) => {
+      const url = String(input);
+      calls.push({
+        url,
+        body: JSON.parse(String(init?.body ?? "{}")),
+        userAgent: new Headers(init?.headers).get("user-agent"),
+      });
+
+      if (url.endsWith("/v1internal:loadCodeAssist")) {
+        return new Response(
+          JSON.stringify({
+            currentTier: { id: "free-tier", name: "Antigravity" },
+            paidTier: {
+              id: "g1-ultra-lite-tier",
