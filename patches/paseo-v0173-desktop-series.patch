new file mode 100644
index 000000000..9622ed9e4
--- /dev/null
+++ b/packages/app/src/utils/agent-directory-update-policy.test.ts
@@ -0,0 +1,34 @@
+import { describe, expect, it } from "vitest";
+import type { AgentBackgroundTasksPayload } from "@getpaseo/protocol/messages";
+import { acceptAgentDirectoryUpdate } from "./agent-directory-update-policy";
+
+interface AgentUpdateFixture {
+  updatedAt: Date;
+  backgroundTasks: AgentBackgroundTasksPayload | null;
+}
+
+describe("acceptAgentDirectoryUpdate", () => {
+  it("merges backgroundTasks even when delta timestamp looks stale", () => {
+    const current: AgentUpdateFixture = {
+      updatedAt: new Date("2026-10-03T12:00:00.000Z"),
+      backgroundTasks: null,
+    };
+    const incoming: AgentUpdateFixture = {
+      updatedAt: new Date("2026-10-03T12:00:00.000Z"),
+      backgroundTasks: {
+        count: 1,
+        tasks: [
+          {
+            id: "bash-1",
+            command: "sleep 60",
+            status: "running",
+            startedAt: 1791034549628,
+          },
+        ],
+      },
+    };
+
+    const merged = acceptAgentDirectoryUpdate(current, incoming);
+    expect(merged.backgroundTasks).toEqual(incoming.backgroundTasks);
+  });
+});
