+ * strips the echoed prompt dump from exhausted `Malformed function call` errors.
+ */
+function formatAntigravityTimelineError(errorText: string): string | null {
+  if (!errorText) {
+    return "Antigravity runtime error";
+  }
+  if (isTransientAntigravityRetryError(errorText)) {
+    return null;
+  }
+  const userEchoIdx = errorText.indexOf("\n user\n");
+  if (userEchoIdx > 0 && /Malformed function call/i.test(errorText)) {
+    const headline = errorText.slice(0, userEchoIdx).trim();
+    const retriesMatch = /\bRetries remaining:\s*\d+/i.exec(errorText);
+    return retriesMatch ? `${headline} (${retriesMatch[0]})` : headline;
+  }
