+import { describe, expect, test } from "vitest";
+
+import { buildKimiSubagentSubtitle } from "./subagent-presentation.js";
+
+describe("buildKimiSubagentSubtitle", () => {
+  test("formats Kimi facts into one compact provider-owned label", () => {
+    expect(
+      buildKimiSubagentSubtitle({
+        name: "explore",
+        model: "erlapi/deepseek-flash",
+        thinkingEffort: "high",
+        totalTokens: 63_800,
+      }),
+    ).toBe("explore · erlapi/deepseek-flash · High · 63.8k tokens");
+  });
+
+  test("drops each fact the spawn did not record", () => {
+    expect(
+      buildKimiSubagentSubtitle({
+        model: "erlapi/deepseek-flash",
+        thinkingEffort: "high",
+        totalTokens: 63_800,
+      }),
+    ).toBe("erlapi/deepseek-flash · High · 63.8k tokens");
+    expect(
+      buildKimiSubagentSubtitle({
+        name: "explore",
+        thinkingEffort: "high",
+        totalTokens: 63_800,
+      }),
+    ).toBe("explore · High · 63.8k tokens");
+    expect(
+      buildKimiSubagentSubtitle({
+        name: "explore",
+        model: "erlapi/deepseek-flash",
+        totalTokens: 63_800,
+      }),
+    ).toBe("explore · erlapi/deepseek-flash · 63.8k tokens");
+    expect(
+      buildKimiSubagentSubtitle({
+        name: "explore",
+        model: "erlapi/deepseek-flash",
+        thinkingEffort: "high",
+      }),
+    ).toBe("explore · erlapi/deepseek-flash · High");
+  });
+
+  test("maps xhigh to Extra High", () => {
+    expect(buildKimiSubagentSubtitle({ thinkingEffort: "xhigh" })).toBe("Extra High");
+  });
+
+  test("formats token counts at the abbreviation boundary", () => {
+    expect(buildKimiSubagentSubtitle({ totalTokens: 999 })).toBe("999 tokens");
+    expect(buildKimiSubagentSubtitle({ totalTokens: 1_000 })).toBe("1k tokens");
+    expect(buildKimiSubagentSubtitle({ totalTokens: 63_800 })).toBe("63.8k tokens");
+  });
+
+  test("returns undefined when no fact is present", () => {
+    expect(buildKimiSubagentSubtitle({})).toBeUndefined();
+    expect(buildKimiSubagentSubtitle({ name: "  ", totalTokens: 0 })).toBeUndefined();
+  });
+});
