--- /dev/null
+++ b/packages/server/src/server/agent/providers/kimi/main-turn-renderer.ts
@@ -0,0 +1,543 @@
+import { randomUUID } from "node:crypto";
+
+import type { Logger } from "pino";
+
+import type { AgentProvider, AgentStreamEvent, AgentTimelineItem } from "../../agent-sdk-types.js";
+import { asRecord, readString } from "./session-log.js";
+import { mapKimiLoopEvent, type KimiSubagentCallRecord } from "./subagent-log.js";
+
+/**
+ * How long a turn's first output waits for the ACP stream to claim it. Kimi
+ * writes a content part to its log once the part is complete, after the ACP
+ * chunks for it have gone out, so a streamed turn is normally claimed long
+ * before this expires; the wait only covers a record that lands first.
+ */
+const CLASSIFY_DELAY_MS = 300;
+/**
+ * ACP content received this soon after a turn started may still be the tail of
+ * the turn before it — Kimi starts a queued turn the moment the previous one
+ * ends — so it does not claim the new turn.
+ */
+const STREAM_CLAIM_MARGIN_MS = 200;
+
+/** A main-agent prompt Kimi recorded, kept so a submitted prompt can be found. */
+export interface KimiPromptRecord {
+  promptTurnId: number;
+  promptId: string | null;
+  /** True when Kimi attributed the prompt to the user rather than to a task, cron job or trigger. */
+  fromUser: boolean;
+  text: string;
+  time: number;
+  ended: boolean;
+}
+
+export interface KimiMainTurnRendererOptions {
+  provider: AgentProvider;
+  emit: (event: AgentStreamEvent) => void;
+  logger: Logger;
+  /** Records stamped before this instant are history and are never rendered. */
+  renderFrom: number;
+  /** True while Paseo's ACP session has a foreground turn open. */
+  isForegroundTurnActive: () => boolean;
+  /** When the ACP stream last delivered agent output, or null if never. */
+  lastStreamedContentAt: () => number | null;
+  now?: () => number;
+  classifyDelayMs?: number;
+}
+
+type TurnSource = "skipped" | "pending" | "acp" | "wire";
+
+interface RenderedTurn {
+  turnId: number;
+  startedAt: number;
+  source: TurnSource;
+  pending: AgentTimelineItem[];
+  firstPendingAt: number | null;
+}
+
+/**
+ * Renders the main agent's turns that Kimi does not stream over ACP.
+ *
+ * Kimi's ACP server only streams a turn while one of Paseo's `session/prompt`
+ * requests is waiting for its answer. Turns the runtime starts on its own — a
+ * background task finishing, a goal continuing, a cron job, or a prompt it had
+ * queued while busy (whose request it already answered with `end_turn`) — are
+ * written to `wire.jsonl` and nowhere else. Without this, Paseo shows the agent
+ * idle while it works, and reports a queued prompt as an empty turn.
+ *
+ * Each turn is rendered from exactly one source. Its first output waits briefly
+ * for the ACP stream: a streamed turn's chunks arrive before its log record, so
+ * ACP output after the turn started claims it, and the log copy is dropped.
+ * Otherwise the turn is rendered from the log. A turn that starts while Paseo
+ * has no foreground turn is opened as a turn of its own, so Paseo shows the
+ * agent running and a message sent meanwhile is queued behind it.
+ */
+export class KimiMainTurnRenderer {
+  private readonly provider: AgentProvider;
+  private readonly emit: (event: AgentStreamEvent) => void;
+  private readonly logger: Logger;
+  private readonly renderFrom: number;
+  private readonly isForegroundTurnActive: () => boolean;
+  private readonly lastStreamedContentAt: () => number | null;
+  private readonly now: () => number;
+  private readonly classifyDelayMs: number;
+
+  private current: RenderedTurn | null = null;
+  private autonomousTurnId: string | null = null;
+  private compactionTrigger: "auto" | "manual" | null = null;
+  private lastCompactionAt: number | null = null;
+  private readonly calls = new Map<string, KimiSubagentCallRecord>();
+  private readonly prompts = new Map<number, KimiPromptRecord>();
+  /** Prompts already logged when the latest foreground turn was noted; none is its submission. */
+  private knownPromptTurnIds = new Set<number>();
+  private classifyTimer: ReturnType<typeof setTimeout> | null = null;
+  private stopped = false;
+
+  constructor(options: KimiMainTurnRendererOptions) {
+    this.provider = options.provider;
+    this.emit = options.emit;
+    this.logger = options.logger;
+    this.renderFrom = options.renderFrom;
+    this.isForegroundTurnActive = options.isForegroundTurnActive;
+    this.lastStreamedContentAt = options.lastStreamedContentAt;
+    this.now = options.now ?? Date.now;
+    this.classifyDelayMs = options.classifyDelayMs ?? CLASSIFY_DELAY_MS;
+  }
+
+  /** Folds newly appended log lines, emitting whatever they render. */
+  consume(lines: Iterable<string>): void {
+    if (this.stopped) {
+      return;
+    }
+    for (const raw of lines) {
+      const line = raw.trim();
+      if (line.length === 0) {
+        continue;
+      }
+      let parsed: unknown;
+      try {
+        parsed = JSON.parse(line);
+      } catch {
+        continue;
+      }
+      const record = asRecord(parsed);
+      if (record !== null) {
+        this.apply(record);
+      }
+    }
+  }
+
+  /**
+   * Re-checks state that can change without a log record: a foreground turn
+   * ending while the runtime is still in a turn of its own leaves that turn
+   * needing one of its own, and a pending classification may be due.
+   */
+  tick(): void {
+    if (this.stopped) {
+      return;
+    }
+    const turn = this.current;
+    if (turn && turn.source !== "skipped" && this.autonomousTurnId === null) {
+      if (!this.isForegroundTurnActive()) {
+        this.openAutonomousTurn();
+      }
+    }
+    this.classifyPending();
+  }
+
+  /**
+   * A foreground turn is about to start. A turn of the runtime's own that is
+   * still open is closed first, so the two never overlap and the rest of the
+   * runtime's output lands in the foreground turn.
+   */
+  noteForegroundTurnStarting(): void {
+    this.knownPromptTurnIds = new Set(this.prompts.keys());
+    if (this.autonomousTurnId !== null) {
+      this.closeAutonomousTurn("done");
+    }
+  }
+
+  /**
+   * Paseo stopped the turn the runtime started on its own. Kimi ignores a
+   * cancel for such a turn and keeps running it, so the stop is honoured by
+   * closing Paseo's turn as canceled, and the next tick opens a fresh one while
+   * the runtime is still in that turn: Paseo keeps showing the agent at work
+   * instead of idle while it plainly is not.
+   */
+  noteInterrupted(): void {
+    if (this.autonomousTurnId !== null) {
+      this.closeAutonomousTurn("aborted");
+    }
+  }
+
+  /**
+   * The prompt Kimi logged for a submission sent at `sentAt`: one whose text
+   * matches what was sent, else the first user prompt, else the first inbound
+   * prompt of any origin (Kimi logs some submitted text, such as a forwarded
+   * task notification, under that origin). Kimi logs a queued prompt only when
+   * it starts, so a turn the runtime starts on its own can be logged first and
+   * taken for the submission; that is harmless, since the submission's own turn
+   * is still rendered when it runs. Both processes share a clock; the slack only
+   * absorbs millisecond rounding. A prompt already logged when the foreground
+   * turn was noted is an earlier turn's, however recent, so it is never a match.
+   */
+  findSubmittedPrompt(sentAt: number, text: string | null): KimiPromptRecord | null {
+    let firstUser: KimiPromptRecord | null = null;
+    let firstAny: KimiPromptRecord | null = null;
+    for (const prompt of this.prompts.values()) {
+      if (prompt.time < sentAt - 1_000 || this.knownPromptTurnIds.has(prompt.promptTurnId)) {
+        continue;
+      }
+      if (text !== null && prompt.text.trim() === text.trim()) {
+        return prompt;
+      }
+      if (prompt.fromUser) {
+        firstUser ??= prompt;
+      }
+      firstAny ??= prompt;
+    }
+    return firstUser ?? firstAny;
+  }
+
+  stop(): void {
+    this.stopped = true;
+    this.clearClassifyTimer();
+  }
+
+  private apply(record: Record<string, unknown>): void {
+    const time = typeof record.time === "number" ? record.time : null;
+    switch (record.type) {
+      case "agent.turn.started":
+        this.onTurnStarted(record, time);
+        return;
+      case "agent.turn.ended":
+        this.onTurnEnded(record);
+        return;
+      case "context.append_loop_event":
+        this.onLoopEvent(record);
+        return;
+      case "full_compaction.begin":
+      case "full_compaction.complete":
+        this.onCompaction(record, time);
+        return;
+      case "turn.prompt":
+        this.onPrompt(record, time);
+        return;
+      case "turn.ended":
+      case "prompt.completed":
+        this.onPromptEnded(record);
+        return;
+      default:
+        return;
+    }
+  }
+
+  /**
+   * Kimi never sends compaction over ACP; its log is the only record of it.
+   *
+   * Only the finished row is written. The timeline is append-only, so a `loading`
+   * row could never be settled in place: every reader that loads the timeline
+   * from the store instead of watching it live would keep an open marker next to
+   * the finished one, and a later compaction's `completed` would then settle the
+   * wrong row and leave the newest marker open for good.
+   */
+  private onCompaction(record: Record<string, unknown>, time: number | null): void {
+    if (time === null || time < this.renderFrom) {
+      return;
+    }
+    if (record.type === "full_compaction.begin") {
+      this.compactionTrigger = record.source === "manual" ? "manual" : "auto";
+      return;
+    }
+    const trigger = this.compactionTrigger;
+    this.compactionTrigger = null;
+    this.lastCompactionAt = time;
+    this.emitItem({
+      type: "compaction",
+      status: "completed",
+      ...(trigger ? { trigger } : {}),
+    });
+  }
+
+  /** True once a compaction this session ran has been rendered at or after `at`. */
+  compactedSince(at: number): boolean {
+    return this.lastCompactionAt !== null && this.lastCompactionAt >= at;
+  }
+
+  /** A prompt is over at its prompt-level `turn.ended`, or at `prompt.completed` for a user prompt. */
+  private onPromptEnded(record: Record<string, unknown>): void {
+    if (record.type === "turn.ended") {
+      const turnId = typeof record.turnId === "number" ? record.turnId : null;
+      const prompt = turnId !== null ? this.prompts.get(turnId) : undefined;
+      if (prompt) {
+        prompt.ended = true;
+      }
+      // Current Kimi logs end the turn only here, with no `agent.turn.ended`,
+      // so the turn being rendered is closed by this record too.
+      if (this.current !== null && (turnId === null || this.current.turnId === turnId)) {
+        this.finishCurrentTurn(readString(record.reason) === "cancelled" ? "aborted" : "done");
+      }
+      return;
+    }
+    const promptId = readString(record.promptId);
+    if (promptId === undefined) {
+      return;
+    }
+    for (const prompt of this.prompts.values()) {
+      if (prompt.promptId === promptId) {
+        prompt.ended = true;
+      }
+    }
+  }
+
+  private onTurnStarted(record: Record<string, unknown>, time: number | null): void {
+    const turnId = typeof record.turnId === "number" ? record.turnId : -1;
+    this.beginTurn(turnId, time);
+  }
+
+  /**
+   * Opens the turn `turnId`. Kimi announces a turn twice in older logs — an
+   * `agent.turn.started` record and the turn's own `turn.prompt` — and only
+   * once, at the prompt receipt, in the logs its current version writes; the id
+   * makes the second announcement a no-op instead of a second turn.
+   */
+  private beginTurn(turnId: number, time: number | null): void {
+    const current = this.current;
+    if (current !== null && current.turnId === turnId) {
+      return;
+    }
+    // A turn that never logged its end is over once the next one starts.
+    if (current !== null) {
+      this.finishCurrentTurn("done");
+    }
+    if (time === null || time < this.renderFrom) {
+      this.current = {
+        turnId,
+        startedAt: time ?? 0,
+        source: "skipped",
+        pending: [],
+        firstPendingAt: null,
+      };
+      return;
+    }
+    this.current = {
+      turnId,
+      startedAt: time,
+      source: "pending",
+      pending: [],
+      firstPendingAt: null,
+    };
+    if (!this.isForegroundTurnActive()) {
+      this.openAutonomousTurn();
+    }
+  }
+
+  private onTurnEnded(record: Record<string, unknown>): void {
+    if (!this.current) {
+      return;
+    }
+    const outcome = readString(record.outcome) ?? "done";
+    this.finishCurrentTurn(outcome);
+  }
+
+  private finishCurrentTurn(outcome: string): void {
+    const turn = this.current;
+    if (!turn) {
+      return;
+    }
+    // Output still waiting for the ACP stream at the turn's end was not claimed.
+    if (turn.source === "pending" && turn.pending.length > 0) {
+      this.settleClassification(turn, this.isClaimedByStream(turn) ? "acp" : "wire");
+    }
+    this.current = null;
+    this.clearClassifyTimer();
+    if (this.autonomousTurnId !== null) {
+      this.closeAutonomousTurn(outcome);
+    }
+  }
+
+  private onLoopEvent(record: Record<string, unknown>): void {
+    if (record.agentId !== undefined && record.agentId !== "main") {
+      return;
+    }
+    const event = asRecord(record.event);
+    if (event === null) {
+      return;
+    }
+    const items: AgentTimelineItem[] = [];
+    // Always folded, so a tool result can recover the call it answers.
+    mapKimiLoopEvent(event, this.calls, items);
+    const turn = this.current;
+    if (items.length === 0 || !turn) {
+      return;
+    }
+    switch (turn.source) {
+      case "skipped":
+      case "acp":
+        return;
+      case "wire":
+        for (const item of items) {
+          this.emitItem(item);
+        }
+        return;
+      case "pending":
+        turn.pending.push(...items);
+        turn.firstPendingAt ??= this.now();
+        this.classifyPending();
+        return;
+    }
+  }
+
+  private onPrompt(record: Record<string, unknown>, time: number | null): void {
+    // A record without a timestamp is taken as read now; Kimi stamps them all.
+    const at = time ?? this.now();
+    if (at < this.renderFrom || record.agentId !== "main" || typeof record.turnId !== "number") {
+      return;
+    }
+    const origin = asRecord(record.origin);
+    if (!isInboundOrigin(origin)) {
+      return;
+    }
+    this.prompts.set(record.turnId, {
+      promptTurnId: record.turnId,
+      promptId: readString(record.promptId) ?? null,
+      fromUser: origin?.kind === "user",
+      text: readPromptText(record.input),
+      time: at,
+      ended: false,
+    });
+    // Kimi's current log names the turn's start with this receipt and writes no
+    // `agent.turn.started`, so the turn the prompt belongs to is opened here.
+    this.beginTurn(record.turnId, at);
+    // Only the latest few matter: a submission is matched within seconds.
+    if (this.prompts.size > 64) {
+      const oldest = this.prompts.keys().next().value;
+      if (oldest !== undefined) {
+        this.prompts.delete(oldest);
+      }
+    }
+  }
+
+  private isClaimedByStream(turn: RenderedTurn): boolean {
+    const streamedAt = this.lastStreamedContentAt();
+    return streamedAt !== null && streamedAt > turn.startedAt + STREAM_CLAIM_MARGIN_MS;
+  }
+
+  private classifyPending(): void {
+    const turn = this.current;
+    if (!turn || turn.source !== "pending" || turn.firstPendingAt === null) {
+      return;
+    }
+    if (this.isClaimedByStream(turn)) {
+      this.settleClassification(turn, "acp");
+      return;
+    }
+    const waited = this.now() - turn.firstPendingAt;
+    if (waited >= this.classifyDelayMs) {
+      this.settleClassification(turn, "wire");
+      return;
+    }
+    if (this.classifyTimer === null) {
+      this.classifyTimer = setTimeout(() => {
+        this.classifyTimer = null;
+        this.classifyPending();
+      }, this.classifyDelayMs - waited);
+      this.classifyTimer.unref?.();
+    }
+  }
+
+  private settleClassification(turn: RenderedTurn, source: "acp" | "wire"): void {
+    this.clearClassifyTimer();
+    turn.source = source;
+    const pending = turn.pending;
+    turn.pending = [];
+    if (source === "wire") {
+      this.logger.debug(
+        { turnId: turn.turnId, items: pending.length },
+        "Kimi turn not streamed over ACP; rendering it from the session log",
+      );
+      for (const item of pending) {
+        this.emitItem(item);
+      }
+    }
+  }
+
+  private clearClassifyTimer(): void {
+    if (this.classifyTimer !== null) {
+      clearTimeout(this.classifyTimer);
+      this.classifyTimer = null;
+    }
+  }
+
+  private openAutonomousTurn(): void {
+    const turnId = `kimi-turn-${randomUUID()}`;
+    this.autonomousTurnId = turnId;
+    this.emit({ type: "turn_started", provider: this.provider, turnId });
+  }
+
+  private closeAutonomousTurn(outcome: string): void {
+    const turnId = this.autonomousTurnId;
+    if (turnId === null) {
+      return;
+    }
+    this.autonomousTurnId = null;
+    if (outcome === "aborted") {
+      this.emit({ type: "turn_canceled", provider: this.provider, reason: "Interrupted", turnId });
+      return;
+    }
+    if (outcome === "failed") {
+      this.emit({
+        type: "turn_failed",
+        provider: this.provider,
+        error: "Kimi ended this turn with a failure",
+        code: "kimi_turn_failed",
+        turnId,
+      });
+      return;
+    }
+    this.emit({ type: "turn_completed", provider: this.provider, turnId });
+  }
+
+  private emitItem(item: AgentTimelineItem): void {
+    this.emit({
+      type: "timeline",
+      provider: this.provider,
+      item,
+      ...(this.autonomousTurnId !== null ? { turnId: this.autonomousTurnId } : {}),
+    });
+  }
+}
+
+/** Origins that start a prompt of their own, mirroring the session log's receipt rules. */
+function isInboundOrigin(origin: Record<string, unknown> | null): boolean {
+  switch (origin?.kind) {
+    case "user":
+    case "task":
+    case "cron_job":
+      return true;
+    case "skill_activation":
+      return origin.trigger === "user-slash";
+    case "system_trigger":
+      return origin.name === "goal_continuation";
+    default:
+      return false;
+  }
+}
+
+function readPromptText(input: unknown): string {
+  if (typeof input === "string") {
+    return input;
+  }
+  if (!Array.isArray(input)) {
+    return "";
+  }
+  const parts: string[] = [];
+  for (const part of input) {
+    const record = asRecord(part);
+    const text = record?.type === "text" ? readString(record.text) : undefined;
+    if (text !== undefined) {
+      parts.push(text);
+    }
+  }
+  return parts.join("\n");
+}
