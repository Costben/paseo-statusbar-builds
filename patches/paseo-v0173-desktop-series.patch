 import equal from "fast-deep-equal";
 import type { AgentMetric, AgentUsage } from "@getpaseo/protocol/agent-types";
+import type { AgentGoalPayload, AgentBackgroundTasksPayload } from "@getpaseo/protocol/messages";
 
 interface AgentUpdateValue {
   updatedAt: Date | string;
   lastUsage?: AgentUsage;
   sessionMetrics?: AgentMetric[];
+  goal?: AgentGoalPayload | null;
+  backgroundTasks?: AgentBackgroundTasksPayload | null;
 }
 
 // The daemon reports these without bumping `updatedAt`, so a stale upsert can still carry the
@@ -23,6 +26,15 @@ export function acceptAgentDirectoryUpdate<T extends AgentUpdateValue>(
   const newer = FIELDS_UPDATED_IN_PLACE.filter(
     (field) => incoming[field] !== undefined && !equal(incoming[field], current[field]),
   );
-  if (newer.length === 0) return current;
-  return { ...current, ...Object.fromEntries(newer.map((field) => [field, incoming[field]])) };
+  let merged = newer.length === 0 ? current : { ...current, ...Object.fromEntries(newer.map((field) => [field, incoming[field]])) };
+  if (incoming.lastUsage !== undefined && !equal(incoming.lastUsage, merged.lastUsage)) {
+    merged = { ...merged, lastUsage: incoming.lastUsage };
+  }
+  if (incoming.goal !== undefined && !equal(incoming.goal, merged.goal)) {
+    merged = { ...merged, goal: incoming.goal };
+  }
+  if (incoming.backgroundTasks !== undefined && !equal(incoming.backgroundTasks, merged.backgroundTasks)) {
+    merged = { ...merged, backgroundTasks: incoming.backgroundTasks };
+  }
+  return merged;
 }
