+function createAntigravityConfigOptions(
+  currentModel = "gemini-4-hydrogen",
+  thoughtLevels: string[] = ["low", "medium", "high", "xhigh"],
+): SessionConfigOption[] {
+  const options: SessionConfigOption[] = [
+    {
+      id: "model",
+      name: "Model",
+      category: "model",
+      type: "select",
+      currentValue: currentModel,
+      options: [
+        { value: "gemini-4-hydrogen", name: "Gemini 4 Hydrogen" },
+        { value: "gemini-4-carbon", name: "Gemini 4 Carbon" },
+        { value: "gemini-pro-orchestrator", name: "Gemini Pro Orchestrator" },
+        { value: "claude-opus-5-5", name: "Claude Opus 5.5" },
+      ],
+    },
+    {
+      id: "mode",
+      name: "Mode",
+      category: "mode",
+      type: "select",
+      currentValue: "default",
+      options: [
+        { value: "default", name: "Ask" },
+        { value: "accept-edits", name: "Accept Edits" },
+        { value: "auto", name: "Auto" },
+        { value: "plan", name: "Plan" },
+      ],
+    },
+  ];
+  if (thoughtLevels.length > 0) {
+    options.push({
+      id: "thought_level",
+      name: "Thinking Level",
+      category: "thought_level",
+      type: "select",
+      currentValue: "high",
+      options: thoughtLevels.map((value) => ({
+        value,
+        name: value === "xhigh" ? "Extra" : value[0]!.toUpperCase() + value.slice(1),
+      })),
+    });
+  }
+  return options;
+}
+
+describe("AntigravityACPAgentClient", () => {
+  test("advertises elicitation.form client capability and host catalog cache key", async () => {
+    const client = new AntigravityACPAgentClient({ logger: createTestLogger() });
+    expect(client.provider).toBe("antigravity");
+    expect(await client.getCatalogCacheKey()).toBe("host");
+    expect(client.capabilities).toMatchObject({
+      supportsStreaming: true,
+      supportsSessionPersistence: true,
+      supportsSessionListing: true,
+      supportsDynamicModes: true,
+      supportsMcpServers: true,
+      supportsReasoningStream: true,
+      supportsToolInvocations: true,
+    });
+  });
+
+  test("resolves launch command without duplicating acp argument", () => {
+    expect(resolveAntigravityDefaultCommand()).toEqual(["agy", "acp"]);
+    expect(
+      resolveAntigravityDefaultCommand({
+        command: { mode: "replace", argv: ["/usr/local/bin/agy"] },
+      }),
+    ).toEqual(["agy", "acp"]);
+    expect(
+      resolveAntigravityDefaultCommand({
+        command: { mode: "replace", argv: ["/usr/local/bin/agy", "acp"] },
+      }),
+    ).toEqual(["/usr/local/bin/agy"]);
+  });
+
+  test("builds _meta.antigravity.systemPrompt.append from prompt settings", () => {
+    expect(
+      buildAntigravitySessionMeta({
+        provider: "antigravity",
