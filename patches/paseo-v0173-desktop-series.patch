+      if (this.hasBlockingBackgroundWork()) {
+        this.clearIdleWakeupTimer();
+      } else {
+        this.armIdleWakeupTimer(
+          this.pendingStepTools.length > 0 ? this.postSettleToolWaitMs : this.postSettleWaitMs,
+        );
+      }
+    }
+  }
+
+  private handleSystemMessage(record: AntigravityTranscriptRecord): void {
+    this.lastTranscriptStepNeedsModelFollowup = true;
+    const senders = parseSystemMessageSenders(record.content);
+    let backgroundChanged = false;
+    const renderThisStep =
+      this.shouldRenderCurrentStep() || this.inTurnHold || !this.isForegroundTurnActive();
+
+    for (const sender of senders) {
+      const canceledOrFailed = /\b(was canceled|failed)\b/i.test(record.content ?? "");
+      if (
+        this.removeTrackedTaskMatching(sender, {
+          render: renderThisStep,
+          failed: canceledOrFailed,
+          output: record.content,
+        })
+      ) {
+        backgroundChanged = true;
+      }
+      if (this.trackedSubagents.delete(sender)) {
+        backgroundChanged = true;
+      }
+    }
+
+    if (senders.length > 0) {
+      for (const [taskId, entry] of Array.from(this.trackedTasks.entries())) {
+        const cond = entry.timerCondition;
+        if (!cond) {
+          continue;
+        }
+        const matched =
+          cond.toLowerCase() === "any" ||
+          senders.some((sender) => matchesAntigravityTaskId(cond, sender));
+        if (matched) {
+          if (
+            this.removeTrackedTaskMatching(taskId, {
+              render: renderThisStep,
+              failed: false,
+              output: "Timer cancelled early by matching message.",
+            })
+          ) {
+            backgroundChanged = true;
+          }
+        }
+      }
+    }
+
+    if (backgroundChanged) {
+      this.emitBackgroundWorkIfChanged();
+    }
+
+    if (this.inTurnHold) {
+      this.holdEpochSawWakeup = true;
+      if (!this.hasBlockingBackgroundWork()) {
+        this.awaitingPostSettleResponse = true;
+        this.postSettleFinalPlannerSeen = false;
+        this.postSettleDeadline = this.now() + this.postSettleWaitMs;
+      } else {
+        this.awaitingPostSettleResponse = false;
+        this.postSettleFinalPlannerSeen = false;
+        this.postSettleDeadline = null;
+      }
+      this.wakeHoldLoop();
+      return;
+    }
+
+    if (!this.isForegroundTurnActive()) {
+      this.idleWakeupActive = true;
+      if (senders.length > 0) {
+        this.ensureIdleWakeupTurn();
+        this.armIdleWakeupTimer(this.postSettleWaitMs);
+      }
+    }
+  }
+
+  private shouldRenderCurrentStep(): boolean {
+    if (this.inTurnHold) {
+      return this.holdEpochSawWakeup;
+    }
+    if (this.idleWakeupActive) {
+      return true;
+    }
+    if (this.isForegroundTurnActive()) {
+      return false;
+    }
+    return this.shouldRenderAutonomousStep();
+  }
+
+  private shouldRenderAutonomousStep(): boolean {
+    if (this.idleWakeupActive) {
+      return true;
+    }
+    const lastStreamed = this.lastStreamedContentAt() ?? 0;
+    const lastEnded = this.lastForegroundEndedAt ?? 0;
+    const mostRecentForegroundActivity = Math.max(lastStreamed, lastEnded);
+    if (mostRecentForegroundActivity <= 0) {
+      return true;
+    }
+    if (this.now() - mostRecentForegroundActivity > this.streamFlushGraceMs) {
+      this.idleWakeupActive = true;
+      return true;
+    }
+    return false;
+  }
+
+  private ensureIdleWakeupTurn(): string {
+    if (this.idleWakeupTurnId !== null) {
+      return this.idleWakeupTurnId;
+    }
+    const turnId = `agy-wakeup-${randomUUID()}`;
+    this.idleWakeupTurnId = turnId;
+    this.idleWakeupActive = true;
+    this.emit({
+      type: "turn_started",
+      provider: this.provider,
+      turnId,
+    });
+    return turnId;
+  }
+
+  private clearIdleWakeupTimer(): void {
+    if (this.idleWakeupTimer !== null) {
+      clearTimeout(this.idleWakeupTimer);
+      this.idleWakeupTimer = null;
+    }
+  }
+
+  private armIdleWakeupTimer(timeoutMs: number): void {
+    this.clearIdleWakeupTimer();
+    if (
+      this.stopped ||
+      this.idleWakeupTurnId === null ||
+      this.hasBlockingBackgroundWork() ||
+      this.recoveringAutonomousAuth401
+    ) {
+      return;
+    }
+    this.idleWakeupTimer = setTimeout(() => {
+      this.idleWakeupTimer = null;
+      this.closeIdleWakeupTurn();
+    }, timeoutMs);
+    this.idleWakeupTimer.unref?.();
+  }
+
+  private closeIdleWakeupTurn(): void {
+    this.clearIdleWakeupTimer();
+    this.idleWakeupActive = false;
+    const turnId = this.idleWakeupTurnId;
+    this.idleWakeupTurnId = null;
+    if (turnId !== null) {
+      this.emit({
+        type: "turn_completed",
+        provider: this.provider,
+        turnId,
+      });
+    }
+  }
+
+  private emitTimelineItem(item: AgentTimelineItem): void {
+    if (!this.inTurnHold && !this.isForegroundTurnActive()) {
+      const turnId = this.ensureIdleWakeupTurn();
+      this.emit({
+        type: "timeline",
+        provider: this.provider,
+        item,
+        turnId,
+      });
+      this.armIdleWakeupTimer(
+        this.pendingStepTools.length > 0 ? this.postSettleToolWaitMs : this.postSettleWaitMs,
+      );
+      return;
+    }
+    this.emit({
+      type: "timeline",
+      provider: this.provider,
+      item,
+    });
+  }
+
+  private emitBackgroundWorkIfChanged(): void {
+    const items: AgentBackgroundWorkInput[] = [];
+    for (const entry of this.trackedTasks.values()) {
+      items.push({
+        id: entry.id,
+        kind: entry.kind,
+        description: entry.description,
+        ...(entry.command ? { command: entry.command } : {}),
+      });
+    }
+    for (const entry of this.trackedSubagents.values()) {
+      items.push({
+        id: entry.id,
+        kind: entry.kind,
+        description: entry.description,
+        ...(entry.command ? { command: entry.command } : {}),
+      });
+    }
+    const serialized = JSON.stringify(items);
+    if (serialized === this.lastEmittedBackgroundKey) {
+      return;
+    }
+    this.lastEmittedBackgroundKey = serialized;
+    this.emittedAnyBackgroundWork = true;
+    this.emit({
+      type: "background_work",
+      provider: this.provider,
+      items,
+    });
+  }
+
+  private removeTrackedTaskMatching(
+    candidateId: string,
+    settleOptions?: RemoveTrackedTaskSettleOptions,
+  ): boolean {
+    let removed = false;
+    for (const key of Array.from(this.trackedTasks.keys())) {
+      if (!matchesAntigravityTaskId(key, candidateId)) {
+        continue;
+      }
+      this.trackedTasks.delete(key);
+      removed = true;
+      const bgTool = this.backgroundToolCalls.get(key);
+      if (bgTool) {
+        this.backgroundToolCalls.delete(key);
+        if (settleOptions?.render && bgTool.callId) {
+          this.emitTimelineItem(
+            buildAntigravitySettledToolItem(
+              bgTool.call,
+              bgTool.callId,
+              Boolean(settleOptions.failed),
+              settleOptions.output ?? null,
+            ),
+          );
+        }
+      }
+    }
+    return removed;
+  }
+
+  private pruneExpiredTrackedTasks(): void {
+    const nowMs = this.now();
+    let removed = false;
+    const render = this.shouldRenderCurrentStep();
+    for (const [key, entry] of Array.from(this.trackedTasks.entries())) {
+      if (typeof entry.expiresAtMs !== "number" || nowMs < entry.expiresAtMs) {
+        continue;
+      }
+      this.trackedTasks.delete(key);
+      removed = true;
+      const bgTool = this.backgroundToolCalls.get(key);
+      if (bgTool) {
+        this.backgroundToolCalls.delete(key);
+        if (render && bgTool.callId) {
+          this.emitTimelineItem(
+            buildAntigravitySettledToolItem(
+              bgTool.call,
+              bgTool.callId,
+              false,
+              "Scheduled timer elapsed.",
+            ),
+          );
+        }
+      }
+    }
+    if (!removed) {
+      return;
+    }
+    this.emitBackgroundWorkIfChanged();
+    if (!this.hasBlockingBackgroundWork()) {
+      if (this.inTurnHold) {
+        this.wakeHoldLoop();
+      } else if (this.idleWakeupTurnId !== null) {
+        this.armIdleWakeupTimer(this.postSettleWaitMs);
+      }
+    }
+  }
+
+  private initializeServerLogBaselineSync(): void {
+    const logPath = this.findServerLogPathSync();
+    if (!logPath) {
+      return;
+    }
+    this.resolvedServerLogPath = logPath;
+    try {
+      const stats = statSync(logPath);
+      const scanLen = Math.min(stats.size, 512 * 1024);
+      if (scanLen > 0) {
+        const tailText = readFileSync(logPath, "utf8").slice(-scanLen);
+        for (const line of tailText.split(/\r?\n/)) {
+          if (AUTH_TOKEN_REFRESHED_RE.test(line)) {
+            this.lastTokenRefreshedAt = this.now();
+          }
+        }
+      }
+      this.serverLogOffset = stats.size;
+      this.serverLogInitialized = true;
+    } catch {
+      // File may have vanished or not yet be readable; async poll will retry.
+    }
+  }
+
+  private findServerLogPathSync(): string | null {
+    if (this.resolvedServerLogPath) {
+      return this.resolvedServerLogPath;
+    }
+    const pid = this.getChildPid();
+    if (typeof pid !== "number" || pid <= 0) {
+      return null;
+    }
+    const logDir = path.join(this.antigravityHome, "log");
+    let entries: string[];
+    try {
+      entries = readdirSync(logDir);
+    } catch {
+      return null;
+    }
+    const suffix = `-${pid}.log`;
+    const candidates: Array<{ fullPath: string; mtimeMs: number }> = [];
+    for (const name of entries) {
+      if (!name.startsWith("acp-server-") || !name.endsWith(suffix)) {
+        continue;
+      }
+      const fullPath = path.join(logDir, name);
+      try {
+        candidates.push({ fullPath, mtimeMs: statSync(fullPath).mtimeMs });
+      } catch {
+        // Skip vanished file.
+      }
+    }
+    if (candidates.length === 0) {
+      return null;
+    }
+    candidates.sort((a, b) => b.mtimeMs - a.mtimeMs);
+    return candidates[0]?.fullPath ?? null;
+  }
+
+  private async resolveServerLogPath(): Promise<string | null> {
+    if (this.resolvedServerLogPath) {
+      return this.resolvedServerLogPath;
+    }
+    const logDir = path.join(this.antigravityHome, "log");
+    let entries: string[];
+    try {
+      entries = await readdir(logDir);
+    } catch {
+      return null;
+    }
+    const acpLogs = entries.filter(
+      (name) => name.startsWith("acp-server-") && name.endsWith(".log"),
+    );
+    if (acpLogs.length === 0) {
+      return null;
+    }
+    const pid = this.getChildPid();
+    if (typeof pid === "number" && pid > 0) {
+      const suffix = `-${pid}.log`;
+      const pidMatches: Array<{ fullPath: string; mtimeMs: number }> = [];
+      for (const name of acpLogs) {
+        if (!name.endsWith(suffix)) {
+          continue;
+        }
+        const fullPath = path.join(logDir, name);
+        try {
+          const stats = await stat(fullPath);
+          pidMatches.push({ fullPath, mtimeMs: stats.mtimeMs });
+        } catch {
+          // Skip vanished file.
+        }
+      }
+      if (pidMatches.length > 0) {
+        pidMatches.sort((a, b) => b.mtimeMs - a.mtimeMs);
+        const bestMatch = pidMatches[0];
+        if (bestMatch) {
+          this.resolvedServerLogPath = bestMatch.fullPath;
+          return this.resolvedServerLogPath;
+        }
+      }
+      return null;
+    }
+    if (!this.sessionId) {
+      return null;
+    }
+    const candidates: Array<{ fullPath: string; mtimeMs: number; size: number }> = [];
+    for (const name of acpLogs) {
+      const fullPath = path.join(logDir, name);
+      try {
+        const stats = await stat(fullPath);
+        candidates.push({ fullPath, mtimeMs: stats.mtimeMs, size: stats.size });
+      } catch {
+        // Skip vanished file.
+      }
+    }
+    candidates.sort((a, b) => b.mtimeMs - a.mtimeMs);
+    for (const candidate of candidates.slice(0, 5)) {
+      try {
+        const readLen = Math.min(candidate.size, SERVER_LOG_READ_CHUNK_BYTES);
+        if (readLen <= 0) {
+          continue;
+        }
+        const handle = await open(candidate.fullPath, "r");
+        try {
+          const buf = Buffer.allocUnsafe(readLen);
+          const { bytesRead } = await handle.read(
+            buf,
+            0,
+            readLen,
+            Math.max(0, candidate.size - readLen),
+          );
+          if (buf.subarray(0, bytesRead).toString("utf8").includes(this.sessionId)) {
+            this.resolvedServerLogPath = candidate.fullPath;
+            return this.resolvedServerLogPath;
+          }
+        } finally {
+          await handle.close();
+        }
+      } catch {
+        // Ignore transient read errors.
+      }
+    }
+    return null;
+  }
+
+  private async pollServerLog(): Promise<void> {
+    if (this.stopped) {
+      return;
+    }
+    if (this.serverLogReading) {
+      await this.serverLogReading;
+      return;
+    }
+    this.serverLogReading = this.drainServerLogLines().finally(() => {
+      this.serverLogReading = null;
+    });
+    await this.serverLogReading;
+  }
+
+  private async drainServerLogLines(): Promise<void> {
+    const logPath = await this.resolveServerLogPath();
+    if (!logPath || this.stopped) {
+      return;
+    }
+    let fileSize: number;
+    try {
+      const stats = await stat(logPath);
+      fileSize = stats.size;
+    } catch {
+      return;
+    }
+    if (!this.serverLogInitialized) {
+      this.serverLogOffset = 0;
+      this.serverLogInitialized = true;
+    }
+    if (fileSize < this.serverLogOffset) {
+      this.serverLogOffset = 0;
+    }
+    while (!this.stopped && this.serverLogOffset < fileSize) {
+      const bytesToRead = Math.min(SERVER_LOG_READ_CHUNK_BYTES, fileSize - this.serverLogOffset);
+      const buffer = Buffer.allocUnsafe(bytesToRead);
+      let bytesRead = 0;
+      try {
+        const handle = await open(logPath, "r");
+        try {
+          const result = await handle.read(buffer, 0, bytesToRead, this.serverLogOffset);
+          bytesRead = result.bytesRead;
+        } finally {
+          await handle.close();
+        }
+      } catch {
+        break;
+      }
+      if (bytesRead <= 0) {
+        break;
+      }
+      const slice = buffer.subarray(0, bytesRead);
+      const lastNewline = slice.lastIndexOf(0x0a);
+      if (lastNewline < 0) {
+        break;
+      }
+      this.serverLogOffset += lastNewline + 1;
+      const text = slice.subarray(0, lastNewline).toString("utf8");
+      this.consumeServerLogLines(text.split(/\r?\n/));
+    }
+  }
+
+  private consumeServerLogLines(lines: string[]): void {
+    for (const line of lines) {
+      if (!line) {
+        continue;
+      }
+      if (AUTH_TOKEN_REFRESHED_RE.test(line)) {
+        this.lastTokenRefreshedAt = this.now();
+        this.fatalAuthFailureSeen = false;
+        this.wakeHoldLoop();
+      }
+      if (AUTH_EXECUTOR_401_RE.test(line)) {
+        const nowMs = this.now();
+        if (
+          this.lastAuth401DetectedAt === null ||
+          nowMs - this.lastAuth401DetectedAt >= AUTH_401_DEDUPE_MS
+        ) {
+          this.lastAuth401DetectedAt = nowMs;
+          this.pendingAuth401At = nowMs;
+          this.wakeHoldLoop();
+        }
+      }
+      if (this.lastAuth401DetectedAt !== null && AUTH_FATAL_LOGIN_RE.test(line)) {
+        this.fatalAuthFailureSeen = true;
+        this.wakeHoldLoop();
+      }
+    }
+  }
+
+  private adoptIdleWakeupTurnForContinuation(): string | undefined {
+    this.clearIdleWakeupTimer();
+    this.idleWakeupActive = false;
+    const turnId = this.idleWakeupTurnId ?? undefined;
+    this.idleWakeupTurnId = null;
+    return turnId;
+  }
+
+  consumeUnrecoverableAuthError(): { code: string; error: string; diagnostic?: string } | null {
+    if (!this.unrecoverableAuthError) {
+      return null;
+    }
+    const error = this.unrecoverableAuthError;
+    this.unrecoverableAuthError = null;
+    return {
+      error,
+      code: "antigravity_oauth_401",
+      diagnostic: error,
+    };
+  }
+
+  private hasValidRefreshAround(errAt: number): boolean {
+    return (
+      this.lastTokenRefreshedAt !== null &&
+      this.lastTokenRefreshedAt >= errAt - PRE_REFRESH_WINDOW_MS
+    );
+  }
+
+  private async waitForTokenRefreshReady(errAt: number, signal?: AbortSignal): Promise<void> {
+    const preRefreshed = this.hasValidRefreshAround(errAt);
+    const minGrace = preRefreshed
+      ? Math.min(250, this.authRefreshMinGraceMs)
+      : this.authRefreshMinGraceMs;
+    const minDeadline = errAt + minGrace;
+    const maxDeadline = errAt + this.authRefreshWaitMs;
+    while (
+      !this.stopped &&
+      !signal?.aborted &&
+      !this.steeredOutOfHold &&
+      !this.fatalAuthFailureSeen
+    ) {
+      const nowMs = this.now();
+      if (nowMs >= minDeadline && this.hasValidRefreshAround(errAt)) {
+        return;
+      }
+      if (nowMs >= maxDeadline) {
+        return;
+      }
+      const remainingToMax = Math.max(1, maxDeadline - nowMs);
+      const targetBeforeRefresh =
+        nowMs < minDeadline ? Math.max(1, minDeadline - nowMs) : remainingToMax;
+      const stepMs = Math.min(
+        Math.min(this.heldPollIntervalMs, 100),
+        targetBeforeRefresh,
+        remainingToMax,
+      );
+      await this.waitHoldStep(stepMs, signal);
+      await this.pollServerLog();
+    }
+  }
+
+  private async tryRecoverPendingAuth401(
+    signal: AbortSignal | undefined,
+    source: string,
+  ): Promise<"none" | "aborted" | "unavailable" | "exhausted" | "dispatched"> {
+    const errAt = this.pendingAuth401At;
+    if (errAt === null) {
+      return "none";
+    }
+    this.pendingAuth401At = null;
+    if (this.stopped || signal?.aborted || this.steeredOutOfHold) {
+      return "aborted";
+    }
+    if (!this.onTransientAuthRecovery) {
+      return "unavailable";
+    }
+    if (this.fatalAuthFailureSeen || this.authExpiryRetryCount >= this.maxAuthExpiryRetries) {
+      this.unrecoverableAuthError = UNRECOVERABLE_AUTH_401_MESSAGE;
+      this.logger?.warn?.(
+        {
+          sessionId: this.sessionId,
+          source,
+          retries: this.authExpiryRetryCount,
+          fatalAuthFailureSeen: this.fatalAuthFailureSeen,
+        },
+        "antigravity.bridge.auth_401_exhausted",
+      );
+      return "exhausted";
+    }
+    await this.waitForTokenRefreshReady(errAt, signal);
+    if (this.stopped || signal?.aborted || this.steeredOutOfHold) {
+      return "aborted";
+    }
+    if (this.fatalAuthFailureSeen) {
+      this.unrecoverableAuthError = UNRECOVERABLE_AUTH_401_MESSAGE;
+      this.logger?.warn?.(
+        {
+          sessionId: this.sessionId,
+          source,
+          retries: this.authExpiryRetryCount,
+          fatalAuthFailureSeen: true,
+        },
+        "antigravity.bridge.auth_401_fatal_login",
+      );
+      return "exhausted";
+    }
+    this.authExpiryRetryCount += 1;
+    this.pendingAuth401At = null;
+    this.lastAuth401DetectedAt = null;
+    const adoptTurnId =
+      !this.inTurnHold && !this.isForegroundTurnActive()
+        ? this.adoptIdleWakeupTurnForContinuation()
+        : undefined;
+    this.logger?.warn?.(
+      {
+        sessionId: this.sessionId,
+        source,
+        attempt: this.authExpiryRetryCount,
+        adoptTurnId: adoptTurnId ?? null,
+        tokenRefreshedSeen: this.hasValidRefreshAround(errAt),
+      },
+      "antigravity.bridge.auth_401_auto_continuing",
+    );
+    const ok = await this.onTransientAuthRecovery(ANTIGRAVITY_AUTH_RECOVERY_PROMPT, source, adoptTurnId);
+    if (!ok) {
+      this.unrecoverableAuthError = UNRECOVERABLE_AUTH_401_MESSAGE;
+      return "exhausted";
+    }
+    return "dispatched";
+  }
