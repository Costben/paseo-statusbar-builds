+import { closeSync, createReadStream, existsSync, openSync, readdirSync, readSync } from "node:fs";
+import { readFile, readdir, stat } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { createInterface } from "node:readline";
+import { setImmediate as waitForImmediate } from "node:timers/promises";
+
+import type { Logger } from "pino";
+
+import {
+  isAgentGoalLive,
+  type AgentBackgroundTask,
+  type AgentBackgroundTasks,
+  type AgentGoal,
+  type AgentGoalStatus,
+  type AgentTimelineItem,
+  type AgentUsage,
+} from "../../agent-sdk-types.js";
+import type { ProviderSubagentInputEvent } from "../../provider-subagents/store.js";
+import { KimiSubagentLogTailer } from "./subagent-log.js";
+import { buildKimiSubagentSubtitle } from "./subagent-presentation.js";
+
+/**
+ * Kimi Code writes one JSON object per line to
+ * `<kimiHome>/sessions/<wd-slug>/<sessionId>/agents/main/wire.jsonl`.
+ *
+ * That file is the only cross-process source of truth for a session's goal and
+ * context usage: the `kimi web` HTTP server materializes a *separate, empty*
+ * runtime for a session another process owns, so it reports zeros and accepts
+ * goals the talking agent never sees. The owning process appends to this log,
+ * and both processes share it on disk.
+ *
+ * The ACP session id is the `<sessionId>` directory name, so the log path is
+ * derivable from the id the daemon already holds.
+ */
+
+/**
+ * Polling cadences. The two fastest were slowed down after a hang where the
+ * daemon stopped answering on its port while the process stayed alive: each poll
+ * read and parsed everything appended since the last one, so the per-tick cost
+ * was unbounded and the main thread could be held for as long as the log had
+ * grown. The reads are now budgeted and the parse yields (see below); a slower
+ * cadence keeps the number of those bounded ticks down.
+ */
+const ACTIVE_POLL_INTERVAL_MS = 1_000;
+/**
+ * A live goal and an idle session are polled as fast as an active one: with no
+ * file watcher, a turn the runtime starts on its own is only shown once the
+ * next poll reads it. A poll that finds nothing new costs one stat.
+ */
+const LIVE_POLL_INTERVAL_MS = 1_000;
+const IDLE_POLL_INTERVAL_MS = 1_000;
+const SETTLE_POLL_INTERVAL_MS = 1_000;
+/** Unchanged goals are re-announced once per bucket so a late subscriber still sees them. */
+const GOAL_REANNOUNCE_BUCKET_MS = 30_000;
+const DEFAULT_KIMI_HOME = "~/.kimi-code";
+const KIMI_CONFIG_FILENAME = "config.toml";
+/** Reading every subagent log from byte 0 is unbounded; tail only the newest few. */
+const TAILED_SUBAGENT_LIMIT = 8;
+/**
+ * Bytes one file read may take in a single tick, so no single read can
+ * monopolize the event loop. Measured on a real 82 MB wire log, streaming and
+ * parsing 512 KiB takes ~2.6ms, while a live session appends a few kilobytes per
+ * step — so this is orders of magnitude more than one cadence needs and the cap
+ * only binds while catching up on a long pre-existing log. Catch-up throughput
+ * comes from `TICK_READ_BUDGET_BYTES` and `TICK_DRAIN_INTERVAL_MS`, not from
+ * this per-file cap.
+ */
+export const MAX_BYTES_PER_TICK = 64 * 1024;
+/**
+ * Bytes every read in one tick shares, the main log and the subagent logs
+ * together. The per-file cap alone bounded nothing: one tick reads the main log
+ * plus up to `TAILED_SUBAGENT_LIMIT` subagent logs, so eight files at the old
+ * 512 KiB cap let a single tick read ~4.5 MiB.
+ */
+export const TICK_READ_BUDGET_BYTES = 128 * 1024;
+/**
+ * Wall clock a tick may spend before it stops starting new reads. The byte
+ * budget bounds the reads, this bounds the awaits between them: a stat or a read
+ * that stalls on a loaded machine would otherwise let the tick keep going long
+ * after the bytes ran out.
+ */
+export const TICK_BUDGET_MS = 16;
+/**
+ * Cadence to drain a backlog at. A tick that ran cheap yet left unread bytes
+ * behind is not the one holding the event loop, so it may come back sooner and
+ * finish the catch-up in many small slices instead of a few second-long ones.
+ */
+export const TICK_DRAIN_INTERVAL_MS = 80;
+/**
+ * How often a session's task directory is scanned for running background tasks.
+ * The scan used to run on every tick of every session, which nothing about a
+ * task file warrants.
+ */
+const BACKGROUND_TASK_SCAN_INTERVAL_MS = 3_000;
+/**
+ * Lines handed to the parser between two yields. Parsing is the expensive half
+ * of a tick, and this caps how long it can run before the loop gets a turn.
+ */
+export const PARSE_LINES_PER_CHUNK = 1_000;
+/**
+ * How far past the budget a read may look for a line terminator before giving up
+ * and cutting where it is. Real records run long — the longest line measured in
+ * a live wire log was 2.03 MB — so the window has to clear them comfortably, and
+ * the scan only runs at all while a log is being read in pieces.
+ */
+const ALIGN_SCAN_MAX_BYTES = 4 * 1024 * 1024;
+/** Slab the alignment scan reads at a time, so a miss does not allocate the window. */
+const ALIGN_SCAN_SLAB_BYTES = 4 * 1024;
+/**
+ * Cap on the unterminated trailing line held between reads. It has to clear the
+ * longest record a read can leave open, which is one budget plus one alignment
+ * window; past that the line is pathological, and holding it would make every
+ * later read copy it whole. Counted in string units, which is what the copy
+ * costs.
+ */
+const MAX_PENDING_FRAGMENT_CHARS = 8 * 1024 * 1024;
+/** Wall-clock budget a single tick may take before it is worth reporting. */
+const SLOW_TICK_WARN_MS = 250;
+
+/**
+ * Locate the wire log for a Kimi session. Returns null when the file does not
+ * exist yet (the session may not have produced output) or the home directory is
+ * unreadable; callers retry on their next poll.
+ */
+export function resolveKimiWireLogPath(
+  kimiSessionId: string,
+  options: { kimiHome?: string } = {},
+): string | null {
+  if (kimiSessionId.length === 0) {
+    return null;
+  }
+  const sessionsDir = path.join(resolveKimiHome(options.kimiHome), "sessions");
+  let entries: string[];
+  try {
+    entries = readdirSync(sessionsDir);
+  } catch {
+    return null;
+  }
+  for (const entry of entries) {
+    const candidate = path.join(sessionsDir, entry, kimiSessionId, "agents", "main", "wire.jsonl");
+    try {
+      if (existsSync(candidate)) {
+        return candidate;
+      }
+    } catch {
+      // Keep scanning; one unreadable slug must not hide the real one.
+    }
+  }
+  return null;
+}
+
+export type KimiSubagentStatus = "running" | "completed" | "canceled";
+
+/** Lifecycle of one subagent, as announced by the main log. */
+export interface KimiSubagentRecord {
+  id: string;
+  name: string | null;
+  description: string | null;
+  toolCallId: string | null;
+  status: KimiSubagentStatus;
+  spawnedAt: number;
+  updatedAt: number;
+  resultSummary: string | null;
+  /** Turn generation that spawned it; the boundary of that turn bounds its life. */
+  turn: number;
+  /** From the spawn record. Null when the log did not say, which is treated as foreground. */
+  runInBackground: boolean | null;
+  /** Model id the spawn record named. Shown raw, because Kimi has no label table here. */
+  model: string | null;
+  /** Thinking level the spawn record named, e.g. "high"; the subtitle expands it. */
+  thinkingEffort: string | null;
+}
+
+/** A provider-owned task that intentionally outlives the ACP turn. */
+export interface KimiBackgroundTaskRecord {
+  id: string;
+  title: string | null;
+  description: string | null;
+  status: KimiSubagentStatus;
+  createdAt: number;
+  updatedAt: number;
+}
+
+/** Derived state of a session log after replaying a batch of lines. */
+export interface KimiSessionLogState {
+  goal: AgentGoal | null;
+  contextWindowUsedTokens: number | null;
+  /** Model alias bound by the last `profile.bind` or `llm.request`; keys the config lookup. */
+  modelAlias: string | null;
+  /**
+   * Input tokens read by the steps of the current goal. Kimi reports the output
+   * side of a goal itself (`goal.update.tokensUsed`) but never the input side,
+   * so this is summed here from the per-step records while the goal runs.
+   */
+  goalInputTokens: number | null;
+  /** The part of `goalInputTokens` that came from a cache read. */
+  goalCachedInputTokens: number | null;
+  /** Subagents of the session, in spawn order. */
+  subagents: KimiSubagentRecord[];
+  backgroundTasks: KimiBackgroundTaskRecord[];
+  /** Count of turn starts seen, from either boundary record. */
+  turnGeneration: number;
+  /** Highest turn known to be over. Starts at -1 so no boundary is assumed before one is seen. */
+  settledThroughTurn: number;
+  /**
+   * Highest Kimi turn id a boundary named, or -1. A turn is announced by both an
+   * `agent.turn.*` record and its `turn.prompt`/`turn.ended` pair in logs that
+   * carry both, so the id is what keeps one turn from counting twice.
+   */
+  lastTurnId: number;
+  /**
+   * Count of main-agent `turn.prompt` receipts from verified inbound origins.
+   * Context messages and turn boundaries also arise from ongoing work, so they
+   * cannot establish receipt of a new prompt.
+   */
+  acceptedPromptCount: number;
+}
+
+export const EMPTY_KIMI_SESSION_LOG_STATE: KimiSessionLogState = Object.freeze({
+  goal: null,
+  contextWindowUsedTokens: null,
+  modelAlias: null,
+  goalInputTokens: null,
+  goalCachedInputTokens: null,
+  subagents: [],
+  backgroundTasks: [],
+  turnGeneration: 0,
+  settledThroughTurn: -1,
+  lastTurnId: -1,
+  acceptedPromptCount: 0,
+});
+
+/**
+ * Replay raw log lines onto a previous state. Pure and side-effect free so the
+ * derivation rules are testable without a filesystem.
+ *
+ * Records the daemon relies on:
+ * - `goal.create` sets the goal to `active` with zeroed counters and stamps `startedAt`.
+ * - `goal.update` carries either `tokensUsed` (one per goal turn) or `status`; a
+ *   terminal status stamps `endedAt`.
+ * - `goal.clear` retires the goal without discarding it. Kimi emits it right
+ *   after the goal ends, so dropping the goal here would erase the only record
+ *   of what the session was asked to do, along with the final counters.
+ * - `profile.bind` and `llm.request` carry the bound model alias; the later
+ *   record wins, because the alias changes when the user switches model.
+ * - `usage.record` and `context.append_loop_event` of type `step.end` carry the
+ *   context size of one step. `token_counting.turn_recorded` is deliberately not
+ *   read: its `tokens` measures something else and lands well below the real
+ *   context size.
+ * - The input side of those same step records is summed while the goal is
+ *   active, because Kimi reports nothing else about a goal's input tokens. Only
+ *   `usage.record` is read for it: the `step.end` copy of a step is byte-identical
+ *   in `usage`, so reading both would double every step. Records whose
+ *   `usageScope` is `session` are cumulative counters, not one step's usage, and
+ *   they land after the goal ended anyway; none of them are summed.
+ * - `subagent.spawned`, `subagent.started`, `subagent.completed` and
+ *   `subagent.cancelled` maintain the subagent registry. Only the lifecycle is
+ *   read here; each subagent's transcript lives in its own log.
+ * - `agent.turn.started` and `agent.turn.ended` move the turn watermark that
+ *   closes out subagents whose turn is over.
+ * - `context.append_message` counts the prompts Kimi attributed to the user;
+ *   everything else appended to the context is an injection or a notification.
+ *
+ * Anything unparseable is skipped; a half-written line must not abort a replay.
+ */
+export function parseKimiSessionLogLines(
+  lines: Iterable<string>,
+  previous: KimiSessionLogState,
+): KimiSessionLogState {
+  const draft = createKimiLogDraft(previous);
+  for (const raw of lines) {
+    const line = raw.trim();
+    if (line.length === 0) {
+      continue;
+    }
+    const entry = parseKimiLogLine(line);
+    if (entry === null) {
+      continue;
+    }
+    applyKimiLogEntry(draft, entry);
+  }
+  return finishKimiLogDraft(draft);
+}
+
+/**
+ * One replay's working copy of a state. The subagent and background-task
+ * registries stay maps here so a lifecycle record updates its entry in place and
+ * the iteration order stays the spawn order; both are flattened on the way out.
+ */
+interface KimiLogDraft {
+  goal: AgentGoal | null;
+  contextWindowUsedTokens: number | null;
+  modelAlias: string | null;
+  goalInputTokens: number | null;
+  goalCachedInputTokens: number | null;
+  turnGeneration: number;
+  settledThroughTurn: number;
+  lastTurnId: number;
+  acceptedPromptCount: number;
+  readonly subagents: Map<string, KimiSubagentRecord>;
+  readonly backgroundTasks: Map<string, KimiBackgroundTaskRecord>;
+}
+
+function createKimiLogDraft(previous: KimiSessionLogState): KimiLogDraft {
+  const subagents = new Map<string, KimiSubagentRecord>();
+  for (const subagent of previous.subagents) {
+    subagents.set(subagent.id, subagent);
+  }
+  const backgroundTasks = new Map<string, KimiBackgroundTaskRecord>();
+  for (const task of previous.backgroundTasks) backgroundTasks.set(task.id, task);
+  return {
+    goal: previous.goal,
+    contextWindowUsedTokens: previous.contextWindowUsedTokens,
+    modelAlias: previous.modelAlias,
+    goalInputTokens: previous.goalInputTokens,
+    goalCachedInputTokens: previous.goalCachedInputTokens,
+    turnGeneration: previous.turnGeneration,
+    settledThroughTurn: previous.settledThroughTurn,
+    lastTurnId: previous.lastTurnId,
+    acceptedPromptCount: previous.acceptedPromptCount,
+    subagents,
+    backgroundTasks,
+  };
+}
+
+function finishKimiLogDraft(draft: KimiLogDraft): KimiSessionLogState {
+  return {
+    goal: draft.goal,
+    contextWindowUsedTokens: draft.contextWindowUsedTokens,
+    modelAlias: draft.modelAlias,
+    goalInputTokens: draft.goalInputTokens,
+    goalCachedInputTokens: draft.goalCachedInputTokens,
+    subagents: [...draft.subagents.values()],
+    backgroundTasks: [...draft.backgroundTasks.values()],
+    turnGeneration: draft.turnGeneration,
+    settledThroughTurn: draft.settledThroughTurn,
+    lastTurnId: draft.lastTurnId,
+    acceptedPromptCount: draft.acceptedPromptCount,
+  };
+}
+
+/**
+ * Fold one parsed record onto the draft. Records that share a subject are applied
+ * by one helper each, so a new record type adds a case here rather than another
+ * branch inside the replay loop.
+ */
+function applyKimiLogEntry(draft: KimiLogDraft, entry: Record<string, unknown>): void {
+  switch (entry.type) {
+    case "goal.create":
+      draft.goal = createGoalFromRecord(entry);
+      // A new goal starts its own input tally; the previous goal's total is
+      // already on the goal the client is showing.
+      draft.goalInputTokens = 0;
+      draft.goalCachedInputTokens = 0;
+      break;
+    case "goal.update":
+      draft.goal = applyGoalUpdate(draft.goal, entry);
+      break;
+    case "goal.clear":
+      draft.goal = clearGoal(draft.goal, readNumber(entry.time));
+      break;
+    case "profile.bind":
+    case "llm.request":
+      draft.modelAlias = readModelAlias(entry) ?? draft.modelAlias;
+      break;
+    case "agent.turn.started":
+      noteTurnStart(draft, entry);
+      break;
+    case "agent.turn.ended":
+      noteTurnEnd(draft, entry);
+      break;
+    case "turn.ended":
+      noteTurnEnd(draft, entry);
+      break;
+    case "subagent.spawned":
+      applySubagentSpawn(draft.subagents, entry, draft.turnGeneration);
+      trackBackgroundTask(draft.backgroundTasks, entry);
+      break;
+    case "subagent.started":
+      applySubagentStarted(draft.subagents, entry, draft.turnGeneration);
+      break;
+    case "subagent.completed":
+      applySubagentTerminal(draft.subagents, entry, "completed", draft.turnGeneration);
+      updateBackgroundTask(draft.backgroundTasks, entry, "completed");
+      break;
+    case "subagent.cancelled":
+      applySubagentTerminal(draft.subagents, entry, "canceled", draft.turnGeneration);
+      updateBackgroundTask(draft.backgroundTasks, entry, "canceled");
+      break;
+    case "turn.prompt":
+      if (isInboundPrompt(entry)) {
+        draft.acceptedPromptCount += 1;
+        // Kimi 2.6 writes the turn's own prompt receipt and no `agent.turn.*`
+        // record, so this receipt is the only evidence the turn exists. Logs
+        // that carry both are kept from counting the turn twice by its id.
+        noteTurnStart(draft, entry);
+      }
+      break;
+    default:
+      applyStepUsage(draft, entry);
+      break;
+  }
+}
+
+/**
+ * A turn boundary. Kimi 2.6 opens a turn with the prompt receipt and closes it
+ * with `turn.ended`, and writes no `agent.turn.*` record at all; older logs
+ * carry both pairs. Either way the id decides whether this is one turn seen
+ * twice, and a boundary without an id counts on its own.
+ */
+function noteTurnStart(draft: KimiLogDraft, entry: Record<string, unknown>): void {
+  if (entry.agentId !== undefined && entry.agentId !== "main") {
+    return;
+  }
+  const turnId = readNumber(entry.turnId);
+  if (turnId !== undefined) {
+    if (turnId <= draft.lastTurnId) {
+      return;
+    }
+    draft.lastTurnId = turnId;
+  }
+  draft.turnGeneration += 1;
+  // A new turn proves every earlier one is over.
+  draft.settledThroughTurn = Math.max(draft.settledThroughTurn, draft.turnGeneration - 1);
+  demoteSettledSubagents(draft.subagents, draft.settledThroughTurn);
+}
+
+/**
+ * A turn ending proves its own turn is over. An end whose start was never seen
+ * — a replay that began mid-turn — still has to count as one turn, or its id
+ * would outrank the counter and later turns would settle immediately.
+ */
+function noteTurnEnd(draft: KimiLogDraft, entry: Record<string, unknown>): void {
+  if (entry.agentId !== undefined && entry.agentId !== "main") {
+    return;
+  }
+  const turnId = readNumber(entry.turnId);
+  if (turnId !== undefined && turnId > draft.lastTurnId) {
+    draft.lastTurnId = turnId;
+    draft.turnGeneration += 1;
+  }
+  draft.settledThroughTurn = Math.max(draft.settledThroughTurn, draft.turnGeneration);
+  demoteSettledSubagents(draft.subagents, draft.settledThroughTurn);
+}
+
+/** The alias a `profile.bind` or `llm.request` record binds, when it names one. */
+function readModelAlias(entry: Record<string, unknown>): string | undefined {
+  const alias = readString(entry.modelAlias);
+  return alias !== undefined && alias.length > 0 ? alias : undefined;
+}
+
+/**
+ * Main-agent turn prompts are receipt records. A task result appended inside an
+ * existing turn, a model-triggered skill activation, or a context reminder is
+ * not evidence that a new prompt ran. These origins were observed in wire logs;
+ * unknown origins stay excluded until their receipt semantics are verified.
+ */
+function isInboundPrompt(entry: Record<string, unknown>): boolean {
+  if (entry.agentId !== "main") return false;
+  const origin = asRecord(entry.origin);
+  switch (origin?.kind) {
+    case "user":
+    case "task":
+    case "cron_job":
+      return true;
+    case "skill_activation":
+      return origin.trigger === "user-slash";
+    case "system_trigger":
+      return origin.name === "goal_continuation";
+    default:
+      return false;
+  }
+}
+
+/**
+ * A subagent spawned to run in the background outlives the turn that spawned it,
+ * so it is tracked apart from the subagent registry and settled by its own
+ * terminal record rather than by the turn watermark.
+ */
+function trackBackgroundTask(
+  backgroundTasks: Map<string, KimiBackgroundTaskRecord>,
+  entry: Record<string, unknown>,
+): void {
+  if (readBoolean(entry.runInBackground) !== true) return;
+  const id = readString(entry.subagentId);
+  if (!id) return;
+  const time = readNumber(entry.time) ?? 0;
+  const previousTask = backgroundTasks.get(id);
+  backgroundTasks.set(id, {
+    id,
+    title: readString(entry.subagentName) ?? previousTask?.title ?? null,
+    description: readString(entry.description) ?? previousTask?.description ?? null,
+    status: previousTask?.status === "completed" ? previousTask.status : "running",
+    createdAt: previousTask?.createdAt ?? time,
+    updatedAt: time,
+  });
+}
+
+/** The context a step ran with, and the input it read while a goal was live. */
+function applyStepUsage(draft: KimiLogDraft, entry: Record<string, unknown>): void {
+  draft.contextWindowUsedTokens = nextContextUsage(entry, draft.contextWindowUsedTokens);
+  // Only a running goal tallies input: once it settles the number is the one the
+  // goal finished with, and later steps belong to whatever the session does next
+  // rather than to this goal.
+  if (draft.goal === null || !isAgentGoalLive(draft.goal)) return;
+  const stepInput = stepInputUsage(entry);
+  if (stepInput === null) return;
+  draft.goalInputTokens = (draft.goalInputTokens ?? 0) + stepInput.used;
+  draft.goalCachedInputTokens = (draft.goalCachedInputTokens ?? 0) + stepInput.cached;
+}
+
+/**
+ * Parse one log line into a record, or null when it is blank, truncated, or not
+ * an object. A half-written line must not abort a replay.
+ */
+function parseKimiLogLine(line: string): Record<string, unknown> | null {
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(line);
+  } catch {
+    return null;
+  }
+  return asRecord(parsed);
+}
+
+function applySubagentSpawn(
+  subagents: Map<string, KimiSubagentRecord>,
+  entry: Record<string, unknown>,
+  turn: number,
+): void {
+  const id = readString(entry.subagentId);
+  if (id === undefined || id.length === 0) {
+    return;
+  }
+  const previous = subagents.get(id);
+  const toolCallId = readString(entry.parentToolCallId);
+  // Kimi recycles `agent-N` ids, so a spawn that names a different `Agent` tool
+  // call is a new subagent that must start fresh: inheriting the previous
+  // incarnation's status would report a live subagent as complete. Its panel
+  // still shows both runs, because Kimi appends both to the one log for this id
+  // and nothing on those records separates them.
+  const recycled =
+    previous !== undefined && toolCallId !== undefined && previous.toolCallId !== toolCallId;
+  const existing = recycled ? undefined : previous;
+  const time = readNumber(entry.time) ?? previous?.spawnedAt ?? 0;
+  subagents.set(
+    id,
+    mergeSubagentRecord(id, existing, {
+      name: readString(entry.subagentName),
+      description: readString(entry.description),
+      toolCallId,
+      updatedAt: time,
+      turn,
+      runInBackground: readBoolean(entry.runInBackground),
+      model: readString(entry.model),
+      thinkingEffort: readString(entry.thinkingEffort),
+    }),
+  );
+}
+
+function applySubagentStarted(
+  subagents: Map<string, KimiSubagentRecord>,
+  entry: Record<string, unknown>,
+  turn: number,
+): void {
+  const id = readString(entry.subagentId);
+  if (id === undefined || id.length === 0) {
+    return;
+  }
+  const existing = subagents.get(id);
+  const time = readNumber(entry.time) ?? existing?.spawnedAt ?? 0;
+  subagents.set(
+    id,
+    mergeSubagentRecord(id, existing, { updatedAt: time, turn: existing?.turn ?? turn }),
+  );
+}
+
+function applySubagentTerminal(
+  subagents: Map<string, KimiSubagentRecord>,
+  entry: Record<string, unknown>,
+  status: "completed" | "canceled",
+  turn: number,
+): void {
+  const id = readString(entry.subagentId);
+  if (id === undefined || id.length === 0) {
+    return;
+  }
+  // A completion always creates the record: its upsert is the only signal the
+  // client ever gets that this subagent existed.
+  const existing = subagents.get(id);
+  const time = readNumber(entry.time) ?? existing?.updatedAt ?? 0;
+  subagents.set(
+    id,
+    mergeSubagentRecord(id, existing, {
+      status,
+      updatedAt: time,
+      resultSummary: readString(entry.resultSummary),
+      turn: existing?.turn ?? turn,
+    }),
+  );
+}
+
+function updateBackgroundTask(
+  tasks: Map<string, KimiBackgroundTaskRecord>,
+  entry: Record<string, unknown>,
+  status: KimiSubagentStatus,
+): void {
+  const id = readString(entry.subagentId);
+  if (!id) return;
+  const previous = tasks.get(id);
+  if (!previous) return;
+  const time = readNumber(entry.time) ?? previous.updatedAt;
+  tasks.set(id, { ...previous, status, updatedAt: time });
+}
+
+/** Fields a lifecycle record changes. Anything absent keeps the previous value. */
+interface KimiSubagentPatch {
+  name?: string;
+  description?: string;
+  toolCallId?: string;
+  status?: KimiSubagentStatus;
+  updatedAt: number;
+  resultSummary?: string;
+  turn: number;
+  runInBackground?: boolean;
+  model?: string;
+  thinkingEffort?: string;
+}
+
+/**
+ * Build the next record from a partial update. A lifecycle record only carries
+ * the fields that changed, so an absent one keeps whatever the spawn announced.
+ */
+function mergeSubagentRecord(
+  id: string,
+  existing: KimiSubagentRecord | undefined,
+  patch: KimiSubagentPatch,
+): KimiSubagentRecord {
+  return {
+    id,
+    name: stickyField(patch.name, existing?.name),
+    description: stickyField(patch.description, existing?.description),
+    toolCallId: stickyField(patch.toolCallId, existing?.toolCallId),
+    // A repeated spawn must not resurrect a subagent that already finished.
+    status: patch.status ?? existing?.status ?? "running",
+    spawnedAt: existing?.spawnedAt ?? patch.updatedAt,
+    updatedAt: patch.updatedAt,
+    resultSummary: stickyField(patch.resultSummary, existing?.resultSummary),
+    turn: patch.turn,
+    runInBackground: stickyField(patch.runInBackground, existing?.runInBackground),
+    model: stickyField(patch.model, existing?.model),
+    thinkingEffort: stickyField(patch.thinkingEffort, existing?.thinkingEffort),
+  };
+}
+
+/** An absent value keeps the stored one; a present value replaces it. */
+function stickyField<T>(next: T | undefined, previous: T | null | undefined): T | null {
+  return next ?? previous ?? null;
+}
+
+/**
+ * Close out the subagents of turns that are already over.
+ *
+ * A foreground subagent blocks the turn that spawned it, so it cannot still be
+ * alive once that turn ends. Kimi writes no terminal record when the user
+ * interrupts an `Agent` call and sends a new prompt, and it has no heartbeat to
+ * fall back on, so the turn boundary is the only evidence that the subagent is
+ * gone. Without this, an abandoned subagent is reported as running forever.
+ *
+ * `canceled` rather than a new status because Kimi already uses that word for
+ * its own `subagent.cancelled`, and the client renders it as an ordinary, done
+ * row instead of claiming attention.
+ */
+function demoteSettledSubagents(
+  subagents: Map<string, KimiSubagentRecord>,
+  settledThroughTurn: number,
+): void {
+  for (const [id, subagent] of subagents) {
+    if (subagent.status !== "running" || subagent.runInBackground === true) {
+      continue;
+    }
+    if (subagent.turn > settledThroughTurn) {
+      continue;
+    }
+    subagents.set(id, { ...subagent, status: "canceled" });
+  }
+}
+
+function readBoolean(value: unknown): boolean | undefined {
+  return typeof value === "boolean" ? value : undefined;
+}
+
+/**
+ * What one tick's read consumed, for the tick's own telemetry and for choosing
+ * the next cadence.
+ */
+interface TickRead {
+  /** Bytes consumed from the log this tick. */
+  bytes: number;
+  /** Lines handed to the parser, the joined pending fragment included. */
+  lines: number;
+  /** Bytes left unread when the budget ran out; the next tick picks them up. */
+  backlogBytes: number;
+}
+
+const EMPTY_TICK_READ: TickRead = Object.freeze({ bytes: 0, lines: 0, backlogBytes: 0 });
+
+/**
+ * What every read in one tick draws from. `bytesLeft` is shared by the main log
+ * and every subagent log, so eight subagent logs cannot add up to eight budgets;
+ * `deferred` records that the tick stopped with bytes left unread, which is what
+ * earns the drain cadence for the next one.
+ */
+export interface TickBudget {
+  /** Wall clock at which this tick stops starting new reads. */
+  readonly deadlineMs: number;
+  /** Bytes the reads still to come in this tick may take, together. */
+  bytesLeft: number;
+  /** Set when the tick stopped with bytes left unread. */
+  deferred: boolean;
+}
+
+export function createTickBudget(): TickBudget {
+  return {
+    deadlineMs: Date.now() + TICK_BUDGET_MS,
+    bytesLeft: TICK_READ_BUDGET_BYTES,
+    deferred: false,
+  };
+}
+
+/** Whether this tick is out of either budget, so no read may start. */
+export function budgetExhausted(budget: TickBudget): boolean {
+  return budget.bytesLeft <= 0 || Date.now() >= budget.deadlineMs;
+}
+
+/** Bytes one file may take out of what is left of the tick's budget. */
+export function fileReadAllowance(budget: TickBudget): number {
+  return Math.min(MAX_BYTES_PER_TICK, Math.max(0, budget.bytesLeft));
+}
+
+/** What a tailer knows about the tick that just finished, for the next cadence. */
+export interface NextTickIntervalInput {
+  /** Whether the log grew this tick. */
+  readNewBytes: boolean;
+  /** Whether the tick stopped with bytes left unread. */
+  deferred: boolean;
+  /** Wall clock the tick took. */
+  lastTickMs: number;
