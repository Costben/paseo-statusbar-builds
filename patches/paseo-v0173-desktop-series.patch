+    if (this.inTurnHold && this.awaitingPostSettleResponse && !this.hasBlockingBackgroundWork()) {
+      this.postSettleDeadline =
+        this.now() +
+        (this.pendingStepTools.length > 0 ? this.postSettleToolWaitMs : this.postSettleWaitMs);
