+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import * as zlib from "node:zlib";
+import { afterEach, describe, expect, test } from "vitest";
+
+import { createTestLogger } from "../../../../test-utils/test-logger.js";
+import type { AgentStreamEvent } from "../../agent-sdk-types.js";
+import { DshSubagentBridge } from "./native-bridge.js";
+
+// The typings this repo builds against do not name zstd yet; the runtime has it.
+const zstdCompressSync = (zlib as unknown as { zstdCompressSync: (buffer: Buffer) => Buffer })
+  .zstdCompressSync;
+
+const tempDirs: string[] = [];
+
+function createTempDir(): string {
+  const dir = mkdtempSync(path.join(tmpdir(), "paseo-dsh-bridge-"));
+  tempDirs.push(dir);
+  return dir;
+}
+
+afterEach(() => {
+  while (tempDirs.length > 0) {
+    const dir = tempDirs.pop();
+    if (dir) {
+      rmSync(dir, { recursive: true, force: true });
+    }
+  }
+});
+
+const SESSION = "ff8f7020-8f6b-45c8-a24d-8082bf797232";
+const CHILD = "d50f5a53-c77d-4bcf-b573-d419d8844e12";
+
+function frame(lines: unknown[]): Buffer {
+  return zstdCompressSync(Buffer.from(`${lines.map((line) => JSON.stringify(line)).join("\n")}\n`, "utf8"));
+}
+
+function sessionFile(home: string): string {
+  const dir = path.join(home, "sessions", "--Users-me-Projects-demo--", SESSION);
+  mkdirSync(dir, { recursive: true });
+  const file = path.join(dir, "session.v4.jsonl.zstd");
+  writeFileSync(file, Buffer.alloc(0));
+  return file;
+}
+
+function catalogFrame(): Buffer {
+  return frame([
+    { type: "session", version: 4, id: SESSION, cwd: "/tmp/demo" },
+    {
+      type: "subagent/catalog",
+      data: { version: 0, childId: CHILD, childCreatedAt: 1_700_000_000_000, mode: "continuable", label: "Inspect the toolbar" },
+    },
+  ]);
+}
+
+function settleFrame(text: string): Buffer {
+  return frame([
+    {
+      type: "user/message",
+      data: {
+        source: { kind: "subagent-settled" },
+        content: [{ type: "text", text }],
+      },
+    },
+  ]);
+}
+
+function createBridge(home: string, events: AgentStreamEvent[]): DshSubagentBridge {
+  return new DshSubagentBridge({
+    sessionId: SESSION,
+    home,
+    provider: "dsh",
+    logger: createTestLogger(),
+    emit: (event) => events.push(event),
+  });
+}
+
+describe("DshSubagentBridge", () => {
+  test("reports a child the transcript registers", async () => {
+    const home = createTempDir();
+    writeFileSync(sessionFile(home), catalogFrame());
+    const events: AgentStreamEvent[] = [];
+    const bridge = createBridge(home, events);
+
+    await bridge.pollOnce();
+
+    expect(events).toEqual([
+      {
+        type: "provider_subagent",
+        provider: "dsh",
+        event: {
+          type: "upsert",
+          id: CHILD,
+          title: null,
+          description: "Inspect the toolbar",
+          status: "running",
+          toolCallId: null,
+          subtitle: null,
+        },
+      },
+    ]);
+    bridge.stop();
+  });
+
+  test("closes the row and carries the closing message once", async () => {
+    const home = createTempDir();
+    const file = sessionFile(home);
+    const head = catalogFrame();
+    writeFileSync(file, head);
+    const events: AgentStreamEvent[] = [];
+    const bridge = createBridge(home, events);
+    await bridge.pollOnce();
+    events.length = 0;
+
+    writeFileSync(
+      file,
+      Buffer.concat([
+        head,
+        settleFrame(
+          `Background subagent ${CHILD} finished and will do no further work unless you send it more. Its closing message: 6 checks passed`,
+        ),
+      ]),
+    );
+    await bridge.pollOnce();
+
+    expect(events).toEqual([
+      {
+        type: "provider_subagent",
+        provider: "dsh",
+        event: {
+          type: "upsert",
+          id: CHILD,
+          title: null,
+          description: "Inspect the toolbar",
+          status: "completed",
+          toolCallId: null,
+          subtitle: null,
+        },
+      },
+      {
+        type: "provider_subagent",
+        provider: "dsh",
+        event: {
+          type: "timeline",
+          id: CHILD,
+          item: { type: "assistant_message", text: "6 checks passed", messageId: `${CHILD}:final` },
+        },
+      },
+    ]);
+
+    // A second pass over the same transcript must not repeat the row.
+    events.length = 0;
+    await bridge.pollOnce();
+    expect(events).toEqual([]);
+    bridge.stop();
+  });
+
+  test("reports a child that was stopped as canceled", async () => {
+    const home = createTempDir();
+    writeFileSync(
+      sessionFile(home),
+      settleFrame(`Background subagent ${CHILD} was stopped before it finished. It left no closing message.`),
+    );
+    const events: AgentStreamEvent[] = [];
+    const bridge = createBridge(home, events);
+
+    await bridge.pollOnce();
+
+    expect(events).toHaveLength(1);
+    const [event] = events;
+    expect(event?.type === "provider_subagent" && event.event.type === "upsert" && event.event.status).toBe(
+      "canceled",
+    );
+    bridge.stop();
+  });
+
+  test("puts the child's token totals on the rail row", async () => {
+    const home = createTempDir();
+    writeFileSync(sessionFile(home), catalogFrame());
+    const cacheDir = path.join(home, "storages", "session_projcache", "sessions");
+    mkdirSync(cacheDir, { recursive: true });
+    writeFileSync(
+      path.join(cacheDir, `${CHILD}.json`),
+      JSON.stringify({
+        record: {
+          rows: {
+            tokenUsage: {
+              val: {
+                totals: {
+                  uncachedInputTokens: 43_867,
+                  outputTokens: 14_058,
+                  cacheReadTokens: 718_592,
+                  cacheWriteTokens: 0,
+                },
+              },
+            },
+          },
+        },
+      }),
+    );
+    const events: AgentStreamEvent[] = [];
+    const bridge = createBridge(home, events);
+
+    await bridge.pollOnce();
+
+    const [event] = events;
+    const subtitle =
+      event?.type === "provider_subagent" && event.event.type === "upsert"
+        ? event.event.subtitle
+        : null;
+    expect(subtitle).toBe("44k in · 14k out · 719k cached");
+    bridge.stop();
+  });
+
+  test("re-sends a running row when its spend moves", async () => {
+    const home = createTempDir();
+    writeFileSync(sessionFile(home), catalogFrame());
+    const cacheDir = path.join(home, "storages", "session_projcache", "sessions");
+    mkdirSync(cacheDir, { recursive: true });
+    const cacheFile = path.join(cacheDir, `${CHILD}.json`);
+    const writeTotals = (input: number) =>
+      writeFileSync(
+        cacheFile,
+        JSON.stringify({
+          record: { rows: { tokenUsage: { val: { totals: { uncachedInputTokens: input, outputTokens: 0, cacheReadTokens: 0, cacheWriteTokens: 0 } } } } },
+        }),
+      );
+    writeTotals(1_000);
+    const events: AgentStreamEvent[] = [];
+    const bridge = createBridge(home, events);
+
+    await bridge.pollOnce();
+    writeTotals(2_000);
+    await bridge.pollOnce();
+
+    expect(events).toHaveLength(2);
+    const subtitles = events.map((event) =>
+      event.type === "provider_subagent" && event.event.type === "upsert" ? event.event.subtitle : null,
+    );
+    expect(subtitles).toEqual(["1.0k in · 0 out", "2.0k in · 0 out"]);
+    bridge.stop();
+  });
+
+  test("waits for the transcript to exist", async () => {
+    const home = createTempDir();
+    mkdirSync(path.join(home, "sessions"), { recursive: true });
+    const events: AgentStreamEvent[] = [];
+    const bridge = createBridge(home, events);
+
+    await expect(bridge.pollOnce()).resolves.toBeUndefined();
+    expect(events).toEqual([]);
+    bridge.stop();
+  });
+});
diff --git a/packages/server/src/server/agent/providers/dsh/native-bridge.ts b/packages/server/src/server/agent/providers/dsh/native-bridge.ts
new file mode 100644
index 000000000..4e2df199f
--- /dev/null
+++ b/packages/server/src/server/agent/providers/dsh/native-bridge.ts
@@ -0,0 +1,246 @@
+import type { Logger } from "pino";
+
+import type { AgentProvider, AgentStreamEvent } from "../../agent-sdk-types.js";
+import type { ProviderSubagentStatus } from "../../provider-subagents/store.js";
+import {
+  collectDshSubagentFacts,
+  readDshSessionLog,
+  readDshTokenTotals,
+  resolveDshSessionLogPath,
+  type DshSubagentFacts,
+  type DshTokenTotals,
+} from "./session-store.js";
+
+/** Default cadence. A transcript poll is a `stat` until dsh flushes, so this is cheap. */
+const DEFAULT_POLL_INTERVAL_MS = 1_000;
+
+export interface DshSubagentBridgeOptions {
+  sessionId: string;
+  /** dsh home; the transcript lives under `<home>/sessions`. */
+  home: string;
+  provider: AgentProvider;
+  logger: Logger;
+  emit: (event: AgentStreamEvent) => void;
+  pollIntervalMs?: number;
+}
+
+/**
+ * Reads the subagent rail out of dsh's own transcript.
+ *
+ * dsh spawns children in-process and never mentions them on the ACP stream —
+ * `dsh-acp` has no `_meta` at all, and `session/list` filters subagent sessions
+ * out. The transcript is the only place the edges survive: `subagent/catalog`
+ * registers a child, and a `subagent-settled` notice ends it. Tailing that file
+ * is the same shape Kimi Code's bridge uses, and it lands on the same
+ * `provider_subagent` rail the ACP projector feeds.
+ */
+export class DshSubagentBridge {
+  private readonly sessionId: string;
+  private readonly home: string;
+  private readonly provider: AgentProvider;
+  private readonly logger: Logger;
+  private readonly emit: (event: AgentStreamEvent) => void;
+  private readonly pollIntervalMs: number;
+
+  private file: string | null = null;
+  private offset = 0;
+  private timer: ReturnType<typeof setTimeout> | null = null;
+  private started = false;
+  private stopped = false;
+  private polling = false;
+  /**
+   * Last row reported per child. The transcript hands the catalogue row and the
+   * settle notice to different polls, so the name has to outlive the batch that
+   * carried it.
+   */
+  private readonly reported = new Map<
+    string,
+    {
+      status: ProviderSubagentStatus;
+      subtitle: string | null;
+      label: string | null;
+      mode: string | null;
+    }
+  >();
+  /** Children whose closing message already went out; a compaction re-read must not duplicate it. */
+  private readonly closingSent = new Set<string>();
+
+  constructor(options: DshSubagentBridgeOptions) {
+    this.sessionId = options.sessionId;
+    this.home = options.home;
+    this.provider = options.provider;
+    this.logger = options.logger;
+    this.emit = options.emit;
+    this.pollIntervalMs = options.pollIntervalMs ?? DEFAULT_POLL_INTERVAL_MS;
+  }
+
+  /** Idempotent. Reads what the session already produced, then keeps up with it. */
+  start(): void {
+    if (this.started || this.stopped) {
+      return;
+    }
+    this.started = true;
+    void this.pollOnce();
+    this.schedule();
+  }
+
+  /** Idempotent. */
+  stop(): void {
+    this.stopped = true;
+    if (this.timer) {
+      clearTimeout(this.timer);
+      this.timer = null;
+    }
+  }
+
+  /** One read. Exposed for tests; the timer calls it with the same body. */
+  async pollOnce(): Promise<void> {
+    if (this.stopped || this.polling) {
+      return;
+    }
+    this.polling = true;
+    try {
+      if (this.file === null) {
+        this.file = resolveDshSessionLogPath(this.home, this.sessionId);
+        if (this.file === null) {
+          return;
+        }
+      }
+      const read = readDshSessionLog(this.file, this.offset);
+      if (read.text.length === 0) {
+        return;
+      }
+      this.offset = read.offset;
+      const facts = collectDshSubagentFacts(read.text.split("\n"));
+      for (const entry of facts) {
+        this.report(entry);
+      }
+    } catch (error) {
+      this.logger.warn({ err: error, sessionId: this.sessionId }, "dsh subagent bridge read failed");
+    } finally {
+      if (this.reported.size > 0) {
+        this.refreshSpend();
+      }
+      this.polling = false;
+    }
+  }
+
+  private report(entry: DshSubagentFacts): void {
+    const status: ProviderSubagentStatus = entry.settled ?? "running";
+    const previous = this.reported.get(entry.childId);
+    const label = entry.label ?? previous?.label ?? null;
+    const mode = entry.mode ?? previous?.mode ?? null;
+    const subtitle = this.subtitleFor(entry.childId, mode);
+    if (
+      previous?.status === status &&
+      previous.subtitle === subtitle &&
+      previous.label === label
+    ) {
+      return;
+    }
+    const next = { status, subtitle, label, mode };
+    this.reported.set(entry.childId, next);
+    this.emitRow(entry.childId, next);
+    if (entry.settled && entry.closingMessage && !this.closingSent.has(entry.childId)) {
+      this.closingSent.add(entry.childId);
+      this.emit({
+        type: "provider_subagent",
+        provider: this.provider,
+        event: {
+          type: "timeline",
+          id: entry.childId,
+          item: {
+            type: "assistant_message",
+            text: entry.closingMessage,
+            messageId: `${entry.childId}:final`,
+          },
+        },
+      });
+    }
+  }
+
+  /**
+   * The spend keeps moving while a child works, and a running child writes
+   * nothing to its parent's transcript — the cache is the only thing that
+   * changes. Re-read it every poll so the row's numbers tick along instead of
+   * waiting for the child to finish.
+   */
+  private refreshSpend(): void {
+    for (const [childId, state] of this.reported) {
+      const subtitle = this.subtitleFor(childId, state.mode);
+      if (subtitle === state.subtitle) {
+        continue;
+      }
+      state.subtitle = subtitle;
+      this.emitRow(childId, state);
+    }
+  }
+
+  private emitRow(
+    childId: string,
+    row: { status: ProviderSubagentStatus; subtitle: string | null; label: string | null },
+  ): void {
+    this.emit({
+      type: "provider_subagent",
+      provider: this.provider,
+      event: {
+        type: "upsert",
+        id: childId,
+        // dsh records the task, not a type: the label is the only name a child has.
+        title: null,
+        description: row.label,
+        status: row.status,
+        toolCallId: null,
+        subtitle: row.subtitle,
+      },
+    });
+  }
+
+  /**
+   * The rail's compact line: what the child is, and what it has spent so far.
+   * Totals come from the child's own projection cache — dsh writes one per
+   * session, so a subagent's spend is readable the same way its parent's is.
+   */
+  private subtitleFor(childId: string, mode: string | null): string | null {
+    const parts: string[] = [];
+    if (mode === "fork") {
+      parts.push("fork");
+    }
+    const totals = readDshTokenTotals(this.home, childId);
+    if (totals) {
+      parts.push(formatTokenUsage(totals));
+    }
+    return parts.length > 0 ? parts.join(" · ") : null;
+  }
+
+  private schedule(): void {
+    if (this.stopped) {
+      return;
+    }
+    this.timer = setTimeout(() => {
+      this.timer = null;
+      void this.pollOnce().finally(() => this.schedule());
+    }, this.pollIntervalMs);
+    this.timer.unref?.();
+  }
+}
+
+/** `43867 → 43.9k`, `718592 → 719k`, `14058 → 14.1k`. */
+function formatTokens(count: number): string {
+  if (count < 1_000) {
+    return String(Math.round(count));
+  }
+  if (count < 1_000_000) {
+    const thousands = count / 1_000;
+    return `${thousands < 10 ? thousands.toFixed(1) : Math.round(thousands)}k`;
+  }
+  return `${(count / 1_000_000).toFixed(1)}m`;
+}
+
+function formatTokenUsage(totals: DshTokenTotals): string {
+  const parts = [`${formatTokens(totals.inputTokens)} in`, `${formatTokens(totals.outputTokens)} out`];
+  if (totals.cachedInputTokens > 0) {
+    parts.push(`${formatTokens(totals.cachedInputTokens)} cached`);
+  }
+  return parts.join(" · ");
+}
