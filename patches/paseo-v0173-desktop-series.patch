+export interface RangeReadResult {
+  lines: string[];
+  fragment: string;
+}
+
+/**
+ * Stream lines out of `[start, end)` without buffering the range. A trailing
+ * line with no newline is returned separately so the caller can prepend it to
+ * the next read instead of losing a record split across ticks.
+ */
+export async function readLinesFromRange(
+  filePath: string,
+  start: number,
+  end: number,
+): Promise<RangeReadResult> {
+  const lines: string[] = [];
+  const stream = createReadStream(filePath, { start, end: end - 1, encoding: "utf8" });
+  const reader = createInterface({ input: stream, crlfDelay: Number.POSITIVE_INFINITY });
+  try {
+    for await (const line of reader) {
+      lines.push(line);
+    }
+  } finally {
+    reader.close();
+    stream.destroy();
+  }
+  if (lines.length === 0 || rangeEndsWithNewline(filePath, end)) {
+    return { lines, fragment: "" };
+  }
+  return { lines, fragment: lines.pop() ?? "" };
+}
+
+function rangeEndsWithNewline(filePath: string, end: number): boolean {
+  if (end <= 0) {
+    return true;
+  }
+  let fd: number | null = null;
+  try {
+    fd = openSync(filePath, "r");
+    const buffer = Buffer.alloc(1);
+    readSync(fd, buffer, 0, 1, end - 1);
+    return buffer[0] === 0x0a;
+  } catch {
+    // Treat an unreadable byte as terminated: dropping a fragment is safer than
+    // concatenating the same bytes twice.
+    return true;
+  } finally {
+    if (fd !== null) {
+      try {
+        closeSync(fd);
+      } catch {
+        // ignore
+      }
+    }
+  }
+}
+
+/**
+ * Move `end` forward to just past the next newline, so a budget-sized read stops
+ * on a record boundary. A range that ends inside a multi-byte UTF-8 sequence is
+ * decoded with a replacement character on both sides of the cut, and because the
+ * two halves are decoded separately they no longer rejoin into the original text
+ * — the record still parses, but its strings silently acquire garbage. Cutting on
+ * a newline avoids that, and `0x0a` never occurs inside a UTF-8 sequence, so the
+ * scan can work on raw bytes.
+ *
+ * Returns `end` unchanged when no newline turns up inside the window, which is
+ * the only case that leaves a read ending mid-line.
+ *
+ * Exported for the per-subagent tailer, which reads the same way.
+ */
+export function alignRangeEndToNewline(filePath: string, end: number, size: number): number {
+  const limit = Math.min(size, end + ALIGN_SCAN_MAX_BYTES);
+  if (limit <= end) {
+    return end;
+  }
+  let fd: number | null = null;
+  try {
+    fd = openSync(filePath, "r");
+    const slab = Buffer.alloc(Math.min(ALIGN_SCAN_SLAB_BYTES, limit - end));
+    for (let from = end; from < limit; from += slab.length) {
+      const read = readSync(fd, slab, 0, Math.min(slab.length, limit - from), from);
+      if (read <= 0) {
+        break;
+      }
+      const newline = slab.subarray(0, read).indexOf(0x0a);
+      if (newline !== -1) {
+        return from + newline + 1;
+      }
+    }
+    return end;
+  } catch {
+    // Unreadable: keep the unaligned cut, which the fragment handling covers.
+    return end;
+  } finally {
+    if (fd !== null) {
+      try {
+        closeSync(fd);
+      } catch {
+        // ignore
+      }
+    }
+  }
+}
