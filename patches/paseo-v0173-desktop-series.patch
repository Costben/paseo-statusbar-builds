+      connection: {
+        setSessionMode,
+        setSessionConfigOption: vi.fn(),
+        extMethod: vi.fn(),
+      } as unknown as ACPProviderModeWriterContext["connection"],
+      sessionId: "sess-1",
+      requestedModeId: ANTIGRAVITY_FULL_ACCESS_MODE_ID,
+      currentModeId: "plan",
+      selection: {
+        availableMode: null,
+        configOption: null,
+        configChoice: null,
+        hasAvailableModes: true,
+      },
+      configOptions: [],
+      logger: createTestLogger(),
+    };
+
+    const result = await writeAntigravityProviderMode(baseContext);
+    expect(setSessionMode).toHaveBeenCalledWith({
+      sessionId: "sess-1",
+      modeId: ANTIGRAVITY_DEFAULT_MODE_ID,
+    });
+    expect(result).toEqual({
+      handled: true,
+      currentModeId: ANTIGRAVITY_FULL_ACCESS_MODE_ID,
+    });
+
+    const passthrough = await writeAntigravityProviderMode({
+      ...baseContext,
+      requestedModeId: "plan",
+    });
+    expect(passthrough).toEqual({ handled: false });
+  });
+
+  test("adds --dangerously-skip-permissions for full-access/auto_accept and advertises promptTurnTakeoverSteer", () => {
+    expect(shouldSkipAntigravityPermissions({ modeId: ANTIGRAVITY_FULL_ACCESS_MODE_ID })).toBe(true);
+    expect(
+      shouldSkipAntigravityPermissions({
+        modeId: ANTIGRAVITY_DEFAULT_MODE_ID,
+        providerOptions: { auto_accept: true },
+      }),
+    ).toBe(true);
+    expect(shouldSkipAntigravityPermissions({ modeId: ANTIGRAVITY_DEFAULT_MODE_ID })).toBe(false);
+
+    expect(
+      resolveAntigravityDefaultCommand(undefined, { skipPermissions: true }),
+    ).toEqual(["agy", "acp", ANTIGRAVITY_SKIP_PERMISSIONS_FLAG]);
+    expect(
+      resolveAntigravityDefaultCommand(
+        { command: { mode: "append", args: [ANTIGRAVITY_SKIP_PERMISSIONS_FLAG] } },
+        { skipPermissions: true },
+      ),
+    ).toEqual(["agy", "acp"]);
+    expect(
+      resolveAntigravityDefaultCommand(
+        { command: { mode: "replace", argv: ["/usr/local/bin/agy", "acp"] } },
+        { skipPermissions: true },
+      ),
+    ).toEqual(["/usr/local/bin/agy", ANTIGRAVITY_SKIP_PERMISSIONS_FLAG]);
+
+    const client = new AntigravityACPAgentClient({ logger: createTestLogger() }) as unknown as {
+      capabilities: { promptTurnTakeoverSteer?: boolean };
+      resolveSessionDefaultCommand: (config: {
+        provider: string;
+        cwd: string;
+        modeId?: string;
+      }) => [string, ...string[]];
