+function isExpiredCredentials(credentials: AntigravityCredentials, now: number): boolean {
+  return credentials.expiresAtMs !== undefined && credentials.expiresAtMs <= now;
+}
+
+/**
+ * agy 的 composite_token_storage 在钥匙串写入失败时会回退到本地文件，
+ * 下个进程可能又写回钥匙串并把另一侧留成过期副本；因此两侧都读并取有效且更晚过期的一份。
+ */
+export function pickFresherCredentials(
+  candidates: Array<AntigravityCredentials | null>,
+  now: number = Date.now(),
+): AntigravityCredentials | null {
+  let best: AntigravityCredentials | null = null;
+  for (const candidate of candidates) {
+    if (!candidate) continue;
+    if (!best) {
+      best = candidate;
+      continue;
+    }
+    const candidateExpired = isExpiredCredentials(candidate, now);
+    const bestExpired = isExpiredCredentials(best, now);
+    if (candidateExpired !== bestExpired) {
+      if (!candidateExpired) best = candidate;
+      continue;
+    }
+    const candidateExpiry = candidate.expiresAtMs ?? Number.NEGATIVE_INFINITY;
+    const bestExpiry = best.expiresAtMs ?? Number.NEGATIVE_INFINITY;
+    if (candidateExpiry > bestExpiry) {
+      best = candidate;
+    }
+  }
+  return best;
+}
+
+async function readCredentials(
+  input: AntigravityUsageInput,
+  lookup: AntigravityLookup = {},
+): Promise<AntigravityCredentials | null> {
+  if (input.route.store === "file") {
+    return readFileCredentials(input.route.path, lookup);
+  }
+  if (input.route.store === "keyring") {
+    return readKeyringCredentials(input.route.service, input.route.account, lookup);
+  }
+  const { path, service, account } = input.route;
+  const now = (lookup.now ?? Date.now)();
+  const [fileCredentials, keyringCredentials] = await Promise.all([
+    readFileCredentials(path, lookup),
+    readKeyringCredentials(service, account, lookup),
+  ]);
+  return pickFresherCredentials([fileCredentials, keyringCredentials], now);
+}
