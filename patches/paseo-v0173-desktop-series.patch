+  /**
+   * Matches `chunk` against `queue` starting at `startIndex`, tolerating single-item
+   * splits, concatenated adjacent items, and trimmed newline separators without
+   * mutating `queue` unless the entire chunk is accounted for.
+   */
+  private consumeCatchupTextAtIndex(
+    queue: string[],
+    startIndex: number,
+    chunk: string,
+  ): boolean {
+    if (startIndex < 0 || startIndex >= queue.length) {
+      return false;
+    }
+    const workQueue = queue.slice(startIndex);
+    let remaining = chunk;
+    let steps = 0;
+
+    while (remaining.length > 0 && workQueue.length > 0) {
+      const expected = workQueue[0];
+      if (expected === undefined) {
+        break;
+      }
+
+      if (expected === remaining) {
+        workQueue.shift();
+        remaining = "";
+        break;
+      }
+
+      if (expected.startsWith(remaining)) {
+        const rest = expected.slice(remaining.length);
+        if (rest.trim().length === 0) {
+          workQueue.shift();
+        } else {
+          workQueue[0] = rest;
+        }
+        remaining = "";
+        break;
+      }
+
+      const expectedNoLead = expected.replace(/^[\r\n]+/, "");
+      if (
+        expectedNoLead.length > 0 &&
+        expectedNoLead !== expected &&
+        expectedNoLead.startsWith(remaining)
+      ) {
+        const rest = expectedNoLead.slice(remaining.length);
+        if (rest.trim().length === 0) {
+          workQueue.shift();
+        } else {
+          workQueue[0] = rest;
+        }
+        remaining = "";
+        break;
+      }
+
+      const trimmedExpected = expected.trim();
+      const trimmedRemaining = remaining.trim();
+      if (trimmedExpected.length > 0 && trimmedExpected === trimmedRemaining) {
+        workQueue.shift();
+        remaining = "";
+        break;
+      }
+
+      if (remaining.startsWith(expected)) {
+        const tail = remaining.slice(expected.length);
+        workQueue.shift();
+        remaining = tail.trim().length === 0 ? "" : tail;
+        steps += 1;
+        continue;
+      }
+
+      const remainingNoLead = remaining.replace(/^[\r\n]+/, "");
+      if (trimmedExpected.length > 0 && remainingNoLead.startsWith(trimmedExpected)) {
+        const after = remainingNoLead.slice(trimmedExpected.length);
+        if (after.length === 0 || /^[\s⚠]/.test(after)) {
+          workQueue.shift();
+          remaining = after.trim().length === 0 ? "" : after;
+          steps += 1;
+          continue;
+        }
+      }
+
+      if (steps > 0 && remaining.trim().length === 0) {
+        remaining = "";
+        break;
+      }
+      return false;
+    }
+
+    if (remaining.trim().length > 0) {
+      return false;
+    }
+
+    queue.splice(0, queue.length, ...workQueue);
+    return true;
+  }
+
+  private consumeCatchupText(queue: string[], chunk: string): boolean {
+    if (queue.length === 0 || chunk.length === 0) {
+      return false;
+    }
+    if (this.consumeCatchupTextAtIndex(queue, 0, chunk)) {
+      return true;
+    }
+
+    // Resynchronize if ACP omitted or already flushed an earlier wakeup item.
+    const trimmedChunk = chunk.trim();
+    if (trimmedChunk.length < 4) {
+      return false;
+    }
+    const minPrefixLen = /[^\x00-\x7F]/.test(trimmedChunk) ? 4 : 8;
+    for (let idx = 1; idx < queue.length; idx++) {
+      const candidate = queue[idx];
+      if (!candidate) {
+        continue;
+      }
+      const trimmedCandidate = candidate.trim();
+      const exactMatch = trimmedCandidate.length > 0 && trimmedCandidate === trimmedChunk;
+      const distinctPrefixMatch =
+        trimmedChunk.length >= minPrefixLen &&
+        trimmedCandidate.length >= minPrefixLen &&
+        trimmedCandidate.startsWith(trimmedChunk);
+      if ((exactMatch || distinctPrefixMatch) && this.consumeCatchupTextAtIndex(queue, idx, chunk)) {
+        return true;
+      }
+    }
+    return false;
+  }
