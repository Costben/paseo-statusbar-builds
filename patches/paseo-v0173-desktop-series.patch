+  if (entry.type !== "usage.record") {
+    return null;
+  }
+  if (readString(entry.usageScope) === "session") {
+    return null;
+  }
+  const usage = asRecord(entry.usage);
+  if (usage === null) {
+    return null;
+  }
+  const other = positiveNumber(usage.inputOther);
+  const cached = positiveNumber(usage.inputCacheRead);
+  const created = positiveNumber(usage.inputCacheCreation);
+  const used = other + cached + created;
