+function matchesAntigravityTaskId(trackedId: string, candidateId: string): boolean {
+  const a = trackedId.trim();
+  const b = candidateId.trim();
+  if (!a || !b) {
+    return false;
+  }
+  if (a === b) {
+    return true;
+  }
+  if (!a.includes("/") && b.endsWith(`/${a}`)) {
+    return true;
+  }
