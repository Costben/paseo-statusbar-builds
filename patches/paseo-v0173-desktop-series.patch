+/**
+ * Context tokens a `usage.record` line reports, or null for any other record.
+ * The same step is also written as a `step.end` loop event carrying an
+ * identical `usage`, so a caller scanning whole lines must count
+ * `usage.record` only. A `session`-scoped record is a running total rather
+ * than one step, so it is skipped.
+ */
+export function kimiUsageRecordContextTokens(entry: Record<string, unknown>): number | null {
+  if (entry.type !== "usage.record" || readString(entry.usageScope) === "session") {
+    return null;
+  }
+  return stepContextUsage(entry);
