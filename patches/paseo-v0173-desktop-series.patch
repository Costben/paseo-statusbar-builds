+    replaceAgentRun: async () => {
+      calls.push("replace");
+      return (async function* empty() {})();
+    },
+    steerOrReplaceActiveTurn: async () => {
+      calls.push("steer");
+      return { status: "inactive" };
+    },
+    streamAgent: () => {
+      calls.push("stream");
+      return (async function* empty() {})();
+    },
+    reloadAgentSession: async () => undefined,
+    reloadStalePluginSession: async () => undefined,
+  };
+  return { controller, calls };
