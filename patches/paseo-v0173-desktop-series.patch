+    const updateTarget = extractSessionUpdateToolTarget(update);
+    const head = this.unstreamedRenderedTools[0];
+    if (head && matchesCatchupToolEntry(head, updateKind, updateTarget)) {
+      this.unstreamedRenderedTools.shift();
+      return true;
+    }
