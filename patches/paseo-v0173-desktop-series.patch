+function createGoalFromRecord(entry: Record<string, unknown>): AgentGoal {
+  const completionCriterion = readString(entry.completionCriterion);
+  const time = readNumber(entry.time);
+  return {
+    goalId: readString(entry.goalId) ?? "",
+    objective: readString(entry.objective) ?? "",
+    status: "active",
+    turnsUsed: 0,
+    tokensUsed: 0,
+    ...(time !== undefined ? { startedAt: time } : {}),
+    updatedAt: time ?? 0,
+    ...(completionCriterion !== undefined ? { completionCriterion } : {}),
+  };
+}
+
+function applyGoalUpdate(goal: AgentGoal | null, entry: Record<string, unknown>): AgentGoal | null {
+  if (!goal) {
+    return null;
+  }
+  const time = readNumber(entry.time) ?? goal.updatedAt;
+  let next = goal;
+
+  const tokensUsed = readNumber(entry.tokensUsed);
+  if (tokensUsed !== undefined) {
+    // One `tokensUsed` update per goal turn; that count is `turnsUsed`.
+    next = { ...next, turnsUsed: next.turnsUsed + 1, tokensUsed, updatedAt: time };
+  }
+
+  const status = readString(entry.status);
+  if (status !== undefined) {
+    const reason = readString(entry.reason);
+    const mapped = mapGoalStatus(status);
+    next = {
+      ...next,
+      status: mapped,
+      updatedAt: time,
+      ...(reason !== undefined ? { terminalReason: reason } : {}),
+    };
+    // The first terminal status is the one that ended the goal; a later record
+    // must not move the mark.
+    const ended = next.endedAt;
+    if (isGoalTerminalStatus(mapped) && (ended === undefined || ended === null)) {
+      next = { ...next, endedAt: time };
+    }
+  }
+
+  return next;
+}
+
+/**
+ * Retire a goal on `goal.clear`. Kimi writes this record immediately after the
+ * goal stops, so the goal itself is kept: the status and counters it reached
+ * are what the session did, and a pill that vanishes at the moment of
+ * completion hides exactly the outcome the reader came to see.
+ */
+function clearGoal(goal: AgentGoal | null, time: number | undefined): AgentGoal | null {
+  if (!goal) {
+    return null;
+  }
+  const at = time ?? goal.updatedAt;
+  if (isGoalTerminalStatus(goal.status)) {
+    return goal.endedAt === undefined || goal.endedAt === null ? { ...goal, endedAt: at } : goal;
+  }
+  return { ...goal, status: "cleared", endedAt: at, updatedAt: at };
+}
+
+function isGoalTerminalStatus(status: AgentGoalStatus): boolean {
+  return status === "complete" || status === "cleared";
+}
+
+function mapGoalStatus(value: string): AgentGoalStatus {
+  switch (value) {
+    case "active":
+    case "paused":
+    case "blocked":
+    case "complete":
+    case "cleared":
+      return value;
+    default:
+      // Any other reported status is terminal; the exact label is not part of
+      // the shared vocabulary, so the goal is reported as cleared.
+      return "cleared";
+  }
+}
+
+/**
+ * Change detector for goal emission. `updatedAt` is deliberately excluded: it
+ * advances with the log and would make every replay look like a change.
+ */
+function goalValueSignature(goal: AgentGoal | null): string {
+  if (!goal) {
+    return "null";
+  }
+  return JSON.stringify([
+    goal.goalId,
+    goal.objective,
+    goal.status,
+    goal.turnsUsed,
+    goal.tokensUsed,
+    goal.inputTokens ?? 0,
+    goal.cachedInputTokens ?? 0,
+    goal.completionCriterion ?? "",
+    goal.terminalReason ?? "",
