--- /dev/null
+++ b/packages/server/src/server/agent/providers/kimi/native-bridge.ts
@@ -0,0 +1,302 @@
+import { setTimeout as delay } from "node:timers/promises";
+
+import type { Logger } from "pino";
+
+import {
+  isAgentGoalLive,
+  type AgentGoal,
+  type AgentProvider,
+  type AgentStreamEvent,
+} from "../../agent-sdk-types.js";
+import { KimiMainTurnRenderer } from "./main-turn-renderer.js";
+import { KimiSessionLog } from "./session-log.js";
+
+/** How often a held turn re-checks its submitted prompt. */
+const SUBMISSION_POLL_MS = 250;
+/**
+ * How long the runtime may sit idle without ever starting a submitted prompt
+ * before that prompt counts as dropped. Idle is the only state in which it
+ * should already have run: while the runtime works, the prompt is queued.
+ */
+const SUBMISSION_IDLE_GRACE_MS = 30_000;
+
+export type KimiSubmissionOutcome = "completed" | "not_accepted" | "aborted";
+
+interface KimiSubmission {
+  sentAt: number;
+  text: string | null;
+  outcome: KimiSubmissionOutcome | null;
+}
+
+/**
+ * Native goal/usage/subagent bridge for one live Kimi ACP session.
+ *
+ * Kimi keeps driving a goal after the ACP prompt returns, and the ACP stream
+ * carries no goal state. The daemon used to read a `kimi web` HTTP sidecar, but
+ * that server materializes a *separate, empty runtime* for a session another
+ * process owns: goals written there are invisible to the talking agent, and the
+ * agent's own goals never appear there.
+ *
+ * The session's append-only log file is the only cross-process truth, so the
+ * bridge tails `agents/main/wire.jsonl` and derives the goal and the subagent
+ * registry from it. There is deliberately no control API: the daemon cannot
+ * mutate a goal it does not own, so control commands are rewritten into prompts
+ * instead.
+ */
+export interface KimiNativeBridgeOptions {
+  kimiSessionId: string;
+  kimiHome?: string;
+  logger: Logger;
+  /** Overrides both poll cadences; see `KimiSessionLog`. */
+  pollIntervalMs?: number;
+  /** Push a provider stream event into the owning ACP session. */
+  emit: (event: AgentStreamEvent) => void;
+  /** Provider id, for the events' `provider` field. */
+  provider: AgentProvider;
+  /** True while the owning ACP session has a foreground turn open. */
+  isForegroundTurnActive?: () => boolean;
+  /** When the owning ACP session last received agent output, or null. */
+  lastStreamedContentAt?: () => number | null;
+  /** Overrides how long an idle runtime may leave a submitted prompt unstarted. */
+  submissionIdleGraceMs?: number;
+}
+
+export class KimiNativeBridge {
+  private readonly log: KimiSessionLog;
+  private readonly renderer: KimiMainTurnRenderer;
+  private readonly emit: (event: AgentStreamEvent) => void;
+  private readonly provider: AgentProvider;
+  private started = false;
+  private stopped = false;
+  private promptBaseline: number | null = null;
+  private submission: KimiSubmission | null = null;
+  private readonly submissionIdleGraceMs: number;
+
+  constructor(options: KimiNativeBridgeOptions) {
+    this.emit = options.emit;
+    this.submissionIdleGraceMs = options.submissionIdleGraceMs ?? SUBMISSION_IDLE_GRACE_MS;
+    this.provider = options.provider;
+    this.renderer = new KimiMainTurnRenderer({
+      provider: options.provider,
+      emit: options.emit,
+      logger: options.logger,
+      // Anything Kimi logged before this bridge attached is history: the ACP
+      // session replays it, and rendering it again would duplicate it.
+      renderFrom: Date.now(),
+      isForegroundTurnActive: options.isForegroundTurnActive ?? (() => false),
+      lastStreamedContentAt: options.lastStreamedContentAt ?? (() => null),
+    });
+    this.log = new KimiSessionLog({
+      kimiSessionId: options.kimiSessionId,
+      kimiHome: options.kimiHome,
+      logger: options.logger,
+      pollIntervalMs: options.pollIntervalMs,
+      onGoal: (goal) => {
+        this.emit({ type: "goal_updated", provider: this.provider, goal });
+      },
+      onUsage: (usage) => {
+        this.emit({ type: "usage_updated", provider: this.provider, usage });
+      },
+      onSubagent: (event) => {
+        this.emit({ type: "provider_subagent", provider: this.provider, event });
+      },
+      onBackgroundTasks: (backgroundTasks) => {
+        this.emit({ type: "background_tasks_updated", provider: this.provider, backgroundTasks });
+      },
+      onLines: (lines) => this.renderer.consume(lines),
+      onTick: () => this.renderer.tick(),
+    });
+  }
+
+  /** Idempotent. Starts tailing the session log. */
+  start(): void {
+    if (this.started || this.stopped) {
+      return;
+    }
+    this.started = true;
+    this.log.start();
+  }
+
+  /** Idempotent. Stops tailing the session log. */
+  stop(): void {
+    if (this.stopped) {
+      return;
+    }
+    this.stopped = true;
+    this.log.stop();
+    this.renderer.stop();
+  }
+
+  /** Latest known goal, or null. */
+  getGoal(): AgentGoal | null {
+    return this.log.getGoal();
+  }
+
+  /** True while the provider is still working toward the goal. */
+  isGoalLive(): boolean {
+    return isAgentGoalLive(this.log.getGoal());
+  }
+
+  /** True while the runtime is inside a turn it has not ended yet. */
+  isTurnInProgress(): boolean {
+    return this.log.isTurnInProgress();
+  }
+
+  /** Resolves when the goal stops being live, after `timeoutMs`, or on abort. */
+  async waitForGoalSettled(timeoutMs: number, signal?: AbortSignal): Promise<void> {
+    if (this.stopped) {
+      return;
+    }
+    await this.log.waitForSettled(timeoutMs, signal);
+  }
+
+  /** Paseo stopped a turn the runtime started on its own; see the renderer. */
+  noteInterrupted(): void {
+    this.renderer.noteInterrupted();
+  }
+
+  /**
+   * Records the foreground prompt about to be sent, so the turn can later be
+   * matched to the user prompt Kimi logs for it. `text` is what was sent; it
+   * tells the prompt apart from one another client sent at the same moment.
+   */
+  markPromptSubmitted(text: string | null = null): void {
+    this.promptBaseline = this.log.getAcceptedPromptCount();
+    this.submission = { sentAt: Date.now(), text, outcome: null };
+    this.renderer.noteForegroundTurnStarting();
+  }
+
+  /**
+   * True when Kimi logged the submitted prompt, or when nothing was submitted:
+   * an unknown submission must not accuse the runtime of dropping a prompt.
+   */
+  wasPromptAccepted(): boolean {
+    const submission = this.submission;
+    if (submission === null) {
+      return (
+        this.promptBaseline === null || this.log.getAcceptedPromptCount() > this.promptBaseline
+      );
+    }
+    if (submission.outcome === "not_accepted") {
+      return false;
+    }
+    return this.renderer.findSubmittedPrompt(submission.sentAt, submission.text) !== null;
+  }
+
+  /** True when the runtime logged an inbound prompt receipt after the submission. */
+  acceptedPromptSinceSubmission(): boolean {
+    return this.promptBaseline !== null && this.log.getAcceptedPromptCount() > this.promptBaseline;
+  }
+
+  /**
+   * True when Kimi recorded a compaction at or after the prompt was submitted.
+   *
+   * A `/compact` is answered by compacting: Kimi logs no prompt for a slash
+   * command, so the compaction is the only evidence the command was taken.
+   */
+  compactedSinceSubmission(): boolean {
+    const submission = this.submission;
+    return submission !== null && this.renderer.compactedSince(submission.sentAt);
+  }
+
+  /** How the last submitted prompt's wait ended, or null if it has not. */
+  getSubmissionOutcome(): KimiSubmissionOutcome | null {
+    return this.submission?.outcome ?? null;
+  }
+
+  /**
+   * Resolves once the submitted prompt's own turn has ended in Kimi.
+   *
+   * Kimi answers a prompt that arrives while it is busy with an immediate
+   * `end_turn` and runs it later from its queue, without streaming it over ACP.
+   * Holding the foreground turn until the prompt actually ran keeps Paseo from
+   * calling it empty; its output reaches the turn through the log renderer.
+   *
+   * There is no fixed ceiling, because a queued prompt legitimately waits for
+   * however long the turn ahead of it runs. The wait instead ends as
+   * `not_accepted` when the runtime has sat idle for a while without the prompt
+   * ever appearing — idle is the one state in which it should already have run.
+   */
+  async waitForSubmittedPromptSettled(signal?: AbortSignal): Promise<KimiSubmissionOutcome> {
+    const submission = this.submission;
+    if (submission === null || this.stopped) {
+      return "completed";
+    }
+    let idleSince: number | null = null;
+    let recordsSeen = this.log.getRecordCount();
+    while (!this.stopped) {
+      if (signal?.aborted) {
+        submission.outcome = "aborted";
+        return "aborted";
+      }
+      // A log that keeps growing is a runtime that keeps working, whatever its
+      // turn boundaries say. Only a log that has gone quiet for the whole grace
+      // period counts as idle.
+      const records = this.log.getRecordCount();
+      if (records !== recordsSeen) {
+        recordsSeen = records;
+        idleSince = null;
+      }
+      const prompt = this.renderer.findSubmittedPrompt(submission.sentAt, submission.text);
+      if (prompt?.ended) {
+        submission.outcome = "completed";
+        return "completed";
+      }
+      // A receipt means the runtime took the prompt, so it was not dropped; once
+      // nothing of Kimi's is running, there is nothing left to wait for. The
+      // receipt need not name this submission: a prompt steered into a turn
+      // already running is folded into that turn's own receipt and never gets
+      // one of its own.
+      if (!this.log.isTurnInProgress() && this.acceptedPromptSinceSubmission()) {
+        submission.outcome = "completed";
+        return "completed";
+      }
+      if (this.log.hasUnreadBacklog()) {
+        // The log has records this wait has not folded in yet, so its state is
+        // the log's, not the runtime's. A lagging tail restarts the grace.
+        idleSince = null;
+      } else if (this.log.isTurnInProgress()) {
+        // A turn is open: Kimi is working on something, ours or the one ours is
+        // queued behind. With no receipt for this prompt nothing proves Kimi
+        // took it, and a queued prompt must not be reported as dropped, so the
+        // wait holds for as long as that turn runs. Once a receipt has landed
+        // the prompt did run, so a turn that never ends settles this one after
+        // the grace instead of holding it forever.
+        if (!this.acceptedPromptSinceSubmission()) {
+          idleSince = null;
+        } else {
+          idleSince ??= Date.now();
+          if (Date.now() - idleSince >= this.submissionIdleGraceMs) {
+            submission.outcome = "completed";
+            return "completed";
+          }
+        }
+      } else if (prompt) {
+        // Logged and no longer running: its turn is over even if the prompt's
+        // own end record has not been read yet.
+        submission.outcome = "completed";
+        return "completed";
+      } else {
+        idleSince ??= Date.now();
+        if (Date.now() - idleSince >= this.submissionIdleGraceMs) {
+          // A prompt receipt landed without being matchable to this submission:
+          // the runtime ran something of ours, so it did not drop the prompt.
+          if (this.acceptedPromptSinceSubmission()) {
+            submission.outcome = "completed";
+            return "completed";
+          }
+          submission.outcome = "not_accepted";
+          return "not_accepted";
+        }
+      }
+      await delayOrAbort(SUBMISSION_POLL_MS, signal);
+    }
+    submission.outcome = "aborted";
+    return "aborted";
+  }
+}
+
+/** Waits `ms`, or less if `signal` aborts first. Never rejects. */
+async function delayOrAbort(ms: number, signal?: AbortSignal): Promise<void> {
+  await delay(ms, undefined, signal ? { signal } : undefined).catch(() => undefined);
+}
