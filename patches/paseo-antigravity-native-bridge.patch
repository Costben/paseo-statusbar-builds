+      sessionHandle?.onClose?.();
+    }
+    expect(harness.events.at(-1)).toEqual({
+      type: "background_work",
+      provider: "antigravity",
+      items: null,
+    });
+  });
+
+  test("tracks spawned subagents across hold and supports abort and autonomous idle wakeups", async () => {
+    const harness = createHarness();
+    const sessionHandle = harness.attach();
+    try {
+      harness.setForeground(true);
+      harness.hooks.onForegroundTurnStarting?.(harness.ctx, "delegate investigation");
+
+      appendJsonl(harness.transcriptPath, {
+        step_index: 1,
+        source: "MODEL",
+        type: "PLANNER_RESPONSE",
+        status: "DONE",
+        tool_calls: [
+          {
+            name: "invoke_subagent",
+            args: {
+              TypeName: '"research"',
+              Role: '"Codebase Researcher"',
+              Prompt: '"Inspect module"',
+            },
+          },
+        ],
+      });
+      appendJsonl(harness.transcriptPath, {
+        step_index: 2,
+        source: "MODEL",
+        type: "GENERIC",
+        status: "DONE",
+        content:
+          'Created At: 2026-11-14T18:16:10+08:00\nCreated the following subagent:\n{\n  "conversationId": "child-subagent-1",\n  "logAbsoluteUri": "file:///tmp/child.jsonl"\n}\nThe subagent will send you a message when it has completed its task.',
+      });
+
+      const abortController = new AbortController();
+      const holdPromise = harness.hooks.holdTurnWhile?.({
+        acpSessionId: harness.sessionId,
+        logger: harness.ctx.logger,
+        signal: abortController.signal,
+        sawTimeline: true,
+      });
+
+      await expect
+        .poll(() => harness.events.findLast((event) => event.type === "background_work"))
+        .toEqual({
+          type: "background_work",
+          provider: "antigravity",
+          items: [
+            {
+              id: "subagent:child-subagent-1",
+              kind: "other",
+              description: "Subagent: Codebase Researcher",
+              command: "research",
