+  type AntigravityTranscriptRecord,
+} from "./transcript-log.js";
+
+export const DEFAULT_ANTIGRAVITY_POLL_INTERVAL_MS = 500;
+export const HELD_ANTIGRAVITY_POLL_INTERVAL_MS = 250;
+export const ANTIGRAVITY_TURN_HOLD_TIMEOUT_MS = 15 * 60 * 1000;
+const STREAM_FLUSH_GRACE_MS = 1_500;
+const DEFAULT_POST_SETTLE_WAIT_MS = 3_000;
+const DEFAULT_POST_SETTLE_TOOL_WAIT_MS = 15_000;
+
+interface TrackedBackgroundEntry {
+  id: string;
+  kind: "shell" | "monitor" | "other";
+  blocking: boolean;
+  description: string | null;
+  command?: string;
+}
+
+interface PendingStepToolEntry {
+  call: AntigravityToolCallEntry;
+  renderedCallId: string | null;
+}
+
+interface RenderedCallRef {
+  call: AntigravityToolCallEntry;
+  callId: string;
+}
+
+export interface AntigravityNativeBridgeOptions {
+  sessionId: string;
+  antigravityHome?: string;
+  logger: Logger;
+  provider: AgentProvider;
+  emit: (event: AgentStreamEvent) => void;
+  isForegroundTurnActive?: () => boolean;
+  lastStreamedContentAt?: () => number | null;
+  pollIntervalMs?: number;
+  heldPollIntervalMs?: number;
+  postSettleWaitMs?: number;
+  postSettleToolWaitMs?: number;
+  streamFlushGraceMs?: number;
+  now?: () => number;
+}
+
+export interface AntigravityProviderHooksOptions {
+  antigravityHome?: string;
+  pollIntervalMs?: number;
+  heldPollIntervalMs?: number;
+  turnHoldTimeoutMs?: number;
+  postSettleWaitMs?: number;
+  postSettleToolWaitMs?: number;
+  streamFlushGraceMs?: number;
+}
+
+/**
+ * Bridges Antigravity's on-disk `transcript.jsonl` to Paseo stream events:
+ *
+ * 1. Background `run_command` tasks (`task-<N>`) and `invoke_subagent` children
+ *    often keep running after `agy acp` returns `end_turn`, and their later
+ *    wakeup turns are written only to `transcript.jsonl` (0 bytes on ACP stdio).
+ *    The bridge exposes live `background_work`, holds the foreground turn until
+ *    non-daemon background work settles, renders unstreamed wakeup turns into
+ *    the held foreground turn (or opens an autonomous turn if woken up later),
+ *    and blocks idle runtime reaper collection while blocking work is active.
+ * 2. `/compact` and auto-compaction write `SYSTEM/CHECKPOINT` to `transcript.jsonl`
+ *    while ACP emits only `usage_update` + `end_turn`. The bridge emits a
+ *    native `compaction` timeline marker (`manual` or `auto`).
+ */
+export class AntigravityNativeBridge {
+  private readonly log: AntigravityTranscriptLog;
+  private readonly logger: Logger;
+  private readonly provider: AgentProvider;
+  private readonly emit: (event: AgentStreamEvent) => void;
+  private readonly isForegroundTurnActive: () => boolean;
+  private readonly lastStreamedContentAt: () => number | null;
+  private readonly pollIntervalMs: number;
+  private readonly heldPollIntervalMs: number;
+  private readonly postSettleWaitMs: number;
+  private readonly postSettleToolWaitMs: number;
+  private readonly streamFlushGraceMs: number;
+  private readonly now: () => number;
+
+  private started = false;
+  private stopped = false;
+  private pollTimer: ReturnType<typeof setTimeout> | null = null;
+  private holdWakeResolve: (() => void) | null = null;
+
+  private pendingManualCompact = false;
+  private lastUserInputText: string | null = null;
+  private lastForegroundEndedAt: number | null = null;
+
+  private inTurnHold = false;
+  private holdEpochSawWakeup = false;
+  private awaitingPostSettleResponse = false;
+  private postSettleFinalPlannerSeen = false;
+  private postSettleDeadline: number | null = null;
+  private idleWakeupActive = false;
+
+  private readonly pendingStepTools: PendingStepToolEntry[] = [];
+  private readonly trackedTasks = new Map<string, TrackedBackgroundEntry>();
+  private readonly trackedSubagents = new Map<string, TrackedBackgroundEntry>();
+  private readonly backgroundToolCalls = new Map<string, RenderedCallRef>();
+  private lastEmittedBackgroundKey = "[]";
+  private emittedAnyBackgroundWork = false;
+  private syntheticCallOrdinal = 0;
+
+  constructor(options: AntigravityNativeBridgeOptions) {
+    this.logger = options.logger;
+    this.provider = options.provider;
+    this.emit = options.emit;
+    this.isForegroundTurnActive = options.isForegroundTurnActive ?? (() => false);
+    this.lastStreamedContentAt = options.lastStreamedContentAt ?? (() => null);
+    this.pollIntervalMs = options.pollIntervalMs ?? DEFAULT_ANTIGRAVITY_POLL_INTERVAL_MS;
+    this.heldPollIntervalMs = options.heldPollIntervalMs ?? HELD_ANTIGRAVITY_POLL_INTERVAL_MS;
+    this.postSettleWaitMs = options.postSettleWaitMs ?? DEFAULT_POST_SETTLE_WAIT_MS;
+    this.postSettleToolWaitMs = options.postSettleToolWaitMs ?? DEFAULT_POST_SETTLE_TOOL_WAIT_MS;
+    this.streamFlushGraceMs = options.streamFlushGraceMs ?? STREAM_FLUSH_GRACE_MS;
+    this.now = options.now ?? (() => Date.now());
+    this.log = new AntigravityTranscriptLog({
+      sessionId: options.sessionId,
+      antigravityHome: options.antigravityHome,
+      logger: options.logger,
+      onRecord: (record) => this.handleRecord(record),
+    });
+  }
+
+  start(): void {
+    if (this.started || this.stopped) {
+      return;
+    }
+    this.started = true;
+    this.log.start();
+    this.scheduleNextPoll();
+  }
+
+  stop(): void {
+    if (this.stopped) {
+      return;
+    }
+    this.stopped = true;
+    if (this.pollTimer !== null) {
+      clearTimeout(this.pollTimer);
+      this.pollTimer = null;
+    }
+    this.log.stop();
+    this.trackedTasks.clear();
+    this.trackedSubagents.clear();
+    this.backgroundToolCalls.clear();
+    this.pendingStepTools.length = 0;
+    if (this.emittedAnyBackgroundWork) {
+      this.emit({ type: "background_work", provider: this.provider, items: null });
+    }
+    this.wakeHoldLoop();
+  }
+
+  async pollNow(): Promise<void> {
+    if (this.stopped) {
+      return;
+    }
+    await this.log.pollNow();
+  }
+
+  markPromptSubmitted(promptText: string | null): void {
+    this.pendingManualCompact = promptText !== null && isCompactSlashCommand(promptText);
+    this.idleWakeupActive = false;
+    this.awaitingPostSettleResponse = false;
+    this.postSettleFinalPlannerSeen = false;
+    this.postSettleDeadline = null;
+  }
+
+  hasBlockingBackgroundWork(): boolean {
+    for (const entry of this.trackedTasks.values()) {
+      if (entry.blocking) {
+        return true;
+      }
+    }
+    for (const entry of this.trackedSubagents.values()) {
+      if (entry.blocking) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  /**
+   * Holds the active foreground turn open until all non-daemon background
+   * tasks and spawned subagents have settled AND the post-wakeup response has
+   * finished (or a bounded quiet period elapses). Resolves early on abort.
+   */
+  async waitForBackgroundSettled(timeoutMs: number, signal?: AbortSignal): Promise<void> {
+    if (this.stopped || signal?.aborted) {
+      return;
+    }
+    await this.pollNow();
+    if (!this.hasBlockingBackgroundWork()) {
+      this.lastForegroundEndedAt = this.now();
+      return;
+    }
+
+    const deadline = this.now() + timeoutMs;
+    this.inTurnHold = true;
+    this.holdEpochSawWakeup = false;
+    this.awaitingPostSettleResponse = false;
+    this.postSettleFinalPlannerSeen = false;
+    this.postSettleDeadline = null;
+
+    const onAbort = (): void => {
+      this.wakeHoldLoop();
+    };
+    signal?.addEventListener("abort", onAbort, { once: true });
+
+    try {
+      while (!this.stopped && !signal?.aborted) {
+        await this.pollNow();
+
+        if (this.hasBlockingBackgroundWork()) {
+          this.awaitingPostSettleResponse = false;
+          this.postSettleFinalPlannerSeen = false;
+          this.postSettleDeadline = null;
+        } else if (!this.awaitingPostSettleResponse || this.postSettleFinalPlannerSeen) {
+          break;
+        } else if (this.postSettleDeadline !== null && this.now() >= this.postSettleDeadline) {
+          break;
+        }
+
+        const nowMs = this.now();
+        if (nowMs >= deadline) {
+          break;
+        }
+        const nextWaitCap = Math.min(this.heldPollIntervalMs, Math.max(1, deadline - nowMs));
+        const waitMs =
+          this.postSettleDeadline !== null
+            ? Math.min(nextWaitCap, Math.max(1, this.postSettleDeadline - nowMs))
+            : nextWaitCap;
+        await this.waitHoldStep(waitMs, signal);
+      }
+    } finally {
+      signal?.removeEventListener("abort", onAbort);
+      this.inTurnHold = false;
+      this.holdEpochSawWakeup = false;
+      this.awaitingPostSettleResponse = false;
+      this.postSettleFinalPlannerSeen = false;
+      this.postSettleDeadline = null;
+      this.lastForegroundEndedAt = this.now();
+    }
+  }
+
+  private scheduleNextPoll(): void {
+    if (this.stopped || this.pollTimer !== null) {
+      return;
+    }
+    const interval = this.inTurnHold ? this.heldPollIntervalMs : this.pollIntervalMs;
+    this.pollTimer = setTimeout(() => {
+      this.pollTimer = null;
+      void this.pollNow().finally(() => {
+        if (!this.stopped) {
+          this.scheduleNextPoll();
+        }
+      });
+    }, interval);
+    this.pollTimer.unref?.();
+  }
+
+  private wakeHoldLoop(): void {
+    const resolve = this.holdWakeResolve;
+    if (resolve) {
+      this.holdWakeResolve = null;
+      resolve();
+    }
+  }
+
+  private async waitHoldStep(ms: number, signal?: AbortSignal): Promise<void> {
+    if (this.stopped || signal?.aborted) {
+      return;
+    }
+    await new Promise<void>((resolve) => {
+      let settled = false;
+      const done = (): void => {
+        if (settled) {
+          return;
+        }
+        settled = true;
+        clearTimeout(timer);
+        if (this.holdWakeResolve === done) {
+          this.holdWakeResolve = null;
+        }
+        resolve();
+      };
+      this.holdWakeResolve = done;
+      const timer = setTimeout(done, ms);
+      timer.unref?.();
+      if (signal) {
+        void delay(ms, undefined, { signal }).then(done, done);
+      }
+    });
+  }
+
+  private handleRecord(record: AntigravityTranscriptRecord): void {
+    if (record.source === "USER_EXPLICIT" && record.type === "USER_INPUT") {
+      this.pendingStepTools.length = 0;
+      this.lastUserInputText = record.content;
+      if (!this.inTurnHold) {
+        this.idleWakeupActive = false;
+      }
+      return;
+    }
+
+    if (record.source === "SYSTEM" && record.type === "CHECKPOINT" && record.status === "DONE") {
+      const manualFromPrompt = this.pendingManualCompact;
+      const manualFromTranscript =
+        !manualFromPrompt &&
+        this.lastUserInputText !== null &&
+        isCompactSlashCommand(this.lastUserInputText);
+      const trigger: "manual" | "auto" = manualFromPrompt || manualFromTranscript ? "manual" : "auto";
+      this.pendingManualCompact = false;
+      if (manualFromTranscript) {
+        this.lastUserInputText = null;
+      }
+      const preTokens = computeCheckpointPreTokens(record);
+      this.emit({
+        type: "timeline",
+        provider: this.provider,
+        item: {
+          type: "compaction",
+          status: "completed",
+          trigger,
+          ...(preTokens !== undefined ? { preTokens } : {}),
+        },
+      });
+      return;
+    }
+
+    if (record.source === "SYSTEM" && record.type === "SYSTEM_MESSAGE") {
+      this.handleSystemMessage(record);
+      return;
+    }
+
+    if (record.source === "SYSTEM" && record.type === "ERROR_MESSAGE") {
+      if (this.inTurnHold) {
+        this.holdEpochSawWakeup = true;
+        if (this.awaitingPostSettleResponse) {
+          this.postSettleDeadline = this.now() + this.postSettleToolWaitMs;
+        }
+      }
+      if (this.shouldRenderCurrentStep()) {
+        this.emitTimelineItem({
+          type: "error",
+          message: record.error ?? record.content ?? "Antigravity runtime error",
+        });
+      }
+      return;
+    }
+
+    if (record.source === "MODEL" && record.type === "PLANNER_RESPONSE") {
+      this.handlePlannerResponse(record);
+      return;
+    }
+
+    if (record.source === "MODEL" && record.type === "GENERIC") {
+      this.handleGenericToolResult(record);
+    }
+  }
+
+  private handlePlannerResponse(record: AntigravityTranscriptRecord): void {
+    // Discard any unconsumed tool queue entries from a previously interrupted turn.
+    this.pendingStepTools.length = 0;
+
+    const renderThisStep = this.shouldRenderCurrentStep();
+    const hasToolCalls = record.toolCalls.length > 0;
+
+    if (renderThisStep && record.thinking && record.thinking.trim().length > 0) {
+      this.emitTimelineItem({
+        type: "reasoning",
+        text: record.thinking,
+      });
+    }
+
+    for (let idx = 0; idx < record.toolCalls.length; idx++) {
+      const call = record.toolCalls[idx]!;
+      let renderedCallId: string | null = null;
+      if (renderThisStep) {
+        renderedCallId = `agy-step-${record.stepIndex ?? this.syntheticCallOrdinal++}-tc-${idx}`;
+        this.emitTimelineItem(buildAntigravityRunningToolItem(call, renderedCallId));
+      }
+      this.pendingStepTools.push({ call, renderedCallId });
+    }
+
+    if (renderThisStep && record.content && record.content.length > 0) {
+      this.emitTimelineItem({
+        type: "assistant_message",
+        text: record.content,
+      });
+    }
+
+    if (renderThisStep) {
+      if (this.inTurnHold && this.awaitingPostSettleResponse) {
+        if (hasToolCalls) {
+          this.postSettleDeadline = this.now() + this.postSettleToolWaitMs;
+        } else if (!this.hasBlockingBackgroundWork()) {
+          this.postSettleFinalPlannerSeen = true;
+          this.wakeHoldLoop();
+        }
+      } else if (
+        !this.inTurnHold &&
+        this.idleWakeupActive &&
+        !hasToolCalls &&
+        !this.hasBlockingBackgroundWork()
+      ) {
+        this.idleWakeupActive = false;
+        this.emit({ type: "turn_completed", provider: this.provider });
+      }
+    }
+  }
+
+  private handleGenericToolResult(record: AntigravityTranscriptRecord): void {
+    const stepTool = this.pendingStepTools.shift() ?? null;
+    const call = stepTool?.call ?? null;
+    const renderedCallId = stepTool?.renderedCallId ?? null;
+
+    if (record.status === "RUNNING") {
+      const taskSpawn = parseBackgroundTaskSpawn(record.content);
+      if (taskSpawn) {
+        const isDaemon = call?.name === "run_command" && isAntigravityTruthyArg(call.args?.IsDaemon);
+        const command =
+          (call?.name === "run_command"
+            ? unwrapAntigravityArgString(call.args?.CommandLine)
+            : undefined) ?? (taskSpawn.taskDescription || undefined);
+        const summary =
+          (call?.name === "run_command"
+            ? unwrapAntigravityArgString(call.args?.toolSummary)
+            : undefined) ??
+          (taskSpawn.taskDescription || (isDaemon ? "Background daemon" : "Background command"));
+
+        this.trackedTasks.set(taskSpawn.taskId, {
+          id: taskSpawn.taskId,
+          kind: isDaemon ? "monitor" : "shell",
+          blocking: !isDaemon,
+          description: summary,
+          ...(command ? { command } : {}),
+        });
+        if (renderedCallId && call) {
+          this.backgroundToolCalls.set(taskSpawn.taskId, { call, callId: renderedCallId });
+        }
+        this.emitBackgroundWorkIfChanged();
+        return;
+      }
+    }
+
+    let backgroundChanged = false;
+    const subagentSpawn = parseSubagentSpawn(record.content);
+    if (subagentSpawn) {
+      const role =
+        call?.name === "invoke_subagent" ? unwrapAntigravityArgString(call.args?.Role) : undefined;
+      const typeName =
+        call?.name === "invoke_subagent"
+          ? unwrapAntigravityArgString(call.args?.TypeName)
+          : undefined;
+      this.trackedSubagents.set(subagentSpawn.conversationId, {
+        id: `subagent:${subagentSpawn.conversationId}`,
+        kind: "other",
+        blocking: true,
+        description: role ? `Subagent: ${role}` : `Subagent ${subagentSpawn.conversationId.slice(0, 8)}`,
+        ...(typeName ? { command: typeName } : {}),
+      });
+      backgroundChanged = true;
+    }
+
+    if (record.status === "DONE" && call?.name === "manage_task") {
+      const action = unwrapAntigravityArgString(call.args?.Action)?.toLowerCase();
+      const targetTaskId = unwrapAntigravityArgString(call.args?.TaskId);
+      if (action === "kill" && targetTaskId && this.trackedTasks.delete(targetTaskId)) {
+        this.backgroundToolCalls.delete(targetTaskId);
+        backgroundChanged = true;
+      }
+    }
+
+    if (record.status === "DONE" && call?.name === "manage_subagents") {
+      const action = unwrapAntigravityArgString(call.args?.Action)?.toLowerCase();
+      if (action === "kill_all" && this.trackedSubagents.size > 0) {
+        this.trackedSubagents.clear();
+        backgroundChanged = true;
+      } else if (action === "kill") {
+        for (const childId of unwrapAntigravityStringArrayArg(call.args?.ConversationIds)) {
+          if (this.trackedSubagents.delete(childId)) {
+            backgroundChanged = true;
+          }
+        }
+      }
+    }
+
+    if (backgroundChanged) {
+      this.emitBackgroundWorkIfChanged();
+      if (!this.hasBlockingBackgroundWork()) {
+        this.wakeHoldLoop();
+      }
+    }
+
+    if (renderedCallId && call) {
+      const failed = record.status === "ERROR" || record.status === "INVALID";
+      this.emitTimelineItem(buildAntigravitySettledToolItem(call, renderedCallId, failed, record.content));
+    }
+
+    if (this.inTurnHold && this.awaitingPostSettleResponse && !this.hasBlockingBackgroundWork()) {
+      this.postSettleDeadline = this.now() + this.postSettleWaitMs;
+    }
+  }
+
+  private handleSystemMessage(record: AntigravityTranscriptRecord): void {
+    const senders = parseSystemMessageSenders(record.content);
+    let backgroundChanged = false;
+    const renderThisStep = this.shouldRenderCurrentStep() || this.inTurnHold || !this.isForegroundTurnActive();
+
+    for (const sender of senders) {
+      if (this.trackedTasks.delete(sender)) {
+        backgroundChanged = true;
+      }
+      if (this.trackedSubagents.delete(sender)) {
+        backgroundChanged = true;
+      }
+      const bgTool = this.backgroundToolCalls.get(sender);
+      if (bgTool) {
+        this.backgroundToolCalls.delete(sender);
+        if (renderThisStep) {
+          const canceledOrFailed = /\b(was canceled|failed)\b/i.test(record.content ?? "");
+          this.emitTimelineItem(
+            buildAntigravitySettledToolItem(bgTool.call, bgTool.callId, canceledOrFailed, record.content),
+          );
+        }
+      }
+    }
+
+    if (backgroundChanged) {
+      this.emitBackgroundWorkIfChanged();
+    }
+
+    if (this.inTurnHold) {
+      this.holdEpochSawWakeup = true;
+      if (!this.hasBlockingBackgroundWork()) {
+        this.awaitingPostSettleResponse = true;
+        this.postSettleFinalPlannerSeen = false;
+        this.postSettleDeadline = this.now() + this.postSettleWaitMs;
+      } else {
+        this.awaitingPostSettleResponse = false;
+        this.postSettleFinalPlannerSeen = false;
+        this.postSettleDeadline = null;
+      }
+      this.wakeHoldLoop();
+      return;
+    }
+
+    if (!this.isForegroundTurnActive()) {
+      this.idleWakeupActive = true;
+    }
+  }
+
+  private shouldRenderCurrentStep(): boolean {
+    if (this.inTurnHold) {
+      return this.holdEpochSawWakeup;
+    }
+    if (this.idleWakeupActive) {
+      return true;
+    }
+    if (this.isForegroundTurnActive()) {
+      return false;
+    }
+    return this.shouldRenderAutonomousStep();
+  }
+
+  private shouldRenderAutonomousStep(): boolean {
+    if (this.idleWakeupActive) {
+      return true;
+    }
+    const lastStreamed = this.lastStreamedContentAt() ?? 0;
+    const lastEnded = this.lastForegroundEndedAt ?? 0;
+    const mostRecentForegroundActivity = Math.max(lastStreamed, lastEnded);
+    if (mostRecentForegroundActivity <= 0) {
+      return true;
+    }
+    if (this.now() - mostRecentForegroundActivity > this.streamFlushGraceMs) {
+      this.idleWakeupActive = true;
+      return true;
+    }
+    return false;
+  }
+
+  private emitTimelineItem(item: AgentTimelineItem): void {
+    this.emit({
+      type: "timeline",
+      provider: this.provider,
+      item,
+    });
+  }
+
+  private emitBackgroundWorkIfChanged(): void {
+    const items: AgentBackgroundWorkInput[] = [];
+    for (const entry of this.trackedTasks.values()) {
+      items.push({
+        id: entry.id,
+        kind: entry.kind,
+        description: entry.description,
+        ...(entry.command ? { command: entry.command } : {}),
+      });
+    }
+    for (const entry of this.trackedSubagents.values()) {
+      items.push({
+        id: entry.id,
+        kind: entry.kind,
+        description: entry.description,
+        ...(entry.command ? { command: entry.command } : {}),
+      });
+    }
+    const serialized = JSON.stringify(items);
+    if (serialized === this.lastEmittedBackgroundKey) {
+      return;
+    }
+    this.lastEmittedBackgroundKey = serialized;
+    this.emittedAnyBackgroundWork = true;
+    this.emit({
+      type: "background_work",
+      provider: this.provider,
+      items,
+    });
+  }
+}
+
+export function createAntigravityProviderHooks(
+  options: AntigravityProviderHooksOptions = {},
+): ACPProviderHooks {
+  const bridges = new Map<string, AntigravityNativeBridge>();
+  const holdTimeoutMs = options.turnHoldTimeoutMs ?? ANTIGRAVITY_TURN_HOLD_TIMEOUT_MS;
+
+  return {
+    onSessionReady(ctx) {
+      const bridge = new AntigravityNativeBridge({
+        sessionId: ctx.acpSessionId,
+        antigravityHome: options.antigravityHome,
+        logger: ctx.logger,
+        provider: ctx.provider,
+        emit: ctx.emit,
+        isForegroundTurnActive: ctx.isForegroundTurnActive,
+        lastStreamedContentAt: ctx.lastStreamedContentAt,
+        pollIntervalMs: options.pollIntervalMs,
+        heldPollIntervalMs: options.heldPollIntervalMs,
+        postSettleWaitMs: options.postSettleWaitMs,
+        postSettleToolWaitMs: options.postSettleToolWaitMs,
+        streamFlushGraceMs: options.streamFlushGraceMs,
+      });
+      bridges.set(ctx.acpSessionId, bridge);
+      bridge.start();
+      return {
+        onClose: () => {
+          bridges.delete(ctx.acpSessionId);
+          bridge.stop();
+        },
+      };
+    },
+    onForegroundTurnStarting(ctx, prompt) {
+      const text = extractPromptText(prompt);
+      bridges.get(ctx.acpSessionId)?.markPromptSubmitted(text.trim().length > 0 ? text : null);
+    },
+    holdTurnWhile(ctx) {
+      const bridge = bridges.get(ctx.acpSessionId);
+      if (!bridge) {
+        return null;
+      }
+      return bridge.waitForBackgroundSettled(holdTimeoutMs, ctx.signal);
+    },
+    canStopRuntime(ctx: ACPProviderHookContext) {
+      return !(bridges.get(ctx.acpSessionId)?.hasBlockingBackgroundWork() ?? false);
+    },
+  };
+}
+
+function isCompactSlashCommand(text: string): boolean {
+  return /^\/compact(?:\s|$)/i.test(text.trim());
+}
