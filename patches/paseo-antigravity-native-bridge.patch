+import { mkdtempSync, mkdirSync, rmSync, writeFileSync, appendFileSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+import { afterEach, describe, expect, test } from "vitest";
+
+import { createTestLogger } from "../../../../test-utils/test-logger.js";
+import type { AgentStreamEvent } from "../../agent-sdk-types.js";
+import type { ACPProviderHookContext } from "../acp-agent.js";
+import { createAntigravityProviderHooks } from "./native-bridge.js";
+import {
+  parseBackgroundTaskSpawn,
+  parseSubagentSpawn,
+  parseSystemMessageSenders,
+  unwrapAntigravityArgString,
+} from "./transcript-log.js";
+
+const tempDirs: string[] = [];
+
+function createTempAntigravityHome(): string {
+  const dir = mkdtempSync(path.join(os.tmpdir(), "paseo-agy-bridge-test-"));
+  tempDirs.push(dir);
+  return dir;
+}
+
+function getTranscriptPath(antigravityHome: string, sessionId: string): string {
+  const logsDir = path.join(antigravityHome, "brain", sessionId, ".system_generated", "logs");
+  mkdirSync(logsDir, { recursive: true });
+  return path.join(logsDir, "transcript.jsonl");
+}
+
+function appendJsonl(filePath: string, record: Record<string, unknown>): void {
+  appendFileSync(filePath, `${JSON.stringify(record)}\n`, "utf8");
+}
+
+function createHarness(options?: {
+  antigravityHome?: string;
+  sessionId?: string;
+  postSettleWaitMs?: number;
+}) {
+  const antigravityHome = options?.antigravityHome ?? createTempAntigravityHome();
+  const sessionId = options?.sessionId ?? "11111111-2222-4333-8444-555555555555";
+  const transcriptPath = getTranscriptPath(antigravityHome, sessionId);
+  const events: AgentStreamEvent[] = [];
+  let foregroundActive = false;
+  let lastStreamedAt: number | null = null;
+
+  const hooks = createAntigravityProviderHooks({
+    antigravityHome,
+    pollIntervalMs: 25,
+    heldPollIntervalMs: 15,
+    postSettleWaitMs: options?.postSettleWaitMs ?? 80,
+    postSettleToolWaitMs: 300,
+    streamFlushGraceMs: 200,
+  });
+
+  const ctx: ACPProviderHookContext = {
+    acpSessionId: sessionId,
+    provider: "antigravity",
+    logger: createTestLogger(),
+    emit: (event) => events.push(event),
+    isForegroundTurnActive: () => foregroundActive,
+    lastStreamedContentAt: () => lastStreamedAt,
+  };
+
+  return {
+    antigravityHome,
+    sessionId,
+    transcriptPath,
+    events,
+    hooks,
+    ctx,
+    attach() {
+      return hooks.onSessionReady?.(ctx);
+    },
+    setForeground(active: boolean) {
+      foregroundActive = active;
+    },
+    setStreamedAt(at: number | null) {
+      lastStreamedAt = at;
+    },
+  };
+}
+
+afterEach(() => {
+  while (tempDirs.length > 0) {
+    const dir = tempDirs.pop()!;
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+describe("Antigravity transcript helpers", () => {
+  test("unwraps JSON-quoted tool call argument strings cleanly", () => {
+    expect(unwrapAntigravityArgString('"./gradlew test"')).toBe("./gradlew test");
+    expect(unwrapAntigravityArgString("plain text")).toBe("plain text");
+    expect(unwrapAntigravityArgString(42)).toBeUndefined();
+  });
+
+  test("parses background task spawn, subagent spawn, and SYSTEM_MESSAGE senders", () => {
+    const taskSpawn = parseBackgroundTaskSpawn(
+      "Created At: 2026-11-14T18:00:00+08:00\nTool is running as a background task with task id: abc-123/task-42\nTask Description: sleep 30",
+    );
+    expect(taskSpawn).toEqual({
+      taskId: "abc-123/task-42",
+      taskDescription: "sleep 30",
+    });
+
+    const subSpawn = parseSubagentSpawn(
+      'Created At: 2026-11-14T18:00:00+08:00\nCreated the following subagent:\n{\n  "conversationId": "sub-999",\n  "logAbsoluteUri": "file:///tmp/t.jsonl"\n}\nThe subagent will send you a message.',
+    );
+    expect(subSpawn).toEqual({ conversationId: "sub-999" });
+
+    expect(
+      parseSystemMessageSenders(
+        "<SYSTEM_MESSAGE>\n[Message] timestamp=2026-11-14T10:00:00Z sender=abc-123/task-42 priority=HIGH content=done\n</SYSTEM_MESSAGE>",
+      ),
+    ).toEqual(["abc-123/task-42"]);
+  });
+});
+
+describe("AntigravityNativeBridge & provider hooks", () => {
+  test("ignores pre-existing transcript history on attach and emits manual vs auto compaction", async () => {
+    const home = createTempAntigravityHome();
+    const sessionId = "aaaa1111-2222-4333-8444-555555555555";
+    const transcriptPath = getTranscriptPath(home, sessionId);
+    writeFileSync(
+      transcriptPath,
+      `${JSON.stringify({
+        step_index: 1,
+        source: "SYSTEM",
+        type: "CHECKPOINT",
+        status: "DONE",
+        input_tokens: 1000,
+        cache_read_tokens: 9000,
+      })}\n`,
+      "utf8",
+    );
+
+    const harness = createHarness({ antigravityHome: home, sessionId });
+    const sessionHandle = harness.attach();
+    try {
+      harness.setForeground(true);
+      harness.hooks.onForegroundTurnStarting?.(harness.ctx, "/compact");
+
+      appendJsonl(transcriptPath, {
+        step_index: 2,
+        source: "SYSTEM",
+        type: "CHECKPOINT",
+        status: "DONE",
+        input_tokens: 4252,
+        cache_read_tokens: 254356,
+        content: "# Resuming from a compaction",
+      });
+
+      await harness.hooks.holdTurnWhile?.({
+        acpSessionId: sessionId,
+        logger: harness.ctx.logger,
+        signal: new AbortController().signal,
+        sawTimeline: false,
+      });
+
+      const compactions = harness.events.filter(
+        (event): event is Extract<AgentStreamEvent, { type: "timeline" }> =>
+          event.type === "timeline" && event.item.type === "compaction",
+      );
+      expect(compactions).toHaveLength(1);
+      expect(compactions[0]!.item).toEqual({
+        type: "compaction",
+        status: "completed",
+        trigger: "manual",
+        preTokens: 258608,
+      });
+
+      harness.hooks.onForegroundTurnStarting?.(harness.ctx, "continue working");
+      appendJsonl(transcriptPath, {
+        step_index: 3,
+        source: "SYSTEM",
+        type: "CHECKPOINT",
+        status: "DONE",
+        input_tokens: 2000,
+        cache_read_tokens: 180000,
+        content: "# Resuming from auto compaction",
+      });
+
+      await harness.hooks.holdTurnWhile?.({
+        acpSessionId: sessionId,
+        logger: harness.ctx.logger,
+        signal: new AbortController().signal,
+        sawTimeline: true,
+      });
+
+      const autoCompactions = harness.events.filter(
+        (event): event is Extract<AgentStreamEvent, { type: "timeline" }> =>
+          event.type === "timeline" && event.item.type === "compaction",
+      );
+      expect(autoCompactions).toHaveLength(2);
+      expect(autoCompactions[1]!.item).toEqual({
+        type: "compaction",
+        status: "completed",
+        trigger: "auto",
+        preTokens: 182000,
+      });
+    } finally {
+      sessionHandle?.onClose?.();
+    }
+  });
+
+  test("holds foreground turn while non-daemon background task runs and renders post-wakeup turn without duplicating pre-hold text", async () => {
+    const harness = createHarness();
+    const sessionHandle = harness.attach();
+    try {
+      harness.setForeground(true);
+      harness.setStreamedAt(Date.now());
+      harness.hooks.onForegroundTurnStarting?.(harness.ctx, "run tests");
+
+      appendJsonl(harness.transcriptPath, {
+        step_index: 1,
+        source: "MODEL",
+        type: "PLANNER_RESPONSE",
+        status: "DONE",
+        tool_calls: [
+          {
+            name: "run_command",
+            args: {
+              CommandLine: '"./gradlew test"',
+              IsDaemon: "false",
+              toolSummary: '"Run Gradle tests"',
+            },
+          },
+        ],
+      });
+      appendJsonl(harness.transcriptPath, {
+        step_index: 2,
+        source: "MODEL",
+        type: "GENERIC",
+        status: "RUNNING",
+        content: `Tool is running as a background task with task id: ${harness.sessionId}/task-1\nTask Description: ./gradlew test`,
+      });
+      // Pre-hold assistant message already streamed over ACP; if written near end_turn it must not duplicate.
+      appendJsonl(harness.transcriptPath, {
+        step_index: 3,
+        source: "MODEL",
+        type: "PLANNER_RESPONSE",
+        status: "DONE",
+        content: "Running Gradle tests in the background...",
+      });
+
+      let settled = false;
+      const holdPromise = harness.hooks.holdTurnWhile?.({
+        acpSessionId: harness.sessionId,
+        logger: harness.ctx.logger,
+        signal: new AbortController().signal,
+        sawTimeline: true,
+      })?.then(() => {
+        settled = true;
+      });
+
+      await expect
+        .poll(() =>
+          harness.events.findLast((event) => event.type === "background_work"),
+        )
+        .toEqual({
+          type: "background_work",
+          provider: "antigravity",
+          items: [
+            {
+              id: `${harness.sessionId}/task-1`,
+              kind: "shell",
+              description: "Run Gradle tests",
+              command: "./gradlew test",
+            },
+          ],
+        });
+      expect(harness.hooks.canStopRuntime?.(harness.ctx)).toBe(false);
+      expect(settled).toBe(false);
+
+      // Background task finishes and triggers an unstreamed post-wakeup turn.
+      appendJsonl(harness.transcriptPath, {
+        step_index: 4,
+        source: "SYSTEM",
+        type: "SYSTEM_MESSAGE",
+        status: "DONE",
+        content: `<SYSTEM_MESSAGE>\n[Message] timestamp=2026-11-14T10:10:00Z sender=${harness.sessionId}/task-1 priority=MESSAGE_PRIORITY_HIGH content=Task id "${harness.sessionId}/task-1" finished with result:\nCommand exited with code 0.\n</SYSTEM_MESSAGE>`,
+      });
+      appendJsonl(harness.transcriptPath, {
+        step_index: 5,
+        source: "MODEL",
+        type: "PLANNER_RESPONSE",
+        status: "DONE",
+        thinking: "The Gradle build succeeded; reading summary output.",
+        tool_calls: [
+          {
+            name: "read_file",
+            args: { Path: '"/tmp/report.txt"' },
+          },
+        ],
+      });
+      appendJsonl(harness.transcriptPath, {
+        step_index: 6,
+        source: "MODEL",
+        type: "GENERIC",
+        status: "DONE",
+        content: "42 tests passed",
+      });
+      appendJsonl(harness.transcriptPath, {
+        step_index: 7,
+        source: "MODEL",
+        type: "PLANNER_RESPONSE",
+        status: "DONE",
+        content: "All 42 Gradle tests passed.",
+      });
+
+      await holdPromise;
+      expect(settled).toBe(true);
+      expect(harness.hooks.canStopRuntime?.(harness.ctx)).toBe(true);
+
+      const timelineItems = harness.events
+        .filter(
+          (event): event is Extract<AgentStreamEvent, { type: "timeline" }> =>
+            event.type === "timeline",
+        )
+        .map((event) => event.item);
+
+      expect(timelineItems).not.toContainEqual({
+        type: "assistant_message",
+        text: "Running Gradle tests in the background...",
+      });
+      expect(timelineItems).toContainEqual({
+        type: "reasoning",
+        text: "The Gradle build succeeded; reading summary output.",
+      });
+      expect(timelineItems).toContainEqual(
+        expect.objectContaining({
+          type: "tool_call",
+          name: "read_file",
+          status: "completed",
+          detail: {
+            type: "read",
+            filePath: "/tmp/report.txt",
+            content: "42 tests passed",
+          },
+        }),
+      );
+      expect(timelineItems).toContainEqual({
+        type: "assistant_message",
+        text: "All 42 Gradle tests passed.",
+      });
+      expect(harness.events.findLast((event) => event.type === "background_work")).toEqual({
+        type: "background_work",
+        provider: "antigravity",
+        items: [],
+      });
+    } finally {
+      sessionHandle?.onClose?.();
+    }
+  });
+
+  test("does not hold turns or runtime cleanup for IsDaemon commands", async () => {
+    const harness = createHarness();
+    const sessionHandle = harness.attach();
+    try {
+      harness.setForeground(true);
+      harness.hooks.onForegroundTurnStarting?.(harness.ctx, "start dev server");
+
+      appendJsonl(harness.transcriptPath, {
+        step_index: 1,
+        source: "MODEL",
+        type: "PLANNER_RESPONSE",
+        status: "DONE",
+        tool_calls: [
+          {
+            name: "run_command",
+            args: {
+              CommandLine: '"npm run dev"',
+              IsDaemon: "true",
+              toolSummary: '"Start dev server"',
+            },
+          },
+        ],
+      });
+      appendJsonl(harness.transcriptPath, {
+        step_index: 2,
+        source: "MODEL",
+        type: "GENERIC",
+        status: "RUNNING",
+        content: `Tool is running as a background task with task id: ${harness.sessionId}/task-1\nTask Description: npm run dev`,
+      });
+
+      await harness.hooks.holdTurnWhile?.({
+        acpSessionId: harness.sessionId,
+        logger: harness.ctx.logger,
