+import { statSync } from "node:fs";
+import { open, stat } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { StringDecoder } from "node:string_decoder";
+
+import type { Logger } from "pino";
+
+import type { AgentTimelineItem, ToolCallDetail } from "../../agent-sdk-types.js";
+
+const DEFAULT_ANTIGRAVITY_HOME_SEGMENTS = [".gemini", "antigravity-cli"] as const;
+const MAX_BYTES_PER_READ = 256 * 1024;
+const MAX_PENDING_LINE_BYTES = 4 * 1024 * 1024;
+const FULL_TRANSCRIPT_TAIL_BYTES = 512 * 1024;
+
+export interface AntigravityToolCallEntry {
+  name: string;
+  args: Record<string, unknown> | null;
+}
+
+export interface AntigravityTranscriptRecord {
+  stepIndex: number | null;
+  source: string | null;
+  type: string | null;
+  status: string | null;
+  createdAtMs: number | null;
+  content: string | null;
+  thinking: string | null;
+  error: string | null;
+  inputTokens: number | null;
+  cacheReadTokens: number | null;
+  truncatedFields: string[];
+  toolCalls: AntigravityToolCallEntry[];
+}
+
+export interface ParsedBackgroundTaskSpawn {
+  taskId: string;
+  taskDescription: string;
+}
+
+export interface ParsedSubagentSpawn {
+  conversationId: string;
+}
+
+export function isSafeAntigravitySessionId(sessionId: string): boolean {
+  const trimmed = sessionId.trim();
+  return (
+    trimmed.length > 0 &&
+    !trimmed.includes("/") &&
+    !trimmed.includes("\\") &&
+    !trimmed.includes("..") &&
+    !trimmed.includes("\0")
+  );
+}
+
+export function resolveAntigravityHome(antigravityHome?: string): string {
+  const configured = antigravityHome?.trim() || process.env.ANTIGRAVITY_HOME?.trim();
+  if (configured) {
+    return path.resolve(configured);
+  }
+  return path.join(os.homedir(), ...DEFAULT_ANTIGRAVITY_HOME_SEGMENTS);
+}
+
+export function resolveAntigravityTranscriptPath(
+  sessionId: string,
+  antigravityHome?: string,
+): string | null {
+  if (!isSafeAntigravitySessionId(sessionId)) {
+    return null;
+  }
+  return path.join(
+    resolveAntigravityHome(antigravityHome),
+    "brain",
+    sessionId,
+    ".system_generated",
+    "logs",
+    "transcript.jsonl",
+  );
+}
+
+export function resolveAntigravityFullTranscriptPath(
+  sessionId: string,
+  antigravityHome?: string,
+): string | null {
+  if (!isSafeAntigravitySessionId(sessionId)) {
+    return null;
+  }
+  return path.join(
+    resolveAntigravityHome(antigravityHome),
+    "brain",
+    sessionId,
+    ".system_generated",
+    "logs",
+    "transcript_full.jsonl",
+  );
+}
+
+export function asRecord(value: unknown): Record<string, unknown> | null {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) {
+    return null;
+  }
+  return value as Record<string, unknown>;
+}
+
+export function readString(value: unknown): string | undefined {
+  return typeof value === "string" ? value : undefined;
+}
+
+export function readFiniteNumber(value: unknown): number | null {
+  return typeof value === "number" && Number.isFinite(value) ? value : null;
+}
+
+/**
+ * Antigravity serializes some `tool_calls[].args` string fields with an extra
+ * layer of JSON string quotes (for example `"\"echo hi\""`). Unwrap one layer
+ * when it parses back as a string.
+ */
+export function unwrapAntigravityArgString(value: unknown): string | undefined {
+  if (typeof value !== "string") {
+    return undefined;
+  }
+  const trimmed = value.trim();
+  if (trimmed.length >= 2 && trimmed.startsWith('"') && trimmed.endsWith('"')) {
+    try {
+      const parsed: unknown = JSON.parse(trimmed);
+      if (typeof parsed === "string") {
+        return parsed;
+      }
+    } catch {
+      return value;
+    }
+  }
+  return value;
+}
+
+export function isAntigravityTruthyArg(value: unknown): boolean {
+  if (value === true) {
+    return true;
+  }
+  const unwrapped = unwrapAntigravityArgString(value);
+  return unwrapped !== undefined && unwrapped.trim().toLowerCase() === "true";
+}
+
+export function unwrapAntigravityStringArrayArg(value: unknown): string[] {
+  if (Array.isArray(value)) {
+    return value
+      .map((entry) => unwrapAntigravityArgString(entry))
+      .filter((entry): entry is string => entry !== undefined && entry.length > 0);
+  }
+  const raw = unwrapAntigravityArgString(value);
+  if (raw === undefined) {
+    return [];
+  }
+  const trimmed = raw.trim();
+  if (trimmed.startsWith("[") && trimmed.endsWith("]")) {
+    try {
+      const parsed: unknown = JSON.parse(trimmed);
+      if (Array.isArray(parsed)) {
+        return parsed
+          .map((entry) => unwrapAntigravityArgString(entry))
+          .filter((entry): entry is string => entry !== undefined && entry.length > 0);
+      }
+    } catch {
+      return [];
+    }
+  }
+  return [];
+}
+
+export function parseAntigravityTranscriptLine(line: string): AntigravityTranscriptRecord | null {
+  const trimmed = line.trim();
+  if (trimmed.length === 0) {
+    return null;
+  }
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(trimmed);
+  } catch {
+    return null;
+  }
+  const record = asRecord(parsed);
+  if (record === null) {
+    return null;
+  }
+
+  const createdAtRaw = readString(record.created_at);
+  const parsedTime = createdAtRaw ? Date.parse(createdAtRaw) : Number.NaN;
+  const truncatedFields = Array.isArray(record.truncated_fields)
+    ? record.truncated_fields.filter((entry): entry is string => typeof entry === "string")
+    : [];
+
+  const toolCalls: AntigravityToolCallEntry[] = [];
+  if (Array.isArray(record.tool_calls)) {
+    for (const rawCall of record.tool_calls) {
+      const callObj = asRecord(rawCall);
+      const name = callObj ? readString(callObj.name) : undefined;
+      if (!name) {
+        continue;
+      }
+      toolCalls.push({
+        name,
+        args: asRecord(callObj?.args),
+      });
+    }
+  }
+
+  return {
+    stepIndex: readFiniteNumber(record.step_index),
+    source: readString(record.source) ?? null,
+    type: readString(record.type) ?? null,
+    status: readString(record.status) ?? null,
+    createdAtMs: Number.isFinite(parsedTime) ? parsedTime : null,
+    content: readString(record.content) ?? null,
+    thinking: readString(record.thinking) ?? null,
+    error: readString(record.error) ?? null,
+    inputTokens: readFiniteNumber(record.input_tokens),
+    cacheReadTokens: readFiniteNumber(record.cache_read_tokens),
+    truncatedFields,
+    toolCalls,
+  };
+}
+
+export function parseBackgroundTaskSpawn(content: string | null): ParsedBackgroundTaskSpawn | null {
+  if (!content) {
+    return null;
+  }
+  const match =
+    /Tool is running as a background task with task id:\s*([^\s\r\n]+)(?:\r?\nTask Description:\s*([\s\S]*))?/i.exec(
+      content,
+    );
+  if (!match?.[1]) {
+    return null;
+  }
+  return {
+    taskId: match[1].trim(),
+    taskDescription: (match[2] ?? "").trim(),
+  };
+}
+
+export function parseSubagentSpawn(content: string | null): ParsedSubagentSpawn | null {
+  if (!content) {
+    return null;
+  }
+  const marker = "Created the following subagent:";
+  const idx = content.indexOf(marker);
+  if (idx < 0) {
+    return null;
+  }
+  const after = content.slice(idx + marker.length);
+  const startBrace = after.indexOf("{");
+  if (startBrace < 0) {
+    return null;
+  }
+  let depth = 0;
+  let endBrace = -1;
+  let inString = false;
+  let escaped = false;
+  for (let i = startBrace; i < after.length; i++) {
+    const ch = after[i]!;
+    if (inString) {
+      if (escaped) {
+        escaped = false;
+      } else if (ch === "\\") {
+        escaped = true;
+      } else if (ch === '"') {
+        inString = false;
+      }
+      continue;
+    }
+    if (ch === '"') {
+      inString = true;
+    } else if (ch === "{") {
+      depth++;
+    } else if (ch === "}") {
+      depth--;
+      if (depth === 0) {
+        endBrace = i;
+        break;
+      }
+    }
+  }
+  if (endBrace < 0) {
+    return null;
+  }
+  try {
+    const parsed = asRecord(JSON.parse(after.slice(startBrace, endBrace + 1)));
+    const conversationId = readString(parsed?.conversationId)?.trim();
+    return conversationId ? { conversationId } : null;
+  } catch {
+    return null;
+  }
+}
+
+export function parseSystemMessageSenders(content: string | null): string[] {
+  if (!content) {
+    return [];
+  }
+  const senders: string[] = [];
+  const regex = /\bsender=([^\s\r\n]+)/g;
+  let match: RegExpExecArray | null;
+  while ((match = regex.exec(content)) !== null) {
+    const sender = match[1]?.trim();
+    if (sender && !senders.includes(sender)) {
+      senders.push(sender);
+    }
+  }
+  return senders;
+}
+
+export function computeCheckpointPreTokens(record: AntigravityTranscriptRecord): number | undefined {
+  const input = record.inputTokens ?? 0;
+  const cacheRead = record.cacheReadTokens ?? 0;
+  const total = input + cacheRead;
+  return total > 0 ? total : undefined;
+}
+
+export function buildAntigravityToolDetail(
+  call: AntigravityToolCallEntry,
+  output?: string | null,
+): ToolCallDetail {
+  const args = call.args ?? {};
+  switch (call.name) {
+    case "run_command": {
+      const command = unwrapAntigravityArgString(args.CommandLine) ?? "";
+      return {
+        type: "shell",
+        command,
+        ...(typeof output === "string" ? { output } : {}),
+      };
+    }
+    case "read_file": {
+      const filePath = unwrapAntigravityArgString(args.Path) ?? "";
+      return {
+        type: "read",
+        filePath,
+        ...(typeof output === "string" ? { content: output } : {}),
+      };
+    }
+    case "edit_file": {
+      const filePath = unwrapAntigravityArgString(args.Path) ?? "";
+      const oldString = unwrapAntigravityArgString(args.Target);
+      const newString = unwrapAntigravityArgString(args.Replacement);
+      return {
+        type: "edit",
+        filePath,
+        ...(oldString !== undefined ? { oldString } : {}),
+        ...(newString !== undefined ? { newString } : {}),
+      };
+    }
+    case "write_file": {
+      const filePath = unwrapAntigravityArgString(args.Path) ?? "";
+      const content = unwrapAntigravityArgString(args.Content);
+      return {
+        type: "write",
+        filePath,
+        ...(content !== undefined ? { content } : {}),
+      };
+    }
+    case "search_web": {
+      const query = unwrapAntigravityArgString(args.query) ?? "";
+      return {
+        type: "search",
+        query,
+        toolName: "web_search",
+        ...(typeof output === "string" ? { content: output } : {}),
+      };
+    }
+    case "invoke_subagent": {
+      const subAgentType = unwrapAntigravityArgString(args.TypeName);
+      const description = unwrapAntigravityArgString(args.Role) ?? unwrapAntigravityArgString(args.Prompt);
+      return {
+        type: "sub_agent",
+        ...(subAgentType ? { subAgentType } : {}),
+        ...(description ? { description } : {}),
+      };
+    }
+    default:
+      return {
+        type: "unknown",
+        input: call.args ?? null,
+        output: output ?? null,
+      };
+  }
+}
+
+export function buildAntigravityRunningToolItem(
+  call: AntigravityToolCallEntry,
+  callId: string,
+): Extract<AgentTimelineItem, { type: "tool_call" }> {
+  return {
+    type: "tool_call",
+    callId,
+    name: call.name,
+    detail: buildAntigravityToolDetail(call),
+    status: "running",
+    error: null,
+  };
+}
+
+export function buildAntigravitySettledToolItem(
+  call: AntigravityToolCallEntry,
+  callId: string,
+  failed: boolean,
+  output: string | null,
+): Extract<AgentTimelineItem, { type: "tool_call" }> {
+  if (failed) {
+    return {
+      type: "tool_call",
+      callId,
+      name: call.name,
+      detail: buildAntigravityToolDetail(call, output),
+      status: "failed",
+      error: output ?? "Tool execution failed",
+    };
+  }
+  return {
+    type: "tool_call",
+    callId,
+    name: call.name,
+    detail: buildAntigravityToolDetail(call, output),
+    status: "completed",
+    error: null,
+  };
+}
+
+export interface AntigravityTranscriptLogOptions {
+  sessionId: string;
+  antigravityHome?: string;
+  logger: Logger;
+  onRecord: (record: AntigravityTranscriptRecord) => void | Promise<void>;
+}
+
+/**
+ * Tails `<antigravityHome>/brain/<sessionId>/.system_generated/logs/transcript.jsonl`
+ * starting from the file's size when attached so historical turns are never
+ * replayed as fresh activity.
+ */
+export class AntigravityTranscriptLog {
+  private readonly transcriptPath: string | null;
+  private readonly fullTranscriptPath: string | null;
+  private readonly logger: Logger;
+  private readonly onRecord: (record: AntigravityTranscriptRecord) => void | Promise<void>;
+
+  private offset = 0;
+  private pendingFragment = "";
+  private initializedBaseline = false;
+  private decoder = new StringDecoder("utf8");
+  private reading: Promise<void> | null = null;
+  private stopped = false;
+
+  constructor(options: AntigravityTranscriptLogOptions) {
+    this.transcriptPath = resolveAntigravityTranscriptPath(
+      options.sessionId,
+      options.antigravityHome,
+    );
+    this.fullTranscriptPath = resolveAntigravityFullTranscriptPath(
+      options.sessionId,
+      options.antigravityHome,
+    );
+    this.logger = options.logger;
+    this.onRecord = options.onRecord;
+  }
+
+  /** Capture baseline file size synchronously on session attach. */
+  start(): void {
+    if (this.initializedBaseline || this.stopped) {
+      return;
+    }
+    this.initializedBaseline = true;
+    if (!this.transcriptPath) {
+      return;
+    }
+    try {
+      const stats = statSync(this.transcriptPath);
+      this.offset = stats.size;
+    } catch {
+      this.offset = 0;
+    }
+  }
+
+  stop(): void {
+    this.stopped = true;
+    this.pendingFragment = "";
+  }
+
+  async pollNow(): Promise<void> {
+    if (this.stopped || !this.transcriptPath) {
+      return;
+    }
+    if (!this.initializedBaseline) {
+      this.start();
+    }
+    if (this.reading) {
+      await this.reading;
+      return;
+    }
+    this.reading = this.drainNewLines().finally(() => {
+      this.reading = null;
+    });
+    await this.reading;
+  }
+
+  /**
+   * Resolves a full `PLANNER_RESPONSE` record from `transcript_full.jsonl` when
+   * `transcript.jsonl` had a field truncated. Scans only the tail window so
+   * multi-megabyte logs stay bounded.
+   */
+  async readFullRecordForStep(stepIndex: number): Promise<AntigravityTranscriptRecord | null> {
+    if (!this.fullTranscriptPath) {
+      return null;
+    }
+    try {
+      const stats = await stat(this.fullTranscriptPath);
+      if (stats.size <= 0) {
+        return null;
+      }
+      const start = Math.max(0, stats.size - FULL_TRANSCRIPT_TAIL_BYTES);
+      const length = stats.size - start;
+      const handle = await open(this.fullTranscriptPath, "r");
+      try {
+        const buffer = Buffer.allocUnsafe(length);
+        const { bytesRead } = await handle.read(buffer, 0, length, start);
+        let text = buffer.subarray(0, bytesRead).toString("utf8");
+        if (start > 0) {
+          const firstNewline = text.indexOf("\n");
+          if (firstNewline >= 0) {
+            text = text.slice(firstNewline + 1);
+          }
+        }
+        for (const rawLine of text.split(/\r?\n/)) {
+          const parsed = parseAntigravityTranscriptLine(rawLine);
+          if (parsed && parsed.stepIndex === stepIndex) {
+            return parsed;
+          }
+        }
+        return null;
+      } finally {
+        await handle.close();
+      }
+    } catch {
+      return null;
+    }
+  }
+
+  private async drainNewLines(): Promise<void> {
+    if (!this.transcriptPath || this.stopped) {
+      return;
+    }
+    let fileSize: number;
+    try {
+      const stats = await stat(this.transcriptPath);
+      fileSize = stats.size;
+    } catch (error) {
+      const code = (error as NodeJS.ErrnoException).code;
+      if (code === "ENOENT") {
+        return;
+      }
+      this.logger.warn(
+        { err: error, path: this.transcriptPath },
+        "Antigravity transcript stat failed",
+      );
+      return;
+    }
+
+    if (fileSize < this.offset) {
+      // Truncation/rotation recovery.
+      this.offset = 0;
+      this.pendingFragment = "";
+      this.decoder = new StringDecoder("utf8");
+    }
+
+    while (!this.stopped && this.offset < fileSize) {
+      const bytesToRead = Math.min(MAX_BYTES_PER_READ, fileSize - this.offset);
+      const buffer = Buffer.allocUnsafe(bytesToRead);
+      let bytesRead = 0;
+      const handle = await open(this.transcriptPath, "r");
+      try {
+        const result = await handle.read(buffer, 0, bytesToRead, this.offset);
+        bytesRead = result.bytesRead;
+      } finally {
+        await handle.close();
+      }
+      if (bytesRead <= 0) {
+        break;
+      }
+      this.offset += bytesRead;
+      const chunk = this.decoder.write(buffer.subarray(0, bytesRead));
+      await this.consumeTextChunk(chunk);
+    }
+  }
+
+  private async consumeTextChunk(chunk: string): Promise<void> {
+    const combined = this.pendingFragment + chunk;
+    const endsWithNewline = combined.endsWith("\n");
+    const lines = combined.split(/\r?\n/);
+    if (endsWithNewline) {
+      this.pendingFragment = "";
+      if (lines.length > 0 && lines[lines.length - 1] === "") {
+        lines.pop();
+      }
+    } else {
+      const tail = lines.pop() ?? "";
+      this.pendingFragment = Buffer.byteLength(tail, "utf8") > MAX_PENDING_LINE_BYTES ? "" : tail;
+    }
+
+    for (const rawLine of lines) {
+      if (this.stopped) {
+        return;
+      }
+      let record = parseAntigravityTranscriptLine(rawLine);
+      if (!record) {
+        continue;
+      }
+      if (
+        record.type === "PLANNER_RESPONSE" &&
+        record.stepIndex !== null &&
+        record.truncatedFields.some((f) => f === "content" || f === "thinking")
+      ) {
+        const full = await this.readFullRecordForStep(record.stepIndex);
+        if (full) {
+          record = full;
+        }
+      }
+      await this.onRecord(record);
+    }
+  }
+}
