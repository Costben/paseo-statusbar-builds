+import {
+  AntigravityTranscriptLog,
+  buildAntigravityRunningToolItem,
+  buildAntigravitySettledToolItem,
+  computeCheckpointPreTokens,
+  isAntigravityTruthyArg,
+  parseBackgroundTaskSpawn,
+  parseSubagentSpawn,
