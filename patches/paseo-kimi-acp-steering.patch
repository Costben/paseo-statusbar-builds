+      expect(harness.prompt).toHaveBeenCalledTimes(1);
+
+      await harness.append(...promptRun(1, "FIRST"));
+      first.release();
+      const started = await harness.waitFor(
+        (event) => event.type === "turn_started" && event.turnId !== firstTurnId,
