+  /** Make the harness agent advertise `_session/steering`, answered by `extMethod`. */
+  function enableSteering(harness: KimiLogHarness, extMethod: ReturnType<typeof vi.fn>): void {
+    const internals = asInternals<{ agentSteers: boolean; connection: Record<string, unknown> }>(
+      harness.session,
+    );
+    internals.agentSteers = true;
+    internals.connection.extMethod = extMethod;
+  }
+
+  function steeredTexts(extMethod: ReturnType<typeof vi.fn>): string[] {
+    return extMethod.mock.calls.map((call) => {
+      const request = call[1] as { prompt: Array<{ text?: string }> };
+      return request.prompt.map((block) => block.text ?? "").join("");
+    });
+  }
+
+  test("injects a steer into Paseo's own turn when Kimi advertises _session/steering", async () => {
+    const harness = await createKimiLogHarness();
+    try {
+      const first = gatedPrompt();
+      harness.prompt.mockImplementationOnce(() => first.response);
+      const extMethod = vi.fn(async () => ({ outcome: "injected" }));
+      enableSteering(harness, extMethod);
+      const { turnId } = await harness.session.startTurn("FIRST");
+
+      const result = await harness.session.steerActiveTurn!("follow-up", {
+        expectedTurnId: turnId,
+      });
+
+      expect(result).toEqual({ status: "accepted" });
+      expect(extMethod).toHaveBeenCalledWith(
+        "_session/steering",
+        expect.objectContaining({ sessionId: "session_unstreamed-test" }),
+      );
+      expect(steeredTexts(extMethod)).toEqual([expect.stringContaining("follow-up")]);
+
+      await harness.append(...promptRun(1, "FIRST"));
+      first.release();
+      await harness.waitFor((event) => event.type === "turn_completed" && event.turnId === turnId);
+      await new Promise((resolve) => setTimeout(resolve, 50));
+
+      // The message went into the running turn, so nothing is held for after it.
+      expect(harness.prompt).toHaveBeenCalledTimes(1);
+      expect(turnStartCount(harness.events)).toBe(1);
+      expect(harness.cancel).not.toHaveBeenCalled();
+    } finally {
+      await harness.dispose();
+    }
+  });
+
