@@ -0,0 +1,134 @@
+import type { Logger } from "pino";
+
+import {
+  isAgentGoalLive,
+  type AgentGoal,
+  type AgentProvider,
+  type AgentStreamEvent,
+} from "../../agent-sdk-types.js";
+import { KimiSessionLog } from "./session-log.js";
+
+/**
+ * Native goal/usage/subagent bridge for one live Kimi ACP session.
+ *
+ * Kimi keeps driving a goal after the ACP prompt returns, and the ACP stream
+ * carries no goal state. The daemon used to read a `kimi web` HTTP sidecar, but
+ * that server materializes a *separate, empty runtime* for a session another
+ * process owns: goals written there are invisible to the talking agent, and the
+ * agent's own goals never appear there.
+ *
+ * The session's append-only log file is the only cross-process truth, so the
+ * bridge tails `agents/main/wire.jsonl` and derives the goal and the subagent
+ * registry from it. There is deliberately no control API: the daemon cannot
+ * mutate a goal it does not own, so control commands are rewritten into prompts
+ * instead.
+ */
+export interface KimiNativeBridgeOptions {
+  kimiSessionId: string;
+  kimiHome?: string;
+  logger: Logger;
+  /** Overrides both poll cadences; see `KimiSessionLog`. */
+  pollIntervalMs?: number;
+  /** Push a provider stream event into the owning ACP session. */
+  emit: (event: AgentStreamEvent) => void;
+  /** Provider id, for the events' `provider` field. */
+  provider: AgentProvider;
+}
+
+export class KimiNativeBridge {
+  private readonly log: KimiSessionLog;
+  private readonly emit: (event: AgentStreamEvent) => void;
+  private readonly provider: AgentProvider;
+  private started = false;
+  private stopped = false;
+  private promptBaseline: number | null = null;
+
+  constructor(options: KimiNativeBridgeOptions) {
+    this.emit = options.emit;
+    this.provider = options.provider;
+    this.log = new KimiSessionLog({
+      kimiSessionId: options.kimiSessionId,
+      kimiHome: options.kimiHome,
+      logger: options.logger,
+      pollIntervalMs: options.pollIntervalMs,
+      onGoal: (goal) => {
+        this.emit({ type: "goal_updated", provider: this.provider, goal });
+      },
+      onUsage: (usage) => {
+        this.emit({ type: "usage_updated", provider: this.provider, usage });
+      },
+      onSubagent: (event) => {
+        this.emit({ type: "provider_subagent", provider: this.provider, event });
+      },
+      onBackgroundTasks: (backgroundTasks) => {
+        this.emit({ type: "background_tasks_updated", provider: this.provider, backgroundTasks });
+      },
+    });
+  }
+
+  /** Idempotent. Starts tailing the session log. */
+  start(): void {
+    if (this.started || this.stopped) {
+      return;
+    }
+    this.started = true;
+    this.log.start();
+  }
+
+  /** Idempotent. Stops tailing the session log. */
+  stop(): void {
+    if (this.stopped) {
+      return;
+    }
+    this.stopped = true;
+    this.log.stop();
+  }
+
+  /** Latest known goal, or null. */
+  getGoal(): AgentGoal | null {
+    return this.log.getGoal();
+  }
+
+  /** True while the provider is still working toward the goal. */
+  isGoalLive(): boolean {
+    return isAgentGoalLive(this.log.getGoal());
+  }
+
+  /** True while the runtime is inside a turn it has not ended yet. */
+  isTurnInProgress(): boolean {
+    return this.log.isTurnInProgress();
+  }
+
+  /** Resolves when the goal stops being live, after `timeoutMs`, or on abort. */
+  async waitForGoalSettled(timeoutMs: number, signal?: AbortSignal): Promise<void> {
+    if (this.stopped) {
+      return;
+    }
+    await this.log.waitForSettled(timeoutMs, signal);
+  }
+
+  /** Resolves when the runtime's turn ends, after `timeoutMs`, or on abort. */
+  async waitForTurnSettled(timeoutMs: number, signal?: AbortSignal): Promise<void> {
+    if (this.stopped) {
+      return;
+    }
+    await this.log.waitForTurnSettled(timeoutMs, signal);
+  }
+
+  /**
+   * Records how many prompts the session had accepted, so a later
+   * `wasPromptAccepted()` can tell whether the prompt just sent ever landed.
+   */
+  markPromptSubmitted(): void {
+    this.promptBaseline = this.log.getAcceptedPromptCount();
+  }
+
+  /**
+   * True when the session accepted a prompt since `markPromptSubmitted()`, or
+   * when no baseline was taken: an unknown baseline must not accuse the runtime
+   * of dropping a prompt.
+   */
+  wasPromptAccepted(): boolean {
+    return this.promptBaseline === null || this.log.getAcceptedPromptCount() > this.promptBaseline;
+  }
+}
