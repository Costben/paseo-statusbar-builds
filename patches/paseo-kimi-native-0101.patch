+function finishKimiLogDraft(draft: KimiLogDraft): KimiSessionLogState {
+  return {
+    goal: draft.goal,
+    contextWindowUsedTokens: draft.contextWindowUsedTokens,
+    modelAlias: draft.modelAlias,
+    goalInputTokens: draft.goalInputTokens,
+    goalCachedInputTokens: draft.goalCachedInputTokens,
+    subagents: [...draft.subagents.values()],
+    backgroundTasks: [...draft.backgroundTasks.values()],
+    turnGeneration: draft.turnGeneration,
+    settledThroughTurn: draft.settledThroughTurn,
+    acceptedPromptCount: draft.acceptedPromptCount,
