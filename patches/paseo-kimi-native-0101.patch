+interface KimiTaskFileRecord {
+  taskId?: string;
+  description?: string;
+  status?: string;
+  command?: string;
+  startedAt?: number;
+  pid?: number;
+}
+
+export function readRunningTasksFromSessionDir(sessionDir: string): AgentBackgroundTask[] {
+  const tasksDir = path.join(sessionDir, "agents", "main", "tasks");
+  if (!existsSync(tasksDir)) {
+    return [];
+  }
+  let entries: string[];
+  try {
+    entries = readdirSync(tasksDir);
+  } catch {
+    return [];
+  }
+  const runningTasks: AgentBackgroundTask[] = [];
+  for (const entry of entries) {
+    if (!entry.endsWith(".json")) continue;
+    try {
+      const fullPath = path.join(tasksDir, entry);
+      const content = readFileSync(fullPath, "utf8");
+      const record = JSON.parse(content) as KimiTaskFileRecord;
+      if (record && record.status === "running") {
+        runningTasks.push({
+          id: record.taskId || path.basename(entry, ".json"),
+          command: record.command ?? null,
+          description: record.description ?? null,
+          status: "running",
+          startedAt: record.startedAt ?? null,
+          pid: record.pid,
+        });
+      }
+    } catch {
+      // Ignore reading / parsing errors on partially written files
+    }
+  }
+  return runningTasks;
+}
