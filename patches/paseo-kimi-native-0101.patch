+ * registries stay maps here so a lifecycle record updates its entry in place and
+ * the iteration order stays the spawn order; both are flattened on the way out.
+ */
+interface KimiLogDraft {
+  goal: AgentGoal | null;
+  contextWindowUsedTokens: number | null;
+  modelAlias: string | null;
+  goalInputTokens: number | null;
+  goalCachedInputTokens: number | null;
+  turnGeneration: number;
+  settledThroughTurn: number;
+  acceptedPromptCount: number;
+  readonly subagents: Map<string, KimiSubagentRecord>;
+  readonly backgroundTasks: Map<string, KimiBackgroundTaskRecord>;
+}
