+      signal.addEventListener("abort", () => resolve(), { once: true });
+    });
+    await Promise.race([abortPromise, this.pollUntilSettled(isPending, deadline, signal)]);
+  }
+
+  /** Re-check every second until `isPending` is false, the deadline passes, or the signal aborts. */
+  private async pollUntilSettled(
+    isPending: () => boolean,
+    deadline: number,
+    signal?: AbortSignal,
+  ): Promise<void> {
