+
+  test("re-reads config.toml only after its mtime changes", async () => {
+    const { home, file } = createSessionHome(SESSION_ID);
+    const configPath = writeKimiConfig(home, configFor(MODEL_ALIAS, 300_000));
+    setConfigMtime(configPath, CONFIG_MTIME);
