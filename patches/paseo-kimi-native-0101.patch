+      file,
+      `${profileBindLine(MODEL_ALIAS)}\n${usageRecordLine({ inputOther: 22063, inputCacheRead: 28456, inputCacheCreation: 0, output: 310 })}\n`,
+    );
+
+    const usage: AgentUsage[] = [];
