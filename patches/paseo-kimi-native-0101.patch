+      break;
+    case "agent.turn.ended":
+      // A turn ending proves its own turn is over.
+      draft.settledThroughTurn = Math.max(draft.settledThroughTurn, draft.turnGeneration);
+      demoteSettledSubagents(draft.subagents, draft.settledThroughTurn);
+      break;
+    case "subagent.spawned":
+      applySubagentSpawn(draft.subagents, entry, draft.turnGeneration);
+      trackBackgroundTask(draft.backgroundTasks, entry);
+      break;
+    case "subagent.started":
+      applySubagentStarted(draft.subagents, entry, draft.turnGeneration);
+      break;
+    case "subagent.completed":
+      applySubagentTerminal(draft.subagents, entry, "completed", draft.turnGeneration);
+      updateBackgroundTask(draft.backgroundTasks, entry, "completed");
+      break;
+    case "subagent.cancelled":
