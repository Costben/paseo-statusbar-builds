@@ -0,0 +1,137 @@
+import { describe, expect, it } from "vitest";
+import {
+  formatCompactTokens,
+  formatFullTokens,
+  formatGoalElapsed,
+  formatGoalInputUsage,
+  formatGoalUsageSuffix,
+  resolveGoalStatusLabel,
+  resolveGoalUsageHints,
+} from "./goal-pill";
+
+describe("resolveGoalUsageHints", () => {
+  it("says Kimi does not report a goal's turn count", () => {
+    expect(resolveGoalUsageHints("kimi").turns).toContain("Kimi 不提供这个数");
+  });
+
+  it("does not describe a Claude goal with Kimi's wording", () => {
+    const hints = resolveGoalUsageHints("claude");
+
+    expect(hints.turns).not.toContain("Kimi");
+    expect(hints.tokens).not.toContain("Kimi");
+    expect(hints.turns).toContain("Claude 只在评估目标时报自己的计数");
+  });
+
+  it("has wording for a provider it does not know", () => {
+    const hints = resolveGoalUsageHints("codex");
+
+    expect(hints.turns.length).toBeGreaterThan(0);
+    expect(hints.tokens.length).toBeGreaterThan(0);
+    expect(hints.turns).not.toContain("Kimi");
+  });
+
+  it("has wording for a goal with no provider at all", () => {
+    expect(resolveGoalUsageHints(undefined).turns).not.toContain("Kimi");
+  });
+});
+
+describe("resolveGoalStatusLabel", () => {
+  it.each([
+    ["active", "目标进行中"],
+    ["paused", "目标已暂停"],
+    ["blocked", "目标受阻"],
+    ["complete", "目标已完成"],
+    ["cleared", "目标已清除"],
+  ] as const)("labels %s", (status, label) => {
+    expect(resolveGoalStatusLabel(status)).toBe(label);
+  });
+});
+
+describe("formatCompactTokens", () => {
+  it.each([
+    [0, "0"],
+    [-1, "0"],
+    [999, "999"],
+    [12_300, "12.3K"],
+    [100_000, "100K"],
+    [1_234_567, "1.2M"],
+  ] as const)("formats %i as %s", (tokens, expected) => {
+    expect(formatCompactTokens(tokens)).toBe(expected);
+  });
+});
+
+describe("formatFullTokens", () => {
+  it.each([
+    [0, "0"],
+    [-1, "0"],
+    [999, "999"],
+    [12_300, "12,300"],
+    [1_234_567, "1,234,567"],
+  ] as const)("formats %i as %s", (tokens, expected) => {
+    expect(formatFullTokens(tokens)).toBe(expected);
+  });
+});
+
+describe("formatGoalUsageSuffix", () => {
+  it("joins turns and tokens", () => {
+    expect(formatGoalUsageSuffix(3, 12_300)).toBe("· 3 回合 · 12.3K");
+  });
+
+  it("drops the side that is zero", () => {
+    expect(formatGoalUsageSuffix(2, 0)).toBe("· 2 回合");
+    expect(formatGoalUsageSuffix(0, 500)).toBe("· 500");
+  });
+
+  it("appends the input side when the log carried one", () => {
+    expect(formatGoalUsageSuffix(3, 12_300, 1_200_000)).toBe("· 3 回合 · 12.3K · IN 1.2M");
+  });
+
+  it("leaves the suffix alone when there is no input count", () => {
+    expect(formatGoalUsageSuffix(3, 12_300, 0)).toBe("· 3 回合 · 12.3K");
+  });
+
+  it("returns null when the goal has no usage yet", () => {
+    expect(formatGoalUsageSuffix(0, 0)).toBeNull();
+  });
+});
+
+describe("formatGoalInputUsage", () => {
+  it("shows the summed input with the exact count", () => {
+    const usage = formatGoalInputUsage(1_203_194, undefined);
+    expect(usage?.value).toBe("1.2M tokens");
+    expect(usage?.hint).toContain("1,203,194");
+    expect(usage?.hint).toContain("每次请求都计入");
+  });
+
+  it("names the cache-read part when there was one", () => {
+    const usage = formatGoalInputUsage(1_203_194, 1_108_328);
+    expect(usage?.hint).toContain("其中缓存 1,108,328");
+  });
+
+  it("omits the cache note when nothing was cached", () => {
+    const usage = formatGoalInputUsage(1_203_194, 0);
+    expect(usage?.hint).not.toContain("缓存");
+  });
+
+  it("has nothing to show without an input count", () => {
+    expect(formatGoalInputUsage(undefined, undefined)).toBeNull();
+    expect(formatGoalInputUsage(0, 0)).toBeNull();
+  });
+});
+
+describe("formatGoalElapsed", () => {
+  const NOW = 1_790_500_000_000;
+
+  it("measures up to the end mark once the goal has ended", () => {
+    expect(formatGoalElapsed(NOW - 90_000, NOW - 30_000, NOW)).toBe("1m");
+  });
+
+  it("measures up to now while the goal is still running", () => {
+    expect(formatGoalElapsed(NOW - 45_000, null, NOW)).toBe("45s");
+    expect(formatGoalElapsed(NOW - 45_000, undefined, NOW)).toBe("45s");
+  });
+
+  it("has nothing to show without a start mark", () => {
+    expect(formatGoalElapsed(undefined, null, NOW)).toBeNull();
+  });
+});
diff --git a/packages/app/src/composer/goal-pill.tsx b/packages/app/src/composer/goal-pill.tsx
