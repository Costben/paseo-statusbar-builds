@@ -0,0 +1,175 @@
+import { useCallback, type ReactElement } from "react";
+import { Text, View } from "react-native";
+import { Terminal } from "lucide-react-native";
+import { StyleSheet, withUnistyles } from "react-native-unistyles";
+import type { AgentBackgroundTasksPayload } from "@getpaseo/protocol/messages";
+import {
+  MenuRoot,
+  MenuSurface,
+  MenuTrigger,
+  menuRowContentInset,
+  type MenuTriggerState,
+} from "@/components/ui/menu";
+import { formatDuration } from "@/utils/time";
+
+const ThemedTerminal = withUnistyles(Terminal);
+
+const blueMapping = () => ({ color: "#3b82f6" });
+
+const taskPillStyles = StyleSheet.create((theme) => ({
+  pill: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: 4,
+    minHeight: 24,
+    paddingHorizontal: 8,
+    paddingVertical: 2,
+    borderRadius: 9999,
+    borderWidth: 1,
+    borderColor: theme.colors.borderAccent,
+    backgroundColor: theme.colors.surface1,
+    minWidth: 0,
+    flexShrink: 0,
+  },
+  pillActive: {
+    backgroundColor: theme.colors.surface2,
+  },
+  count: {
+    color: "#3b82f6",
+    fontSize: 12,
+    fontWeight: theme.fontWeight.medium,
+    lineHeight: 14,
+  },
+  detailContainer: {
+    paddingVertical: theme.spacing[2],
+    gap: theme.spacing[2],
+  },
+  taskItem: {
+    paddingHorizontal: menuRowContentInset(theme),
+    paddingVertical: theme.spacing[2],
+    borderBottomWidth: StyleSheet.hairlineWidth,
+    borderBottomColor: theme.colors.border,
+    gap: 4,
+  },
+  taskHeader: {
+    flexDirection: "row",
+    alignItems: "center",
+    justifyContent: "space-between",
+  },
+  taskId: {
+    fontSize: 11,
+    fontWeight: theme.fontWeight.medium,
+    color: "#3b82f6",
+    fontFamily: theme.fontFamily.mono,
+  },
+  taskElapsed: {
+    fontSize: 11,
+    color: theme.colors.foregroundExtraMuted,
+  },
+  taskCommand: {
+    fontSize: 12,
+    color: theme.colors.foreground,
+    fontFamily: theme.fontFamily.mono,
+  },
+  taskDesc: {
+    fontSize: 12,
+    color: theme.colors.foregroundMuted,
+  },
+  emptyText: {
+    paddingHorizontal: menuRowContentInset(theme),
+    paddingVertical: theme.spacing[3],
+    color: theme.colors.foregroundMuted,
+    fontSize: 12,
+  },
+}));
+
+interface BackgroundTaskPillProps {
+  backgroundTasks?: AgentBackgroundTasksPayload | null;
+}
+
+export function BackgroundTaskPill({
+  backgroundTasks,
+}: BackgroundTaskPillProps): ReactElement | null {
+  if (!backgroundTasks || backgroundTasks.count <= 0) {
+    return null;
+  }
+
+  return (
+    <MenuRoot compactMode="sheet">
+      <BackgroundTaskPillTrigger count={backgroundTasks.count} />
+      <MenuSurface
+        side="top"
+        align="start"
+        offset={6}
+        sheetTitle={`后台任务 (${backgroundTasks.count})`}
+        minWidth={280}
+        maxWidth={460}
+        maxHeight={400}
+        scrollable
+        testID="composer-background-task-panel"
+      >
+        <BackgroundTaskDetail tasks={backgroundTasks.tasks} />
+      </MenuSurface>
+    </MenuRoot>
+  );
+}
+
+function BackgroundTaskPillTrigger({ count }: { count: number }): ReactElement {
+  const pillStyle = useCallback(
+    ({ hovered, pressed, open }: MenuTriggerState) => [
+      taskPillStyles.pill,
+      (hovered || pressed || open) && taskPillStyles.pillActive,
+    ],
+    [],
+  );
+
+  return (
+    <MenuTrigger
+      testID="composer-background-task-pill"
+      accessibilityRole="button"
+      accessibilityLabel={`后台任务: ${count} 个运行中`}
+      style={pillStyle}
+    >
+      <ThemedTerminal size={13} uniProps={blueMapping} />
+      <Text style={taskPillStyles.count}>{count}</Text>
+    </MenuTrigger>
+  );
+}
+
+function BackgroundTaskDetail({
+  tasks,
+}: {
+  tasks: AgentBackgroundTasksPayload["tasks"];
+}): ReactElement {
+  if (tasks.length === 0) {
+    return <Text style={taskPillStyles.emptyText}>当前没有正在运行的后台任务</Text>;
+  }
+
+  const now = Date.now();
+
+  return (
+    <View style={taskPillStyles.detailContainer}>
+      {tasks.map((task) => {
+        const elapsed = task.startedAt ? formatDuration(now - task.startedAt) : null;
+        return (
+          <View key={task.id} style={taskPillStyles.taskItem}>
+            <View style={taskPillStyles.taskHeader}>
+              <Text style={taskPillStyles.taskId}>{task.id}</Text>
+              {elapsed ? <Text style={taskPillStyles.taskElapsed}>已运行 {elapsed}</Text> : null}
+            </View>
+            {task.description ? (
+              <Text style={taskPillStyles.taskDesc} numberOfLines={2}>
+                {task.description}
+              </Text>
+            ) : null}
+            {task.command ? (
+              <Text style={taskPillStyles.taskCommand} numberOfLines={3}>
+                {task.command}
+              </Text>
+            ) : null}
+          </View>
+        );
+      })}
+    </View>
+  );
+}
diff --git a/packages/app/src/composer/goal-pill.browser.test.tsx b/packages/app/src/composer/goal-pill.browser.test.tsx
new file mode 100644
index 0000000..1f04f67
--- /dev/null
+++ b/packages/app/src/composer/goal-pill.browser.test.tsx
@@ -0,0 +1,168 @@
+import React, { act, type ReactNode } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { AgentGoalPayload } from "@getpaseo/protocol/messages";
+import { GoalPill } from "./goal-pill";
+
+// App sources compile against the classic JSX runtime, which expects React on the global.
+beforeEach(() => vi.stubGlobal("React", React));
+
+/**
+ * The real menu engine in a real browser: the pill only becomes a trigger there, and the panel is
+ * a portal, so a jsdom run would prove neither.
+ */
+
+const PANEL = "composer-goal-pill-panel";
+const STARTED_AT = Date.now() - 3_600_000;
+const ENDED_AT = STARTED_AT + 900_000;
+
+const GOAL: AgentGoalPayload = {
+  goalId: "goal-1",
+  objective: "在当前目录创建 goal-ok.txt 并写入 hello",
+  completionCriterion: "goal-ok.txt 存在，且内容为 hello",
+  status: "active",
+  turnsUsed: 7,
+  tokensUsed: 136_400,
+  inputTokens: 6_398_865,
+  startedAt: STARTED_AT,
+  updatedAt: STARTED_AT + 60_000,
+};
+
+/** A goal whose log carried cache reads, which the input row has to name. */
+const CACHED_GOAL: AgentGoalPayload = {
+  ...GOAL,
+  inputTokens: 1_203_194,
+  cachedInputTokens: 1_108_328,
+};
+/** A goal whose log carried no input measurement at all. */
+const OUTPUT_ONLY_GOAL: AgentGoalPayload = { ...GOAL, inputTokens: undefined };
+
+const CLEARED_GOAL: AgentGoalPayload = { ...GOAL, status: "cleared", endedAt: ENDED_AT };
+/** A goal whose create record carried no `time`, which the panel has to render without a start. */
+const UNSTARTED_GOAL: AgentGoalPayload = { ...GOAL, startedAt: undefined };
+
+interface Mounted {
+  root: Root;
+  container: HTMLDivElement;
+}
+
+const mounted: Mounted[] = [];
+
+function mount(node: ReactNode): void {
+  const container = document.createElement("div");
+  document.body.appendChild(container);
+  const root = createRoot(container);
+  act(() => root.render(node));
+  mounted.push({ root, container });
+}
+
+afterEach(() => {
+  for (const entry of mounted.splice(0)) {
+    act(() => entry.root.unmount());
+    entry.container.remove();
+  }
+});
+
+function element(testID: string): HTMLElement | null {
+  const found = document.querySelector(`[data-testid="${testID}"]`);
+  return found instanceof HTMLElement ? found : null;
+}
+
+function pill(): HTMLElement {
+  const trigger = element("composer-goal-pill");
+  if (trigger === null) {
+    throw new Error("goal pill did not render");
+  }
+  return trigger;
+}
+
+function openPanel(): void {
+  act(() => {
+    pill().click();
+  });
+}
+
+function fieldText(name: string): string | null {
+  return element(`${PANEL}-${name}`)?.textContent ?? null;
+}
+
+describe("goal pill detail panel", () => {
+  it("opens the details the pill has no room for", () => {
+    mount(<GoalPill goal={GOAL} provider="kimi" />);
+
+    expect(pill().textContent).toContain("目标进行中");
+    expect(pill().textContent).toContain("· 7 回合 · 136K · 入 6.4M");
+    expect(pill().getAttribute("aria-expanded")).toBe("false");
+    expect(element(PANEL)).toBeNull();
+
+    openPanel();
+
+    expect(pill().getAttribute("aria-expanded")).toBe("true");
+    expect(fieldText("objective")).toContain("goal-ok.txt");
+    expect(fieldText("criterion")).toContain("内容为 hello");
+    expect(fieldText("turns")).toContain("7 回合");
+    expect(fieldText("turns")).toContain("Paseo 按会话日志统计");
+    expect(fieldText("tokens")).toContain("136K tokens");
+    expect(fieldText("tokens")).toContain("136,400");
+    expect(fieldText("input-tokens")).toContain("6.4M tokens");
+    expect(fieldText("input-tokens")).toContain("6,398,865");
+    expect(fieldText("elapsed")).toBe("已跑1h");
+    expect(fieldText("started")).not.toBeNull();
+    expect(element(`${PANEL}-ended`)).toBeNull();
+  });
+
+  it("names the cache-read part of the input when the log reported one", () => {
+    mount(<GoalPill goal={CACHED_GOAL} />);
+    openPanel();
+
+    expect(fieldText("input-tokens")).toContain("1.2M tokens");
+    expect(fieldText("input-tokens")).toContain("其中缓存 1,108,328");
+  });
+
+  it("drops the input row when the log carried no input measurement", () => {
+    mount(<GoalPill goal={OUTPUT_ONLY_GOAL} />);
+
+    expect(pill().textContent).not.toContain("入 ");
+    openPanel();
+
+    expect(element(`${PANEL}-input-tokens`)).toBeNull();
+    expect(fieldText("tokens")).toContain("136K tokens");
+  });
+
+  it("keeps a finished goal readable after it is cleared", () => {
+    mount(<GoalPill goal={CLEARED_GOAL} />);
+
+    expect(pill().textContent).toContain("目标已清除");
+    openPanel();
+
+    expect(fieldText("elapsed")).toBe("已跑15m");
+    expect(fieldText("ended")).not.toBeNull();
+  });
+
+  it("drops the elapsed rows when the log never recorded a start", () => {
+    mount(<GoalPill goal={UNSTARTED_GOAL} />);
+    openPanel();
+
+    expect(element(`${PANEL}-started`)).toBeNull();
+    expect(element(`${PANEL}-elapsed`)).toBeNull();
+  });
+
+  it("renders nothing without a goal", () => {
+    mount(<GoalPill goal={null} provider="claude" />);
+
+    expect(element("composer-goal-pill")).toBeNull();
+  });
+
+  it("describes a Claude goal in Claude's terms, not Kimi's", () => {
+    mount(<GoalPill goal={GOAL} provider="claude" />);
+    openPanel();
+
+    expect(fieldText("turns")).toContain("7 回合");
+    expect(fieldText("turns")).toContain("Claude 只在评估目标时报自己的计数");
+    expect(fieldText("tokens")).toContain("Paseo 按响应累计的输出 token");
+    // Kimi's wording belongs to Kimi: it says Kimi reports the number, which is
+    // the opposite of what a Claude goal is.
+    expect(fieldText("turns")).not.toContain("Kimi");
+    expect(fieldText("tokens")).not.toContain("Kimi");
+  });
+});
diff --git a/packages/app/src/composer/goal-pill.test.ts b/packages/app/src/composer/goal-pill.test.ts
