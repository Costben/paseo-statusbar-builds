+  switch (entry.type) {
+    case "goal.create":
+      draft.goal = createGoalFromRecord(entry);
+      // A new goal starts its own input tally; the previous goal's total is
+      // already on the goal the client is showing.
+      draft.goalInputTokens = 0;
+      draft.goalCachedInputTokens = 0;
+      break;
+    case "goal.update":
+      draft.goal = applyGoalUpdate(draft.goal, entry);
+      break;
+    case "goal.clear":
