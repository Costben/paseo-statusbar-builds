+    subagents.set(subagent.id, subagent);
+  }
+  const backgroundTasks = new Map<string, KimiBackgroundTaskRecord>();
+  for (const task of previous.backgroundTasks) backgroundTasks.set(task.id, task);
+  return {
+    goal: previous.goal,
+    contextWindowUsedTokens: previous.contextWindowUsedTokens,
+    modelAlias: previous.modelAlias,
+    goalInputTokens: previous.goalInputTokens,
+    goalCachedInputTokens: previous.goalCachedInputTokens,
+    turnGeneration: previous.turnGeneration,
+    settledThroughTurn: previous.settledThroughTurn,
+    acceptedPromptCount: previous.acceptedPromptCount,
+    subagents,
+    backgroundTasks,
+  };
+}
