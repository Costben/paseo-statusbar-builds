+/** Claude Code reads a `[1m]` suffix on a model id as "this session runs with a 1M window". */
+const CLAUDE_LONG_CONTEXT_MODEL_ID_PATTERN = /\[1m\]/i;
+const CLAUDE_LONG_CONTEXT_WINDOW_TOKENS = 1_000_000;
+
+/**
+ * The context window Claude Code will use for a model id the manifest does not know.
+ *
+ * Claude Code reports the window only in a turn's result (`modelUsage`), so a fresh session with a
+ * gateway model — `deepseek-flash` behind `ANTHROPIC_BASE_URL`, say — has no window until its first
+ * turn ends, and the composer draws an empty meter for that whole turn. Claude Code computes the
+ * value itself from the model id and the environment, so the daemon can compute the same value up
+ * front instead of waiting to be told.
+ *
+ * `env` must be the environment the Claude Code process runs with, with settings.json's own `env`
+ * merged over it: Claude Code applies its settings over the process env, so a value written there
+ * wins over one the daemon passed.
+ */
+export function resolveClaudeContextWindowMaxTokens(
+  modelId: string | null | undefined,
+  env: Record<string, string | undefined> | undefined,
+): number | undefined {
+  const manifestWindow = findClaudeModel(modelId)?.contextWindowMaxTokens;
+  if (manifestWindow !== undefined) {
+    return manifestWindow;
+  }
+
+  const trimmed = typeof modelId === "string" ? modelId.trim() : "";
+  if (trimmed.length === 0) {
+    return undefined;
+  }
+
+  if (
+    !env?.["CLAUDE_CODE_DISABLE_1M_CONTEXT"] &&
+    CLAUDE_LONG_CONTEXT_MODEL_ID_PATTERN.test(trimmed)
+  ) {
+    return CLAUDE_LONG_CONTEXT_WINDOW_TOKENS;
+  }
+
+  const configured = Number(env?.["CLAUDE_CODE_MAX_CONTEXT_TOKENS"]);
+  return Number.isFinite(configured) && configured > 0 ? Math.round(configured) : undefined;
+}
+
+/**
+ * Read settings.json's `env` block. Synchronous because the window above is resolved while a
+ * session is being constructed.
+ */
+export function readClaudeSettingsEnvSync(
+  settingsPath: string,
+): Record<string, string> | undefined {
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(readFileSync(settingsPath, "utf8"));
+  } catch {
+    return undefined;
+  }
+
+  if (!isRecord(parsed) || !isRecord(parsed.env)) {
+    return undefined;
+  }
+
+  const env: Record<string, string> = {};
+  for (const [key, value] of Object.entries(parsed.env)) {
+    if (typeof value === "string") {
+      env[key] = value;
+    }
+  }
+  return env;
+}
