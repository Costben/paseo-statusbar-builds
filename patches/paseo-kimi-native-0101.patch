+/**
+ * Reads `file` the way a tailer does — `budget` bytes at a time, offset over
+ * bytes consumed — and returns every line that reached the parser. Mirrors
+ * `KimiSessionLog.readAppended`; `align: false` skips the newline alignment so
+ * the pending-fragment seam is exercised directly.
+ */
+async function readInPieces(file: string, budget: number, align = true): Promise<string[]> {
+  const size = statSync(file).size;
+  const parsed: string[] = [];
+  let offset = 0;
+  let pending = "";
+  let guard = 0;
+  while (offset < size) {
+    if (++guard > 10_000) {
+      throw new Error("readInPieces did not make progress");
+    }
+    const budgetEnd = Math.min(size, offset + budget);
+    const end =
+      !align || budgetEnd === size ? budgetEnd : alignRangeEndToNewline(file, budgetEnd, size);
+    const { lines, fragment } = await readLinesFromRange(file, offset, end);
+    offset = end;
+    parsed.push(...mergePendingFragment(pending, lines));
+    pending = nextPendingFragment(pending, lines, fragment);
+  }
+  return parsed;
+}
+
+describe("budgeted wire log reads", () => {
+  test("hands every line to the parser exactly once when the budget cuts mid-line", async () => {
+    const home = mkdtempSync(path.join(tmpdir(), "kimi-chunked-"));
+    const file = path.join(home, "wire.jsonl");
+    const lines = [goalCreateLine(), tokensUpdateLine(74), statusUpdateLine("complete")];
+    writeFileSync(file, `${lines.join("\n")}\n`);
+
+    // A budget far below one record, so every read stops inside the next one.
+    expect(await readInPieces(file, 40)).toEqual(lines);
+  });
+
+  test("loses nothing when the reads cannot be aligned to a line", async () => {
+    const home = mkdtempSync(path.join(tmpdir(), "kimi-chunked-"));
+    const file = path.join(home, "wire.jsonl");
+    // ASCII only: an unaligned read cannot round-trip a character split across
+    // two of them, and this test is about the byte accounting, not the text.
+    const lines = [
+      goalCreateLine({ objective: "ascii objective", completionCriterion: "ascii criterion" }),
+      tokensUpdateLine(74),
+      statusUpdateLine("complete"),
+    ];
+    writeFileSync(file, `${lines.join("\n")}\n`);
+
+    // Every read ends mid-record, so the seam is carried entirely by the held
+    // fragment — including a read that holds no complete line at all.
+    expect(await readInPieces(file, 40, false)).toEqual(lines);
+  });
+
+  test("threads a fragment onto the one already held while a record is unfinished", () => {
+    expect(nextPendingFragment("head", [], "tail")).toBe("headtail");
+    expect(nextPendingFragment("head", ["line"], "tail")).toBe("tail");
+    expect(nextPendingFragment("head", [], "")).toBe("");
+    expect(nextPendingFragment("", ["line"], "tail")).toBe("tail");
+  });
+
+  test("never cuts a range inside a multi-byte character", async () => {
+    const home = mkdtempSync(path.join(tmpdir(), "kimi-utf8-"));
+    const file = path.join(home, "wire.jsonl");
+    const objective = "在当前目录创建 goal-ok.txt 并写入 hello";
+    const line = goalCreateLine({ objective });
+    const prefix = "x".repeat(20);
+    const contents = `${prefix}\n${line}\n`;
+    writeFileSync(file, contents);
+
+    // Cut one byte into the objective's first character, which is three bytes
+    // wide, so the budget boundary lands inside it.
+    const objectiveStart = Buffer.from(contents, "utf8").indexOf(Buffer.from(objective, "utf8"));
+    const budget = objectiveStart + 1;
+
+    expect(await readInPieces(file, budget)).toEqual([prefix, line]);
+    // Without the alignment step the same read decodes the character as a
+    // replacement character on both sides of the cut, and the halves do not
+    // rejoin — the record survives but its text is silently corrupted.
+    expect((await readInPieces(file, budget, false)).join("\n")).toContain("\uFFFD");
+  });
+
+  test("derives the goal from a log larger than one tick's budget", async () => {
+    const { home, file } = createSessionHome(SESSION_ID);
+    const filler = Array.from({ length: 4_000 }, (_, index) =>
+      JSON.stringify({
+        type: "context.append_loop_event",
+        agentId: "main",
+        seq: index,
+        pad: "x".repeat(120),
+      }),
+    ).join("\n");
+    expect(Buffer.byteLength(filler)).toBeGreaterThan(MAX_BYTES_PER_TICK);
+
+    // The goal opens before the filler and its counter lands after it, so both
+    // sides of every chunk seam have to have been parsed.
+    appendFileSync(file, `${goalCreateLine()}\n${filler}\n${tokensUpdateLine(74)}\n`);
+
+    const log = new KimiSessionLog({
+      kimiSessionId: SESSION_ID,
+      kimiHome: home,
+      logger: createTestLogger(),
+      pollIntervalMs: 10,
+    });
+    log.start();
+    try {
+      await waitFor(() => log.getGoal()?.tokensUsed === 74);
+
+      expect(log.getGoal()?.goalId).toBe(GOAL_ID);
+      expect(log.isLive()).toBe(true);
+    } finally {
+      log.stop();
+    }
+  });
+});
