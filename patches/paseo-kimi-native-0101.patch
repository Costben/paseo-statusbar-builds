+const ACTIVE_POLL_INTERVAL_MS = 1_000;
+const LIVE_POLL_INTERVAL_MS = 2_000;
+const IDLE_POLL_INTERVAL_MS = 10_000;
+const SETTLE_POLL_INTERVAL_MS = 1_000;
