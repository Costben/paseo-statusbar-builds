+describe("KimiSessionLog", () => {
+  const logs: KimiSessionLog[] = [];
+
+  function createLog(
+    home: string,
+    overrides: Partial<ConstructorParameters<typeof KimiSessionLog>[0]> = {},
+  ): KimiSessionLog {
+    const log = new KimiSessionLog({
+      kimiSessionId: SESSION_ID,
+      kimiHome: home,
+      logger: createTestLogger(),
+      pollIntervalMs: 10,
+      ...overrides,
+    });
+    logs.push(log);
+    return log;
+  }
+
+  afterEach(() => {
+    for (const log of logs.splice(0)) {
+      log.stop();
+    }
+  });
+
+  test("picks up a goal that was created before the log started", async () => {
+    const { home, file } = createSessionHome(SESSION_ID);
+    appendFileSync(file, `${goalCreateLine()}\n${tokensUpdateLine(74)}\n`);
+
+    const log = createLog(home);
+    log.start();
+    await waitFor(() => log.getGoal() !== null);
+
+    expect(log.getGoal()?.goalId).toBe(GOAL_ID);
+    expect(log.getGoal()?.turnsUsed).toBe(1);
+    expect(log.getGoal()?.tokensUsed).toBe(74);
+    expect(log.isLive()).toBe(true);
+  });
+
+  test("picks up records appended after it started", async () => {
+    const { home, file } = createSessionHome(SESSION_ID);
+    appendFileSync(file, `${goalCreateLine()}\n`);
+
+    const log = createLog(home);
+    log.start();
+    await waitFor(() => log.getGoal()?.turnsUsed === 0);
+
+    appendFileSync(file, `${tokensUpdateLine(74)}\n${tokensUpdateLine(189)}\n`);
+    await waitFor(() => log.getGoal()?.turnsUsed === 2);
+
+    expect(log.getGoal()?.tokensUsed).toBe(189);
+  });
+
+  test("completes a record split across two reads", async () => {
+    const { home, file } = createSessionHome(SESSION_ID);
+    const line = goalCreateLine();
+    appendFileSync(file, line.slice(0, 20));
+
+    const log = createLog(home);
+    log.start();
+    await delay(80);
+
+    expect(log.getGoal()).toBeNull();
+
+    appendFileSync(file, `${line.slice(20)}\n`);
+    await waitFor(() => log.getGoal() !== null);
+
+    expect(log.getGoal()?.objective).toBe(OBJECTIVE);
+  });
+
+  test("reports the goal with its input tally to the goal listener", async () => {
+    const { home, file } = createSessionHome(SESSION_ID);
+    appendFileSync(
+      file,
+      `${goalCreateLine()}\n${usageRecordLine({ inputOther: 1000, inputCacheRead: 400, output: 10 })}\n`,
+    );
+
+    const emitted: Array<AgentGoal | null> = [];
+    const log = createLog(home, { onGoal: (goal) => emitted.push(goal) });
+    log.start();
+    await waitFor(() => (emitted.at(-1)?.inputTokens ?? 0) > 0);
+
+    expect(emitted.at(-1)?.inputTokens).toBe(1400);
+    expect(emitted.at(-1)?.cachedInputTokens).toBe(400);
+    // The parsed goal keeps the provider's own number untouched.
+    expect(log.getGoal()?.tokensUsed).toBe(0);
+  });
+
+  test("emits a goal again when only its input tally moved", async () => {
+    const { home, file } = createSessionHome(SESSION_ID);
+    appendFileSync(file, `${goalCreateLine()}\n`);
+
+    const emitted: Array<AgentGoal | null> = [];
+    const log = createLog(home, { onGoal: (goal) => emitted.push(goal) });
+    log.start();
+    await waitFor(() => emitted.length > 0);
+
+    appendFileSync(file, `${usageRecordLine({ inputOther: 1000, output: 10 })}\n`);
+    await waitFor(() => emitted.at(-1)?.inputTokens === 1000);
+
+    expect(emitted.at(-1)?.inputTokens).toBe(1000);
+  });
+
+  test("emits usage with the model's context window once both are known", async () => {
+    const { home, file } = createSessionHome(SESSION_ID);
+    writeKimiConfig(home, configFor(MODEL_ALIAS, 300_000));
