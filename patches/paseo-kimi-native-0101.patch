+    await delay(150);
+
+    expect(usage).toEqual([]);
+  });
+
+  test("does not repeat an unchanged usage", async () => {
+    const { home, file } = createSessionHome(SESSION_ID);
+    writeKimiConfig(home, configFor(MODEL_ALIAS, 300_000));
+    const record = usageRecordLine({ inputOther: 50829 });
+    appendFileSync(file, `${profileBindLine(MODEL_ALIAS)}\n${record}\n`);
+
+    const usage: AgentUsage[] = [];
+    const log = createLog(home, { onUsage: (value) => usage.push(value) });
+    log.start();
+    await waitFor(() => usage.length === 1);
+
+    appendFileSync(file, `${record}\n`);
+    await delay(150);
+
+    expect(usage).toHaveLength(1);
