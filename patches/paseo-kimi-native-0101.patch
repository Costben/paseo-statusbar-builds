+
+export type KimiSubagentStatus = "running" | "completed" | "canceled";
+
+/** Lifecycle of one subagent, as announced by the main log. */
+export interface KimiSubagentRecord {
+  id: string;
+  name: string | null;
+  description: string | null;
+  toolCallId: string | null;
+  status: KimiSubagentStatus;
+  spawnedAt: number;
+  updatedAt: number;
+  resultSummary: string | null;
+  /** Turn generation that spawned it; the boundary of that turn bounds its life. */
+  turn: number;
+  /** From the spawn record. Null when the log did not say, which is treated as foreground. */
+  runInBackground: boolean | null;
+}
+
+/** A provider-owned task that intentionally outlives the ACP turn. */
+export interface KimiBackgroundTaskRecord {
+  id: string;
+  title: string | null;
+  description: string | null;
+  status: KimiSubagentStatus;
+  createdAt: number;
+  updatedAt: number;
+}
+
+/** Derived state of a session log after replaying a batch of lines. */
+export interface KimiSessionLogState {
+  goal: AgentGoal | null;
+  contextWindowUsedTokens: number | null;
+  /** Model alias bound by the last `profile.bind` or `llm.request`; keys the config lookup. */
+  modelAlias: string | null;
