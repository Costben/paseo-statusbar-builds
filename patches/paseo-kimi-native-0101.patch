+      file,
+      `${profileBindLine(MODEL_ALIAS)}\n${usageRecordLine({ inputOther: 50829 })}\n`,
+    );
+
+    const usage: AgentUsage[] = [];
+    const log = createLog(home, { onUsage: (value) => usage.push(value) });
+    log.start();
+    await waitFor(() => usage.length === 1);
+    expect(usage.at(-1)?.contextWindowMaxTokens).toBe(300_000);
+
+    // Same mtime: the cached parse is served even though the file now says otherwise.
+    writeFileSync(configPath, configFor(MODEL_ALIAS, 400_000));
+    setConfigMtime(configPath, CONFIG_MTIME);
+    appendFileSync(file, `${usageRecordLine({ inputOther: 60000 })}\n`);
+    await waitFor(() => usage.length === 2);
+    expect(usage.at(-1)).toEqual({
+      contextWindowUsedTokens: 60000,
+      contextWindowMaxTokens: 300_000,
+    });
+
+    // New mtime: the parse is redone.
+    setConfigMtime(configPath, new Date(CONFIG_MTIME.getTime() + 60_000));
+    appendFileSync(file, `${usageRecordLine({ inputOther: 70000 })}\n`);
+    await waitFor(() => usage.length === 3);
+    expect(usage.at(-1)).toEqual({
+      contextWindowUsedTokens: 70000,
+      contextWindowMaxTokens: 400_000,
+    });
