+describe("ACP provider hook turn hold", () => {
+  test("interrupt() releases a turn that holdTurnWhile keeps open", async () => {
+    const signals: AbortSignal[] = [];
+    let markHeld!: () => void;
+    const held = new Promise<void>((resolve) => {
+      markHeld = resolve;
+    });
+    const neverSettles = new Promise<void>(() => {});
+    const events: AgentStreamEvent[] = [];
+    const prompt = vi.fn(async (): Promise<PromptResponse> => ({ stopReason: "end_turn" }));
+    const cancel = vi.fn(async () => {});
+    let settleTurn!: () => void;
+    const settled = new Promise<void>((resolve) => {
+      settleTurn = resolve;
+    });
+
+    const session = createSessionWithConfig(
+      {},
+      createTestLogger(),
+      {},
+      {
+        holdTurnWhile: ({ signal }) => {
+          signals.push(signal);
+          markHeld();
+          return neverSettles;
+        },
+      },
+    );
+    asInternals<ACPSessionInternals>(session).sessionId = "session-1";
+    asInternals<ACPSessionInternals>(session).connection = { prompt, cancel };
+    session.subscribe((event) => {
+      events.push(event);
+      if (
+        event.type === "turn_completed" ||
+        event.type === "turn_failed" ||
+        event.type === "turn_canceled"
+      ) {
+        settleTurn();
+      }
+    });
+
+    const { turnId } = await session.startTurn("hello");
+    await held;
+
+    expect(asInternals<ACPSessionInternals>(session).activeForegroundTurnId).toBe(turnId);
+    expect(events.some((event) => event.type === "turn_completed")).toBe(false);
+
+    await session.interrupt();
+    await settled;
+
+    expect(asInternals<ACPSessionInternals>(session).activeForegroundTurnId).toBeNull();
+    expect(cancel).toHaveBeenCalledWith({ sessionId: "session-1" });
+  });
+
+  test("holdTurnWhile receives a signal that interrupt() aborts", async () => {
+    const signals: AbortSignal[] = [];
+    let markHeld!: () => void;
+    const held = new Promise<void>((resolve) => {
+      markHeld = resolve;
+    });
+    let releaseHold!: () => void;
+    const hold = new Promise<void>((resolve) => {
+      releaseHold = resolve;
+    });
+
+    const session = createSessionWithConfig(
+      {},
+      createTestLogger(),
+      {},
+      {
+        holdTurnWhile: ({ signal }) => {
+          signals.push(signal);
+          markHeld();
+          return hold;
+        },
+      },
+    );
+    asInternals<ACPSessionInternals>(session).sessionId = "session-1";
+    asInternals<ACPSessionInternals>(session).connection = {
+      prompt: vi.fn(async (): Promise<PromptResponse> => ({ stopReason: "end_turn" })),
+      cancel: vi.fn(async () => {}),
+    };
+
+    await session.startTurn("hello");
+    await held;
+
+    expect(signals.length).toBe(1);
+    expect(signals[0]?.aborted).toBe(false);
+
+    await session.interrupt();
+
+    expect(signals[0]?.aborted).toBe(true);
+    releaseHold();
+  });
+
+  /**
+   * Runs one turn whose prompt response is withheld until `emit` has had its
+   * chance to land, and reports what the hold was told about the turn's output.
+   */
+  async function collectHoldSawTimeline(update?: SessionUpdate): Promise<boolean[]> {
+    const holds: boolean[] = [];
+    let respondPrompt!: (response: PromptResponse) => void;
+    const response = new Promise<PromptResponse>((resolve) => {
+      respondPrompt = resolve;
+    });
+    let markHeld!: () => void;
+    const held = new Promise<void>((resolve) => {
+      markHeld = resolve;
+    });
+    let releaseHold!: () => void;
+    const hold = new Promise<void>((resolve) => {
+      releaseHold = resolve;
+    });
+    let settleTurn!: () => void;
+    const settled = new Promise<void>((resolve) => {
+      settleTurn = resolve;
+    });
+
+    const session = createSessionWithConfig(
+      {},
+      createTestLogger(),
+      {},
+      {
+        holdTurnWhile: ({ sawTimeline }) => {
+          holds.push(sawTimeline);
+          markHeld();
+          return hold;
+        },
+      },
+    );
+    asInternals<ACPSessionInternals>(session).sessionId = "session-1";
+    asInternals<ACPSessionInternals>(session).connection = {
+      prompt: vi.fn(() => response),
+      cancel: vi.fn(async () => {}),
+    };
+    session.subscribe((event) => {
+      if (
+        event.type === "turn_completed" ||
+        event.type === "turn_failed" ||
+        event.type === "turn_canceled"
+      ) {
+        settleTurn();
+      }
+    });
+
+    await session.startTurn("hello");
+    if (update) {
+      await session.sessionUpdate({ sessionId: "session-1", update });
+    }
+    respondPrompt({ stopReason: "end_turn" });
+    await held;
+
+    releaseHold();
+    await settled;
+    return holds;
+  }
+
+  test("holdTurnWhile is told a turn produced no timeline item", async () => {
+    const holds = await collectHoldSawTimeline();
+
+    expect(holds).toEqual([false]);
+  });
+
+  test("holdTurnWhile is told a turn already produced a timeline item", async () => {
+    const holds = await collectHoldSawTimeline({
+      sessionUpdate: "agent_message_chunk",
+      messageId: "assistant-1",
+      content: { type: "text", text: "on it" },
+    } as SessionUpdate);
+
+    expect(holds).toEqual([true]);
+  });
+});
