@@ -0,0 +1,175 @@
+import { useCallback, type ReactElement } from "react";
+import { Text, View } from "react-native";
+import { Terminal } from "lucide-react-native";
+import { StyleSheet, withUnistyles } from "react-native-unistyles";
+import type { AgentBackgroundTasksPayload } from "@getpaseo/protocol/messages";
+import {
+  MenuRoot,
+  MenuSurface,
+  MenuTrigger,
+  menuRowContentInset,
+  type MenuTriggerState,
+} from "@/components/ui/menu";
+import { formatDuration } from "@/utils/time";
+
+const ThemedTerminal = withUnistyles(Terminal);
+
+const blueMapping = () => ({ color: "#3b82f6" });
+
+const taskPillStyles = StyleSheet.create((theme) => ({
+  pill: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: 4,
+    minHeight: 24,
+    paddingHorizontal: 8,
+    paddingVertical: 2,
+    borderRadius: 9999,
+    borderWidth: 1,
+    borderColor: theme.colors.borderAccent,
+    backgroundColor: theme.colors.surface1,
+    minWidth: 0,
+    flexShrink: 0,
+  },
+  pillActive: {
+    backgroundColor: theme.colors.surface2,
+  },
+  count: {
+    color: "#3b82f6",
+    fontSize: 12,
+    fontWeight: theme.fontWeight.medium,
+    lineHeight: 14,
+  },
+  detailContainer: {
+    paddingVertical: theme.spacing[2],
+    gap: theme.spacing[2],
+  },
+  taskItem: {
+    paddingHorizontal: menuRowContentInset(theme),
+    paddingVertical: theme.spacing[2],
+    borderBottomWidth: StyleSheet.hairlineWidth,
+    borderBottomColor: theme.colors.border,
+    gap: 4,
+  },
+  taskHeader: {
+    flexDirection: "row",
+    alignItems: "center",
+    justifyContent: "space-between",
+  },
+  taskId: {
+    fontSize: 11,
+    fontWeight: theme.fontWeight.medium,
+    color: "#3b82f6",
+    fontFamily: theme.fontFamily.mono,
+  },
+  taskElapsed: {
+    fontSize: 11,
+    color: theme.colors.foregroundExtraMuted,
+  },
+  taskCommand: {
+    fontSize: 12,
+    color: theme.colors.foreground,
+    fontFamily: theme.fontFamily.mono,
+  },
+  taskDesc: {
+    fontSize: 12,
+    color: theme.colors.foregroundMuted,
+  },
+  emptyText: {
+    paddingHorizontal: menuRowContentInset(theme),
+    paddingVertical: theme.spacing[3],
+    color: theme.colors.foregroundMuted,
+    fontSize: 12,
+  },
+}));
+
+interface BackgroundTaskPillProps {
+  backgroundTasks?: AgentBackgroundTasksPayload | null;
+}
+
+export function BackgroundTaskPill({
+  backgroundTasks,
+}: BackgroundTaskPillProps): ReactElement | null {
+  if (!backgroundTasks || backgroundTasks.count <= 0) {
+    return null;
+  }
+
+  return (
+    <MenuRoot compactMode="sheet">
+      <BackgroundTaskPillTrigger count={backgroundTasks.count} />
+      <MenuSurface
+        side="top"
+        align="start"
+        offset={6}
+        sheetTitle={`后台任务 (${backgroundTasks.count})`}
+        minWidth={280}
+        maxWidth={460}
+        maxHeight={400}
+        scrollable
+        testID="composer-background-task-panel"
+      >
+        <BackgroundTaskDetail tasks={backgroundTasks.tasks} />
+      </MenuSurface>
+    </MenuRoot>
+  );
+}
+
+function BackgroundTaskPillTrigger({ count }: { count: number }): ReactElement {
+  const pillStyle = useCallback(
+    ({ hovered, pressed, open }: MenuTriggerState) => [
+      taskPillStyles.pill,
+      (hovered || pressed || open) && taskPillStyles.pillActive,
+    ],
+    [],
+  );
+
+  return (
+    <MenuTrigger
+      testID="composer-background-task-pill"
+      accessibilityRole="button"
+      accessibilityLabel={`后台任务: ${count} 个运行中`}
+      style={pillStyle}
+    >
+      <ThemedTerminal size={13} uniProps={blueMapping} />
+      <Text style={taskPillStyles.count}>{count}</Text>
+    </MenuTrigger>
+  );
+}
+
+function BackgroundTaskDetail({
+  tasks,
+}: {
+  tasks: AgentBackgroundTasksPayload["tasks"];
+}): ReactElement {
+  if (tasks.length === 0) {
+    return <Text style={taskPillStyles.emptyText}>当前没有正在运行的后台任务</Text>;
+  }
+
+  const now = Date.now();
+
+  return (
+    <View style={taskPillStyles.detailContainer}>
+      {tasks.map((task) => {
+        const elapsed = task.startedAt ? formatDuration(now - task.startedAt) : null;
+        return (
+          <View key={task.id} style={taskPillStyles.taskItem}>
+            <View style={taskPillStyles.taskHeader}>
+              <Text style={taskPillStyles.taskId}>{task.id}</Text>
+              {elapsed ? <Text style={taskPillStyles.taskElapsed}>已运行 {elapsed}</Text> : null}
+            </View>
+            {task.description ? (
+              <Text style={taskPillStyles.taskDesc} numberOfLines={2}>
+                {task.description}
+              </Text>
+            ) : null}
+            {task.command ? (
+              <Text style={taskPillStyles.taskCommand} numberOfLines={3}>
+                {task.command}
+              </Text>
+            ) : null}
+          </View>
+        );
+      })}
+    </View>
+  );
+}
