+const REDUNDANT_THINKING_PREFIX = /^thinking[\s:_-]+/i;
+
+function stripThinkingPrefix(label: string): string {
+  const stripped = label.replace(REDUNDANT_THINKING_PREFIX, "").trim();
+  return stripped || label;
+}
