@@ -0,0 +1,31 @@
+import { describe, expect, it } from "vitest";
+import { updateChromeHeight } from "./chrome";
+
+describe("composer chrome totals", () => {
+  it("adds each reported row to the total", () => {
+    const heights = new Map<string, number>();
+    expect(updateChromeHeight(heights, "attachment-tray", 60)).toBe(60);
+    expect(updateChromeHeight(heights, "import-pill", 44)).toBe(104);
+  });
+
+  it("replaces a row instead of adding it twice", () => {
+    const heights = new Map<string, number>();
+    updateChromeHeight(heights, "attachment-tray", 60);
+    expect(updateChromeHeight(heights, "attachment-tray", 120)).toBe(120);
+    expect(updateChromeHeight(heights, "attachment-tray", 120)).toBe(120);
+  });
+
+  it("drops a row that reports zero", () => {
+    const heights = new Map<string, number>();
+    updateChromeHeight(heights, "attachment-tray", 60);
+    updateChromeHeight(heights, "import-pill", 44);
+    expect(updateChromeHeight(heights, "attachment-tray", 0)).toBe(44);
+    expect(heights.has("attachment-tray")).toBe(false);
+  });
+
+  it("treats a negative height as absent", () => {
+    const heights = new Map<string, number>();
+    expect(updateChromeHeight(heights, "attachment-tray", -20)).toBe(0);
+    expect(heights.size).toBe(0);
+  });
+});
