+/** Agents such as Kimi caption the entry themselves ("Thinking High"); the badge already sits under that caption. */
+const REDUNDANT_THINKING_PREFIX = /^thinking[\s:_-]+/i;
+
+function stripThinkingPrefix(label: string): string {
+  const stripped = label.replace(REDUNDANT_THINKING_PREFIX, "").trim();
+  return stripped || label;
+}
+
 export function formatThinkingOptionLabel(option: ControlLabelInput): string {
   const rawLabel = (option.label ?? option.id).trim();
   const compactId = option.id.replace(/[\s_-]+/g, "").toLowerCase();
@@ -41,5 +49,5 @@ export function formatThinkingOptionLabel(option: ControlLabelInput): string {
     return i18n.t("agentControls.thinking.extraHigh");
   }
 
-  return formatControlLabel(option, true);
+  return formatControlLabel({ id: option.id, label: stripThinkingPrefix(rawLabel) }, true);
 }
