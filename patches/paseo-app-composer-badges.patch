+import { createContext, useContext } from "react";
+
+/**
+ * Reports the height of composer chrome that sits above the editing area — the
+ * attachment tray, the import pill. The dock adds the sum to the compact cap, so
+ * attachments grow the shell by their own height instead of coming out of the
+ * text's budget.
+ *
+ * Keyed because the composer and the draft tab each own a row; the last height a
+ * key reports replaces its previous one, and `0` removes it.
+ */
+export type ComposerChromeSink = (key: string, height: number) => void;
+
+export const ComposerChromeContext = createContext<ComposerChromeSink | null>(null);
+
+export function useComposerChromeSink(): ComposerChromeSink | null {
+  return useContext(ComposerChromeContext);
+}
+
+/** Apply one report and return the total the dock should add to its cap. */
+export function updateChromeHeight(
+  heights: Map<string, number>,
+  key: string,
+  height: number,
+): number {
+  const next = Math.max(0, height);
+  if (next === 0) {
+    heights.delete(key);
+  } else {
+    heights.set(key, next);
+  }
+  let total = 0;
+  for (const value of heights.values()) total += value;
+  return total;
+}
