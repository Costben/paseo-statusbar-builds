diff --git a/packages/app/src/agent-controls/labels.test.ts b/packages/app/src/agent-controls/labels.test.ts
index 4f1302f..4a15f6b 100644
--- a/packages/app/src/agent-controls/labels.test.ts
+++ b/packages/app/src/agent-controls/labels.test.ts
@@ -29,4 +29,16 @@ describe("formatThinkingOptionLabel", () => {
     expect(formatThinkingOptionLabel({ id: "think-hard", label: "think-hard" })).toBe("Think hard");
     expect(formatThinkingOptionLabel({ id: "xhigh", label: "XHigh" })).toBe("Extra high");
   });
+
+  it("drops the prefix agents already caption the option with", () => {
+    expect(formatThinkingOptionLabel({ id: "off", label: "Thinking Off" })).toBe("Off");
+    expect(formatThinkingOptionLabel({ id: "medium", label: "Thinking Medium" })).toBe("Medium");
+    expect(formatThinkingOptionLabel({ id: "high", label: "Thinking High" })).toBe("High");
+    expect(formatThinkingOptionLabel({ id: "xhigh", label: "Thinking Xhigh" })).toBe("Extra high");
+  });
+
+  it("leaves an unprefixed label alone", () => {
+    expect(formatThinkingOptionLabel({ id: "high", label: "High" })).toBe("High");
+    expect(formatThinkingOptionLabel({ id: "thinking" })).toBe("Thinking");
+  });
 });
