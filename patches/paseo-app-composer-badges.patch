+// image alt text stay untouched.
+const PORT_URL = String.raw`https?:\/\/[A-Za-z0-9\-._~%]+:\d{1,5}[A-Za-z0-9\-._~:/?#\[\]@!$&'()*+,;=%]*`;
+const PORT_URL_PATTERN = new RegExp(PORT_URL, "g");
+const HAS_PORT_URL = new RegExp(PORT_URL);
+
+function trimAutolink(url: string): string {
+  let end = url.length;
+  while (end > 0 && ".,;:!?".includes(url[end - 1])) end--;
+  while (end > 0 && (url[end - 1] === ")" || url[end - 1] === "]")) {
+    const close = url[end - 1];
+    const open = close === ")" ? "(" : "[";
+    const head = url.slice(0, end);
+    if (head.split(close).length > head.split(open).length) end--;
+    else break;
+  }
+  return url.slice(0, end);
